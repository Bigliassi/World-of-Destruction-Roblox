local launchPromptBanner = makeFrame("LaunchPromptBanner", UDim2.fromOffset(520, 64), UDim2.new(0.5, 0, 0.22, 0), Vector2.new(0.5, 0.5), Color3.fromRGB(14, 20, 34), 0.08, gui)
