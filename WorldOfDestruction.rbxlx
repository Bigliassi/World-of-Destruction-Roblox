		EnableRoadblocks = true,
		EnableSpikeStrips = true,
		EnableHelicopter = true,
	},
}

--------------------------------------------------------------------------------
-- Shared Infrastructure Helpers (Bindables & Remotes)
--------------------------------------------------------------------------------
local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function ensureBindableEvent(parent: Instance, name: string): BindableEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BindableEvent") then
		return existing
	end
	local ev = Instance.new("BindableEvent")
	ev.Name = name
	ev.Parent = parent
	return ev
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = parent
	return re
end

local serverEventsFolder = ensureFolder(ServerStorage, "Events")
local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")
local policeWorldFolder = ensureFolder(Workspace, "PoliceUnits")

-- ServerStorage Bindables
local AddHeatBindable = ensureBindableEvent(ServerStorage, "AddHeatEvent")
local PoliceTakedownBindable = ensureBindableEvent(ServerStorage, "PoliceTakedownEvent")
local PlayerBustedBindable = ensureBindableEvent(ServerStorage, "PlayerBustedEvent")
local AddCashBindable = ensureBindableEvent(ServerStorage, "AddCashEvent")
local VehicleRepairedBindable = ensureBindableEvent(ServerStorage, "VehicleRepairedEvent")

local FolderAddHeatBindable = ensureBindableEvent(serverEventsFolder, "AddHeatEvent")
local FolderPoliceTakedownBindable = ensureBindableEvent(serverEventsFolder, "PoliceTakedownEvent")
local FolderPlayerBustedBindable = ensureBindableEvent(serverEventsFolder, "PlayerBustedEvent")

-- ReplicatedStorage Remotes
local PoliceAlertRemote = ensureRemoteEvent(remotesFolder, "PoliceAlert")
local HeatUpdateRemote = ensureRemoteEvent(remotesFolder, "HeatUpdate")
local PlayerBustedRemote = ensureRemoteEvent(remotesFolder, "PlayerBusted")
local ReportCopImpactRemote = ensureRemoteEvent(remotesFolder, "ReportCopImpact")
local StyleCalloutRemote = ensureRemoteEvent(remotesFolder, "StyleCallout")

local RootPoliceAlertRemote = ensureRemoteEvent(ReplicatedStorage, "PoliceAlertEvent")
local RootPlayerBustedRemote = ensureRemoteEvent(ReplicatedStorage, "PlayerBustedEvent")
local RootReportCopImpactRemote = ensureRemoteEvent(ReplicatedStorage, "PoliceTakedown")

--------------------------------------------------------------------------------
-- Active Pursuit Data Structures
--------------------------------------------------------------------------------
type ActiveCopUnit = {
	Id: string,
	Kind: PoliceUnitKind,
	Archetype: UnitArchetype,
	Model: Model,
	Chassis: Part,
	RedSiren: Part,
	BlueSiren: Part,
	RedLight: PointLight,
	BlueLight: PointLight,
	Heading: number,
	HP: number,
	StunTimer: number,
	RamPhase: number,
	SlotIndex: number,
}

type ActiveRoadblock = {
	Model: Model,
	SpawnedAt: number,
}

type ActiveSpikeStrip = {
	Model: Model,
	TriggerPart: Part,
	Triggered: boolean,
	SpawnedAt: number,
}

type ActiveHelicopter = {
	Model: Model,
	Hull: Part,
	Rotor: Part,
	SearchlightBeam: Beam?,
	SpotLight: SpotLight,
	GroundSpot: Part,
	OrbitAngle: number,
}

type PlayerHeatState = {
	TotalHeat: number, -- 0..500
	HeatStars: number, -- 0..5
	HeatProgress: number, -- 0..100 within current star
	LastCrimeAt: number,
	LastSeenByPoliceAt: number,
	InLineOfSight: boolean,
	BustedTimer: number, -- 0..4.0 seconds
	ReachedFiveStarBanner: boolean,
	Units: { ActiveCopUnit },
	Roadblocks: { ActiveRoadblock },
	SpikeStrips: { ActiveSpikeStrip },
	Helicopter: ActiveHelicopter?,
	LastRoadblockAt: number,
	LastSpikeStripAt: number,
	LastImpactReportAt: number,
}

local playerHeatStates: { [number]: PlayerHeatState } = {}

--------------------------------------------------------------------------------
-- Player & Vehicle Pose / Velocity Helpers
--------------------------------------------------------------------------------
local function getPlayerVehicleOrRoot(player: Player): (BasePart?, Model?)
	local vehiclesFolder = Workspace:FindFirstChild("PlayerVehicles") or Workspace:FindFirstChild("Vehicles")
	if vehiclesFolder then
		local vModel = vehiclesFolder:FindFirstChild(player.Name .. "_Vehicle")
			or vehiclesFolder:FindFirstChild(player.Name)
			or vehiclesFolder:FindFirstChild("PlayerCar_" .. tostring(player.UserId))
		if vModel and vModel:IsA("Model") then
			local primary = vModel.PrimaryPart or vModel:FindFirstChildWhichIsA("BasePart")
			if primary then
				return primary, vModel
			end
		end
	end

	local character = player.Character
	if character then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then
			local seatModel = hum.SeatPart:FindFirstAncestorOfClass("Model")
			return hum.SeatPart, seatModel
		end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp, character
		end
	end
	return nil, nil
end

local function getPlayerMotion(player: Player): (Vector3, Vector3, number, Vector3)
	local rootPart, model = getPlayerVehicleOrRoot(player)
	if not rootPart then
		return Vector3.new(0, 3, 0), Vector3.new(0, 0, -1), 0, Vector3.zero
	end

	local pos = rootPart.Position
	local look = rootPart.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude > 0.001 then
		flatLook = flatLook.Unit
	else
		flatLook = Vector3.new(0, 0, -1)
	end

	local vel = rootPart.AssemblyLinearVelocity
	local speed = vel.Magnitude

	-- Also support kinematic vehicle controllers that store speed as an attribute
	local attrSpeed = tonumber(
		rootPart:GetAttribute("CurrentSpeed")
		or (if model then model:GetAttribute("CurrentSpeed") or model:GetAttribute("Speed") else nil)
		or player:GetAttribute("VehicleSpeed")
	)
	if attrSpeed and math.abs(attrSpeed) > speed then
		speed = math.abs(attrSpeed)
		vel = flatLook * attrSpeed
	end

	return pos, flatLook, speed, vel
end

--------------------------------------------------------------------------------
-- Model Builders: Police Cruisers, SUV Interceptors, SWAT Trucks, Roadblocks,
-- Spike Strips & Star-5 Police Helicopter with Spotlight!
--------------------------------------------------------------------------------
local unitSerial = 0

local function buildPoliceVehicle(kind: PoliceUnitKind, spawnPos: Vector3, heading: number, slotIndex: number): ActiveCopUnit
	unitSerial += 1
	local arch = UNIT_ARCHETYPES[kind]
	local model = Instance.new("Model")
	model.Name = string.format("Police_%s_%d", kind, unitSerial)
	model:SetAttribute("IsPoliceUnit", true)
	model:SetAttribute("PoliceUnitKind", kind)
	model:SetAttribute("MaxHP", arch.MaxHP)
	model:SetAttribute("HP", arch.MaxHP)

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = arch.BodySize
	chassis.Color = arch.BodyColor
	chassis.Material = Enum.Material.SmoothPlastic
	chassis.Anchored = true
	chassis.CanCollide = true
	chassis.CFrame = CFrame.new(spawnPos) * CFrame.Angles(0, heading, 0)
	chassis.Parent = model
	model.PrimaryPart = chassis

	-- Side Police Livery Stripe / Cabin
	local cabin = Instance.new("Part")
	cabin.Name = "Cabin"
	cabin.Size = Vector3.new(arch.BodySize.X * 0.86, arch.BodySize.Y * 0.65, arch.BodySize.Z * 0.52)
	cabin.Color = arch.AccentColor
	cabin.Material = Enum.Material.SmoothPlastic
	cabin.Anchored = true
	cabin.CanCollide = false
	cabin.CFrame = chassis.CFrame * CFrame.new(0, arch.BodySize.Y * 0.62, 0.4)
	cabin.Parent = model

	-- Front Push-Bumper / Bullbar
	local bumper = Instance.new("Part")
	bumper.Name = "PushBumper"
	bumper.Size = Vector3.new(arch.BodySize.X * 0.92, arch.BodySize.Y * 0.45, 0.8)
	bumper.Color = Color3.fromRGB(20, 22, 26)
	bumper.Material = Enum.Material.Metal
	bumper.Anchored = true
	bumper.CanCollide = false
	bumper.CFrame = chassis.CFrame * CFrame.new(0, -arch.BodySize.Y * 0.15, -arch.BodySize.Z * 0.5 - 0.35)
	bumper.Parent = model

	-- Roof Siren Lightbar (Red + Blue)
	local barY = arch.BodySize.Y * 0.98
	local redSiren = Instance.new("Part")
	redSiren.Name = "SirenRed"
	redSiren.Size = Vector3.new(arch.BodySize.X * 0.36, 0.45, 0.9)
	redSiren.Color = Color3.fromRGB(255, 35, 35)
	redSiren.Material = Enum.Material.Neon
	redSiren.Anchored = true
	redSiren.CanCollide = false
	redSiren.CFrame = chassis.CFrame * CFrame.new(-arch.BodySize.X * 0.2, barY, 0)
	redSiren.Parent = model

	local redLight = Instance.new("PointLight")
	redLight.Color = Color3.fromRGB(255, 40, 40)
	redLight.Range = 28
	redLight.Brightness = 3.5
	redLight.Parent = redSiren

	local blueSiren = Instance.new("Part")
	blueSiren.Name = "SirenBlue"
	blueSiren.Size = Vector3.new(arch.BodySize.X * 0.36, 0.45, 0.9)
	blueSiren.Color = Color3.fromRGB(35, 110, 255)
	blueSiren.Material = Enum.Material.Neon
	blueSiren.Anchored = true
	blueSiren.CanCollide = false
	blueSiren.CFrame = chassis.CFrame * CFrame.new(arch.BodySize.X * 0.2, barY, 0)
	blueSiren.Parent = model

	local blueLight = Instance.new("PointLight")
	blueLight.Color = Color3.fromRGB(40, 120, 255)
	blueLight.Range = 28
	blueLight.Brightness = 0.5
	blueLight.Parent = blueSiren

	CollectionService:AddTag(model, "PoliceUnit")
	model.Parent = policeWorldFolder

	return {
		Id = model.Name,
		Kind = kind,
		Archetype = arch,
		Model = model,
		Chassis = chassis,
		RedSiren = redSiren,
		BlueSiren = blueSiren,
		RedLight = redLight,
		BlueLight = blueLight,
		Heading = heading,
		HP = arch.MaxHP,
		StunTimer = 0,
		RamPhase = math.random() * math.pi * 2,
		SlotIndex = slotIndex,
	}
end

local function updateCopModelTransform(unit: ActiveCopUnit, pos: Vector3, heading: number)
	local cf = CFrame.new(pos) * CFrame.Angles(0, heading, 0)
	unit.Chassis.CFrame = cf
	local arch = unit.Archetype
	local cabin = unit.Model:FindFirstChild("Cabin") :: BasePart?
	if cabin then
		cabin.CFrame = cf * CFrame.new(0, arch.BodySize.Y * 0.62, 0.4)
	end
	local bumper = unit.Model:FindFirstChild("PushBumper") :: BasePart?
	if bumper then
		bumper.CFrame = cf * CFrame.new(0, -arch.BodySize.Y * 0.15, -arch.BodySize.Z * 0.5 - 0.35)
	end
	local barY = arch.BodySize.Y * 0.98
	unit.RedSiren.CFrame = cf * CFrame.new(-arch.BodySize.X * 0.2, barY, 0)
	unit.BlueSiren.CFrame = cf * CFrame.new(arch.BodySize.X * 0.2, barY, 0)
end

local function spawnDebrisBurst(position: Vector3, tint: Color3)
	for i = 1, 7 do
		local chunk = Instance.new("Part")
		chunk.Name = "CopDebris"
		chunk.Size = Vector3.new(1.2 + math.random(), 0.8 + math.random(), 1.4 + math.random())
		chunk.Color = if i % 2 == 0 then tint else Color3.fromRGB(45, 50, 60)
		chunk.Material = Enum.Material.Metal
		chunk.Position = position + Vector3.new(math.random(-3, 3), 2 + math.random() * 2, math.random(-3, 3))
		chunk.Anchored = false
		chunk.CanCollide = false
		chunk.AssemblyLinearVelocity = Vector3.new(math.random(-38, 38), math.random(24, 52), math.random(-38, 38))
		chunk.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
		chunk.Parent = policeWorldFolder
		Debris:AddItem(chunk, 2.2)
	end
end

local function deployRoadblockAhead(playerPos: Vector3, playerForward: Vector3): ActiveRoadblock
	local centerPos = Vector3.new(playerPos.X, 2.0, playerPos.Z) + playerForward * 115
	local facingCF = CFrame.lookAt(centerPos, centerPos - playerForward)
	local rightVec = facingCF.RightVector

	local rbModel = Instance.new("Model")
	rbModel.Name = "PoliceRoadblock"
	rbModel:SetAttribute("IsPoliceRoadblock", true)
	rbModel:SetAttribute("DestructibleType", "PoliceRoadblock")
	rbModel:SetAttribute("CashReward", 120)

	-- Two angled Interceptor barriers + concrete sawhorses in the gap
	for _, offset in ipairs({ -11, 11 }) do
		local cruiserBarrier = Instance.new("Part")
		cruiserBarrier.Name = "RoadblockInterceptor"
		cruiserBarrier.Size = Vector3.new(6.5, 3.8, 14.0)
		cruiserBarrier.Color = Color3.fromRGB(25, 30, 44)
		cruiserBarrier.Material = Enum.Material.Metal
		cruiserBarrier.Anchored = true
		cruiserBarrier.CanCollide = true
		cruiserBarrier.CFrame = CFrame.new(centerPos + rightVec * offset)
			* CFrame.Angles(0, math.rad(if offset < 0 then 72 else -72), 0)
		cruiserBarrier.Parent = rbModel
	end

	for _, barricadeOffset in ipairs({ -3.5, 3.5 }) do
		local barrier = Instance.new("Part")
		barrier.Name = "PoliceBarricade"
		barrier.Size = Vector3.new(5.5, 3.0, 1.8)
		barrier.Color = Color3.fromRGB(255, 140, 20)
		barrier.Material = Enum.Material.Neon
		barrier.Anchored = true
		barrier.CanCollide = true
		barrier.CFrame = facingCF * CFrame.new(barricadeOffset, -0.3, 0)
		barrier.Parent = rbModel
	end

	rbModel.Parent = policeWorldFolder
	return {
		Model = rbModel,
		SpawnedAt = os.clock(),
	}
end

local function deploySpikeStripAhead(targetPlayer: Player, playerPos: Vector3, playerForward: Vector3): ActiveSpikeStrip
	local stripPos = Vector3.new(playerPos.X, 0.35, playerPos.Z) + playerForward * 92
	local stripCF = CFrame.lookAt(stripPos, stripPos + playerForward)

	local stripModel = Instance.new("Model")
	stripModel.Name = "PoliceSpikeStrip"
	stripModel:SetAttribute("IsSpikeStrip", true)

	local basePart = Instance.new("Part")
	basePart.Name = "SpikeStripBar"
	basePart.Size = Vector3.new(22, 0.45, 2.2)
	basePart.Color = Color3.fromRGB(250, 200, 30)
	basePart.Material = Enum.Material.Metal
	basePart.Anchored = true
	basePart.CanCollide = false
	basePart.CFrame = stripCF
	basePart.Parent = stripModel
	stripModel.PrimaryPart = basePart

	local stateRecord: ActiveSpikeStrip = {
		Model = stripModel,
		TriggerPart = basePart,
		Triggered = false,
		SpawnedAt = os.clock(),
	}

	basePart.Touched:Connect(function(hit: BasePart)
		if stateRecord.Triggered then
			return
		end
		local rootPart, vehicleModel = getPlayerVehicleOrRoot(targetPlayer)
		if not rootPart then
			return
		end
		if hit == rootPart or (vehicleModel and hit:IsDescendantOf(vehicleModel)) or (targetPlayer.Character and hit:IsDescendantOf(targetPlayer.Character)) then
			stateRecord.Triggered = true
			targetPlayer:SetAttribute("TiresPopped", true)
			targetPlayer:SetAttribute("SpikeStripSlowUntil", os.clock() + 4.5)

			if vehicleModel then
				vehicleModel:SetAttribute("TiresPopped", true)
				local seat = vehicleModel:FindFirstChildOfClass("VehicleSeat")
				if seat then
					local originalSpeed = seat.MaxSpeed
					seat.MaxSpeed = math.max(24, originalSpeed * 0.45)
					task.delay(4.5, function()
						if seat.Parent then
							seat.MaxSpeed = originalSpeed
						end
						if vehicleModel.Parent then
							vehicleModel:SetAttribute("TiresPopped", false)
						end
						if targetPlayer.Parent then
							targetPlayer:SetAttribute("TiresPopped", false)
						end
					end)
				end
			end

			StyleCalloutRemote:FireClient(targetPlayer, {
				Callout = "SPIKE STRIP HIT! TIRES DAMAGED!",
				Multiplier = tonumber(targetPlayer:GetAttribute("ComboMultiplier")) or 1,
				ComboCount = tonumber(targetPlayer:GetAttribute("ComboCount")) or 0,
				CashAwarded = 0,
			})
		end
	end)

	stripModel.Parent = policeWorldFolder
	return stateRecord
end

local function spawnPoliceHelicopter(playerPos: Vector3): ActiveHelicopter
	local heliModel = Instance.new("Model")
	heliModel.Name = "PoliceChopper_Star5"
	heliModel:SetAttribute("IsPoliceHelicopter", true)

	local hull = Instance.new("Part")
	hull.Name = "HeliHull"
	hull.Size = Vector3.new(7.5, 5.2, 18.0)
	hull.Color = Color3.fromRGB(18, 26, 48)
	hull.Material = Enum.Material.Metal
	hull.Anchored = true
	hull.CanCollide = false
	hull.Position = playerPos + Vector3.new(0, 82, 0)
	hull.Parent = heliModel
	heliModel.PrimaryPart = hull

	local rotor = Instance.new("Part")
	rotor.Name = "MainRotor"
	rotor.Size = Vector3.new(26.0, 0.25, 1.8)
	rotor.Color = Color3.fromRGB(220, 225, 235)
	rotor.Material = Enum.Material.Metal
	rotor.Anchored = true
	rotor.CanCollide = false
	rotor.Position = hull.Position + Vector3.new(0, 3.1, 0)
	rotor.Parent = heliModel

	local spotLight = Instance.new("SpotLight")
	spotLight.Name = "ChopperSearchlight"
	spotLight.Face = Enum.NormalId.Bottom
	spotLight.Angle = 45
	spotLight.Brightness = 6.0
	spotLight.Range = 120
	spotLight.Color = Color3.fromRGB(255, 250, 215)
	spotLight.Parent = hull

	local groundSpot = Instance.new("Part")
	groundSpot.Name = "SearchlightPool"
	groundSpot.Shape = Enum.PartType.Cylinder
	groundSpot.Size = Vector3.new(0.3, 28, 28)
	groundSpot.Color = Color3.fromRGB(255, 250, 200)
	groundSpot.Material = Enum.Material.Neon
	groundSpot.Transparency = 0.68
	groundSpot.Anchored = true
	groundSpot.CanCollide = false
	groundSpot.CFrame = CFrame.new(playerPos.X, 0.3, playerPos.Z) * CFrame.Angles(0, 0, math.rad(90))
	groundSpot.Parent = heliModel

	-- Visible Volumetric Spotlight Beam from Helicopter to Ground Pool
	local attachTop = Instance.new("Attachment")
	attachTop.Name = "BeamTop"
	attachTop.Position = Vector3.new(0, -2.4, -3.0)
	attachTop.Parent = hull

	local attachBottom = Instance.new("Attachment")
	attachBottom.Name = "BeamBottom"
	attachBottom.Parent = groundSpot

	local beam = Instance.new("Beam")
	beam.Name = "SpotlightBeam"
	beam.Attachment0 = attachTop
	beam.Attachment1 = attachBottom
	beam.Width0 = 2.2
	beam.Width1 = 22.0
	beam.FaceCamera = true
	beam.LightEmission = 1.0
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 252, 215))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.45),
		NumberSequenceKeypoint.new(1, 0.88),
	})
	beam.Parent = hull

	heliModel.Parent = policeWorldFolder

	return {
		Model = heliModel,
		Hull = hull,
		Rotor = rotor,
		SearchlightBeam = beam,
		SpotLight = spotLight,
		GroundSpot = groundSpot,
		OrbitAngle = 0,
	}
end

--------------------------------------------------------------------------------
-- State Synchronization & Force Spawning
--------------------------------------------------------------------------------
local function syncHeatAttributes(player: Player, state: PlayerHeatState)
	local stars = 0
	if state.TotalHeat > 0 then
		stars = math.clamp(math.ceil(state.TotalHeat / HEAT_POINTS_PER_STAR), 1, MAX_HEAT_STARS)
	end
	state.HeatStars = stars

	local progressInStar = 0
	if stars > 0 then
		local starFloor = (stars - 1) * HEAT_POINTS_PER_STAR
		progressInStar = math.clamp(((state.TotalHeat - starFloor) / HEAT_POINTS_PER_STAR) * 100, 0, 100)
	end
	state.HeatProgress = math.floor(progressInStar + 0.5)

	local bustedRatio = math.clamp(state.BustedTimer / BUSTED_HOLD_DURATION, 0, 1)
	local isEvading = stars > 0 and not state.InLineOfSight and (os.clock() - state.LastSeenByPoliceAt >= EVADE_COOLDOWN_DELAY)

	player:SetAttribute("HeatStars", stars)
	player:SetAttribute("HeatProgress", state.HeatProgress)
	player:SetAttribute("HeatProgressNormalized", tonumber(string.format("%.3f", state.HeatProgress / 100)))
	player:SetAttribute("PoliceInSight", state.InLineOfSight)
	player:SetAttribute("PoliceEvading", isEvading)
	player:SetAttribute("BustedProgress", tonumber(string.format("%.3f", bustedRatio)))

	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local heatVal = ls:FindFirstChild("HeatLevel") :: IntValue?
		if heatVal and heatVal.Value ~= stars then
			heatVal.Value = stars
		end
	end
end

local function clearAllPursuitAssets(state: PlayerHeatState)
	for _, unit in ipairs(state.Units) do
		if unit.Model and unit.Model.Parent then
			unit.Model:Destroy()
		end
	end
	table.clear(state.Units)

	for _, rb in ipairs(state.Roadblocks) do
		if rb.Model and rb.Model.Parent then
			rb.Model:Destroy()
		end
	end
	table.clear(state.Roadblocks)

	for _, ss in ipairs(state.SpikeStrips) do
		if ss.Model and ss.Model.Parent then
			ss.Model:Destroy()
		end
	end
	table.clear(state.SpikeStrips)

	if state.Helicopter then
		if state.Helicopter.Model and state.Helicopter.Model.Parent then
			state.Helicopter.Model:Destroy()
		end
		state.Helicopter = nil
	end
end

local function reconcilePoliceForceForStars(player: Player, state: PlayerHeatState)
	local stars = state.HeatStars
	if stars <= 0 then
		clearAllPursuitAssets(state)
		return
	end

	local roster = STAR_ROSTER[stars]
	if not roster then
		return
	end

	local playerPos, _playerFwd = getPlayerMotion(player)

	-- Count currently active units by kind
	local desiredCounts: { [PoliceUnitKind]: number } = {
		Cruiser = 0,
		InterceptorSUV = 0,
		SWATEnforcer = 0,
	}
	for _, kind in ipairs(roster.Units) do
		desiredCounts[kind] = (desiredCounts[kind] or 0) + 1
	end

	local currentCounts: { [PoliceUnitKind]: number } = {
		Cruiser = 0,
		InterceptorSUV = 0,
		SWATEnforcer = 0,
	}
	for _, u in ipairs(state.Units) do
		currentCounts[u.Kind] = (currentCounts[u.Kind] or 0) + 1
	end

	-- Spawn missing units in a wide perimeter ring (85..125 studs out)
	for _, kind in ipairs({ "Cruiser", "InterceptorSUV", "SWATEnforcer" } :: { PoliceUnitKind }) do
		local needed = (desiredCounts[kind] or 0) - (currentCounts[kind] or 0)
		for _ = 1, needed do
			local angle = math.random() * math.pi * 2
			local dist = math.random(85, 125)
			local spawnPos = Vector3.new(
				playerPos.X + math.cos(angle) * dist,
				UNIT_ARCHETYPES[kind].BodySize.Y * 0.5 + 0.5,
				playerPos.Z + math.sin(angle) * dist
			)
			local slotIndex = #state.Units + 1
			local newUnit = buildPoliceVehicle(kind, spawnPos, angle + math.pi, slotIndex)
			table.insert(state.Units, newUnit)
		end
	end

	-- Star 5 Helicopter Spotlight from above!
	if roster.EnableHelicopter and not state.Helicopter then
		state.Helicopter = spawnPoliceHelicopter(playerPos)
		PoliceAlertRemote:FireClient(player, {
			HeatStars = 5,
			Headline = "5-STAR MAXIMUM HEAT! POLICE CHOPPER INBOUND!",
			UnitType = "Helicopter",
		})
	elseif not roster.EnableHelicopter and state.Helicopter then
		if state.Helicopter.Model and state.Helicopter.Model.Parent then
			state.Helicopter.Model:Destroy()
		end
		state.Helicopter = nil
	end
end

--------------------------------------------------------------------------------
-- Cop Takedowns & "BUSTED!" Sequence
--------------------------------------------------------------------------------
local function destroyPoliceUnit(player: Player, state: PlayerHeatState, unitIndex: number)
	local unit = state.Units[unitIndex]
	if not unit then
		return
	end

	local crashPos = unit.Chassis.Position
	local kindName = unit.Archetype.DisplayName
	local takedownBonus = unit.Archetype.TakedownCash

	spawnDebrisBurst(crashPos, unit.Archetype.BodyColor)
	if unit.Model and unit.Model.Parent then
		unit.Model:Destroy()
	end
	table.remove(state.Units, unitIndex)

	-- Grant slight heat relief when wrecking a pursuer, while firing COP TAKEDOWN!
	state.TotalHeat = math.max(40, state.TotalHeat - 30)
	syncHeatAttributes(player, state)

	PoliceTakedownBindable:Fire(player, kindName, crashPos, takedownBonus)
	FolderPoliceTakedownBindable:Fire(player, kindName, crashPos, takedownBonus)
end

local function findRespawnLocation(player: Player): (CFrame, string)
	-- Check for a Police Station or Garage spawn point in Workspace
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BasePart") then
			local lower = string.lower(desc.Name)
			if string.find(lower, "policestation") or string.find(lower, "precinct") then
				return desc.CFrame + Vector3.new(0, 4.5, 0), "Police Station Precinct"
			end
		end
	end

	local lastMechanicCF = player:GetAttribute("LastMechanicRespawnCFrame")
	if typeof(lastMechanicCF) == "CFrame" then
		return lastMechanicCF, "Mechanic Garage"
	end

	local spotsFolder = Workspace:FindFirstChild("GarageSpots")
	if spotsFolder then
		local firstSpot = spotsFolder:FindFirstChildWhichIsA("BasePart")
		if firstSpot then
			return firstSpot.CFrame + Vector3.new(0, 4.5, 0), firstSpot.Name
		end
	end

	local spawnLoc = Workspace:FindFirstChildOfClass("SpawnLocation")
	if spawnLoc then
		return spawnLoc.CFrame + Vector3.new(0, 4.5, 0), "Central Police Station"
	end

	return DEFAULT_POLICE_STATION_CFRAME, "Central Police Station"
end

local function triggerPlayerBusted(player: Player, state: PlayerHeatState)
	player:SetAttribute("IsBusted", true)

	local unbankedCombo = math.max(0, math.floor(tonumber(player:GetAttribute("UnbankedComboCash")) or 0))
	local currentCash = math.max(0, math.floor(tonumber(player:GetAttribute("Cash")) or 0))
	local confiscated = if unbankedCombo > 0
		then math.max(10, math.floor(unbankedCombo * 0.30))
		else math.min(150, math.floor(currentCash * 0.08))

	local respawnCF, locationName = findRespawnLocation(player)

	-- Reset heat and clear all police units
	state.TotalHeat = 0
	state.HeatStars = 0
	state.HeatProgress = 0
	state.BustedTimer = 0
	state.InLineOfSight = false
	state.ReachedFiveStarBanner = false
	clearAllPursuitAssets(state)
	syncHeatAttributes(player, state)

	-- Notify ChaosAndEconomyService to confiscate unbanked combo % & reset combo
	PlayerBustedBindable:Fire(player, confiscated, respawnCF)
	FolderPlayerBustedBindable:Fire(player, confiscated, respawnCF)

	-- Repair & teleport player vehicle or character to Police Station / Garage
	local maxHealth = tonumber(player:GetAttribute("VehicleMaxHealth")) or 100
	player:SetAttribute("VehicleHealth", maxHealth)
	player:SetAttribute("TiresPopped", false)

	local rootPart, vehicleModel = getPlayerVehicleOrRoot(player)
	if vehicleModel and vehicleModel:IsA("Model") then
		vehicleModel:SetAttribute("Health", maxHealth)
		vehicleModel:SetAttribute("Damage", 0)
		vehicleModel:PivotTo(respawnCF)
		if rootPart then
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end
	elseif rootPart then
		rootPart.CFrame = respawnCF
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end

	VehicleRepairedBindable:Fire(player, locationName, 0)

	local bustPayload = {
		Banner = "BUSTED!",
		ConfiscatedCash = confiscated,
		RespawnLocation = locationName,
	}
	PlayerBustedRemote:FireClient(player, bustPayload)
	RootPlayerBustedRemote:FireClient(player, bustPayload)
	StyleCalloutRemote:FireClient(player, {
		Callout = if confiscated > 0 then string.format("BUSTED! -$%d", confiscated) else "BUSTED!",
		Multiplier = 1,
		ComboCount = 0,
		CashAwarded = 0,
	})

	task.delay(2.0, function()
		if player.Parent then
			player:SetAttribute("IsBusted", false)
		end
	end)
end

--------------------------------------------------------------------------------
-- Heat Escalation Listener
--------------------------------------------------------------------------------
local function addHeatToPlayer(player: Player, heatDelta: number, _reason: string?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	if player:GetAttribute("IsBusted") == true then
		return
	end

	local state = playerHeatStates[player.UserId]
	if not state then
		return
	end

	local delta = math.max(1, tonumber(heatDelta) or 10)
	local prevStars = state.HeatStars
	local now = os.clock()

	state.TotalHeat = math.clamp(state.TotalHeat + delta, 0, MAX_TOTAL_HEAT)
	state.LastCrimeAt = now
	state.LastSeenByPoliceAt = now
	state.InLineOfSight = true

	syncHeatAttributes(player, state)

	if state.HeatStars > prevStars then
		reconcilePoliceForceForStars(player, state)

		local starMessages = {
			[1] = "1-STAR HEAT: PATROL CRUISER DISPATCHED!",
			[2] = "2-STAR HEAT: AGGRESSIVE CRUISER SQUAD INBOUND!",
			[3] = "3-STAR HEAT: SUV INTERCEPTORS & ROADBLOCKS ACTIVE!",
			[4] = "4-STAR HEAT: HEAVY SWAT ENFORCERS & SPIKE STRIPS!",
			[5] = "5-STAR MAXIMUM WANTED: ALL UNITS + HELICOPTER SPOTLIGHT!",
		}
		local alertMsg = starMessages[state.HeatStars] or "WANTED LEVEL INCREASED!"
		PoliceAlertRemote:FireClient(player, {
			HeatStars = state.HeatStars,
			HeatProgress = state.HeatProgress,
			Headline = alertMsg,
		})
		RootPoliceAlertRemote:FireClient(player, {
			HeatStars = state.HeatStars,
			HeatProgress = state.HeatProgress,
			Headline = alertMsg,
		})
	end
end

AddHeatBindable.Event:Connect(addHeatToPlayer)
FolderAddHeatBindable.Event:Connect(addHeatToPlayer)

-- Client Remote for reporting high-speed police impacts
local function onClientReportCopImpact(player: Player, targetUnitOrId: any, impactSpeed: any)
	local state = playerHeatStates[player.UserId]
	if not state or #state.Units == 0 then
		return
	end
	local now = os.clock()
	if now - state.LastImpactReportAt < 0.15 then
		return
	end
	state.LastImpactReportAt = now

	local playerPos, _playerFwd, measuredSpeed = getPlayerMotion(player)
	local plowMult = tonumber(player:GetAttribute("RammingForceMultiplier")) or 1.0
	local effSpeed = math.max(measuredSpeed, math.min(130, tonumber(impactSpeed) or 0)) * plowMult

	for i, u in ipairs(state.Units) do
		local matches = (u.Model == targetUnitOrId) or (u.Id == targetUnitOrId)
		local dist = (u.Chassis.Position - playerPos).Magnitude
		if (matches or dist <= TAKEDOWN_CONTACT_RANGE * 1.45) and dist <= 26 then
			if effSpeed >= TAKEDOWN_INSTANT_WRECK_SPEED then
				destroyPoliceUnit(player, state, i)
			elseif effSpeed >= TAKEDOWN_MIN_SPEED * 0.75 then
				u.HP -= 55 * plowMult
				u.StunTimer = 1.8
				if u.HP <= 0 then
					destroyPoliceUnit(player, state, i)
				end
			end
			break
		end
	end
end

ReportCopImpactRemote.OnServerEvent:Connect(onClientReportCopImpact)
RootReportCopImpactRemote.OnServerEvent:Connect(onClientReportCopImpact)

--------------------------------------------------------------------------------
-- Player Lifecycle
--------------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	playerHeatStates[player.UserId] = {
		TotalHeat = 0,
		HeatStars = 0,
		HeatProgress = 0,
		LastCrimeAt = 0,
		LastSeenByPoliceAt = 0,
		InLineOfSight = false,
		BustedTimer = 0,
		ReachedFiveStarBanner = false,
		Units = {},
		Roadblocks = {},
		SpikeStrips = {},
		Helicopter = nil,
		LastRoadblockAt = 0,
		LastSpikeStripAt = 0,
		LastImpactReportAt = 0,
	}
	player:SetAttribute("HeatStars", 0)
	player:SetAttribute("HeatProgress", 0)
	player:SetAttribute("PoliceInSight", false)
	player:SetAttribute("PoliceEvading", false)
	player:SetAttribute("BustedProgress", 0)
	player:SetAttribute("IsBusted", false)
end

local function onPlayerRemoving(player: Player)
	local state = playerHeatStates[player.UserId]
	if state then
		clearAllPursuitAssets(state)
		playerHeatStates[player.UserId] = nil
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

--------------------------------------------------------------------------------
-- Autonomous AI Pursuit, Tactical Deployments, Siren Strobe & Busted Loop
--------------------------------------------------------------------------------
local sirenClock = 0
local sirenPhaseOn = true

RunService.Heartbeat:Connect(function(dt: number)
	local now = os.clock()

	-- Toggle red/blue lightbars ~6 times a second
	sirenClock += dt
	local toggledSiren = false
	if sirenClock >= 0.16 then
		sirenClock = 0
		sirenPhaseOn = not sirenPhaseOn
		toggledSiren = true
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local state = playerHeatStates[player.UserId]
		if not state or state.HeatStars <= 0 then
			continue
		end

		local stars = state.HeatStars
		local roster = STAR_ROSTER[stars]
		local playerPos, playerFwd, playerSpeed, _playerVel = getPlayerMotion(player)
		local playerRight = Vector3.new(-playerFwd.Z, 0, playerFwd.X)
		local plowMult = tonumber(player:GetAttribute("RammingForceMultiplier")) or 1.0

		-- Ensure unit count stays topped up during active chase
		if #state.Units < #roster.Units then
			reconcilePoliceForceForStars(player, state)
		end

		-- Deploy Star 3+ Roadblocks ahead of fast-moving player
		if roster.EnableRoadblocks and playerSpeed > 28 and (now - state.LastRoadblockAt >= ROADBLOCK_COOLDOWN) then
			state.LastRoadblockAt = now
			if #state.Roadblocks >= 2 then
				local oldest = table.remove(state.Roadblocks, 1)
				if oldest and oldest.Model and oldest.Model.Parent then
					oldest.Model:Destroy()
				end
			end
			table.insert(state.Roadblocks, deployRoadblockAhead(playerPos, playerFwd))
		end

		-- Deploy Star 4+ Spike Strips ahead of player
		if roster.EnableSpikeStrips and playerSpeed > 32 and (now - state.LastSpikeStripAt >= SPIKESTRIP_COOLDOWN) then
			state.LastSpikeStripAt = now
			if #state.SpikeStrips >= 2 then
				local oldest = table.remove(state.SpikeStrips, 1)
				if oldest and oldest.Model and oldest.Model.Parent then
					oldest.Model:Destroy()
				end
			end
			table.insert(state.SpikeStrips, deploySpikeStripAhead(player, playerPos, playerFwd))
		end

		-- Update Star 5 Police Helicopter + Spotlight from above
		local heliInSight = false
		if state.Helicopter and state.Helicopter.Model.Parent then
			local heli = state.Helicopter
			heli.OrbitAngle += dt * 0.65
			local targetHeliPos = Vector3.new(
				playerPos.X + math.cos(heli.OrbitAngle) * 26,
				playerPos.Y + 78,
				playerPos.Z + math.sin(heli.OrbitAngle) * 26
			)
			local nextHeliPos = heli.Hull.Position:Lerp(targetHeliPos, math.clamp(dt * 4.5, 0, 1))
			local lookAtTarget = Vector3.new(playerPos.X, nextHeliPos.Y - 12, playerPos.Z)
			heli.Hull.CFrame = CFrame.lookAt(nextHeliPos, lookAtTarget)
			heli.Rotor.CFrame = CFrame.new(nextHeliPos + Vector3.new(0, 3.1, 0))
				* CFrame.Angles(0, now * 18.0, 0)
			heli.GroundSpot.CFrame = CFrame.new(playerPos.X, 0.3, playerPos.Z)
				* CFrame.Angles(0, 0, math.rad(90))
			heliInSight = true
		end

		-- Update Autonomous Ground Police Units
		local anyCopInLineOfSight = heliInSight
		local anyCopBoxingInPlayer = false
		local unitsToDestroy: { number } = {}

		for i, unit in ipairs(state.Units) do
			if not (unit.Model and unit.Model.Parent) then
				table.insert(unitsToDestroy, i)
				continue
			end

			if toggledSiren then
				unit.RedLight.Brightness = if sirenPhaseOn then 3.8 else 0.4
				unit.BlueLight.Brightness = if sirenPhaseOn then 0.4 else 3.8
				unit.RedSiren.Transparency = if sirenPhaseOn then 0.0 else 0.45
				unit.BlueSiren.Transparency = if sirenPhaseOn then 0.45 else 0.0
			end

			local unitPos = unit.Chassis.Position
			local toPlayer = Vector3.new(playerPos.X - unitPos.X, 0, playerPos.Z - unitPos.Z)
			local dist = toPlayer.Magnitude

			-- Teleport far-behind police closer along pursuit perimeter so chase stays intense
			if dist > 260 then
				local respawnAngle = math.random() * math.pi * 2
				local respawnDist = math.random(95, 130)
				unitPos = Vector3.new(
					playerPos.X + math.cos(respawnAngle) * respawnDist,
					unit.Archetype.BodySize.Y * 0.5 + 0.5,
					playerPos.Z + math.sin(respawnAngle) * respawnDist
				)
				toPlayer = Vector3.new(playerPos.X - unitPos.X, 0, playerPos.Z - unitPos.Z)
				dist = toPlayer.Magnitude
			end

			if dist <= LINE_OF_SIGHT_RANGE then
				anyCopInLineOfSight = true
			end

			-- Stunned spin-out state after glancing hit
			if unit.StunTimer > 0 then
				unit.StunTimer = math.max(0, unit.StunTimer - dt)
				unit.Heading += dt * 4.5
				local coastFwd = Vector3.new(-math.sin(unit.Heading), 0, -math.cos(unit.Heading))
				local nextPos = unitPos + coastFwd * (unit.Archetype.Speed * 0.25 * dt)
				updateCopModelTransform(unit, nextPos, unit.Heading)
				continue
			end

			-- Check High-Speed Player Ram -> COP TAKEDOWN!
			local effRamSpeed = playerSpeed * plowMult
			if dist <= TAKEDOWN_CONTACT_RANGE and effRamSpeed >= TAKEDOWN_MIN_SPEED then
				if effRamSpeed >= TAKEDOWN_INSTANT_WRECK_SPEED then
					table.insert(unitsToDestroy, i)
					continue
				else
					unit.HP -= 55 * plowMult
					unit.Model:SetAttribute("HP", math.max(0, unit.HP))
					if unit.HP <= 0 then
						table.insert(unitsToDestroy, i)
						continue
					end
					unit.StunTimer = 2.0
					continue
				end
			end

			-- Check close-range boxing in / immobilization for BUSTED timer
			if dist <= BUSTED_RANGE and playerSpeed <= BUSTED_MAX_PLAYER_SPEED then
				anyCopBoxingInPlayer = true
			end

			-- Tactical Steering Target:
			-- Star 1: Direct pursuit
			-- Star 2+: Aggressive ramming weave + flanking / PIT intercept ahead of player
			local seekTarget = Vector3.new(playerPos.X, unitPos.Y, playerPos.Z)
			if stars >= 2 and i > 1 then
				local flankSide = if i % 2 == 0 then 1 else -1
				local leadDistance = if unit.Kind == "InterceptorSUV" then 26 elseif unit.Kind == "SWATEnforcer" then 34 else 14
				local weaveOffset = math.sin(now * 2.6 + unit.RamPhase) * 6 * unit.Archetype.RamAggression
				seekTarget = seekTarget
					+ playerFwd * leadDistance
					+ playerRight * (flankSide * 11 + weaveOffset)
			end

			local toSeek = Vector3.new(seekTarget.X - unitPos.X, 0, seekTarget.Z - unitPos.Z)
			if toSeek.Magnitude > 0.1 then
				local desiredDir = toSeek.Unit
				local desiredHeading = math.atan2(-desiredDir.X, -desiredDir.Z)
				local deltaAngle = math.atan2(math.sin(desiredHeading - unit.Heading), math.cos(desiredHeading - unit.Heading))
				local maxStep = unit.Archetype.TurnRate * (1 + (stars - 1) * 0.05) * dt
				unit.Heading += math.clamp(deltaAngle, -maxStep, maxStep)
			end

			local moveFwd = Vector3.new(-math.sin(unit.Heading), 0, -math.cos(unit.Heading))
			local speedBoost = 1.0 + (stars - 1) * 0.04
			-- Slight ram burst when closing in at Star 2+
			if stars >= 2 and dist < 38 and dist > 9 then
				speedBoost *= (1.0 + 0.12 * unit.Archetype.RamAggression)
			end

			local nextPos = unitPos + moveFwd * (unit.Archetype.Speed * speedBoost * dt)
			nextPos = Vector3.new(nextPos.X, unit.Archetype.BodySize.Y * 0.5 + 0.5, nextPos.Z)

			-- Prevent clipping straight inside the player's chassis
			local dxP = nextPos.X - playerPos.X
			local dzP = nextPos.Z - playerPos.Z
			local dP = math.sqrt(dxP * dxP + dzP * dzP)
			local minPlayerSep = 8.2
			if dP < minPlayerSep and dP > 0.01 then
				nextPos = Vector3.new(
					playerPos.X + (dxP / dP) * minPlayerSep,
					nextPos.Y,
					playerPos.Z + (dzP / dP) * minPlayerSep
				)
			end

			-- Separation between fellow police units so they form a surrounding box
			for j = 1, i - 1 do
				local other = state.Units[j]
				if other and other.Chassis and other.Chassis.Parent then
					local oPos = other.Chassis.Position
					local dxC = nextPos.X - oPos.X
					local dzC = nextPos.Z - oPos.Z
					local dC = math.sqrt(dxC * dxC + dzC * dzC)
					if dC < 10.5 and dC > 0.01 then
						nextPos = Vector3.new(
							oPos.X + (dxC / dC) * 10.5,
							nextPos.Y,
							oPos.Z + (dzC / dC) * 10.5
						)
					end
				end
			end

			updateCopModelTransform(unit, nextPos, unit.Heading)
		end

		-- Process wrecked police units in reverse index order
		for idx = #unitsToDestroy, 1, -1 do
			destroyPoliceUnit(player, state, unitsToDestroy[idx])
		end

		-- Update Line-of-Sight & Cooldown / Evade Heat Decay
		state.InLineOfSight = anyCopInLineOfSight
		if anyCopInLineOfSight then
			state.LastSeenByPoliceAt = now
		elseif now - state.LastSeenByPoliceAt >= EVADE_COOLDOWN_DELAY and now - state.LastCrimeAt >= EVADE_COOLDOWN_DELAY then
			local prevStars = state.HeatStars
			state.TotalHeat = math.max(0, state.TotalHeat - HEAT_DECAY_PER_SECOND * dt)
			syncHeatAttributes(player, state)

			if state.TotalHeat <= 0 then
				-- Player successfully evaded the pursuit! Award Escape Bounty!
				local escapeBounty = math.max(150, prevStars * 175)
				clearAllPursuitAssets(state)
				AddCashBindable:Fire(player, escapeBounty, "PoliceEscapeBounty")
				StyleCalloutRemote:FireClient(player, {
					Callout = string.format("ESCAPED POLICE! +$%d BOUNTY!", escapeBounty),
					Multiplier = tonumber(player:GetAttribute("ComboMultiplier")) or 1,
					ComboCount = tonumber(player:GetAttribute("ComboCount")) or 0,
					CashAwarded = escapeBounty,
				})
				HeatUpdateRemote:FireClient(player, 0, 0, "ESCAPED", 0)
				continue
			end
		end

		-- Update 4-Second "BUSTED!" Immobilized / Boxed-In Timer
		if anyCopBoxingInPlayer then
			state.BustedTimer = math.min(BUSTED_HOLD_DURATION, state.BustedTimer + dt)
			if state.BustedTimer >= BUSTED_HOLD_DURATION then
				triggerPlayerBusted(player, state)
				continue
			end
		else
			state.BustedTimer = math.max(0, state.BustedTimer - dt * BUSTED_DECAY_RATE)
		end

		syncHeatAttributes(player, state)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000012">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">ProgressionAndLevelsService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProgressionAndLevelsService.script.luau
	World of Destruction (Roblox) — Version 1.0
	
	Full 50-Level Player Progression System:
	- Configures `Level` on `leaderstats` and Player Attributes (`Level`, `XP`,
	  `XPRequired`, `TotalXP`, `RankTitle`, `NextRankTitle`, `XPProgressRatio`).
	- Rank Titles from Lv.1 Street Rookie, Lv.5 Curb Crusher, Lv.10 Asphalt Outlaw,
	  Lv.20 Demolition Expert, Lv.35 Apex Wrecker, up to Lv.50 Lord of Destruction.
	- Awards XP for every prop destroyed, combo banked, stunt landed, mission
	  completed, and police cruiser wrecked.
	- Grants scaling Cash bonuses + unlocks milestone rewards on every Level Up,
	  firing celebratory client notifications, HUD callouts, and 3D golden level-up VFX.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

--------------------------------------------------------------------------------
-- Constants & 50-Level Configuration
--------------------------------------------------------------------------------
local MAX_LEVEL = 50

export type RankTier = {
	MinLevel: number,
	Title: string,
	BadgeColor: Color3,
	MilestoneRewardNote: string?,
}

-- Ordered highest to lowest for fast lookup, containing all canonical v1.0 ranks
local RANK_TIERS: { RankTier } = {
	{
		MinLevel = 50,
		Title = "Lord of Destruction",
		BadgeColor = Color3.fromRGB(255, 215, 0),
		MilestoneRewardNote = "MAX LEVEL 50! +$50,000 Apex Sovereign Bonus & Golden Aura!",
	},
	{
		MinLevel = 45,
		Title = "Cataclysm King",
		BadgeColor = Color3.fromRGB(255, 95, 45),
		MilestoneRewardNote = "Unlocked Cataclysm King Title & +$20,000 Bonus!",
	},
	{
		MinLevel = 40,
		Title = "Titan of Chaos",
		BadgeColor = Color3.fromRGB(255, 65, 110),
		MilestoneRewardNote = "Unlocked Titan of Chaos Title & +$15,000 Bonus!",
	},
	{
		MinLevel = 35,
		Title = "Apex Wrecker",
		BadgeColor = Color3.fromRGB(215, 70, 255),
		MilestoneRewardNote = "Unlocked Apex Wrecker Rank & +$12,000 Bonus!",
	},
	{
		MinLevel = 30,
		Title = "Heat Bringer",
		BadgeColor = Color3.fromRGB(165, 90, 255),
		MilestoneRewardNote = "Unlocked Heat Bringer Rank & +$9,000 Bonus!",
	},
	{
		MinLevel = 25,
		Title = "City Flattener",
		BadgeColor = Color3.fromRGB(80, 175, 255),
		MilestoneRewardNote = "Unlocked City Flattener Rank & +$7,500 Bonus!",
	},
	{
		MinLevel = 20,
		Title = "Demolition Expert",
		BadgeColor = Color3.fromRGB(0, 225, 255),
		MilestoneRewardNote = "Unlocked Demolition Expert Rank & +$5,000 Bonus!",
	},
	{
		MinLevel = 15,
		Title = "Neon Menace",
		BadgeColor = Color3.fromRGB(50, 240, 150),
		MilestoneRewardNote = "Unlocked Neon Menace Rank & +$3,500 Bonus!",
	},
	{
		MinLevel = 10,
		Title = "Asphalt Outlaw",
		BadgeColor = Color3.fromRGB(120, 255, 90),
		MilestoneRewardNote = "Unlocked Asphalt Outlaw Rank & +$2,500 Bonus!",
	},
	{
		MinLevel = 5,
		Title = "Curb Crusher",
		BadgeColor = Color3.fromRGB(255, 200, 65),
		MilestoneRewardNote = "Unlocked Curb Crusher Rank & +$1,250 Bonus!",
	},
	{
		MinLevel = 1,
		Title = "Street Rookie",
		BadgeColor = Color3.fromRGB(210, 220, 235),
		MilestoneRewardNote = "Welcome to Leo City!",
	},
}

-- Smooth polynomial XP curve from Lv.1 -> Lv.50
-- Lv.1 requires 250 XP, Lv.5 requires 650 XP, Lv.10 requires 1,350 XP,
-- Lv.20 requires 3,200 XP, Lv.35 requires 7,100 XP, Lv.49->50 requires 12,000 XP.
local function getXPRequiredForLevel(level: number): number
	local clamped = math.clamp(math.floor(level), 1, MAX_LEVEL)
	if clamped >= MAX_LEVEL then
		return 0
	end
	return math.floor(180 + (clamped * 65) + math.pow(clamped, 1.75) * 10)
end

local function getRankInfoForLevel(level: number): (RankTier, RankTier?)
	local clamped = math.clamp(math.floor(level), 1, MAX_LEVEL)
	local currentTier = RANK_TIERS[#RANK_TIERS]
	local nextTier: RankTier? = nil

	for i, tier in ipairs(RANK_TIERS) do
		if clamped >= tier.MinLevel then
			currentTier = tier
			if i > 1 then
				nextTier = RANK_TIERS[i - 1]
			end
			break
		end
	end
	return currentTier, nextTier
end

local function getLevelUpCashReward(newLevel: number): number
	-- Base cash reward scales with level, plus extra milestone jackpots
	local base = newLevel * 250
	if newLevel == 50 then
		return 50000
	elseif newLevel == 45 then
		return 20000
	elseif newLevel == 40 then
		return 15000
	elseif newLevel == 35 then
		return 12000
	elseif newLevel == 30 then
		return 9000
	elseif newLevel == 25 then
		return 7500
	elseif newLevel == 20 then
		return 5000
	elseif newLevel == 15 then
		return 3500
	elseif newLevel == 10 then
		return 2500
	elseif newLevel == 5 then
		return 1250
	end
	return base
end

--------------------------------------------------------------------------------
-- Shared Infrastructure Helpers (Bindables & Remotes)
--------------------------------------------------------------------------------
local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function ensureBindableEvent(parent: Instance, name: string): BindableEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BindableEvent") then
		return existing
	end
	local ev = Instance.new("BindableEvent")
	ev.Name = name
	ev.Parent = parent
	return ev
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = parent
	return re
end

local function ensureRemoteFunction(parent: Instance, name: string): RemoteFunction
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local rf = Instance.new("RemoteFunction")
	rf.Name = name
	rf.Parent = parent
	return rf
end

local serverEventsFolder = ensureFolder(ServerStorage, "Events")
local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")

-- Server Bindables
local DestructionBindable = ensureBindableEvent(ServerStorage, "DestructionEvent")
local OnObjectDestroyedBindable = ensureBindableEvent(ServerStorage, "OnObjectDestroyed")
local StuntBindable = ensureBindableEvent(ServerStorage, "StuntEvent")
local PoliceTakedownBindable = ensureBindableEvent(ServerStorage, "PoliceTakedownEvent")
local AddCashBindable = ensureBindableEvent(ServerStorage, "AddCashEvent")
local AwardXPBindable = ensureBindableEvent(ServerStorage, "AwardXPEvent")
local LevelUpBindable = ensureBindableEvent(ServerStorage, "PlayerLevelUpEvent")

local FolderDestructionBindable = ensureBindableEvent(serverEventsFolder, "DestructionEvent")
local FolderStuntBindable = ensureBindableEvent(serverEventsFolder, "StuntEvent")
local FolderPoliceTakedownBindable = ensureBindableEvent(serverEventsFolder, "PoliceTakedownEvent")
local FolderAwardXPBindable = ensureBindableEvent(serverEventsFolder, "AwardXPEvent")
local FolderLevelUpBindable = ensureBindableEvent(serverEventsFolder, "PlayerLevelUpEvent")

-- Client Remotes
local LevelUpRemote = ensureRemoteEvent(remotesFolder, "LevelUp")
local XPGainedRemote = ensureRemoteEvent(remotesFolder, "XPGained")
local StyleCalloutRemote = ensureRemoteEvent(remotesFolder, "StyleCallout")
local GetProgressionTableRemote = ensureRemoteFunction(remotesFolder, "GetProgressionTable")

-- Root Remote Aliases
local RootLevelUpRemote = ensureRemoteEvent(ReplicatedStorage, "LevelUpEvent")
local RootStyleCalloutRemote = ensureRemoteEvent(ReplicatedStorage, "StyleCalloutEvent")

--------------------------------------------------------------------------------
-- Per-Player Progression State
--------------------------------------------------------------------------------
type PlayerProgressionState = {
	Level: number,
	XP: number,
	TotalXP: number,
	XPRequired: number,
	RankTitle: string,
	LastDestructionXPAt: number,
	LastTakedownXPAt: number,
	TrackedDestructions: number,
	TrackedTakedowns: number,
	TrackedMissions: number,
	PeakUnbankedComboCash: number,
	PeakComboChain: number,
}

local playerProgression: { [number]: PlayerProgressionState } = {}
local playerConnections: { [number]: { RBXScriptConnection } } = {}

local function getXPMultiplier(player: Player): number
	local mult = tonumber(player:GetAttribute("XPMultiplier")) or 1.0
	if player:GetAttribute("Pass_VIP2xCash") == true or player:GetAttribute("VIP2xCash") == true then
		mult = math.max(mult, 2.0)
	end
	if player:GetAttribute("OverdriveBoostActive") == true then
		mult = mult * 1.5
	end
	return math.clamp(mult, 1.0, 10.0)
end

local function ensureLevelLeaderstat(player: Player, initialLevel: number): IntValue
	local ls = player:FindFirstChild("leaderstats")
	if not (ls and ls:IsA("Folder")) then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local lvlValue = ls:FindFirstChild("Level")
	if lvlValue and lvlValue:IsA("IntValue") then
		lvlValue.Value = initialLevel
		return lvlValue
	end
	local iv = Instance.new("IntValue")
	iv.Name = "Level"
	iv.Value = initialLevel
	iv.Parent = ls
	return iv
end

local function syncProgressionAttributes(player: Player, state: PlayerProgressionState)
	local currentTier, nextTier = getRankInfoForLevel(state.Level)
	state.RankTitle = currentTier.Title
	state.XPRequired = getXPRequiredForLevel(state.Level)

	local ratio = 1.0
	if state.Level < MAX_LEVEL and state.XPRequired > 0 then
		ratio = math.clamp(state.XP / state.XPRequired, 0, 1)
	end

	player:SetAttribute("Level", state.Level)
	player:SetAttribute("XP", state.XP)
	player:SetAttribute("TotalXP", state.TotalXP)
	player:SetAttribute("XPRequired", state.XPRequired)
	player:SetAttribute("XPProgressRatio", tonumber(string.format("%.3f", ratio)))
	player:SetAttribute("RankTitle", state.RankTitle)
	player:SetAttribute("NextRankTitle", if nextTier then nextTier.Title else "MAX RANK")
	player:SetAttribute("NextRankLevel", if nextTier then nextTier.MinLevel else MAX_LEVEL)

	local lvlStat = ensureLevelLeaderstat(player, state.Level)
	lvlStat.Value = state.Level
end

local function spawnCelebratoryLevelUpVFX(player: Player, newLevel: number, tier: RankTier)
	local character = player.Character
	if not character then
		return
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not rootPart then
		return
	end

	-- Create expanding golden shockwave ring around player/vehicle
	local ring = Instance.new("Part")
	ring.Name = "LevelUpShockwave_" .. tostring(newLevel)
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = tier.BadgeColor
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Transparency = 0.15
	ring.Size = Vector3.new(0.6, 6, 6)
	ring.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace

	task.spawn(function()
		local steps = 20
		for i = 1, steps do
			local alpha = i / steps
			local radius = 6 + alpha * 38
			ring.Size = Vector3.new(math.max(0.15, 0.6 * (1 - alpha)), radius, radius)
			ring.Transparency = 0.15 + (0.85 * alpha)
			ring.CFrame = CFrame.new(rootPart.Position) * CFrame.Angles(0, 0, math.rad(90))
			task.wait(0.025)
		end
		ring:Destroy()
	end)
end

local function grantCashBonus(player: Player, cashBonus: number, reason: string)
	if cashBonus <= 0 then
		return
	end
	-- Fire AddCashEvent so ChaosAndEconomyService and PlayerDataService stay in sync
	AddCashBindable:Fire(player, cashBonus, reason)
end

local function awardXP(player: Player, baseXP: number, sourceReason: string?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local state = playerProgression[player.UserId]
	if not state then
		return
	end

	local rawXP = math.max(1, math.floor(tonumber(baseXP) or 0))
	if rawXP <= 0 then
		return
	end

	local mult = getXPMultiplier(player)
	local finalXP = math.max(1, math.floor(rawXP * mult))

	state.TotalXP += finalXP

	if state.Level >= MAX_LEVEL then
		state.XP = 0
		syncProgressionAttributes(player, state)
		return
	end

	state.XP += finalXP
	local leveledUpCount = 0
	local totalCashAwarded = 0
	local latestMilestoneNote: string? = nil

	while state.Level < MAX_LEVEL do
		local req = getXPRequiredForLevel(state.Level)
		if state.XP >= req then
			state.XP -= req
			state.Level += 1
			leveledUpCount += 1

			local cashBonus = getLevelUpCashReward(state.Level)
			totalCashAwarded += cashBonus

			local newTier = getRankInfoForLevel(state.Level)
			if newTier.MinLevel == state.Level and newTier.MilestoneRewardNote then
				latestMilestoneNote = newTier.MilestoneRewardNote
			end
		else
			break
		end
	end

	if state.Level >= MAX_LEVEL then
		state.XP = 0
	end

	syncProgressionAttributes(player, state)

	-- Notify client of XP gain
	XPGainedRemote:FireClient(player, {
		Amount = finalXP,
		Reason = sourceReason or "ChaosAction",
		Level = state.Level,
		XP = state.XP,
		XPRequired = state.XPRequired,
		RankTitle = state.RankTitle,
	})

	-- Handle Level Up celebrations & rewards
	if leveledUpCount > 0 then
		grantCashBonus(player, totalCashAwarded, "LevelUp_" .. tostring(state.Level))
		local tier, nextTier = getRankInfoForLevel(state.Level)
		spawnCelebratoryLevelUpVFX(player, state.Level, tier)

		local levelUpPayload = {
			NewLevel = state.Level,
			LevelsGained = leveledUpCount,
			RankTitle = tier.Title,
			RankColor = {
				R = math.floor(tier.BadgeColor.R * 255),
				G = math.floor(tier.BadgeColor.G * 255),
				B = math.floor(tier.BadgeColor.B * 255),
			},
			CashReward = totalCashAwarded,
			MilestoneNote = latestMilestoneNote or string.format("Reached Level %d — %s!", state.Level, tier.Title),
			NextRankTitle = if nextTier then nextTier.Title else "MAX RANK",
			NextRankLevel = if nextTier then nextTier.MinLevel else MAX_LEVEL,
			XP = state.XP,
			XPRequired = state.XPRequired,
		}

		LevelUpRemote:FireClient(player, levelUpPayload)
		RootLevelUpRemote:FireClient(player, levelUpPayload)

		-- Also broadcast celebratory banner via StyleCalloutRemote so GameHUD displays it prominently
		local calloutBanner = {
			Callout = string.format("LEVEL UP! LV.%d %s (+$%d)", state.Level, string.upper(tier.Title), totalCashAwarded),
			Multiplier = tonumber(player:GetAttribute("ComboMultiplier")) or 1,
			ComboCount = tonumber(player:GetAttribute("ComboCount")) or 1,
			CashAwarded = totalCashAwarded,
			ChaosAwarded = leveledUpCount * 500,
			IsLevelUpBanner = true,
			NewLevel = state.Level,
			RankTitle = tier.Title,
		}
		StyleCalloutRemote:FireClient(player, calloutBanner)
		RootStyleCalloutRemote:FireClient(player, calloutBanner)

		LevelUpBindable:Fire(player, state.Level, tier.Title, totalCashAwarded)
		FolderLevelUpBindable:Fire(player, state.Level, tier.Title, totalCashAwarded)
	end
end

--------------------------------------------------------------------------------
-- Event Listeners for Prop Destructions, Stunts, Combos, Missions & Cop Takedowns
--------------------------------------------------------------------------------
local function onPropDestroyed(playerOrPayload: any, objectTypeOrInfo: any, baseCashReward: number?)
	local player: Player = playerOrPayload
	if type(playerOrPayload) == "table" and objectTypeOrInfo == nil then
		player = playerOrPayload.player or playerOrPayload.Player
		objectTypeOrInfo = playerOrPayload
		baseCashReward = tonumber(playerOrPayload.cashEarned or playerOrPayload.CashReward)
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local state = playerProgression[player.UserId]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.LastDestructionXPAt < 0.02 then
		return
	end
	state.LastDestructionXPAt = now

	local cashVal = tonumber(baseCashReward) or 25
	if type(objectTypeOrInfo) == "table" then
		cashVal = tonumber(objectTypeOrInfo.CashReward or objectTypeOrInfo.cashEarned or objectTypeOrInfo.CoinReward or objectTypeOrInfo.Value) or cashVal
	elseif typeof(objectTypeOrInfo) == "Instance" then
		cashVal = tonumber(objectTypeOrInfo:GetAttribute("CashReward") or objectTypeOrInfo:GetAttribute("CoinReward")) or cashVal
	end

	-- Prop destruction awards between 15 and 220 XP depending on target size
	local xpReward = math.clamp(math.floor(12 + cashVal * 0.45), 15, 220)
	awardXP(player, xpReward, "PropDestroyed")
end

local function onStuntLanded(player: Player, stuntType: string?, rawValue: number?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local val = math.clamp(tonumber(rawValue) or 1, 0.5, 12)
	local xpReward = math.clamp(math.floor(25 + val * 15), 30, 180)
	awardXP(player, xpReward, "Stunt:" .. tostring(stuntType or "Jump"))
end

local function onPoliceTakedown(player: Player, _unitType: string?, _worldPos: Vector3?, customBonusCash: number?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local state = playerProgression[player.UserId]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.LastTakedownXPAt < 0.05 then
		return
	end
	state.LastTakedownXPAt = now

	local bonus = tonumber(customBonusCash) or 175
	local xpReward = math.clamp(math.floor(110 + bonus * 0.35), 120, 350)
	awardXP(player, xpReward, "CopTakedown")
end

DestructionBindable.Event:Connect(onPropDestroyed)
OnObjectDestroyedBindable.Event:Connect(onPropDestroyed)
FolderDestructionBindable.Event:Connect(onPropDestroyed)

local serverEventsAlt = ensureFolder(ServerStorage, "ServerEvents")
local altDestructionBindable = ensureBindableEvent(serverEventsAlt, "DestructionOccurred")
altDestructionBindable.Event:Connect(onPropDestroyed)

StuntBindable.Event:Connect(onStuntLanded)
FolderStuntBindable.Event:Connect(onStuntLanded)

PoliceTakedownBindable.Event:Connect(onPoliceTakedown)
FolderPoliceTakedownBindable.Event:Connect(onPoliceTakedown)

AwardXPBindable.Event:Connect(function(player: Player, amount: number, reason: string?)
	awardXP(player, amount, reason)
end)
FolderAwardXPBindable.Event:Connect(function(player: Player, amount: number, reason: string?)
	awardXP(player, amount, reason)
end)

-- RemoteFunction so TutorialAndGuideUI can display the full 50-Level Rank Table
GetProgressionTableRemote.OnServerInvoke = function(player: Player)
	local state = playerProgression[player.UserId]
	local ranksOut = {}
	for i = #RANK_TIERS, 1, -1 do
		local tier = RANK_TIERS[i]
		table.insert(ranksOut, {
			MinLevel = tier.MinLevel,
			Title = tier.Title,
			CashBonus = getLevelUpCashReward(tier.MinLevel),
			Note = tier.MilestoneRewardNote or "",
		})
	end
	return {
		MaxLevel = MAX_LEVEL,
		CurrentLevel = if state then state.Level else (tonumber(player:GetAttribute("Level")) or 1),
		CurrentXP = if state then state.XP else (tonumber(player:GetAttribute("XP")) or 0),
		XPRequired = if state then state.XPRequired else getXPRequiredForLevel(1),
		RankTitle = if state then state.RankTitle else "Street Rookie",
		Ranks = ranksOut,
	}
end

--------------------------------------------------------------------------------
-- Player Setup & Attribute Watchers (Combos Banked & Missions Completed)
--------------------------------------------------------------------------------
local function setupPlayerProgression(player: Player)
	local savedLevel = math.clamp(math.floor(tonumber(player:GetAttribute("Level")) or 1), 1, MAX_LEVEL)
	local savedXP = math.max(0, math.floor(tonumber(player:GetAttribute("XP")) or 0))
	local savedTotalXP = math.max(savedXP, math.floor(tonumber(player:GetAttribute("TotalXP")) or 0))
	local initialTier = getRankInfoForLevel(savedLevel)

	local state: PlayerProgressionState = {
		Level = savedLevel,
		XP = savedXP,
		TotalXP = savedTotalXP,
		XPRequired = getXPRequiredForLevel(savedLevel),
		RankTitle = initialTier.Title,
		LastDestructionXPAt = 0,
		LastTakedownXPAt = 0,
		TrackedDestructions = tonumber(player:GetAttribute("TotalDestructions")) or 0,
		TrackedTakedowns = tonumber(player:GetAttribute("CopTakedowns")) or 0,
		TrackedMissions = tonumber(player:GetAttribute("MissionsCompleted")) or 0,
		PeakUnbankedComboCash = 0,
		PeakComboChain = 0,
	}
	playerProgression[player.UserId] = state
	syncProgressionAttributes(player, state)

	local conns: { RBXScriptConnection } = {}

	-- 1. Watch MissionsCompleted attribute for Mission Complete XP rewards (+250 XP)
	table.insert(conns, player:GetAttributeChangedSignal("MissionsCompleted"):Connect(function()
		local currentMissions = tonumber(player:GetAttribute("MissionsCompleted")) or 0
		if currentMissions > state.TrackedMissions then
			local delta = currentMissions - state.TrackedMissions
			state.TrackedMissions = currentMissions
			awardXP(player, delta * 250, "MissionCompleted")
		end
	end))

	-- 2. Watch ComboCount & UnbankedComboCash to award Combo Banked XP when a combo finishes
	table.insert(conns, player:GetAttributeChangedSignal("ComboCount"):Connect(function()
		local chain = tonumber(player:GetAttribute("ComboCount")) or 0
		if chain > state.PeakComboChain then
			state.PeakComboChain = chain
		elseif chain == 0 and state.PeakComboChain >= 3 then
			local completedChain = state.PeakComboChain
			local bankedCash = state.PeakUnbankedComboCash
			state.PeakComboChain = 0
			state.PeakUnbankedComboCash = 0

			-- Only award Combo Banked XP if not busted
			if player:GetAttribute("CurrentStreakName") ~= "BUSTED!" then
				local comboXP = math.clamp(math.floor(completedChain * 12 + bankedCash * 0.08), 25, 600)
				awardXP(player, comboXP, "ComboBanked_x" .. tostring(completedChain))
			end
		end
	end))

	table.insert(conns, player:GetAttributeChangedSignal("UnbankedComboCash"):Connect(function()
		local unbanked = tonumber(player:GetAttribute("UnbankedComboCash")) or 0
		if unbanked > state.PeakUnbankedComboCash then
			state.PeakUnbankedComboCash = unbanked
		end
	end))

	-- 3. Backup watcher on TotalDestructions in case another service increments it without firing Bindable
	table.insert(conns, player:GetAttributeChangedSignal("TotalDestructions"):Connect(function()
		local total = tonumber(player:GetAttribute("TotalDestructions")) or 0
		if total > state.TrackedDestructions then
			state.TrackedDestructions = total
			if os.clock() - state.LastDestructionXPAt > 0.15 then
				state.LastDestructionXPAt = os.clock()
				awardXP(player, 25, "PropDestroyed")
			end
		end
	end))

	-- 4. Backup watcher on CopTakedowns
	table.insert(conns, player:GetAttributeChangedSignal("CopTakedowns"):Connect(function()
		local takedowns = tonumber(player:GetAttribute("CopTakedowns")) or 0
		if takedowns > state.TrackedTakedowns then
			state.TrackedTakedowns = takedowns
			if os.clock() - state.LastTakedownXPAt > 0.15 then
				state.LastTakedownXPAt = os.clock()
				awardXP(player, 150, "CopTakedown")
			end
		end
	end))

	playerConnections[player.UserId] = conns
end

local function cleanupPlayerProgression(player: Player)
	local conns = playerConnections[player.UserId]
	if conns then
		for _, conn in ipairs(conns) do
			conn:Disconnect()
		end
		playerConnections[player.UserId] = nil
	end
	playerProgression[player.UserId] = nil
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(setupPlayerProgression, player)
end
Players.PlayerAdded:Connect(setupPlayerProgression)
Players.PlayerRemoving:Connect(cleanupPlayerProgression)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000013">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">TrafficAndNPCAIService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- TrafficAndNPCAIService.script.luau
-- Manages Leo City's living ambient world:
-- 1. Synchronized intersection traffic light cycling (Green -> Yellow -> Red) with orthogonal NS/EW phases.
-- 2. Autonomous AI traffic vehicles driving along road lanes, obeying traffic lights until hit or panicked
--    by nearby chaos/explosions, then swerving and fleeing at high speed!
-- 3. Animated NPC pedestrians walking along sidewalks who perform a compliance-friendly comical dodge leap
--    with a "!" exclamation bubble when a vehicle approaches rapidly or chaos erupts nearby.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- WAIT FOR CITY & CONFIG
--------------------------------------------------------------------------------
local BLOCK_SIZE = (Workspace:GetAttribute("LeoCityBlockSize") :: number?) or 180
local ROAD_WIDTH = (Workspace:GetAttribute("LeoCityRoadWidth") :: number?) or 36
local GRID_RADIUS = (Workspace:GetAttribute("LeoCityGridRadius") :: number?) or 3
local LANE_OFFSET = 8.5
local SIDEWALK_OFFSET = ROAD_WIDTH * 0.5 + 6.5

local AIFolder = Instance.new("Folder")
AIFolder.Name = "LeoCityAI"
AIFolder.Parent = Workspace

local TrafficFolder = Instance.new("Folder")
TrafficFolder.Name = "AITraffic"
TrafficFolder.Parent = AIFolder

local PedestriansFolder = Instance.new("Folder")
PedestriansFolder.Name = "AIPedestrians"
PedestriansFolder.Parent = AIFolder

local roadCoords: { number } = {}
for i = -GRID_RADIUS - 1, GRID_RADIUS do
	table.insert(roadCoords, (i + 0.5) * BLOCK_SIZE)
end
local CITY_LIMIT = (GRID_RADIUS + 1) * BLOCK_SIZE - 15

--------------------------------------------------------------------------------
-- 1. SYNCHRONIZED TRAFFIC LIGHT CYCLING (GREEN -> YELLOW -> RED)
--------------------------------------------------------------------------------
local nsPhase = "Green"
local ewPhase = "Red"

local function applyTrafficLightVisuals(model: Instance, state: string)
	if model:GetAttribute("Destroyed") == true then
		return
	end
	model:SetAttribute("LightState", state)
	local red = model:FindFirstChild("RedLens") :: BasePart?
	local yellow = model:FindFirstChild("YellowLens") :: BasePart?
	local green = model:FindFirstChild("GreenLens") :: BasePart?

	if red then
		red.Material = if state == "Red" then Enum.Material.Neon else Enum.Material.SmoothPlastic
		red.Color = if state == "Red" then Color3.fromRGB(255, 50, 50) else Color3.fromRGB(95, 25, 25)
	end
	if yellow then
		yellow.Material = if state == "Yellow" then Enum.Material.Neon else Enum.Material.SmoothPlastic
		yellow.Color = if state == "Yellow" then Color3.fromRGB(255, 210, 40) else Color3.fromRGB(95, 80, 20)
	end
	if green then
		green.Material = if state == "Green" then Enum.Material.Neon else Enum.Material.SmoothPlastic
		green.Color = if state == "Green" then Color3.fromRGB(45, 255, 95) else Color3.fromRGB(20, 85, 35)
	end
end

local function updateAllTrafficLights()
	Workspace:SetAttribute("TrafficPhaseNS", nsPhase)
	Workspace:SetAttribute("TrafficPhaseEW", ewPhase)
	for _, light in ipairs(CollectionService:GetTagged("TrafficLight")) do
		local axis = (light:GetAttribute("TrafficAxis") :: string?) or "NS"
		applyTrafficLightVisuals(light, if axis == "NS" then nsPhase else ewPhase)
	end
end

task.spawn(function()
	while true do
		nsPhase, ewPhase = "Green", "Red"
		updateAllTrafficLights()
		task.wait(7.0)

		nsPhase, ewPhase = "Yellow", "Red"
		updateAllTrafficLights()
		task.wait(2.0)

		nsPhase, ewPhase = "Red", "Green"
		updateAllTrafficLights()
		task.wait(7.0)

		nsPhase, ewPhase = "Red", "Yellow"
		updateAllTrafficLights()
		task.wait(2.0)
	end
end)

--------------------------------------------------------------------------------
-- 2. AUTONOMOUS AI TRAFFIC VEHICLES
--------------------------------------------------------------------------------
type AICar = {
	model: Model,
	primary: BasePart,
	axis: string, -- "NS" or "EW"
	dir: number, -- 1 or -1
	roadLine: number,
	posAlong: number,
	baseSpeed: number,
	currentSpeed: number,
	panicTimer: number,
	swerveAngle: number,
	smashed: boolean,
}

local aiCars: { AICar } = {}
local CAR_COLORS = {
	Color3.fromRGB(240, 190, 40), -- NYC Taxi Yellow
	Color3.fromRGB(210, 45, 45),
	Color3.fromRGB(45, 115, 220),
	Color3.fromRGB(230, 235, 245),
	Color3.fromRGB(55, 180, 95),
	Color3.fromRGB(65, 72, 88),
}

local function buildTrafficCarModel(color: Color3, isTaxi: boolean): (Model, BasePart)
	local m = Instance.new("Model")
	m.Name = if isTaxi then "AITaxiCab" else "AITrafficCar"

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(6.2, 2.4, 12.5)
	chassis.Color = color
	chassis.Material = Enum.Material.SmoothPlastic
	chassis.Anchored = true
	chassis.TopSurface = Enum.SurfaceType.Smooth
	chassis.BottomSurface = Enum.SurfaceType.Smooth
	chassis.Parent = m

	local cabin = Instance.new("Part")
	cabin.Name = "Cabin"
	cabin.Size = Vector3.new(5.4, 2.0, 6.4)
	cabin.CFrame = chassis.CFrame * CFrame.new(0, 2.1, -0.4)
	cabin.Color = Color3.fromRGB(30, 38, 52)
	cabin.Material = Enum.Material.Glass
	cabin.CanCollide = false
	cabin.Parent = m

	local headlights = Instance.new("Part")
	headlights.Name = "Headlights"
	headlights.Size = Vector3.new(5.2, 0.6, 0.2)
	headlights.CFrame = chassis.CFrame * CFrame.new(0, 0.2, -6.3)
	headlights.Color = Color3.fromRGB(255, 245, 200)
	headlights.Material = Enum.Material.Neon
	headlights.CanCollide = false
	headlights.Parent = m

	local taillights = Instance.new("Part")
	taillights.Name = "Taillights"
	taillights.Size = Vector3.new(5.2, 0.6, 0.2)
	taillights.CFrame = chassis.CFrame * CFrame.new(0, 0.2, 6.3)
	taillights.Color = Color3.fromRGB(255, 40, 40)
	taillights.Material = Enum.Material.Neon
	taillights.CanCollide = false
	taillights.Parent = m

	if isTaxi then
		local sign = Instance.new("Part")
		sign.Name = "TaxiSign"
		sign.Size = Vector3.new(2.2, 0.7, 1.0)
		sign.CFrame = chassis.CFrame * CFrame.new(0, 3.4, -0.4)
		sign.Color = Color3.fromRGB(255, 225, 75)
		sign.Material = Enum.Material.Neon
		sign.CanCollide = false
		sign.Parent = m
	end

	for _, desc in ipairs(m:GetChildren()) do
		if desc:IsA("BasePart") and desc ~= chassis then
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = chassis
			wc.Part1 = desc
			wc.Parent = chassis
			desc.Anchored = false
		end
	end

	m.PrimaryPart = chassis
	m:SetAttribute("PropType", "TrafficVehicle")
	m:SetAttribute("CashValue", 90)
	m:SetAttribute("ChaosPoints", 65)
	m:SetAttribute("BreakThreshold", 28)
	CollectionService:AddTag(m, "AITrafficVehicle")
	CollectionService:AddTag(m, "Destructible")
	m.Parent = TrafficFolder

	return m, chassis
end

local function computeCarCFrame(car: AICar): CFrame
	local laneShift = car.dir * LANE_OFFSET
	if car.axis == "NS" then
		local x = car.roadLine - laneShift
		local z = car.posAlong
		local yaw = if car.dir > 0 then math.pi else 0
		return CFrame.new(x, 1.8, z) * CFrame.Angles(0, yaw + car.swerveAngle, 0)
	else
		local z = car.roadLine + laneShift
		local x = car.posAlong
		local yaw = if car.dir > 0 then -math.pi * 0.5 else math.pi * 0.5
		return CFrame.new(x, 1.8, z) * CFrame.Angles(0, yaw + car.swerveAngle, 0)
	end
end

local function spawnTrafficCars(count: number)
	for i = 1, count do
		local isTaxi = (i % 4 == 1)
		local col = if isTaxi then CAR_COLORS[1] else CAR_COLORS[(i % #CAR_COLORS) + 1]
		local model, primary = buildTrafficCarModel(col, isTaxi)

		local axis = if i % 2 == 0 then "NS" else "EW"
		local dir = if (i % 4 < 2) then 1 else -1
		local roadLine = roadCoords[((i - 1) % #roadCoords) + 1]
		local posAlong = -CITY_LIMIT + ((i * 97) % (CITY_LIMIT * 2))

		local car: AICar = {
			model = model,
			primary = primary,
			axis = axis,
			dir = dir,
			roadLine = roadLine,
			posAlong = posAlong,
			baseSpeed = 34 + (i % 5) * 4,
			currentSpeed = 34,
			panicTimer = 0,
			swerveAngle = 0,
			smashed = false,
		}
		primary.CFrame = computeCarCFrame(car)

		-- React if hit by a player vehicle
		primary.Touched:Connect(function(hit: BasePart)
			if not hit.Anchored and hit.AssemblyLinearVelocity.Magnitude > 22 and not hit:IsDescendantOf(model) then
				car.panicTimer = 7.0
				car.swerveAngle = (math.random() - 0.5) * 0.45
			end
		end)

		table.insert(aiCars, car)
	end
end

local function shouldStopForRedLight(car: AICar): boolean
	if car.panicTimer > 0 then
		return false -- Panicked drivers blow through red lights!
	end
	local phase = if car.axis == "NS" then nsPhase else ewPhase
	if phase == "Green" then
		return false
	end

	-- Check distance to nearest intersection along travel direction
	for _, interCoord in ipairs(roadCoords) do
		local distAhead = (interCoord - car.posAlong) * car.dir
		if distAhead > 18 and distAhead < 42 then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- 3. SIDEWALK NPC PEDESTRIANS (WITH COMICAL DODGE & EXCLAMATION BUBBLE)
--------------------------------------------------------------------------------
type AIPed = {
	model: Model,
	root: BasePart,
	bubbleGui: BillboardGui,
	bubbleLabel: TextLabel,
	axis: string,
	dir: number,
	roadLine: number,
	side: number,
	posAlong: number,
	walkSpeed: number,
	dodgeCooldown: number,
	leapOffset: Vector3,
	phase: number,
}

local aiPeds: { AIPed } = {}
local OUTFIT_COLORS = {
	Color3.fromRGB(45, 95, 185),
	Color3.fromRGB(190, 55, 65),
	Color3.fromRGB(50, 150, 95),
	Color3.fromRGB(145, 90, 190),
	Color3.fromRGB(220, 135, 45),
}

local function buildPedestrian(idx: number): AIPed
	local m = Instance.new("Model")
	m.Name = "CitizenNPC"

	local root = Instance.new("Part")
	root.Name = "Torso"
	root.Size = Vector3.new(2.0, 2.6, 1.1)
	root.Color = OUTFIT_COLORS[(idx % #OUTFIT_COLORS) + 1]
	root.Material = Enum.Material.SmoothPlastic
	root.Anchored = true
	root.CanCollide = false
	root.Parent = m

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.5, 1.5, 1.5)
	head.CFrame = root.CFrame * CFrame.new(0, 2.0, 0)
	head.Color = Color3.fromRGB(240, 198, 160)
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Anchored = false
	head.Parent = m

	local legs = Instance.new("Part")
	legs.Name = "Legs"
	legs.Size = Vector3.new(1.8, 2.2, 1.0)
	legs.CFrame = root.CFrame * CFrame.new(0, -2.4, 0)
	legs.Color = Color3.fromRGB(38, 42, 54)
	legs.Material = Enum.Material.SmoothPlastic
	legs.CanCollide = false
	legs.Anchored = false
	legs.Parent = m

	for _, part in ipairs({ head, legs }) do
		local wc = Instance.new("WeldConstraint")
		wc.Part0 = root
		wc.Part1 = part
		wc.Parent = root
	end

	-- Exclamation Bubble UI (hidden until startled)
	local bb = Instance.new("BillboardGui")
	bb.Name = "AlertBubble"
	bb.Size = UDim2.fromOffset(52, 52)
	bb.StudsOffset = Vector3.new(0, 3.8, 0)
	bb.AlwaysOnTop = true
	bb.Enabled = false
	bb.Parent = head

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundColor3 = Color3.fromRGB(255, 235, 60)
	lbl.BackgroundTransparency = 0.1
	lbl.Text = "!"
	lbl.TextColor3 = Color3.fromRGB(220, 25, 25)
	lbl.TextScaled = true
	lbl.Font = Enum.Font.GothamBlack
	lbl.Parent = bb

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = lbl

	m.PrimaryPart = root
	CollectionService:AddTag(m, "NPCPedestrian")
	m.Parent = PedestriansFolder

	local axis = if idx % 2 == 0 then "NS" else "EW"
	local dir = if idx % 3 == 0 then 1 else -1
	local roadLine = roadCoords[((idx - 1) % #roadCoords) + 1]
	local side = if idx % 4 < 2 then 1 else -1
	local posAlong = -CITY_LIMIT + ((idx * 67) % (CITY_LIMIT * 2))

	return {
		model = m,
		root = root,
		bubbleGui = bb,
		bubbleLabel = lbl,
		axis = axis,
		dir = dir,
		roadLine = roadLine,
		side = side,
		posAlong = posAlong,
		walkSpeed = 7.5 + (idx % 4) * 1.2,
		dodgeCooldown = 0,
		leapOffset = Vector3.zero,
		phase = idx * 1.1,
	}
end

local function triggerPedestrianDodge(ped: AIPed, threatPos: Vector3)
	if ped.dodgeCooldown > 0 then
		return
	end
	ped.dodgeCooldown = 3.2
	ped.bubbleGui.Enabled = true
	ped.bubbleLabel.Text = if math.random() < 0.5 then "!" else "WHOA!"

	local away = (ped.root.Position - threatPos)
	local flatAway = Vector3.new(away.X, 0, away.Z)
	local dodgeDir = if flatAway.Magnitude > 0.1 then flatAway.Unit else Vector3.new(1, 0, 0)
	ped.leapOffset = dodgeDir * 7.5 + Vector3.new(0, 3.6, 0)

	task.delay(1.8, function()
		if ped.bubbleGui then
			ped.bubbleGui.Enabled = false
		end
	end)
end

local function spawnPedestrians(count: number)
	for i = 1, count do
		table.insert(aiPeds, buildPedestrian(i))
	end
end

--------------------------------------------------------------------------------
-- CHAOS / DESTRUCTION PANIC HOOK
--------------------------------------------------------------------------------
local ServerEvents = ServerStorage:FindFirstChild("ServerEvents")
local DestructionBindable = ServerEvents and ServerEvents:FindFirstChild("DestructionOccurred") :: BindableEvent?
if DestructionBindable then
	DestructionBindable.Event:Connect(function(payload: { [string]: any })
		local pos: Vector3? = payload and payload.position
		if not pos then
			return
		end
		for _, car in ipairs(aiCars) do
			if not car.smashed and (car.primary.Position - pos).Magnitude < 85 then
				car.panicTimer = 8.0
				car.swerveAngle = (math.random() - 0.5) * 0.4
			end
		end
		for _, ped in ipairs(aiPeds) do
			if (ped.root.Position - pos).Magnitude < 65 then
				triggerPedestrianDodge(ped, pos)
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- MAIN HEARTBEAT AI UPDATE LOOP
--------------------------------------------------------------------------------
spawnTrafficCars(18)
spawnPedestrians(28)

RunService.Heartbeat:Connect(function(dt: number)
	local clampedDt = math.min(dt, 0.1)

	-- Gather active player positions & velocities for threat detection
	local playerRoots: { BasePart } = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			table.insert(playerRoots, hrp)
		end
	end

	-- Update AI Traffic Vehicles
	for _, car in ipairs(aiCars) do
		if car.model:GetAttribute("Destroyed") == true then
			if not car.smashed then
				car.smashed = true
				-- Respawn traffic car onto road after 18s
				task.delay(18.0, function()
					if car.model and car.model.Parent then
						car.model:SetAttribute("Destroyed", false)
						car.primary.Anchored = true
						car.primary.Transparency = 0
						car.primary.CanCollide = true
						for _, d in ipairs(car.model:GetDescendants()) do
							if d:IsA("BasePart") then
								d.Transparency = 0
							end
						end
						car.posAlong = -CITY_LIMIT
						car.panicTimer = 0
						car.swerveAngle = 0
						car.smashed = false
					end
				end)
			end
			continue
		end

		if car.panicTimer > 0 then
			car.panicTimer = math.max(0, car.panicTimer - clampedDt)
			car.swerveAngle = math.sin(os.clock() * 7) * 0.22
		else
			car.swerveAngle = car.swerveAngle * math.max(0, 1 - clampedDt * 5)
		end

		local stop = shouldStopForRedLight(car)
		local targetSpeed = if stop then 0 elseif car.panicTimer > 0 then car.baseSpeed * 1.75 else car.baseSpeed
		car.currentSpeed += (targetSpeed - car.currentSpeed) * math.min(1, clampedDt * 6)

		car.posAlong += car.dir * car.currentSpeed * clampedDt
		if car.posAlong > CITY_LIMIT then
			car.posAlong = -CITY_LIMIT
		elseif car.posAlong < -CITY_LIMIT then
			car.posAlong = CITY_LIMIT
		end

		car.primary.CFrame = computeCarCFrame(car)
	end

	-- Update Sidewalk Pedestrians
	for _, ped in ipairs(aiPeds) do
		ped.phase += clampedDt * 8
		if ped.dodgeCooldown > 0 then
			ped.dodgeCooldown = math.max(0, ped.dodgeCooldown - clampedDt)
		end
		ped.leapOffset = ped.leapOffset:Lerp(Vector3.zero, math.min(1, clampedDt * 6))

		-- Check for approaching fast player vehicles
		for _, hrp in ipairs(playerRoots) do
			local d = (hrp.Position - ped.root.Position).Magnitude
			if d < 32 and hrp.AssemblyLinearVelocity.Magnitude > 20 then
				triggerPedestrianDodge(ped, hrp.Position)
			end
		end

		local speedMult = if ped.dodgeCooldown > 1.5 then 2.2 else 1.0
		ped.posAlong += ped.dir * ped.walkSpeed * speedMult * clampedDt
		if ped.posAlong > CITY_LIMIT then
			ped.posAlong = -CITY_LIMIT
		elseif ped.posAlong < -CITY_LIMIT then
			ped.posAlong = CITY_LIMIT
		end

		local bob = math.abs(math.sin(ped.phase)) * 0.45
		local sway = math.sin(ped.phase) * 0.08
		local basePos: Vector3
		local yaw: number
		if ped.axis == "NS" then
			basePos = Vector3.new(ped.roadLine + ped.side * SIDEWALK_OFFSET, 3.5 + bob, ped.posAlong)
			yaw = if ped.dir > 0 then math.pi else 0
		else
			basePos = Vector3.new(ped.posAlong, 3.5 + bob, ped.roadLine + ped.side * SIDEWALK_OFFSET)
			yaw = if ped.dir > 0 then -math.pi * 0.5 else math.pi * 0.5
		end

		ped.root.CFrame = CFrame.new(basePos + ped.leapOffset) * CFrame.Angles(0, yaw, sway)
	end
end)

print("[TrafficAndNPCAIService] Synchronized traffic lights, AI vehicles, and sidewalk pedestrians active.")
]]></ProtectedString>
