-- Alias support so `ArmoredTank`, `Hatchback`, `BoxTruck`, etc. resolve cleanly
local ALIAS_MAP: { [string]: string } = {
	compact = "Compact",
	hatchback = "Compact",
	sedan = "Sedan",
	muscle = "Muscle",
	suv = "SUV",
	pickup = "Pickup",
	sports = "Sports",
	monstertruck = "MonsterTruck",
	monster = "MonsterTruck",
	bulldozer = "Bulldozer",
	armoredtank = "Bulldozer",
	tank = "Bulldozer",
	boxtruck = "Bulldozer",
	van = "SUV",
}

-- Also expose ArmoredTank and Tank directly in Archetypes table for direct indexing
VehicleCatalog.Archetypes.ArmoredTank = VehicleCatalog.Archetypes.Bulldozer
VehicleCatalog.Archetypes.Tank = VehicleCatalog.Archetypes.Bulldozer
VehicleCatalog.Vehicles = VehicleCatalog.Archetypes

function VehicleCatalog.ResolveArchetypeId(vehicleType: string?): string
	if not vehicleType or vehicleType == "" then
		return "Compact"
	end
	if VehicleCatalog.Archetypes[vehicleType] then
		return VehicleCatalog.Archetypes[vehicleType].Id
	end
	local lowered = string.lower(vehicleType)
	if ALIAS_MAP[lowered] then
		return ALIAS_MAP[lowered]
	end
	return "Compact"
end

function VehicleCatalog.GetConfig(vehicleType: string?): VehicleArchetypeConfig
	local resolved = VehicleCatalog.ResolveArchetypeId(vehicleType)
	return VehicleCatalog.Archetypes[resolved] or VehicleCatalog.Archetypes.Compact
end

function VehicleCatalog.GetRandomTrafficArchetype(rng: Random?): string
	local r = rng or Random.new()
	local totalWeight = 0
	for _, id in ipairs(VehicleCatalog.OrderedIds) do
		local cfg = VehicleCatalog.Archetypes[id]
		-- Keep MonsterTruck & Bulldozer rare in regular traffic
		totalWeight += cfg.SpawnWeight
	end
	local pick = r:NextInteger(1, totalWeight)
	for _, id in ipairs(VehicleCatalog.OrderedIds) do
		local cfg = VehicleCatalog.Archetypes[id]
		if pick <= cfg.SpawnWeight then
			return id
		end
		pick -= cfg.SpawnWeight
	end
	return "Sedan"
end

function VehicleCatalog.GetRandomTrafficColor(rng: Random?): Color3
	local r = rng or Random.new()
	local palette = VehicleCatalog.TrafficPalette
	return palette[r:NextInteger(1, #palette)]
end

-- Internal helper: create a base Part with zero velocity & smooth surfaces
local function makePart(
	name: string,
	size: Vector3,
	color: Color3,
	material: Enum.Material,
	parent: Instance,
	canCollide: boolean?,
	massless: boolean?,
	transparency: number?,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = if canCollide ~= nil then canCollide else false
	p.Massless = if massless ~= nil then massless else true
	p.Transparency = transparency or 0
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function weldParts(part0: BasePart, part1: BasePart, c0: CFrame?, c1: CFrame?): Weld
	local w = Instance.new("Weld")
	w.Name = part1.Name .. "_Weld"
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = c0 or part0.CFrame:ToObjectSpace(part1.CFrame)
	w.C1 = c1 or CFrame.identity
	w.Parent = part1
	return w
end

local function placeAndWeld(chassis: BasePart, part: BasePart, offsetCFrame: CFrame): Weld
	part.CFrame = chassis.CFrame * offsetCFrame
	return weldParts(chassis, part, offsetCFrame, CFrame.identity)
end

-- Builds or upgrades the front Ramming Plow / Dozer Blade on a vehicle model
function VehicleCatalog.AttachRamPlow(model: Model, plowLevel: number, accentColor: Color3?)
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end

	-- Remove any existing plow first
	local existing = model:FindFirstChild("RamPlow")
	if existing then
		existing:Destroy()
	end

	if plowLevel <= 0 then
		model:SetAttribute("PlowLevel", 0)
		return
	end

	model:SetAttribute("PlowLevel", plowLevel)

	local plowModel = Instance.new("Model")
	plowModel.Name = "RamPlow"
	plowModel.Parent = model

	local size = chassis.Size
	local w = size.X * (1.08 + math.min(plowLevel, 5) * 0.04)
	local h = math.clamp(size.Y * 0.85, 2.0, 3.6)
	local frontZ = -(size.Z * 0.5) - 0.85

	local bladeColor = accentColor or Color3.fromRGB(235, 175, 25)
	local steelColor = Color3.fromRGB(45, 48, 55)

	-- Main heavy curved plow blade (lower angled scoop + upper deflector)
	local mainBlade = makePart(
		"PlowBlade",
		Vector3.new(w, h * 0.68, 0.75),
		steelColor,
		Enum.Material.DiamondPlate,
		plowModel,
		false,
		true
	)
	placeAndWeld(chassis, mainBlade, CFrame.new(0, -size.Y * 0.12, frontZ) * CFrame.Angles(math.rad(14), 0, 0))

	local lowerScoop = makePart(
		"PlowScoop",
		Vector3.new(w * 1.02, h * 0.42, 0.85),
		bladeColor,
		Enum.Material.Metal,
		plowModel,
		false,
		true
	)
	placeAndWeld(chassis, lowerScoop, CFrame.new(0, -size.Y * 0.42, frontZ - 0.45) * CFrame.Angles(math.rad(-28), 0, 0))

	-- Side cheek plates to funnel debris outward
	for _, sx in ipairs({ -1, 1 }) do
		local cheek = makePart(
			"PlowCheek",
			Vector3.new(0.45, h * 0.75, 1.8),
			bladeColor,
			Enum.Material.Metal,
			plowModel,
			false,
			true
		)
		placeAndWeld(
			chassis,
			cheek,
			CFrame.new(sx * (w * 0.5 - 0.15), -size.Y * 0.15, frontZ + 0.1) * CFrame.Angles(0, math.rad(-sx * 18), 0)
		)

		-- Support push-beams connecting chassis frame to blade
		local strut = makePart(
			"PlowStrut",
			Vector3.new(0.55, 0.55, 2.2),
			steelColor,
			Enum.Material.Metal,
			plowModel,
			false,
			true
		)
		placeAndWeld(chassis, strut, CFrame.new(sx * (size.X * 0.32), -size.Y * 0.2, frontZ + 0.8))
	end

	-- Hazard teeth along the bottom edge for higher levels
	local numTeeth = math.clamp(3 + plowLevel, 4, 8)
	for i = 1, numTeeth do
		local frac = (i - 0.5) / numTeeth - 0.5
		local tooth = makePart(
			"PlowTooth",
			Vector3.new((w / numTeeth) * 0.55, 0.45, 0.9),
			Color3.fromRGB(240, 240, 245),
			Enum.Material.Metal,
			plowModel,
			false,
			true
		)
		placeAndWeld(
			chassis,
			tooth,
			CFrame.new(frac * (w * 0.88), -size.Y * 0.54, frontZ - 0.75) * CFrame.Angles(math.rad(-20), 0, 0)
		)
	end
end

-- Creates particle emitters used for Nitro, Drift Tire Smoke, and Low-Health Engine Damage
local function attachVehicleVFX(model: Model, chassis: BasePart, cfg: VehicleArchetypeConfig)
	local halfL = cfg.Size.Z * 0.5
	local halfW = cfg.Size.X * 0.5

	-- Engine bay attachment (front hood) for smoke & fire when damaged
	local engineAttachment = Instance.new("Attachment")
	engineAttachment.Name = "EngineVFXAttachment"
	engineAttachment.Position = Vector3.new(0, cfg.Size.Y * 0.45, -halfL * 0.65)
	engineAttachment.Parent = chassis

	local damageSmoke = Instance.new("ParticleEmitter")
	damageSmoke.Name = "DamageSmoke"
	damageSmoke.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 90, 95)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 30, 35)),
	})
	damageSmoke.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 4.5),
	})
	damageSmoke.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1.0),
	})
	damageSmoke.Lifetime = NumberRange.new(1.0, 1.8)
	damageSmoke.Rate = 28
	damageSmoke.Speed = NumberRange.new(4, 9)
	damageSmoke.SpreadAngle = Vector2.new(25, 25)
	damageSmoke.Enabled = false
	damageSmoke.Parent = engineAttachment

	local damageFire = Instance.new("ParticleEmitter")
	damageFire.Name = "DamageFire"
	damageFire.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 80)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 95, 15)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 20, 10)),
	})
	damageFire.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.0),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	damageFire.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1.0),
	})
	damageFire.LightEmission = 1
	damageFire.Lifetime = NumberRange.new(0.3, 0.6)
	damageFire.Rate = 35
	damageFire.Speed = NumberRange.new(5, 10)
	damageFire.SpreadAngle = Vector2.new(18, 18)
	damageFire.Enabled = false
	damageFire.Parent = engineAttachment

	-- Dual rear exhaust attachments for Nitro flames & exhaust puffs
	for _, sx in ipairs({ -1, 1 }) do
		local exhaustAtt = Instance.new("Attachment")
		exhaustAtt.Name = if sx < 0 then "ExhaustAttachmentL" else "ExhaustAttachmentR"
		exhaustAtt.Position = Vector3.new(sx * (halfW * 0.52), -cfg.Size.Y * 0.28, halfL + 0.3)
		exhaustAtt.Parent = chassis

		local nitroFlame = Instance.new("ParticleEmitter")
		nitroFlame.Name = "NitroFlame"
		nitroFlame.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 220, 255)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(40, 120, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 20)),
		})
		nitroFlame.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.95),
			NumberSequenceKeypoint.new(0.5, 1.35),
			NumberSequenceKeypoint.new(1, 0.1),
		})
		nitroFlame.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		nitroFlame.LightEmission = 1
		nitroFlame.Lifetime = NumberRange.new(0.12, 0.24)
		nitroFlame.Rate = 65
		nitroFlame.Speed = NumberRange.new(22, 36)
		nitroFlame.EmissionDirection = Enum.NormalId.Back
		nitroFlame.SpreadAngle = Vector2.new(8, 8)
		nitroFlame.Enabled = false
		nitroFlame.Parent = exhaustAtt
	end

	-- Rear tire drift smoke & skid trail attachments
	for _, sx in ipairs({ -1, 1 }) do
		local tireAtt = Instance.new("Attachment")
		tireAtt.Name = if sx < 0 then "DriftAttachmentL" else "DriftAttachmentR"
		tireAtt.Position = Vector3.new(sx * cfg.TrackOffsetX, -cfg.HoverHeight + 0.25, cfg.WheelbaseOffsetZ)
		tireAtt.Parent = chassis

		local trailAtt0 = Instance.new("Attachment")
		trailAtt0.Name = if sx < 0 then "SkidAttL0" else "SkidAttR0"
		trailAtt0.Position = Vector3.new(sx * cfg.TrackOffsetX - 0.35, -cfg.HoverHeight + 0.12, cfg.WheelbaseOffsetZ)
		trailAtt0.Parent = chassis

		local trailAtt1 = Instance.new("Attachment")
		trailAtt1.Name = if sx < 0 then "SkidAttL1" else "SkidAttR1"
		trailAtt1.Position = Vector3.new(sx * cfg.TrackOffsetX + 0.35, -cfg.HoverHeight + 0.12, cfg.WheelbaseOffsetZ)
		trailAtt1.Parent = chassis

		local skidTrail = Instance.new("Trail")
		skidTrail.Name = if sx < 0 then "SkidTrailL" else "SkidTrailR"
		skidTrail.Attachment0 = trailAtt0
		skidTrail.Attachment1 = trailAtt1
		skidTrail.Color = ColorSequence.new(Color3.fromRGB(20, 20, 24))
		skidTrail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(0.8, 0.65),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		skidTrail.Lifetime = 2.2
		skidTrail.MinLength = 0.2
		skidTrail.FaceCamera = false
		skidTrail.Enabled = false
		skidTrail.Parent = chassis

		local driftSmoke = Instance.new("ParticleEmitter")
		driftSmoke.Name = "DriftSmoke"
		driftSmoke.Color = ColorSequence.new(Color3.fromRGB(230, 232, 238))
		driftSmoke.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(1, 3.2),
		})
		driftSmoke.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1.0),
		})
		driftSmoke.Lifetime = NumberRange.new(0.45, 0.85)
		driftSmoke.Rate = 45
		driftSmoke.Speed = NumberRange.new(3, 8)
		driftSmoke.SpreadAngle = Vector2.new(35, 20)
		driftSmoke.Enabled = false
		driftSmoke.Parent = tireAtt
	end
end

-- Main procedural 3D vehicle builder
function VehicleCatalog.BuildVehicle(vehicleType: string?, options: BuildOptions?): Model
	local opts: BuildOptions = options or {}
	local cfg = VehicleCatalog.GetConfig(vehicleType)

	local scale = math.clamp(opts.BulkScale or 1.0, 0.75, 2.0)
	local engineLevel = math.max(0, opts.EngineLevel or 0)
	local armorLevel = math.max(0, opts.ArmorLevel or 0)
	local nitroLevel = math.max(0, opts.NitroLevel or 0)
	local plowLevel = math.max(0, opts.PlowLevel or (if opts.HasRamPlow then 1 else 0))
	if cfg.HasBulldozerBlade and plowLevel < 2 then
		plowLevel = 2
	end

	local primaryColor = opts.PrimaryColor or cfg.PrimaryColor
	local secondaryColor = opts.SecondaryColor or cfg.SecondaryColor
	local accentColor = opts.AccentColor or cfg.AccentColor

	local model = Instance.new("Model")
	model.Name = cfg.Id

	local chassisSize = cfg.Size * scale
	local w = chassisSize.X
	local h = chassisSize.Y
	local len = chassisSize.Z

	-- 1. Main Chassis slab (PrimaryPart, CanCollide = true)
	local chassis = makePart(
		"Chassis",
		chassisSize,
		primaryColor,
		Enum.Material.SmoothPlastic,
		model,
		true,
		false
	)
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.8, 0.15, 0.1, 100, 100)
	model.PrimaryPart = chassis

	local spawnCF = opts.CFrame or CFrame.new(0, cfg.HoverHeight * scale + h * 0.5, 0)
	chassis.CFrame = spawnCF

	-- 2. DriveSeat (VehicleSeat) inside the cabin
	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriveSeat"
	seat.Size = Vector3.new(2.2, 0.8, 2.2)
	seat.Color = Color3.fromRGB(30, 32, 38)
	seat.Material = Enum.Material.Fabric
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.CanCollide = false
	seat.Massless = true
	seat.HeadsUpDisplay = false

	-- Effective upgraded stats
	local effectiveMaxSpeed = cfg.MaxSpeed * (1 + engineLevel * 0.09)
	local effectiveAccel = cfg.Acceleration * (1 + engineLevel * 0.10)
	local effectiveMaxHealth = math.round(cfg.MaxHealth * (1 + armorLevel * 0.22))
	local effectiveNitroCap = cfg.NitroCapacity * (1 + nitroLevel * 0.18)
	local effectiveRamMult = cfg.RamMultiplier + plowLevel * 0.35

	seat.MaxSpeed = effectiveMaxSpeed
	seat.Torque = effectiveAccel * 25
	seat.TurnSpeed = cfg.TurnSpeed
	seat.Parent = model

	local seatZ = if cfg.HasTruckBed then -len * 0.08 elseif cfg.HasBulldozerBlade then len * 0.06 else -len * 0.02
	placeAndWeld(chassis, seat, CFrame.new(0, h * 0.25, seatZ))

	-- ProximityPrompt on DriveSeat for quick E enter / hijack on foot
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EnterVehiclePrompt"
	prompt.ActionText = if opts.IsTraffic then "Hijack " .. cfg.DisplayName else "Drive " .. cfg.DisplayName
	prompt.ObjectText = cfg.DisplayName
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = seat

	-- 3. Hood & Trunk steps
	local hoodLen = len * (if cfg.Id == "Sports" or cfg.Id == "Muscle" then 0.34 else 0.27)
	local hood = makePart(
		"Hood",
		Vector3.new(w * 0.94, h * 0.32, hoodLen),
		primaryColor,
		Enum.Material.SmoothPlastic,
		model
	)
	placeAndWeld(chassis, hood, CFrame.new(0, h * 0.52, -len * 0.5 + hoodLen * 0.5 + 0.35 * scale))

	-- Muscle car racing stripe & supercharger blower on hood
	if cfg.HasBlower then
		local stripe = makePart(
			"RacingStripe",
			Vector3.new(w * 0.28, 0.08 * scale, len * 0.96),
			secondaryColor,
			Enum.Material.SmoothPlastic,
			model
		)
		placeAndWeld(chassis, stripe, CFrame.new(0, h * 0.68, 0))

		local blowerBase = makePart(
			"BlowerBase",
			Vector3.new(w * 0.32, h * 0.38, hoodLen * 0.45),
			Color3.fromRGB(205, 210, 220),
			Enum.Material.Metal,
			model
		)
		placeAndWeld(chassis, blowerBase, CFrame.new(0, h * 0.82, -len * 0.24))

		local blowerScoop = makePart(
			"BlowerScoop",
			Vector3.new(w * 0.36, h * 0.26, hoodLen * 0.38),
			Color3.fromRGB(225, 230, 238),
			Enum.Material.Metal,
			model
		)
		placeAndWeld(chassis, blowerScoop, CFrame.new(0, h * 1.06, -len * 0.26))

		for _, intakeX in ipairs({ -0.35, 0, 0.35 }) do
			local butterfly = makePart(
				"IntakeValve",
				Vector3.new(w * 0.08, h * 0.16, 0.12 * scale),
				Color3.fromRGB(220, 45, 35),
				Enum.Material.Neon,
				model
			)
			placeAndWeld(chassis, butterfly, CFrame.new(intakeX * w * 0.28, h * 1.08, -len * 0.26 - hoodLen * 0.19))
		end
	end

	-- 4. Cabin / Greenhouse, Tilted Windshield & Rear Window
	local glassColor = Color3.fromRGB(115, 165, 215)
	local cabW = w * 0.84
	local cabH = if cfg.Id == "Sports" then h * 0.72 elseif cfg.Id == "Bulldozer" then h * 1.05 else h * 0.88
	local cabLen = if cfg.HasTruckBed then len * 0.34 elseif cfg.Id == "Compact" or cfg.Id == "SUV" then len * 0.56 else len * 0.44
	local cabCenterZ = if cfg.HasTruckBed then -len * 0.05 elseif cfg.Id == "Compact" or cfg.Id == "SUV" then len * 0.08 else 0.0

	local cabin = makePart(
		"Cabin",
		Vector3.new(cabW, cabH, cabLen),
		glassColor,
		Enum.Material.Glass,
		model,
		false,
		true,
		0.35
	)
	placeAndWeld(chassis, cabin, CFrame.new(0, h * 0.5 + cabH * 0.5 - 0.1 * scale, cabCenterZ))

	-- Painted roof cap
	local roofCap = makePart(
		"RoofCap",
		Vector3.new(cabW * 1.02, 0.24 * scale, cabLen * 0.96),
		if cfg.Id == "Sports" or cfg.Id == "Muscle" then secondaryColor else primaryColor,
		Enum.Material.SmoothPlastic,
		model
	)
	placeAndWeld(chassis, roofCap, CFrame.new(0, h * 0.5 + cabH, cabCenterZ))

	-- Sloped front windshield
	local windshield = makePart(
		"Windshield",
		Vector3.new(cabW * 0.96, cabH * 1.15, 0.22 * scale),
		glassColor,
		Enum.Material.Glass,
		model,
		false,
		true,
		0.25
	)
	placeAndWeld(
		chassis,
		windshield,
		CFrame.new(0, h * 0.5 + cabH * 0.48, cabCenterZ - cabLen * 0.5 - 0.35 * scale)
			* CFrame.Angles(math.rad(34), 0, 0)
	)

	-- Sloped rear window
	local rearWindow = makePart(
		"RearWindow",
		Vector3.new(cabW * 0.94, cabH * 1.05, 0.2 * scale),
		glassColor,
		Enum.Material.Glass,
		model,
		false,
		true,
		0.3
	)
	placeAndWeld(
		chassis,
		rearWindow,
		CFrame.new(0, h * 0.5 + cabH * 0.48, cabCenterZ + cabLen * 0.5 + 0.3 * scale)
			* CFrame.Angles(math.rad(-30), 0, 0)
	)

	-- 5. Truck Bed (Pickup & MonsterTruck)
	if cfg.HasTruckBed then
		local bedLen = len * 0.38
		local bedZ = len * 0.5 - bedLen * 0.5 - 0.2 * scale
		local bedFloor = makePart(
			"TruckBedFloor",
			Vector3.new(w * 0.88, 0.25 * scale, bedLen),
			secondaryColor,
			Enum.Material.DiamondPlate,
			model
		)
		placeAndWeld(chassis, bedFloor, CFrame.new(0, h * 0.38, bedZ))

		for _, sx in ipairs({ -1, 1 }) do
			local bedWall = makePart(
				"TruckBedWall",
				Vector3.new(0.42 * scale, h * 0.48, bedLen),
				primaryColor,
				Enum.Material.SmoothPlastic,
				model
			)
			placeAndWeld(chassis, bedWall, CFrame.new(sx * (w * 0.46), h * 0.58, bedZ))
		end

		local tailgate = makePart(
			"Tailgate",
			Vector3.new(w * 0.92, h * 0.48, 0.38 * scale),
			primaryColor,
			Enum.Material.SmoothPlastic,
			model
		)
		placeAndWeld(chassis, tailgate, CFrame.new(0, h * 0.58, len * 0.5 - 0.25 * scale))

		-- Sport rollbar behind cab with overhead floodlights
		local rollbar = makePart(
			"RollBar",
			Vector3.new(cabW * 0.94, cabH * 0.95, 0.38 * scale),
			secondaryColor,
			Enum.Material.Metal,
			model
		)
		placeAndWeld(chassis, rollbar, CFrame.new(0, h * 0.5 + cabH * 0.48, cabCenterZ + cabLen * 0.5 + 0.45 * scale))
	end

	-- 6. Roof Rails (SUV)
	if cfg.HasRoofRails then
		for _, sx in ipairs({ -1, 1 }) do
			local rail = makePart(
				"RoofRail",
				Vector3.new(0.24 * scale, 0.26 * scale, cabLen * 0.86),
				secondaryColor,
				Enum.Material.Metal,
				model
			)
			placeAndWeld(chassis, rail, CFrame.new(sx * (cabW * 0.42), h * 0.5 + cabH + 0.2 * scale, cabCenterZ))
		end
	end

	-- 7. Rear Spoiler & Splitter (Sports & Muscle)
	if cfg.HasSpoiler then
		for _, sx in ipairs({ -1, 1 }) do
			local strut = makePart(
				"SpoilerStrut",
				Vector3.new(0.25 * scale, 0.75 * scale, 0.45 * scale),
				secondaryColor,
				Enum.Material.Metal,
				model
			)
			placeAndWeld(chassis, strut, CFrame.new(sx * (w * 0.30), h * 0.72, len * 0.44))
		end
		local wing = makePart(
			"SpoilerWing",
			Vector3.new(w * 0.94, 0.22 * scale, 1.35 * scale),
			accentColor,
			Enum.Material.SmoothPlastic,
			model
		)
		placeAndWeld(chassis, wing, CFrame.new(0, h * 1.12, len * 0.45) * CFrame.Angles(math.rad(-8), 0, 0))
	end

	-- 8. Neon Accents (Sports coupe underglow & side blades)
	if cfg.HasNeonAccents then
		for _, sx in ipairs({ -1, 1 }) do
			local sideNeon = makePart(
				"NeonSideStrip",
				Vector3.new(0.16 * scale, 0.18 * scale, len * 0.68),
				accentColor,
				Enum.Material.Neon,
				model
			)
			placeAndWeld(chassis, sideNeon, CFrame.new(sx * (w * 0.51), -h * 0.36, 0))
		end
		local frontSplitterNeon = makePart(
			"NeonFrontStrip",
			Vector3.new(w * 0.86, 0.14 * scale, 0.22 * scale),
			accentColor,
			Enum.Material.Neon,
			model
		)
		placeAndWeld(chassis, frontSplitterNeon, CFrame.new(0, -h * 0.38, -len * 0.5 - 0.18 * scale))
	end

	-- 9. Monster Truck high-travel suspension struts & shock coils
	if cfg.HasMonsterSuspension then
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				local shock = makePart(
					"SuspensionShock",
					Vector3.new(0.55 * scale, cfg.HoverHeight * 0.85 * scale, 0.55 * scale),
					accentColor,
					Enum.Material.Metal,
					model
				)
				placeAndWeld(
					chassis,
					shock,
					CFrame.new(sx * (w * 0.38), -cfg.HoverHeight * 0.42 * scale, sz * cfg.WheelbaseOffsetZ * scale)
						* CFrame.Angles(0, 0, math.rad(sx * 12))
				)
			end
		end
	end

	-- 10. Bulldozer / ArmoredTank turret cage & hazard beacons
	if cfg.HasBulldozerBlade then
		for _, sx in ipairs({ -1, 1 }) do
			local beacon = makePart(
				"HazardBeacon",
				Vector3.new(0.55 * scale, 0.65 * scale, 0.55 * scale),
				Color3.fromRGB(255, 140, 10),
				Enum.Material.Neon,
				model,
				false,
				true,
				0,
				Enum.PartType.Cylinder
			)
			placeAndWeld(
				chassis,
				beacon,
				CFrame.new(sx * (cabW * 0.35), h * 0.5 + cabH + 0.38 * scale, cabCenterZ)
					* CFrame.Angles(0, 0, math.rad(90))
			)

			-- Side armored track skirts
			local trackSkirt = makePart(
				"ArmoredTrackSkirt",
				Vector3.new(0.75 * scale, h * 0.85, len * 0.88),
				secondaryColor,
				Enum.Material.DiamondPlate,
				model
			)
			placeAndWeld(chassis, trackSkirt, CFrame.new(sx * (w * 0.52), -h * 0.25, 0))
		end
	end

	-- 11. Front & Rear Bumpers, Grille, Headlights, Taillights & Exhaust Pipes
	for _, sz in ipairs({ -1, 1 }) do
		local bumper = makePart(
			if sz < 0 then "FrontBumper" else "RearBumper",
			Vector3.new(w * 1.03, h * 0.32, 0.65 * scale),
			secondaryColor,
			Enum.Material.Metal,
			model
		)
		placeAndWeld(chassis, bumper, CFrame.new(0, -h * 0.28, sz * (len * 0.5 + 0.22 * scale)))
	end

	local grille = makePart(
		"FrontGrille",
		Vector3.new(w * 0.48, h * 0.36, 0.18 * scale),
		Color3.fromRGB(35, 38, 44),
		Enum.Material.DiamondPlate,
		model
	)
	placeAndWeld(chassis, grille, CFrame.new(0, 0.05 * scale, -len * 0.5 - 0.08 * scale))

	-- Headlights (Front = -Z) with SpotLights
	for _, sx in ipairs({ -1, 1 }) do
		local headlight = makePart(
			if sx < 0 then "HeadlightL" else "HeadlightR",
			Vector3.new(w * 0.18, h * 0.22, 0.2 * scale),
			Color3.fromRGB(245, 250, 255),
			Enum.Material.Neon,
			model
		)
		placeAndWeld(chassis, headlight, CFrame.new(sx * (w * 0.35), h * 0.12, -len * 0.5 - 0.08 * scale))

		local spot = Instance.new("SpotLight")
		spot.Name = "HeadlightBeam"
		spot.Face = Enum.NormalId.Front
		spot.Brightness = 2.8
		spot.Range = 55
		spot.Angle = 55
		spot.Color = Color3.fromRGB(255, 248, 230)
		spot.Enabled = true
		spot.Parent = headlight
	end

	-- Taillight bar (Rear = +Z)
	local taillight = makePart(
		"TaillightBar",
		Vector3.new(w * 0.78, h * 0.20, 0.18 * scale),
		Color3.fromRGB(255, 35, 25),
		Enum.Material.Neon,
		model
	)
	placeAndWeld(chassis, taillight, CFrame.new(0, h * 0.12, len * 0.5 + 0.08 * scale))

	-- Twin Exhaust pipes (Rear = +Z)
	for _, sx in ipairs({ -1, 1 }) do
		local exhaust = makePart(
			if sx < 0 then "ExhaustL" else "ExhaustR",
			Vector3.new(0.55 * scale, 0.38 * scale, 0.38 * scale),
			Color3.fromRGB(165, 170, 180),
			Enum.Material.Metal,
			model,
			false,
			true,
			0,
			Enum.PartType.Cylinder
		)
		placeAndWeld(
			chassis,
			exhaust,
			CFrame.new(sx * (w * 0.28), -h * 0.34, len * 0.5 + 0.25 * scale)
				* CFrame.Angles(0, math.rad(90), 0)
		)
	end

	-- 12. 4 Procedural Wheels (FL, FR, RL, RR) with cylinder tires & chrome rims
	local wheelDiameter = cfg.WheelRadius * 2 * scale
	local wheelWidth = cfg.WheelWidth * scale
	local wheelY = -(cfg.HoverHeight * scale) + cfg.WheelRadius * scale - h * 0.15
	local wheelSpecs = {
		{ Name = "WheelFL", X = -cfg.TrackOffsetX * scale, Z = -cfg.WheelbaseOffsetZ * scale, IsFront = true },
		{ Name = "WheelFR", X = cfg.TrackOffsetX * scale, Z = -cfg.WheelbaseOffsetZ * scale, IsFront = true },
		{ Name = "WheelRL", X = -cfg.TrackOffsetX * scale, Z = cfg.WheelbaseOffsetZ * scale, IsFront = false },
		{ Name = "WheelRR", X = cfg.TrackOffsetX * scale, Z = cfg.WheelbaseOffsetZ * scale, IsFront = false },
	}

	for _, ws in ipairs(wheelSpecs) do
		-- Roblox Cylinder axis is local X, so Size = (width, diameter, diameter) aligns axle with X!
		local tire = makePart(
			ws.Name,
			Vector3.new(wheelWidth, wheelDiameter, wheelDiameter),
			Color3.fromRGB(22, 24, 28),
			Enum.Material.SmoothPlastic,
			model,
			false,
			true,
			0,
			Enum.PartType.Cylinder
		)
		tire:SetAttribute("IsFrontWheel", ws.IsFront)
		local baseOffset = CFrame.new(ws.X, wheelY, ws.Z)
		local weld = placeAndWeld(chassis, tire, baseOffset)
		weld.Name = "WheelWeld"
		tire:SetAttribute("BaseX", ws.X)
		tire:SetAttribute("BaseY", wheelY)
		tire:SetAttribute("BaseZ", ws.Z)

		-- Chrome hubcap rim
		local rim = makePart(
			ws.Name .. "_Rim",
			Vector3.new(wheelWidth + 0.12 * scale, wheelDiameter * 0.56, wheelDiameter * 0.56),
			accentColor,
			Enum.Material.Metal,
			model,
			false,
			true,
			0,
			Enum.PartType.Cylinder
		)
		placeAndWeld(tire, rim, CFrame.identity)
	end

	-- 13. Attach VFX Emitters (Nitro, Drift Smoke, Skid Trails, Damage Smoke/Fire)
	attachVehicleVFX(model, chassis, cfg)

	-- 14. Attach Front Ram Plow if upgraded or Bulldozer
	if plowLevel > 0 then
		VehicleCatalog.AttachRamPlow(model, plowLevel, accentColor)
	end

	-- 15. Set Vehicle Attributes on Model & DriveSeat
	model:SetAttribute("VehicleType", cfg.Id)
	model:SetAttribute("DisplayName", cfg.DisplayName)
	model:SetAttribute("MaxHealth", effectiveMaxHealth)
	model:SetAttribute("Health", effectiveMaxHealth)
	model:SetAttribute("Mass", math.round(cfg.Mass * scale))
	model:SetAttribute("MaxSpeed", effectiveMaxSpeed)
	model:SetAttribute("ReverseSpeed", cfg.ReverseSpeed)
	model:SetAttribute("Acceleration", effectiveAccel)
	model:SetAttribute("BrakeDecel", cfg.BrakeDecel)
	model:SetAttribute("TurnSpeed", cfg.TurnSpeed)
	model:SetAttribute("DriftFactor", cfg.DriftFactor)
	model:SetAttribute("RamMultiplier", effectiveRamMult)
	model:SetAttribute("NitroCapacity", effectiveNitroCap)
	model:SetAttribute("HoverHeight", cfg.HoverHeight * scale)
	model:SetAttribute("CoinReward", cfg.CoinReward)
	model:SetAttribute("UnlockCost", cfg.UnlockCost)
	model:SetAttribute("EngineLevel", engineLevel)
	model:SetAttribute("ArmorLevel", armorLevel)
	model:SetAttribute("NitroLevel", nitroLevel)
	model:SetAttribute("PlowLevel", plowLevel)
	model:SetAttribute("BulkScale", scale)
	model:SetAttribute("IsTraffic", opts.IsTraffic == true)
	model:SetAttribute("OwnerUserId", opts.OwnerUserId or 0)
	model:SetAttribute("HeadlightsOn", true)
	model:SetAttribute("IsWrecked", false)

	CollectionService:AddTag(model, "Vehicle")
	if opts.IsTraffic then
		CollectionService:AddTag(model, "TrafficVehicle")
	end

	return model
end

-- Alias for compatibility with other scripts
VehicleCatalog.Build = VehicleCatalog.BuildVehicle
VehicleCatalog.CreateVehicle = VehicleCatalog.BuildVehicle

return VehicleCatalog
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX00000007">
			<Properties>
				<string name="Name">Remotes</string>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX00000017">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX00000009">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">AutomatedSelfTest</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	AutomatedSelfTest.script.luau
	World of Destruction (Roblox) — Version 1.0
	
	Runs an automated diagnostic self-test on server boot in Roblox Studio,
	verifying that:
	1. ReplicatedStorage.Shared modules (GameConfig, Types, Remotes, VehicleCatalog) load cleanly
	2. ReplicatedStorage.Remotes RemoteEvents & RemoteFunctions are active
	3. Workspace.LeoCity world geometry, navigation beacons, destructibles, and vehicles exist
	4. ServerStorage BindableEvents & BindableFunctions are wired
	5. Lighting post-processing & graphics atmosphere effects are active
	6. Player leaderstats, 50-Level Progression, and Monetization services are operational
	
	Prints a clear formatted `=== WORLD OF DESTRUCTION v1.0 DIAGNOSTIC REPORT ===`
	in the Roblox Studio Output window and sets `Workspace:SetAttribute("SelfTestPassed", true)`.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local StarterGui = game:GetService("StarterGui")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

type CheckResult = {
	Category: string,
	Name: string,
	Passed: boolean,
	Details: string,
}

local function runDiagnostics()
	-- Wait briefly for WorldBuilderService, DestructionService, VehicleService, etc. to finish initial boot
	task.wait(2.5)

	local results: { CheckResult } = {}
	local passCount = 0
	local totalCount = 0

	local function recordCheck(category: string, name: string, passed: boolean, details: string)
		totalCount += 1
		if passed then
			passCount += 1
		end
		table.insert(results, {
			Category = category,
			Name = name,
			Passed = passed,
			Details = details,
		})
	end

	-- 1. Verify ReplicatedStorage.Shared Modules
	local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
	recordCheck(
		"SHARED",
		"ReplicatedStorage.Shared Folder",
		sharedFolder ~= nil,
		if sharedFolder then "Found Shared module container" else "Missing ReplicatedStorage.Shared"
	)

	local expectedSharedModules = { "GameConfig", "Types", "Remotes", "VehicleCatalog" }
	for _, modName in ipairs(expectedSharedModules) do
		local mod = if sharedFolder then sharedFolder:FindFirstChild(modName) else nil
		if mod and mod:IsA("ModuleScript") then
			local ok, requiredVal = pcall(require, mod)
			recordCheck(
				"SHARED",
				"Module: " .. modName,
				ok and requiredVal ~= nil,
				if ok then "Loaded cleanly" else ("require() error: " .. tostring(requiredVal))
			)
		else
			recordCheck("SHARED", "Module: " .. modName, false, "ModuleScript not found")
		end
	end

	-- 2. Verify ReplicatedStorage.Remotes
	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	local remoteCount = if remotesFolder then #remotesFolder:GetChildren() else 0
	recordCheck(
		"REMOTES",
		"ReplicatedStorage.Remotes",
		remotesFolder ~= nil and remoteCount >= 6,
		string.format("%d Remote instances registered", remoteCount)
	)

	-- 3. Verify Workspace.LeoCity & Destructibles & Vehicles
	local leoCity = Workspace:FindFirstChild("LeoCity")
	local descCount = if leoCity then #leoCity:GetDescendants() else #Workspace:GetDescendants()
	recordCheck(
		"WORLD",
		"Leo City Map & Geometry",
		descCount > 25,
		string.format("Active (%d world instances)", descCount)
	)

	local beacons = (if leoCity then leoCity:FindFirstChild("CityNavigationBeacons") else nil)
		or Workspace:FindFirstChild("CityNavigationBeacons")
	local beaconCount = if beacons then #beacons:GetChildren() else 0
	recordCheck(
		"WORLD",
		"Landmark Navigation Beacons",
		beaconCount >= 4,
		string.format("%d glowing landmark sky-beacons active", beaconCount)
	)

	-- Count destructible props across Workspace
	local destructibleCount = 0
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:GetAttribute("IsDestructible") == true
			or inst:GetAttribute("Destructible") == true
			or inst:GetAttribute("DestructibleType") ~= nil
			or inst:GetAttribute("MaxHealth") ~= nil
		then
			destructibleCount += 1
		end
	end
	recordCheck(
		"DESTRUCTION",
		"Breakable Props & Landmarks",
		destructibleCount > 0,
		string.format("%d destructible entities tagged in Workspace", destructibleCount)
	)

	-- 4. Verify ServerScriptService & Client Scripts
	local serverScriptsCount = 0
	for _, child in ipairs(ServerScriptService:GetChildren()) do
		if child:IsA("Script") then
			serverScriptsCount += 1
		end
	end
	recordCheck(
		"SERVICES",
		"ServerScriptService Active Scripts",
		serverScriptsCount >= 10,
		string.format("%d server services running", serverScriptsCount)
	)

	local sps = StarterPlayer:FindFirstChild("StarterPlayerScripts")
	local clientScriptsCount = (if sps then #sps:GetChildren() else 0) + #StarterGui:GetChildren()
	recordCheck(
		"CLIENT",
		"StarterPlayerScripts & StarterGui",
		clientScriptsCount >= 5,
		string.format("%d client controllers & UI scripts packaged", clientScriptsCount)
	)

	-- 5. Verify Progression & Monetization Services
	local progRemote = if remotesFolder then remotesFolder:FindFirstChild("GetProgressionTable") else nil
	local monRemote = if remotesFolder then remotesFolder:FindFirstChild("GetMonetizationCatalog") else nil
	recordCheck(
		"PROGRESSION",
		"50-Level Progression System",
		progRemote ~= nil,
		"Lv.1 Street Rookie -> Lv.50 Lord of Destruction active"
	)
	recordCheck(
		"MONETIZATION",
		"Marketplace & Studio Sandbox Mode",
		monRemote ~= nil,
		"5 GamePasses + 5 DevProducts ready for Studio Sandbox testing"
	)

	-- 6. Verify Graphics & Post-Processing
	local hasAtmo = Lighting:FindFirstChildOfClass("Atmosphere") ~= nil
	local hasBloom = Lighting:FindFirstChildOfClass("BloomEffect") ~= nil
	local hasCC = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") ~= nil
	recordCheck(
		"GRAPHICS",
		"Lighting & Post-Processing Pipeline",
		hasAtmo and hasBloom and hasCC,
		"Atmosphere, Bloom, ColorCorrection, SunRays & DepthOfField active"
	)

	-- 7. Verify Connected Players (if running in Play Solo)
	local connectedPlayers = Players:GetPlayers()
	if #connectedPlayers > 0 then
		local p = connectedPlayers[1]
		local ls = p:FindFirstChild("leaderstats")
		local hasLevel = if ls then ls:FindFirstChild("Level") ~= nil else false
		local hasCash = if ls then ls:FindFirstChild("Cash") ~= nil else false
		recordCheck(
			"PLAYER",
			string.format("Player '%s' Leaderstats & Profile", p.Name),
			ls ~= nil and hasLevel and hasCash,
			string.format(
				"Cash=$%s, Level=%s (%s)",
				tostring(p:GetAttribute("Cash") or 500),
				tostring(p:GetAttribute("Level") or 1),
				tostring(p:GetAttribute("RankTitle") or "Street Rookie")
			)
		)
	end

	-- Print Formatted Report to Roblox Studio Output
	local bannerLines = {
		"",
		"======================================================================",
		"===         WORLD OF DESTRUCTION v1.0 DIAGNOSTIC REPORT            ===",
		"======================================================================",
	}
	for _, r in ipairs(results) do
		local statusTag = if r.Passed then "[PASS]" else "[WARN]"
		table.insert(
			bannerLines,
			string.format(" %s [%-12s] %-34s | %s", statusTag, r.Category, r.Name, r.Details)
		)
	end
	table.insert(bannerLines, "----------------------------------------------------------------------")
	table.insert(
		bannerLines,
		string.format(
			" SUMMARY: %d / %d Checks Passed • Version 1.0 Ready to Play!",
			passCount,
			totalCount
		)
	)
	table.insert(bannerLines, " CONTROLS: [V] Summon Car | [WASD] Drive | [Shift] Nitro | [B] Shop | [H] Guide | [M] VIP")
	table.insert(bannerLines, "======================================================================")
	table.insert(bannerLines, "")

	print(table.concat(bannerLines, "\n"))

	Workspace:SetAttribute("SelfTestPassed", passCount == totalCount)
	Workspace:SetAttribute("SelfTestSummary", string.format("%d/%d checks passed", passCount, totalCount))
end

task.spawn(runDiagnostics)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000A">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">AvatarCustomizationService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- AvatarCustomizationService.script.luau
-- Manages player character customization, free/cash/Robux item unlocks, presets, Boutique Kiosk, and 3D character application.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AvatarCatalog = require(Shared:WaitForChild("AvatarCatalog"))

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function ensureRemote(name: string, className: string): Instance
	local existing = remotesFolder:FindFirstChild(name)
	if existing then
		return existing
	end
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotesFolder
	return r
end

local getAvatarWardrobeRF = ensureRemote("GetAvatarWardrobe", "RemoteFunction") :: RemoteFunction
local equipAvatarItemRF = ensureRemote("EquipAvatarItem", "RemoteFunction") :: RemoteFunction
local purchaseAvatarItemRF = ensureRemote("PurchaseAvatarItem", "RemoteFunction") :: RemoteFunction
local applyCharacterPresetRE = ensureRemote("ApplyCharacterPreset", "RemoteEvent") :: RemoteEvent
local avatarUpdatedRE = ensureRemote("AvatarUpdated", "RemoteEvent") :: RemoteEvent
local openAvatarEditorRE = ensureRemote("OpenAvatarEditor", "RemoteEvent") :: RemoteEvent

type PlayerAvatarState = {
	Loadout: AvatarCatalog.AvatarLoadout,
	Unlocked: { [string]: boolean },
	HasCustomized: boolean,
}

local playerStates: { [Player]: PlayerAvatarState } = {}

local function getDefaultUnlocked(): { [string]: boolean }
	local unlocked: { [string]: boolean } = {}
	for id, item in pairs(AvatarCatalog.Items) do
		if item.Currency == "Free" then
			unlocked[id] = true
		end
	end
	return unlocked
end

local function getPlayerCash(player: Player): number
	local attrCash = player:GetAttribute("Cash")
	if typeof(attrCash) == "number" then
		return attrCash
	end
	local ls = player:FindFirstChild("leaderstats")
	local cashVal = ls and ls:FindFirstChild("Cash") :: IntValue?
	if cashVal then
		return cashVal.Value
	end
	return 0
end

local function setPlayerCash(player: Player, newCash: number)
	local clamped = math.max(0, math.floor(newCash))
	player:SetAttribute("Cash", clamped)
	local ls = player:FindFirstChild("leaderstats")
	local cashVal = ls and ls:FindFirstChild("Cash") :: IntValue?
	if cashVal then
		cashVal.Value = clamped
	end
end

local function applyToCharacter(player: Player)
	local state = playerStates[player]
	if not state then return end
	local character = player.Character
	if not character then return end

	AvatarCatalog.ApplyLoadoutToCharacter(character, state.Loadout)
	local perks = AvatarCatalog.ComputePerks(state.Loadout)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = math.floor(16 * perks.SprintMult + 0.5)
		humanoid.UseJumpPower = true
		humanoid.JumpPower = math.floor(50 * perks.SprintMult + 0.5)
	end
end

local function syncStateToPlayer(player: Player)
	local state = playerStates[player]
	if not state then return end

	local perks = AvatarCatalog.ComputePerks(state.Loadout)
	player:SetAttribute("AvatarLoadoutJson", HttpService:JSONEncode(state.Loadout))
	player:SetAttribute("UnlockedAvatarItemsJson", HttpService:JSONEncode(state.Unlocked))
	player:SetAttribute("HasCustomizedCharacter", state.HasCustomized)
	player:SetAttribute("AvatarPerkCashMult", perks.CashMult)
	player:SetAttribute("AvatarPerkXPMult", perks.XPMult)
	player:SetAttribute("AvatarPerkSprintMult", perks.SprintMult)

	applyToCharacter(player)
	avatarUpdatedRE:FireClient(player, {
		Loadout = state.Loadout,
		Unlocked = state.Unlocked,
		Perks = perks,
		HasCustomized = state.HasCustomized,
	})
end

local function initPlayer(player: Player)
	local state: PlayerAvatarState = {
		Loadout = AvatarCatalog.GetDefaultLoadout(),
		Unlocked = getDefaultUnlocked(),
		HasCustomized = false,
	}
	playerStates[player] = state
	syncStateToPlayer(player)

	player.CharacterAdded:Connect(function()
		task.wait(0.15)
		applyToCharacter(player)
	end)
	if player.Character then
		task.spawn(function()
			task.wait(0.15)
			applyToCharacter(player)
		end)
	end
end

local function unlockMegaBundleForPlayer(player: Player)
	local state = playerStates[player]
	if not state then return end
	for id, _ in pairs(AvatarCatalog.Items) do
		state.Unlocked[id] = true
	end
	state.Unlocked[AvatarCatalog.VIPAvatarMegaBundle.Id] = true
	-- Equip Golden VIP signature set automatically on Mega Bundle unlock
	state.Loadout = {
		Outfit = "GoldenSovereignArmor",
		Headgear = "CrownOfDestruction",
		BackAccessory = "ArchangelChaosWings",
		HeldGear = "GoldenWreckingHammer",
		AuraTrail = "SupernovaChaosAura",
		SkinTone = state.Loadout.SkinTone or "SkinWarmTan",
	}
	state.HasCustomized = true
	syncStateToPlayer(player)
end

getAvatarWardrobeRF.OnServerInvoke = function(player: Player)
	local state = playerStates[player]
	if not state then
		initPlayer(player)
		state = playerStates[player]
	end
	return {
		Loadout = state.Loadout,
		Unlocked = state.Unlocked,
		Perks = AvatarCatalog.ComputePerks(state.Loadout),
		HasCustomized = state.HasCustomized,
		Cash = getPlayerCash(player),
	}
end

equipAvatarItemRF.OnServerInvoke = function(player: Player, itemId: any)
	if typeof(itemId) ~= "string" then
		return { Success = false, Message = "Invalid item ID." }
	end
	local state = playerStates[player]
	if not state then
		return { Success = false, Message = "Profile not ready." }
	end
	local item = AvatarCatalog.Items[itemId]
	if not item then
		return { Success = false, Message = "Item not found in catalog." }
	end
	if not state.Unlocked[itemId] and item.Currency ~= "Free" then
		return { Success = false, Message = "Unlock this item first!" }
	end

	state.Unlocked[itemId] = true
	(state.Loadout :: any)[item.Category] = itemId
	state.HasCustomized = true
	syncStateToPlayer(player)
	return {
		Success = true,
		Message = "Equipped " .. item.Name .. "!",
		Loadout = state.Loadout,
		Unlocked = state.Unlocked,
	}
end

purchaseAvatarItemRF.OnServerInvoke = function(player: Player, itemId: any)
	if typeof(itemId) ~= "string" then
		return { Success = false, Message = "Invalid item ID." }
	end
	local state = playerStates[player]
	if not state then
		return { Success = false, Message = "Profile not ready." }
	end

	-- Handle VIP Mega Bundle (599 Robux)
	if itemId == AvatarCatalog.VIPAvatarMegaBundle.Id then
		local bundle = AvatarCatalog.VIPAvatarMegaBundle
		if state.Unlocked[bundle.Id] then
			return { Success = true, Message = "VIP Mega Bundle already owned!" }
		end
		if bundle.ProductId and bundle.ProductId > 0 and not RunService:IsStudio() then
			pcall(function()
				MarketplaceService:PromptProductPurchase(player, bundle.ProductId)
			end)
			return { Success = true, PromptedRobux = true, Message = "Complete Robux purchase in prompt!" }
		end
		-- Studio Sandbox / Placeholder ID immediate unlock so players & testers can enjoy Robux items immediately
		unlockMegaBundleForPlayer(player)
		return {
			Success = true,
			Message = "VIP ALL-ACCESS MEGA BUNDLE UNLOCKED! (Robux Sandbox Grant)",
			Loadout = state.Loadout,
			Unlocked = state.Unlocked,
		}
	end

	local item = AvatarCatalog.Items[itemId]
	if not item then
		return { Success = false, Message = "Unknown item." }
	end

	if state.Unlocked[itemId] or item.Currency == "Free" then
		state.Unlocked[itemId] = true
		;(state.Loadout :: any)[item.Category] = itemId
		state.HasCustomized = true
		syncStateToPlayer(player)
		return {
			Success = true,
			Message = "Equipped " .. item.Name .. "!",
			Loadout = state.Loadout,
			Unlocked = state.Unlocked,
		}
	end

	if item.Currency == "Cash" then
		local cash = getPlayerCash(player)
		if cash < item.Price then
			return {
				Success = false,
				Message = string.format("Need $%d Destruction Cash! (You have $%d)", item.Price, cash),
			}
		end
		setPlayerCash(player, cash - item.Price)
		state.Unlocked[itemId] = true
		;(state.Loadout :: any)[item.Category] = itemId
		state.HasCustomized = true
		syncStateToPlayer(player)
		return {
			Success = true,
			Message = string.format("Purchased & Equipped %s for $%d!", item.Name, item.Price),
			Loadout = state.Loadout,
			Unlocked = state.Unlocked,
		}
	elseif item.Currency == "Robux" then
		if item.ProductId and item.ProductId > 0 and not RunService:IsStudio() then
			pcall(function()
				MarketplaceService:PromptProductPurchase(player, item.ProductId)
			end)
			return { Success = true, PromptedRobux = true, Message = "Complete Robux purchase in prompt!" }
		end
		-- Studio Sandbox / Placeholder ID instant Robux unlock
		state.Unlocked[itemId] = true
		;(state.Loadout :: any)[item.Category] = itemId
		state.HasCustomized = true
		syncStateToPlayer(player)
		return {
			Success = true,
			Message = string.format("UNLOCKED ROBUX ITEM: %s (%d R$ Sandbox Grant)!", item.Name, item.Price),
			Loadout = state.Loadout,
			Unlocked = state.Unlocked,
		}
	end

	return { Success = false, Message = "Purchase failed." }
end

applyCharacterPresetRE.OnServerEvent:Connect(function(player: Player, presetId: any)
	local state = playerStates[player]
	if not state or typeof(presetId) ~= "string" then return end

	if presetId == "MarkCustomized" then
		state.HasCustomized = true
		syncStateToPlayer(player)
		return
	end

	for _, preset in ipairs(AvatarCatalog.Presets) do
		if preset.Id == presetId then
			for category, itemId in pairs(preset.Loadout) do
				local item = AvatarCatalog.Items[itemId]
				if item and (item.Currency == "Free" or state.Unlocked[itemId]) then
					state.Unlocked[itemId] = true
					;(state.Loadout :: any)[category] = itemId
				end
			end
			state.HasCustomized = true
			syncStateToPlayer(player)
			break
		end
	end
end)

-- Spawn Leo City Fashion & Gear Boutique Kiosk near Spawn Plaza
local function buildAvatarBoutiqueKiosk()
	if Workspace:FindFirstChild("LeoAvatarBoutiqueKiosk") then
		return
	end
	local model = Instance.new("Model")
	model.Name = "LeoAvatarBoutiqueKiosk"

	local pad = Instance.new("Part")
	pad.Name = "BoutiquePlatform"
	pad.Size = Vector3.new(12, 0.8, 12)
	pad.Position = Vector3.new(-32, 0.5, 28)
	pad.Anchored = true
	pad.Material = Enum.Material.Neon
	pad.Color = Color3.fromRGB(236, 72, 153)
	pad.Parent = model

	local pedestal = Instance.new("Part")
	pedestal.Name = "BoutiqueKioskTower"
	pedestal.Size = Vector3.new(5, 8, 2.5)
	pedestal.Position = Vector3.new(-32, 4.9, 24)
	pedestal.Anchored = true
	pedestal.Material = Enum.Material.SmoothPlastic
	pedestal.Color = Color3.fromRGB(15, 23, 42)
	pedestal.Parent = model

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(260, 74)
	bb.StudsOffset = Vector3.new(0, 6.2, 0)
	bb.AlwaysOnTop = true
	bb.Parent = pedestal

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 1)
	title.BackgroundColor3 = Color3.fromRGB(15, 23, 42)
	title.BackgroundTransparency = 0.15
	title.TextColor3 = Color3.fromRGB(250, 204, 21)
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.Text = "LEO FASHION & ROBUX GEAR\n[Customize Character]"
	title.Parent = bb
	Instance.new("UICorner", title).CornerRadius = UDim.new(0, 8)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ObjectText = "Leo Fashion & Gear Boutique"
	prompt.ActionText = "Customize Character [C]"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.Parent = pedestal

	prompt.Triggered:Connect(function(player: Player)
		openAvatarEditorRE:FireClient(player)
	end)

	model.Parent = Workspace
end

buildAvatarBoutiqueKiosk()

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(initPlayer, player)
end
Players.PlayerAdded:Connect(initPlayer)
Players.PlayerRemoving:Connect(function(player: Player)
	playerStates[player] = nil
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000B">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">ChaosAndEconomyService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ChaosAndEconomyService.script.luau
	World of Destruction (Roblox)
	
	Core Gameplay Loop, Chaos Combo Tracker, Cash Economy & Live Chaos Missions:
	- Configures Roblox `leaderstats` (`Cash`, `ChaosScore`, `MaxCombo`, `HeatLevel`)
	  and Player Attributes (`Cash`, `ComboCount`, `ComboMultiplier`, `ComboTimer`,
	  `HeatStars`, `HeatProgress`, `CurrentStreakName`).
	- Listens for destruction events, stunt jumps (airtime), drift scores,
	  near-misses, and police takedowns via BindableEvents, RemoteEvents, and
	  character/vehicle attribute signals.
	- Implements the Chaos Combo Tracker:
	  * 4.5s dynamic base combo timer that refreshes on every hit or stunt.
	  * Multiplier tiers: 1x -> 2x -> 3x -> 5x -> 8x -> 10x OVERDRIVE!
	  * Style callouts: "SMASH!", "HYDRO BLAST!", "CHAIN EXPLOSION!",
	    "MEGA AIR!", "DRIFT KING!", "COP TAKEDOWN!", plus "NEAR MISS!" &
	    "10x OVERDRIVE!".
	  * Continuously scales cash & chaos points by (ComboMultiplier * CashMagnetMultiplier * WantedHeatMultiplier)
	    and banks a 25% combo completion bonus when a big combo finishes.
	- Runs cycling Live Chaos Missions / Timed Challenges (e.g.
	  "60s Destruction Derby: Cause $5,000 damage!",
	  "Smash 10 Fire Hydrants!",
	  "Survive 3-Star Heat for 45s!") with automatic rotation and payouts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

--------------------------------------------------------------------------------
-- Constants & Tuning
--------------------------------------------------------------------------------
local COMBO_BASE_WINDOW = 4.5 -- seconds before an active combo finishes & banks bonus
local COMBO_BONUS_RATE = 0.25 -- +25% bonus cash banked when a combo chain >= 3 completes
local MISSION_INTERMISSION = 6.0 -- seconds between timed Live Chaos Missions
local REMOTE_RATE_LIMIT = 0.04 -- anti-spam minimum interval for client stunt reports

-- Multiplier Tiers: 1x -> 2x -> 3x -> 5x -> 8x -> 10x OVERDRIVE!
local MULTIPLIER_TIERS = {
	{ MinChain = 20, Multiplier = 10, IsOverdrive = true, Label = "10x OVERDRIVE!" },
	{ MinChain = 13, Multiplier = 8, IsOverdrive = false, Label = "8x MAYHEM!" },
	{ MinChain = 8, Multiplier = 5, IsOverdrive = false, Label = "5x RAMPAGE!" },
	{ MinChain = 5, Multiplier = 3, IsOverdrive = false, Label = "3x DESTRUCTION!" },
	{ MinChain = 2, Multiplier = 2, IsOverdrive = false, Label = "2x COMBO!" },
	{ MinChain = 0, Multiplier = 1, IsOverdrive = false, Label = "1x" },
}

-- Wanted Heat Risk-Reward Cash Multiplier (mirrors original Swift wantedBountyMultiplier)
local WANTED_BOUNTY_MULTIPLIER: { [number]: number } = {
	[0] = 1.0,
	[1] = 1.25,
	[2] = 1.5,
	[3] = 2.0,
	[4] = 2.5,
	[5] = 3.0,
}

--------------------------------------------------------------------------------
-- Live Chaos Missions / Timed Challenges Catalog
--------------------------------------------------------------------------------
export type MissionDefinition = {
	Id: string,
	Title: string,
	Description: string,
	Duration: number,
	Goal: number,
	RewardCash: number,
	RewardChaos: number,
	Kind: "DamageValue" | "Hydrants" | "SurviveHeat" | "ComboMultiplier" | "Airtime" | "DriftScore" | "CopTakedowns" | "PropsCount",
	RequiredHeatStars: number?,
}

local LIVE_CHAOS_MISSIONS: { MissionDefinition } = {
	{
		Id = "destruction_derby_5k",
		Title = "60s Destruction Derby: Cause $5,000 damage!",
		Description = "Smash props, cars, and structures to rack up $5,000 in chaos value within 60s!",
		Duration = 60,
		Goal = 5000,
		RewardCash = 1200,
		RewardChaos = 2500,
		Kind = "DamageValue",
	},
	{
		Id = "smash_10_hydrants",
		Title = "Smash 10 Fire Hydrants!",
		Description = "Blast through 10 Fire Hydrants or street water mains for HYDRO BLAST bonuses!",
		Duration = 60,
		Goal = 10,
		RewardCash = 1000,
		RewardChaos = 2000,
		Kind = "Hydrants",
	},
	{
		Id = "survive_3star_heat",
		Title = "Survive 3-Star Heat for 45s!",
		Description = "Keep at least 3-Star Police Heat and evade getting BUSTED for 45 seconds!",
		Duration = 75,
		Goal = 45,
		RewardCash = 1500,
		RewardChaos = 3000,
		Kind = "SurviveHeat",
		RequiredHeatStars = 3,
	},
	{
		Id = "overdrive_combo",
		Title = "Reach 8x Combo Multiplier!",
		Description = "Chain hits, drifts, and jumps without letting your 4.5s combo timer expire!",
		Duration = 50,
		Goal = 8,
		RewardCash = 900,
		RewardChaos = 1800,
		Kind = "ComboMultiplier",
	},
	{
		Id = "cop_takedown_spree",
		Title = "Wreck 3 Police Cruisers!",
		Description = "Ram pursuing Police units at high speed for COP TAKEDOWN bonuses!",
		Duration = 65,
		Goal = 3,
		RewardCash = 1350,
		RewardChaos = 2700,
		Kind = "CopTakedowns",
	},
	{
		Id = "drift_and_air_challenge",
		Title = "Score 1,500 Drift & Stunt Points!",
		Description = "Slide around city corners and launch off stunt ramps for MEGA AIR & DRIFT KING!",
		Duration = 55,
		Goal = 1500,
		RewardCash = 950,
		RewardChaos = 1900,
		Kind = "DriftScore",
	},
}

--------------------------------------------------------------------------------
-- Shared Infrastructure Helpers (Bindables & Remotes)
--------------------------------------------------------------------------------
local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function ensureBindableEvent(parent: Instance, name: string): BindableEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BindableEvent") then
		return existing
	end
	local ev = Instance.new("BindableEvent")
	ev.Name = name
	ev.Parent = parent
	return ev
end

local function ensureBindableFunction(parent: Instance, name: string): BindableFunction
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BindableFunction") then
		return existing
	end
	local fn = Instance.new("BindableFunction")
	fn.Name = name
	fn.Parent = parent
	return fn
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = parent
	return re
end

local serverEventsFolder = ensureFolder(ServerStorage, "Events")
local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")

-- ServerStorage BindableEvents & BindableFunctions
local DestructionBindable = ensureBindableEvent(ServerStorage, "DestructionEvent")
local OnObjectDestroyedBindable = ensureBindableEvent(ServerStorage, "OnObjectDestroyed")
local StuntBindable = ensureBindableEvent(ServerStorage, "StuntEvent")
local PoliceTakedownBindable = ensureBindableEvent(ServerStorage, "PoliceTakedownEvent")
local AddCashBindable = ensureBindableEvent(ServerStorage, "AddCashEvent")
local SpendCashFunction = ensureBindableFunction(ServerStorage, "SpendCashFunction")
local AddHeatBindable = ensureBindableEvent(ServerStorage, "AddHeatEvent")
local PlayerBustedBindable = ensureBindableEvent(ServerStorage, "PlayerBustedEvent")
local UpdatePlayerDataBindable = ensureBindableEvent(ServerStorage, "UpdatePlayerDataEvent")

-- Mirror in ServerStorage.Events for scripts expecting subfolder hierarchy
local FolderDestructionBindable = ensureBindableEvent(serverEventsFolder, "DestructionEvent")
local FolderStuntBindable = ensureBindableEvent(serverEventsFolder, "StuntEvent")
local FolderPoliceTakedownBindable = ensureBindableEvent(serverEventsFolder, "PoliceTakedownEvent")
local FolderAddCashBindable = ensureBindableEvent(serverEventsFolder, "AddCashEvent")
local FolderAddHeatBindable = ensureBindableEvent(serverEventsFolder, "AddHeatEvent")
local FolderPlayerBustedBindable = ensureBindableEvent(serverEventsFolder, "PlayerBustedEvent")

-- ReplicatedStorage RemoteEvents (both in ReplicatedStorage.Remotes and root ReplicatedStorage)
local ReportDestructionRemote = ensureRemoteEvent(remotesFolder, "ReportDestruction")
local ReportStuntRemote = ensureRemoteEvent(remotesFolder, "ReportStunt")
local StyleCalloutRemote = ensureRemoteEvent(remotesFolder, "StyleCallout")
local ComboCompletedRemote = ensureRemoteEvent(remotesFolder, "ComboCompleted")
local MissionUpdateRemote = ensureRemoteEvent(remotesFolder, "MissionUpdate")
local SkipMissionRemote = ensureRemoteEvent(remotesFolder, "SkipMission")

-- Root aliases in ReplicatedStorage for broad compatibility
local RootDestructionRemote = ensureRemoteEvent(ReplicatedStorage, "DestructionEvent")
local RootStuntRemote = ensureRemoteEvent(ReplicatedStorage, "StuntEvent")
local RootStyleCalloutRemote = ensureRemoteEvent(ReplicatedStorage, "StyleCalloutEvent")
local RootMissionUpdateRemote = ensureRemoteEvent(ReplicatedStorage, "MissionUpdateEvent")

--------------------------------------------------------------------------------
-- Per-Player Runtime State
--------------------------------------------------------------------------------
type PlayerChaosState = {
	ComboCount: number,
	ComboMultiplier: number,
	ComboTimer: number,
	UnbankedComboCash: number,
	CurrentStreakName: string,
	MissionIndex: number,
	MissionProgress: number,
	MissionTimeRemaining: number,
	MissionIntermission: number,
	HeatSurvivalAccumulator: number,
	LastClientReportAt: number,
}

local playerStates: { [number]: PlayerChaosState } = {}

local function getMagnetMultiplier(player: Player): number
	local attrMult = player:GetAttribute("CashMagnetMultiplier")
	if type(attrMult) == "number" and attrMult >= 1 then
		return attrMult
	end
	local magnetLvl = tonumber(player:GetAttribute("Upgrade_Magnet") or player:GetAttribute("MagnetLevel")) or 1
	-- Level 1 = 1.0x, Level 2 = 1.15x, Level 3 = 1.35x, Level 4 = 1.60x, Level 5 = 2.0x
	local tableMult = { 1.0, 1.15, 1.35, 1.60, 2.0 }
	return tableMult[math.clamp(math.floor(magnetLvl), 1, 5)] or 1.0
end

local function getWantedMultiplier(player: Player): number
	local stars = math.clamp(math.floor(tonumber(player:GetAttribute("HeatStars")) or 0), 0, 5)
	return WANTED_BOUNTY_MULTIPLIER[stars] or 1.0
end

local function computeMultiplierTier(chain: number): (number, boolean, string)
	for _, tier in ipairs(MULTIPLIER_TIERS) do
		if chain >= tier.MinChain then
			return tier.Multiplier, tier.IsOverdrive, tier.Label
		end
	end
	return 1, false, "1x"
end

--------------------------------------------------------------------------------
-- Leaderstats & Attributes Setup
--------------------------------------------------------------------------------
local function ensurePlayerSetup(player: Player): Folder
	local ls = player:FindFirstChild("leaderstats")
	if not (ls and ls:IsA("Folder")) then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end

	local function ensureIntValue(name: string, defaultValue: number): IntValue
		local existing = ls:FindFirstChild(name)
		if existing and existing:IsA("IntValue") then
			return existing
		end
		local iv = Instance.new("IntValue")
		iv.Name = name
		iv.Value = defaultValue
		iv.Parent = ls
		return iv
	end

	local initialCash = tonumber(player:GetAttribute("Cash")) or 500
	local initialChaos = tonumber(player:GetAttribute("ChaosScore")) or 0
	local initialMaxCombo = tonumber(player:GetAttribute("MaxCombo")) or 0
	local initialHeat = tonumber(player:GetAttribute("HeatStars")) or 0

	ensureIntValue("Cash", initialCash)
	ensureIntValue("ChaosScore", initialChaos)
	ensureIntValue("MaxCombo", initialMaxCombo)
	ensureIntValue("HeatLevel", initialHeat)

	-- Required Player Attributes
	if player:GetAttribute("Cash") == nil then
		player:SetAttribute("Cash", initialCash)
	end
	if player:GetAttribute("ChaosScore") == nil then
		player:SetAttribute("ChaosScore", initialChaos)
	end
	if player:GetAttribute("MaxCombo") == nil then
		player:SetAttribute("MaxCombo", initialMaxCombo)
	end
	player:SetAttribute("ComboCount", 0)
	player:SetAttribute("ComboMultiplier", 1)
	player:SetAttribute("ComboTimer", 0)
	player:SetAttribute("ComboTimerRatio", 0)
	player:SetAttribute("ComboMaxTime", COMBO_BASE_WINDOW)
	if player:GetAttribute("HeatStars") == nil then
		player:SetAttribute("HeatStars", 0)
	end
	if player:GetAttribute("HeatProgress") == nil then
		player:SetAttribute("HeatProgress", 0)
	end
	player:SetAttribute("CurrentStreakName", "")
	player:SetAttribute("UnbankedComboCash", 0)

	return ls
end

--------------------------------------------------------------------------------
-- Economy Helpers (Cash & ChaosScore)
--------------------------------------------------------------------------------
local function addCash(player: Player, amount: number, reason: string?): number
	local delta = math.floor(amount)
	if delta <= 0 then
		return tonumber(player:GetAttribute("Cash")) or 0
	end

	local current = math.max(0, math.floor(tonumber(player:GetAttribute("Cash")) or 0))
	local newCash = current + delta
	player:SetAttribute("Cash", newCash)

	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local cashVal = ls:FindFirstChild("Cash") :: IntValue?
		if cashVal then
			cashVal.Value = newCash
		end
	end

	return newCash
end

local function debitCash(player: Player, amount: number, _reason: string?): boolean
	local cost = math.floor(amount)
	if cost <= 0 then
		return true
	end
	local current = math.max(0, math.floor(tonumber(player:GetAttribute("Cash")) or 0))
	if current < cost then
		return false
	end

	local newCash = current - cost
	player:SetAttribute("Cash", newCash)

	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local cashVal = ls:FindFirstChild("Cash") :: IntValue?
		if cashVal then
			cashVal.Value = newCash
		end
	end

	return true
end

local function addChaosScore(player: Player, points: number)
	local delta = math.floor(points)
	if delta <= 0 then
		return
	end
	local current = math.max(0, math.floor(tonumber(player:GetAttribute("ChaosScore")) or 0))
	local newScore = current + delta
	player:SetAttribute("ChaosScore", newScore)

	local highScore = math.max(0, math.floor(tonumber(player:GetAttribute("HighScore")) or 0))
	if newScore > highScore then
		player:SetAttribute("HighScore", newScore)
	end

	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local chaosVal = ls:FindFirstChild("ChaosScore") :: IntValue?
		if chaosVal then
			chaosVal.Value = newScore
		end
	end
end

--------------------------------------------------------------------------------
-- Live Chaos Missions Management
--------------------------------------------------------------------------------
local function getActiveMissionDef(state: PlayerChaosState): MissionDefinition
	local idx = ((state.MissionIndex - 1) % #LIVE_CHAOS_MISSIONS) + 1
	return LIVE_CHAOS_MISSIONS[idx]
end

local function syncMissionToPlayer(player: Player, state: PlayerChaosState, status: string?)
	local def = getActiveMissionDef(state)
	player:SetAttribute("MissionId", def.Id)
	player:SetAttribute("MissionTitle", def.Title)
	player:SetAttribute("MissionDescription", def.Description)
	player:SetAttribute("MissionProgress", math.min(def.Goal, math.floor(state.MissionProgress)))
	player:SetAttribute("MissionGoal", def.Goal)
	player:SetAttribute("MissionTimeRemaining", math.max(0, math.ceil(state.MissionTimeRemaining)))
	player:SetAttribute("MissionReward", def.RewardCash)

	local payload = {
		Id = def.Id,
		Title = def.Title,
		Description = def.Description,
		Progress = math.min(def.Goal, math.floor(state.MissionProgress)),
		Goal = def.Goal,
		TimeRemaining = math.max(0, math.ceil(state.MissionTimeRemaining)),
		RewardCash = def.RewardCash,
		RewardChaos = def.RewardChaos,
		Status = status or "Active",
	}
	MissionUpdateRemote:FireClient(player, payload)
	RootMissionUpdateRemote:FireClient(player, payload)
end

local function startMission(player: Player, state: PlayerChaosState, missionIndex: number)
	state.MissionIndex = missionIndex
	state.MissionProgress = 0
	state.MissionIntermission = 0
	state.HeatSurvivalAccumulator = 0
	local def = getActiveMissionDef(state)
	state.MissionTimeRemaining = def.Duration
	syncMissionToPlayer(player, state, "Started")
end

local function advanceMissionProgress(player: Player, kind: string, amount: number)
	local state = playerStates[player.UserId]
	if not state or state.MissionIntermission > 0 or state.MissionTimeRemaining <= 0 then
		return
	end

	local def = getActiveMissionDef(state)
	if def.Kind ~= kind then
		return
	end

	if kind == "ComboMultiplier" then
		state.MissionProgress = math.max(state.MissionProgress, amount)
	else
		state.MissionProgress = math.min(def.Goal, state.MissionProgress + amount)
	end

	if state.MissionProgress >= def.Goal then
		-- Mission Complete!
		local magnetMult = getMagnetMultiplier(player)
		local finalCash = math.floor(def.RewardCash * magnetMult)
		local finalChaos = math.floor(def.RewardChaos * magnetMult)

		addCash(player, finalCash, "MissionComplete:" .. def.Id)
		addChaosScore(player, finalChaos)

		local completedCount = (tonumber(player:GetAttribute("MissionsCompleted")) or 0) + 1
		player:SetAttribute("MissionsCompleted", completedCount)

		state.MissionProgress = def.Goal
		state.MissionIntermission = MISSION_INTERMISSION
		syncMissionToPlayer(player, state, "Completed")

		StyleCalloutRemote:FireClient(player, {
			Callout = string.format("CHALLENGE COMPLETE! +$%d", finalCash),
			Multiplier = state.ComboMultiplier,
			ComboCount = state.ComboCount,
			CashAwarded = finalCash,
			ChaosAwarded = finalChaos,
			IsMissionBanner = true,
		})
	else
		syncMissionToPlayer(player, state, "Active")
	end
end

--------------------------------------------------------------------------------
-- Chaos Combo Tracker & Style Callouts
--------------------------------------------------------------------------------
local function resolveDestructionCallout(objectType: string, isChainExplosion: boolean?, multiplier: number): string
	local upper = string.upper(objectType)
	if isChainExplosion or string.find(upper, "EXPLOS") or string.find(upper, "TANK") or string.find(upper, "BARREL") or string.find(upper, "GAS") then
		return "CHAIN EXPLOSION!"
	elseif string.find(upper, "HYDRANT") or string.find(upper, "WATER") or string.find(upper, "FOUNTAIN") or string.find(upper, "HYDRO") then
		return "HYDRO BLAST!"
	elseif string.find(upper, "POLICE") or string.find(upper, "COP") or string.find(upper, "CRUISER") or string.find(upper, "SWAT") or string.find(upper, "INTERCEPTOR") then
		return "COP TAKEDOWN!"
	elseif multiplier >= 10 then
		return "10x OVERDRIVE!"
	else
		return "SMASH!"
	end
end

local function syncComboAttributes(player: Player, state: PlayerChaosState)
	player:SetAttribute("ComboCount", state.ComboCount)
	player:SetAttribute("ComboMultiplier", state.ComboMultiplier)
	player:SetAttribute("ComboTimer", tonumber(string.format("%.2f", state.ComboTimer)))
	player:SetAttribute("ComboTimerRatio", math.clamp(state.ComboTimer / COMBO_BASE_WINDOW, 0, 1))
	player:SetAttribute("CurrentStreakName", state.CurrentStreakName)
	player:SetAttribute("UnbankedComboCash", state.UnbankedComboCash)

	local maxCombo = math.max(0, math.floor(tonumber(player:GetAttribute("MaxCombo")) or 0))
	if state.ComboCount > maxCombo then
		player:SetAttribute("MaxCombo", state.ComboCount)
		local ls = player:FindFirstChild("leaderstats")
		if ls then
			local mcVal = ls:FindFirstChild("MaxCombo") :: IntValue?
			if mcVal then
				mcVal.Value = state.ComboCount
			end
		end
	end
end

local function registerComboAction(
	player: Player,
	baseCash: number,
	baseChaos: number,
	styleCallout: string,
	heatDelta: number,
	worldPosition: Vector3?
): (number, number)
	local state = playerStates[player.UserId]
	if not state then
		return 0, 0
	end

	-- Advance chain and refresh 4.5s dynamic combo timer
	state.ComboCount += 1
	state.ComboTimer = COMBO_BASE_WINDOW

	local mult, isOverdrive, _tierLabel = computeMultiplierTier(state.ComboCount)
	state.ComboMultiplier = mult

	-- Upgrade callout to 10x OVERDRIVE! on exact threshold crossing
	local finalCallout = styleCallout
	if isOverdrive and state.ComboCount == 20 then
		finalCallout = "10x OVERDRIVE!"
	end
	state.CurrentStreakName = finalCallout

	-- Scale reward by ComboMultiplier * CashMagnetMultiplier * WantedHeatMultiplier
	local magnetMult = getMagnetMultiplier(player)
	local wantedMult = getWantedMultiplier(player)
	local totalScalar = mult * magnetMult * wantedMult

	local awardedCash = math.max(1, math.floor(baseCash * totalScalar))
	local awardedChaos = math.max(5, math.floor(baseChaos * totalScalar))

	-- Continuously credit cash & chaos score AND accumulate unbanked combo bonus pool
	addCash(player, awardedCash, finalCallout)
	addChaosScore(player, awardedChaos)
	state.UnbankedComboCash += awardedCash

	syncComboAttributes(player, state)

	-- Advance active missions that track damage dollar value or combo multiplier
	advanceMissionProgress(player, "DamageValue", awardedCash * 15)
	advanceMissionProgress(player, "ComboMultiplier", state.ComboMultiplier)

	-- Broadcast Heat increase to PoliceHeatService
	if heatDelta > 0 then
		AddHeatBindable:Fire(player, heatDelta, finalCallout, worldPosition)
		FolderAddHeatBindable:Fire(player, heatDelta, finalCallout, worldPosition)
	end

	-- Fire Style Callout to Client HUD
	local payload = {
		Callout = finalCallout,
		Multiplier = state.ComboMultiplier,
		IsOverdrive = isOverdrive,
		ComboCount = state.ComboCount,
		ComboTimer = state.ComboTimer,
		CashAwarded = awardedCash,
		ChaosAwarded = awardedChaos,
		Position = worldPosition,
	}
	StyleCalloutRemote:FireClient(player, payload)
	RootStyleCalloutRemote:FireClient(player, payload)

	return awardedCash, awardedChaos
end

local function finishAndBankCombo(player: Player, state: PlayerChaosState)
	local completedChain = state.ComboCount
	local comboEarned = state.UnbankedComboCash

	local bankedBonus = 0
	if completedChain >= 3 and comboEarned > 0 then
		local magnetMult = getMagnetMultiplier(player)
		bankedBonus = math.max(10, math.floor(comboEarned * COMBO_BONUS_RATE * magnetMult))
		addCash(player, bankedBonus, "ComboBankBonus")
		addChaosScore(player, bankedBonus * 2)
	end

	state.ComboCount = 0
	state.ComboMultiplier = 1
	state.ComboTimer = 0
	state.UnbankedComboCash = 0
	state.CurrentStreakName = ""
	syncComboAttributes(player, state)

	if completedChain >= 2 then
		ComboCompletedRemote:FireClient(player, {
			CompletedChain = completedChain,
			BankedBonusCash = bankedBonus,
			TotalComboCash = comboEarned + bankedBonus,
		})
	end
end

--------------------------------------------------------------------------------
-- Event Handlers: Destruction, Stunts (Air/Drift/Near-Miss), Cop Takedowns
--------------------------------------------------------------------------------
local function handleDestructionEvent(
	playerOrPayload: any,
	objectTypeOrInfo: any,
	baseCashReward: number?,
	worldPos: Vector3?,
	extraMeta: { [string]: any }?
)
	local player: Player = playerOrPayload
	if type(playerOrPayload) == "table" and objectTypeOrInfo == nil then
		player = playerOrPayload.player or playerOrPayload.Player
		objectTypeOrInfo = playerOrPayload
		baseCashReward = tonumber(playerOrPayload.cashEarned or playerOrPayload.CashReward)
		worldPos = playerOrPayload.position or playerOrPayload.Position
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end

	local objectType = "Prop"
	local baseCash = tonumber(baseCashReward) or 25
	local pos = if typeof(worldPos) == "Vector3" then worldPos else nil
	local isChainExplosion = false
	local heatGenerated = 8 -- base heat progress points (0..100 per star)

	if type(objectTypeOrInfo) == "table" then
		objectType = tostring(objectTypeOrInfo.Type or objectTypeOrInfo.propType or objectTypeOrInfo.Category or objectTypeOrInfo.Name or "Prop")
		baseCash = tonumber(objectTypeOrInfo.CashReward or objectTypeOrInfo.cashEarned or objectTypeOrInfo.CoinReward or objectTypeOrInfo.Value) or baseCash
		if typeof(objectTypeOrInfo.Position) == "Vector3" then
			pos = objectTypeOrInfo.Position
		elseif typeof(objectTypeOrInfo.position) == "Vector3" then
			pos = objectTypeOrInfo.position
		end
		isChainExplosion = objectTypeOrInfo.IsExplosion == true or objectTypeOrInfo.isExplosion == true or objectTypeOrInfo.ChainExplosion == true
		if type(objectTypeOrInfo.Heat) == "number" then
			heatGenerated = objectTypeOrInfo.Heat
		end
	elseif type(objectTypeOrInfo) == "string" then
		objectType = objectTypeOrInfo
	elseif typeof(objectTypeOrInfo) == "Instance" then
		objectType = objectTypeOrInfo:GetAttribute("DestructibleType")
			or objectTypeOrInfo:GetAttribute("Category")
			or objectTypeOrInfo.Name
		baseCash = tonumber(objectTypeOrInfo:GetAttribute("CashReward") or objectTypeOrInfo:GetAttribute("CoinReward")) or baseCash
		if objectTypeOrInfo:IsA("BasePart") then
			pos = objectTypeOrInfo.Position
		elseif objectTypeOrInfo:IsA("Model") and objectTypeOrInfo.PrimaryPart then
			pos = objectTypeOrInfo.PrimaryPart.Position
		end
	end

	if extraMeta and type(extraMeta) == "table" then
		if extraMeta.IsChainExplosion or extraMeta.IsExplosion then
			isChainExplosion = true
		end
	end

	baseCash = math.clamp(math.floor(baseCash), 5, 2500)
	local baseChaos = baseCash * 3

	local state = playerStates[player.UserId]
	local nextMult = if state then select(1, computeMultiplierTier(state.ComboCount + 1)) else 1
	local callout = resolveDestructionCallout(objectType, isChainExplosion, nextMult)

	if callout == "CHAIN EXPLOSION!" then
		baseCash = math.floor(baseCash * 1.6)
		baseChaos = math.floor(baseChaos * 1.8)
		heatGenerated = math.max(heatGenerated, 18)
	elseif callout == "HYDRO BLAST!" then
		baseCash = math.floor(baseCash * 1.35)
		baseChaos = math.floor(baseChaos * 1.4)
		heatGenerated = math.max(heatGenerated, 12)
		advanceMissionProgress(player, "Hydrants", 1)
	elseif callout == "COP TAKEDOWN!" then
		baseCash = math.max(baseCash, 150)
		baseChaos = math.max(baseChaos, 500)
		heatGenerated = math.max(heatGenerated, 25)
		advanceMissionProgress(player, "CopTakedowns", 1)
	end

	local totalDest = (tonumber(player:GetAttribute("TotalDestructions")) or 0) + 1
	player:SetAttribute("TotalDestructions", totalDest)
	advanceMissionProgress(player, "PropsCount", 1)

	registerComboAction(player, baseCash, baseChaos, callout, heatGenerated, pos)
end

local function handleStuntEvent(player: Player, stuntType: string, rawValue: number?, worldPos: Vector3?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local kind = string.upper(tostring(stuntType or "STUNT"))
	local val = math.max(0.1, tonumber(rawValue) or 1.0)
	local pos = if typeof(worldPos) == "Vector3" then worldPos else nil

	if string.find(kind, "AIR") or string.find(kind, "JUMP") then
		-- Airtime jump (val = seconds in air or height)
		local clampedAir = math.clamp(val, 0.4, 12.0)
		local baseCash = math.floor(35 * clampedAir)
		local baseChaos = math.floor(120 * clampedAir)
		registerComboAction(player, baseCash, baseChaos, "MEGA AIR!", 4, pos)
		advanceMissionProgress(player, "DriftScore", baseChaos)
		advanceMissionProgress(player, "Airtime", math.ceil(clampedAir))
	elseif string.find(kind, "DRIFT") then
		-- Drift score (val = drift duration seconds or drift score points)
		local normalized = if val > 25 then math.clamp(val / 100, 0.5, 10) else math.clamp(val, 0.5, 10)
		local baseCash = math.floor(30 * normalized)
		local baseChaos = math.floor(110 * normalized)
		registerComboAction(player, baseCash, baseChaos, "DRIFT KING!", 3, pos)
		advanceMissionProgress(player, "DriftScore", baseChaos)
	elseif string.find(kind, "NEAR") or string.find(kind, "MISS") then
		-- High-speed traffic/police near-miss
		local baseCash = 40
		local baseChaos = 125
		registerComboAction(player, baseCash, baseChaos, "NEAR MISS!", 2, pos)
		advanceMissionProgress(player, "DriftScore", baseChaos)
	end
end

local function handlePoliceTakedown(player: Player, unitType: string?, worldPos: Vector3?, customBonusCash: number?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local unit = tostring(unitType or "Patrol Cruiser")
	local baseCash = math.clamp(tonumber(customBonusCash) or 175, 100, 1000)
	local baseChaos = baseCash * 4
	local pos = if typeof(worldPos) == "Vector3" then worldPos else nil

	local takedowns = (tonumber(player:GetAttribute("CopTakedowns")) or 0) + 1
	player:SetAttribute("CopTakedowns", takedowns)

	advanceMissionProgress(player, "CopTakedowns", 1)
	registerComboAction(player, baseCash, baseChaos, "COP TAKEDOWN!", 22, pos)

	-- Persist milestone update
	UpdatePlayerDataBindable:Fire(player, {
		CopTakedowns = takedowns,
	})
	local _ = unit
end

--------------------------------------------------------------------------------
-- Wire BindableEvents & RemoteEvents
--------------------------------------------------------------------------------
DestructionBindable.Event:Connect(handleDestructionEvent)
OnObjectDestroyedBindable.Event:Connect(handleDestructionEvent)
FolderDestructionBindable.Event:Connect(handleDestructionEvent)

local serverEventsAlt = ensureFolder(ServerStorage, "ServerEvents")
local altDestructionBindable = ensureBindableEvent(serverEventsAlt, "DestructionOccurred")
altDestructionBindable.Event:Connect(handleDestructionEvent)

StuntBindable.Event:Connect(handleStuntEvent)
FolderStuntBindable.Event:Connect(handleStuntEvent)

PoliceTakedownBindable.Event:Connect(handlePoliceTakedown)
FolderPoliceTakedownBindable.Event:Connect(handlePoliceTakedown)

AddCashBindable.Event:Connect(function(player: Player, amount: number, reason: string?)
	if typeof(player) == "Instance" and player:IsA("Player") then
		addCash(player, tonumber(amount) or 0, reason)
	end
end)
FolderAddCashBindable.Event:Connect(function(player: Player, amount: number, reason: string?)
	if typeof(player) == "Instance" and player:IsA("Player") then
		addCash(player, tonumber(amount) or 0, reason)
	end
end)

SpendCashFunction.OnInvoke = function(player: Player, amount: number, reason: string?): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end
	return debitCash(player, tonumber(amount) or 0, reason)
end

-- Handle "BUSTED!" penalty from PoliceHeatService:
-- Confiscates a small % of unbanked combo cash (plus a small capped fine if no combo is active)
local function onPlayerBusted(player: Player, penaltyOverride: number?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local state = playerStates[player.UserId]
	local confiscated = 0

	if state then
		if state.UnbankedComboCash > 0 then
			-- Confiscate 30% of unbanked combo cash
			confiscated = math.max(10, math.floor(state.UnbankedComboCash * 0.30))
		else
			-- Small 8% wallet fine capped at $150
			local currentCash = tonumber(player:GetAttribute("Cash")) or 0
			confiscated = math.min(150, math.floor(currentCash * 0.08))
		end

		if type(penaltyOverride) == "number" and penaltyOverride > 0 then
			confiscated = math.floor(penaltyOverride)
		end

		if confiscated > 0 then
			debitCash(player, confiscated, "BustedPenalty")
		end

		-- Reset active combo without banking bonus
		state.ComboCount = 0
		state.ComboMultiplier = 1
		state.ComboTimer = 0
		state.UnbankedComboCash = 0
		state.CurrentStreakName = "BUSTED!"
		syncComboAttributes(player, state)
	end
end

PlayerBustedBindable.Event:Connect(onPlayerBusted)
FolderPlayerBustedBindable.Event:Connect(onPlayerBusted)

-- Client Remote listeners (with basic rate limiting & validation)
local function onClientDestructionReport(player: Player, objectTypeOrInfo: any, baseCash: any, worldPos: any, extraMeta: any)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.LastClientReportAt < REMOTE_RATE_LIMIT then
		return
	end
	state.LastClientReportAt = now
	local clampedCash = math.clamp(tonumber(baseCash) or 25, 5, 400)
	handleDestructionEvent(player, objectTypeOrInfo, clampedCash, worldPos, extraMeta)
end

ReportDestructionRemote.OnServerEvent:Connect(onClientDestructionReport)
RootDestructionRemote.OnServerEvent:Connect(onClientDestructionReport)

local function onClientStuntReport(player: Player, stuntType: any, value: any, worldPos: any)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.LastClientReportAt < REMOTE_RATE_LIMIT then
		return
	end
	state.LastClientReportAt = now
	handleStuntEvent(player, tostring(stuntType or "Jump"), tonumber(value) or 1, worldPos)
end

ReportStuntRemote.OnServerEvent:Connect(onClientStuntReport)
RootStuntRemote.OnServerEvent:Connect(onClientStuntReport)

SkipMissionRemote.OnServerEvent:Connect(function(player: Player)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	startMission(player, state, state.MissionIndex + 1)
end)

--------------------------------------------------------------------------------
-- Player Lifecycle & HeatLevel Leaderstat Mirroring
--------------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local ls = ensurePlayerSetup(player)
	local state: PlayerChaosState = {
		ComboCount = 0,
		ComboMultiplier = 1,
		ComboTimer = 0,
		UnbankedComboCash = 0,
		CurrentStreakName = "",
		MissionIndex = 1,
		MissionProgress = 0,
		MissionTimeRemaining = LIVE_CHAOS_MISSIONS[1].Duration,
		MissionIntermission = 0,
		HeatSurvivalAccumulator = 0,
		LastClientReportAt = 0,
	}
	playerStates[player.UserId] = state

	-- Mirror HeatStars attribute to leaderstats.HeatLevel automatically
	player:GetAttributeChangedSignal("HeatStars"):Connect(function()
		local stars = math.clamp(math.floor(tonumber(player:GetAttribute("HeatStars")) or 0), 0, 5)
		local heatVal = ls:FindFirstChild("HeatLevel") :: IntValue?
		if heatVal then
			heatVal.Value = stars
		end
	end)

	-- Start first Live Chaos Mission shortly after join
	task.delay(1.5, function()
		if player.Parent and playerStates[player.UserId] == state then
			startMission(player, state, 1)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	playerStates[player.UserId] = nil
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

--------------------------------------------------------------------------------
-- Main Heartbeat Loop: Dynamic Combo Timer & Live Chaos Mission Cycling
--------------------------------------------------------------------------------
local missionSyncAccumulator = 0

RunService.Heartbeat:Connect(function(dt: number)
	missionSyncAccumulator += dt
	local shouldBroadcastMission = missionSyncAccumulator >= 1.0
	if shouldBroadcastMission then
		missionSyncAccumulator = 0
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local state = playerStates[player.UserId]
		if not state then
			continue
		end

		-- 1. Tick dynamic 4.5s Chaos Combo timer
		if state.ComboCount > 0 and state.ComboTimer > 0 then
			state.ComboTimer = math.max(0, state.ComboTimer - dt)
			player:SetAttribute("ComboTimer", tonumber(string.format("%.2f", state.ComboTimer)))
			player:SetAttribute("ComboTimerRatio", math.clamp(state.ComboTimer / COMBO_BASE_WINDOW, 0, 1))

			if state.ComboTimer <= 0 then
				finishAndBankCombo(player, state)
			end
		end

		-- 2. Tick Live Chaos Mission / Timed Challenge
		if state.MissionIntermission > 0 then
			state.MissionIntermission = math.max(0, state.MissionIntermission - dt)
			if state.MissionIntermission <= 0 then
				startMission(player, state, state.MissionIndex + 1)
			end
		elseif state.MissionTimeRemaining > 0 then
			state.MissionTimeRemaining = math.max(0, state.MissionTimeRemaining - dt)

			-- Check "Survive 3-Star Heat for 45s!" mission type
			local def = getActiveMissionDef(state)
			if def.Kind == "SurviveHeat" then
				local reqStars = def.RequiredHeatStars or 3
				local currentStars = tonumber(player:GetAttribute("HeatStars")) or 0
				local isBusted = player:GetAttribute("IsBusted") == true
				if currentStars >= reqStars and not isBusted then
					state.HeatSurvivalAccumulator += dt
					if state.HeatSurvivalAccumulator >= 1.0 then
						local wholeSeconds = math.floor(state.HeatSurvivalAccumulator)
						state.HeatSurvivalAccumulator -= wholeSeconds
						advanceMissionProgress(player, "SurviveHeat", wholeSeconds)
					end
				end
			end

			if state.MissionTimeRemaining <= 0 and state.MissionIntermission <= 0 then
				-- Mission timer expired; rotate to next mission after short intermission
				state.MissionIntermission = MISSION_INTERMISSION * 0.65
				syncMissionToPlayer(player, state, "Expired")
			elseif shouldBroadcastMission then
				player:SetAttribute("MissionTimeRemaining", math.max(0, math.ceil(state.MissionTimeRemaining)))
			end
		end
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000C">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">DestructionService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- DestructionService.script.luau
-- High-impact Roblox physics destruction system for Leo City:
-- - Monitors collisions between vehicles/players/explosions and "Destructible" tagged props.
-- - Calculates impact speed & vehicle ram multiplier.
-- - Unanchors parts, applies dramatic impulse + angular velocity spin, and spawns VFX
--   (water geysers for FireHydrants, sparks for StreetLights/TrafficLights, chain-reaction
--   explosions for GasPumps & ExplosiveBarrels).
-- - Fires ServerStorage.ServerEvents.DestructionOccurred and ReplicatedStorage.Events.DestructionOccurred.
-- - Automatically respawns destroyed props after 45 seconds when players are far away.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

--------------------------------------------------------------------------------
-- EVENTS SETUP
--------------------------------------------------------------------------------
local ServerEvents = ServerStorage:FindFirstChild("ServerEvents")
if not ServerEvents then
	ServerEvents = Instance.new("Folder")
	ServerEvents.Name = "ServerEvents"
	ServerEvents.Parent = ServerStorage
end

local DestructionBindable = ServerEvents:FindFirstChild("DestructionOccurred") :: BindableEvent?
if not DestructionBindable then
	DestructionBindable = Instance.new("BindableEvent")
	DestructionBindable.Name = "DestructionOccurred"
	DestructionBindable.Parent = ServerEvents
end

local RepEvents = ReplicatedStorage:FindFirstChild("Remotes")
if not RepEvents then
	RepEvents = Instance.new("Folder")
	RepEvents.Name = "Remotes"
	RepEvents.Parent = ReplicatedStorage
end

local DestructionRemote = RepEvents:FindFirstChild("DestructionOccurred") :: RemoteEvent?
if not DestructionRemote then
	DestructionRemote = Instance.new("RemoteEvent")
	DestructionRemote.Name = "DestructionOccurred"
	DestructionRemote.Parent = RepEvents
end

--------------------------------------------------------------------------------
-- CONSTANTS & STATE
--------------------------------------------------------------------------------
local RESPAWN_DELAY = 45.0
local SAFE_PLAYER_RESPAWN_DIST = 65.0
local EXPLOSION_BLAST_RADIUS = 38.0

type RespawnEntry = {
	template: Instance,
	parent: Instance,
	originCF: CFrame,
	destroyedAt: number,
	liveInstance: Instance,
}

local respawnQueue: { RespawnEntry } = {}
local boundInstances: { [Instance]: boolean } = {}

--------------------------------------------------------------------------------
-- DRIVER & VEHICLE RESOLUTION
--------------------------------------------------------------------------------
local function resolveAttacker(hitPart: BasePart): (Player?, number, Vector3)
	local vel = hitPart.AssemblyLinearVelocity
	local speed = vel.Magnitude
	local ramMultiplier = 1.0
	local attacker: Player? = nil

	local model = hitPart:FindFirstAncestorOfClass("Model")
	if model then
		-- Check if it's a player character
		local plr = Players:GetPlayerFromCharacter(model)
		if plr then
			attacker = plr
		end

		-- Check if it's a vehicle with a Driver/VehicleSeat or Owner attribute
		local vehicleModel = model
		while vehicleModel.Parent and vehicleModel.Parent:IsA("Model") and vehicleModel.Parent ~= Workspace do
			vehicleModel = vehicleModel.Parent :: Model
		end

		local ramAttr = (vehicleModel:GetAttribute("RamMultiplier") :: number?)
			or (vehicleModel:GetAttribute("RamPower") :: number?)
			or (model:GetAttribute("RamMultiplier") :: number?)
		if ramAttr then
			ramMultiplier = ramAttr
		end

		local ownerUserId = (vehicleModel:GetAttribute("OwnerUserId") :: number?)
			or (vehicleModel:GetAttribute("DriverUserId") :: number?)
		if ownerUserId and not attacker then
			attacker = Players:GetPlayerByUserId(ownerUserId)
		end

		local ownerName = (vehicleModel:GetAttribute("Owner") :: string?)
			or (vehicleModel:GetAttribute("DriverName") :: string?)
		if ownerName and not attacker then
			attacker = Players:FindFirstChild(ownerName) :: Player?
		end

		if not attacker then
			local seat = vehicleModel:FindFirstChildWhichIsA("VehicleSeat", true) or vehicleModel:FindFirstChildWhichIsA("Seat", true)
			if seat and seat.Occupant then
				local char = seat.Occupant.Parent
				if char then
					attacker = Players:GetPlayerFromCharacter(char)
				end
			end
		end
	end

	-- Fallback: nearest player within 32 studs if hit by an unowned physics assembly
	if not attacker and speed > 10 then
		local bestDist = 32
		for _, plr in ipairs(Players:GetPlayers()) do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local d = (root.Position - hitPart.Position).Magnitude
				if d < bestDist then
					bestDist = d
					attacker = plr
				end
			end
		end
	end

	return attacker, ramMultiplier, vel
end

--------------------------------------------------------------------------------
-- SPECIAL PROP VFX (GEYSERS, SPARKS, DEBRIS, EXPLOSIONS)
--------------------------------------------------------------------------------
local function spawnWaterGeyser(pos: Vector3)
	local emitterPart = Instance.new("Part")
	emitterPart.Name = "HydrantWaterGeyser"
	emitterPart.Size = Vector3.new(1, 1, 1)
	emitterPart.Position = pos + Vector3.new(0, 0.5, 0)
	emitterPart.Anchored = true
	emitterPart.Transparency = 1
	emitterPart.CanCollide = false
	emitterPart.Parent = Workspace

	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(165, 225, 255), Color3.fromRGB(240, 250, 255))
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.6, 2.2),
		NumberSequenceKeypoint.new(1, 3.2),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.8, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(1.1, 1.6)
	pe.Rate = 85
	pe.Speed = NumberRange.new(34, 46)
	pe.SpreadAngle = Vector2.new(8, 8)
	pe.Acceleration = Vector3.new(0, -45, 0)
	pe.Parent = emitterPart

	Debris:AddItem(emitterPart, 8.0)
end

local function spawnElectricSparks(part: BasePart)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "ElectricSparks"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 230, 95), Color3.fromRGB(255, 120, 20))
	pe.LightEmission = 1
	pe.Size = NumberSequence.new(0.45, 0)
	pe.Lifetime = NumberRange.new(0.25, 0.55)
	pe.Rate = 60
	pe.Speed = NumberRange.new(16, 28)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -35, 0)
	pe.Parent = part

	task.delay(2.2, function()
		if pe and pe.Parent then
			pe.Enabled = false
		end
	end)
end

local destroyProp: (inst: Instance, attacker: Player?, hitVel: Vector3, isFromExplosion: boolean) -> ()

local function triggerChainExplosion(pos: Vector3, attacker: Player?)
	local exp = Instance.new("Explosion")
	exp.BlastRadius = EXPLOSION_BLAST_RADIUS
	exp.BlastPressure = 0 -- Custom impulse handling for predictable arcade feel
	exp.DestroyJointRadiusPercent = 0
	exp.Position = pos
	exp.Parent = Workspace

	-- Flash light burst
	local flashPart = Instance.new("Part")
	flashPart.Size = Vector3.new(1, 1, 1)
	flashPart.Position = pos
	flashPart.Anchored = true
	flashPart.CanCollide = false
	flashPart.Transparency = 1
	flashPart.Parent = Workspace

	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 150, 40)
	pl.Brightness = 6
	pl.Range = 55
	pl.Parent = flashPart
	Debris:AddItem(flashPart, 0.35)

	-- Blast nearby destructibles and vehicles in radius
	task.delay(0.08, function()
		for _, prop in ipairs(CollectionService:GetTagged("Destructible")) do
			if prop:GetAttribute("Destroyed") ~= true then
				local pPos: Vector3? = nil
				if prop:IsA("Model") and prop.PrimaryPart then
					pPos = prop.PrimaryPart.Position
				elseif prop:IsA("BasePart") then
					pPos = prop.Position
				end
				if pPos then
					local delta = pPos - pos
					local dist = delta.Magnitude
					if dist <= EXPLOSION_BLAST_RADIUS then
						local dir = if dist > 0.1 then delta.Unit else Vector3.new(0, 1, 0)
						destroyProp(prop, attacker, dir * 85 + Vector3.new(0, 35, 0), true)
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- CORE DESTRUCTION HANDLER
--------------------------------------------------------------------------------
destroyProp = function(inst: Instance, attacker: Player?, hitVel: Vector3, isFromExplosion: boolean)
	if inst:GetAttribute("Destroyed") == true then
		return
	end
	inst:SetAttribute("Destroyed", true)

	local primary: BasePart? = if inst:IsA("Model") then inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart") else (inst :: BasePart)
	if not primary then
		return
	end

	local propPos = primary.Position
	local originCF = (inst:GetAttribute("OriginCFrame") :: CFrame?) or primary.CFrame
	local propType = (inst:GetAttribute("PropType") :: string?) or inst.Name
	local cashValue = (inst:GetAttribute("CashValue") :: number?) or 20
	local chaosPoints = (inst:GetAttribute("ChaosPoints") :: number?) or 15
	local isExplosive = (inst:GetAttribute("Explosive") :: boolean?) == true

	-- Clone clean template for respawning before unanchoring/modifying
	local cleanClone = inst:Clone()
	cleanClone:SetAttribute("Destroyed", false)
	if inst.Parent then
		table.insert(respawnQueue, {
			template = cleanClone,
			parent = inst.Parent,
			originCF = originCF,
			destroyedAt = os.clock(),
			liveInstance = inst,
		})
	end

	-- Unanchor and apply dramatic impulse + angular spin
	local launchDir = if hitVel.Magnitude > 1 then hitVel.Unit else Vector3.new(0, 1, 0)
	local launchSpeed = math.clamp(hitVel.Magnitude * 1.15, 32, 110)

	local parts: { BasePart } = {}
	if inst:IsA("Model") then
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
	elseif inst:IsA("BasePart") then
		table.insert(parts, inst)
	end

	for _, p in ipairs(parts) do
		p.Anchored = false
		p.CanCollide = true
		local spread = Vector3.new(math.random() - 0.5, math.random() * 0.65 + 0.25, math.random() - 0.5) * 18
		p.AssemblyLinearVelocity = launchDir * launchSpeed + Vector3.new(0, 22, 0) + spread
		p.AssemblyAngularVelocity = Vector3.new(
			(math.random() - 0.5) * 18,
			(math.random() - 0.5) * 18,
			(math.random() - 0.5) * 18
		)
	end

	-- Special Prop Effects
	if propType == "FireHydrant" then
		spawnWaterGeyser(originCF.Position)
	elseif propType == "StreetLight" or propType == "TrafficLight" or propType == "Billboard" then
		spawnElectricSparks(primary)
	end

	if isExplosive then
		triggerChainExplosion(propPos, attacker)
	end

	-- Broadcast DestructionOccurred to Economy/Combo systems and clients
	local payload = {
		player = attacker,
		Player = attacker,
		propType = propType,
		Type = propType,
		cashEarned = cashValue,
		CashReward = cashValue,
		chaosPoints = chaosPoints,
		position = propPos,
		Position = propPos,
		isExplosion = isExplosive or isFromExplosion,
		IsExplosion = isExplosive or isFromExplosion,
	}
	if DestructionBindable then
		DestructionBindable:Fire(payload)
	end
	local rootDestBindable = ServerStorage:FindFirstChild("DestructionEvent")
	if rootDestBindable and rootDestBindable:IsA("BindableEvent") and attacker then
		rootDestBindable:Fire(attacker, payload, cashValue, propPos)
	end
	if DestructionRemote then
		if attacker then
			DestructionRemote:FireClient(attacker, payload)
		else
			DestructionRemote:FireAllClients(payload)
		end
	end

	-- Fade out broken physics parts after 6 seconds to keep framerate fast
	task.delay(6.0, function()
		if inst and inst.Parent then
			for _, p in ipairs(parts) do
				if p and p.Parent then
					p.Transparency = 1
					p.CanCollide = false
					p.Anchored = true
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- COLLISION BINDING
--------------------------------------------------------------------------------
local function bindDestructible(inst: Instance)
	if boundInstances[inst] then
		return
	end
	boundInstances[inst] = true

	local function onTouched(otherPart: BasePart)
		if inst:GetAttribute("Destroyed") == true then
			return
		end
		if otherPart.Anchored then
			return
		end
		if CollectionService:HasTag(otherPart, "Destructible") then
			return
		end

		local attacker, ramMultiplier, hitVel = resolveAttacker(otherPart)
		local effectiveSpeed = hitVel.Magnitude * ramMultiplier
		local threshold = (inst:GetAttribute("BreakThreshold") :: number?) or 18

		if effectiveSpeed >= threshold then
			destroyProp(inst, attacker, hitVel, false)
		end
	end

	if inst:IsA("BasePart") then
		inst.Touched:Connect(onTouched)
	elseif inst:IsA("Model") then
		local pri = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
		if pri then
			pri.Touched:Connect(onTouched)
		end
	end
end

for _, inst in ipairs(CollectionService:GetTagged("Destructible")) do
	bindDestructible(inst)
end
CollectionService:GetInstanceAddedSignal("Destructible"):Connect(bindDestructible)

--------------------------------------------------------------------------------
-- AUTOMATIC PROP RESPAWNING LOOP (AFTER 45s WHEN PLAYERS ARE FAR AWAY)
--------------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(3.0)
		local now = os.clock()
		for i = #respawnQueue, 1, -1 do
			local entry = respawnQueue[i]
			if now - entry.destroyedAt >= RESPAWN_DELAY then
				local farEnough = true
				for _, plr in ipairs(Players:GetPlayers()) do
					local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and (root.Position - entry.originCF.Position).Magnitude < SAFE_PLAYER_RESPAWN_DIST then
						farEnough = false
						break
					end
				end

				if farEnough then
					table.remove(respawnQueue, i)
					if entry.liveInstance and entry.liveInstance.Parent then
						boundInstances[entry.liveInstance] = nil
						entry.liveInstance:Destroy()
					end
					if entry.parent and entry.parent.Parent then
						local restored = entry.template
						if restored:IsA("Model") and restored.PrimaryPart then
							restored:PivotTo(entry.originCF)
						elseif restored:IsA("BasePart") then
							restored.CFrame = entry.originCF
						end
						restored.Parent = entry.parent
						CollectionService:AddTag(restored, "Destructible")
						bindDestructible(restored)
					end
				end
			end
		end
	end
end)

print("[DestructionService] Ready and monitoring destructible city props.")
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000D">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">GarageAndShopService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GarageAndShopService.script.luau
	World of Destruction (Roblox)
	
	Handles Vehicle Roster Unlocking, Vehicle Selection, Paint Customization,
	the 5 Upgrade Tracks (Levels 1 to 5), Drive-Through Mechanic Spot Repairs,
	and Speed Shop Interactions:
	  1. Engine (Top Speed & Acceleration)
	  2. Armor  (Vehicle Health & Impact Resistance)
	  3. Nitro  (Boost Power & Recharge Rate)
	  4. Plow   (Ramming Force & Destruction Threshold Reduction)
	  5. Magnet (Cash & Chaos Point Multiplier)
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- Vehicle Catalog & Pricing
--------------------------------------------------------------------------------
export type VehicleSpec = {
	Id: string,
	DisplayName: string,
	Tagline: string,
	Price: number,
	BaseHealth: number,
	BaseTopSpeed: number,
	BaseAccel: number,
	BaseSteer: number,
	BaseWreckPower: number,
	BaseArmorFactor: number,
}

local VEHICLE_CATALOG: { [string]: VehicleSpec } = {
	sports = {
		Id = "sports",
		DisplayName = "APEX GT",
		Tagline = "Top speed + sharp handling",
		Price = 0,
		BaseHealth = 100,
		BaseTopSpeed = 1.06,
		BaseAccel = 1.05,
		BaseSteer = 1.05,
		BaseWreckPower = 1.00,
		BaseArmorFactor = 1.00,
	},
	sedan = {
		Id = "sedan",
		DisplayName = "CRUISER V8",
		Tagline = "Balanced muscle all-rounder",
		Price = 0,
		BaseHealth = 110,
		BaseTopSpeed = 1.00,
		BaseAccel = 1.02,
		BaseSteer = 1.00,
		BaseWreckPower = 1.05,
		BaseArmorFactor = 0.92,
	},
	hatchback = {
		Id = "hatchback",
		DisplayName = "TURBO POCKET",
		Tagline = "Nimble cornering + drift pro",
		Price = 1200,
		BaseHealth = 95,
		BaseTopSpeed = 0.98,
		BaseAccel = 1.10,
		BaseSteer = 1.16,
		BaseWreckPower = 0.95,
		BaseArmorFactor = 0.95,
	},
	motorcycle = {
		Id = "motorcycle",
		DisplayName = "STREET BOLT",
		Tagline = "Hyper-agile stunt machine",
		Price = 1800,
		BaseHealth = 80,
		BaseTopSpeed = 1.12,
		BaseAccel = 1.18,
		BaseSteer = 1.25,
		BaseWreckPower = 0.85,
		BaseArmorFactor = 1.05,
	},
	suv = {
		Id = "suv",
		DisplayName = "TITAN 4x4",
		Tagline = "Heavy armor + strong impact",
		Price = 2800,
		BaseHealth = 140,
		BaseTopSpeed = 0.96,
		BaseAccel = 0.98,
		BaseSteer = 0.96,
		BaseWreckPower = 1.25,
		BaseArmorFactor = 0.78,
	},
	pickup = {
		Id = "pickup",
		DisplayName = "RANCH RAMMER",
		Tagline = "High-torque ramming truck",
		Price = 3600,
		BaseHealth = 145,
		BaseTopSpeed = 0.97,
		BaseAccel = 1.00,
		BaseSteer = 0.95,
		BaseWreckPower = 1.30,
		BaseArmorFactor = 0.80,
	},
	van = {
		Id = "van",
		DisplayName = "IRON VAN",
		Tagline = "Tanky hull + big smash weight",
		Price = 5200,
		BaseHealth = 165,
		BaseTopSpeed = 0.92,
		BaseAccel = 0.92,
		BaseSteer = 0.90,
		BaseWreckPower = 1.40,
		BaseArmorFactor = 0.70,
	},
	boxTruck = {
		Id = "boxTruck",
		DisplayName = "GOLIATH RIG",
		Tagline = "Colossal demolition rig",
		Price = 8500,
		BaseHealth = 220,
		BaseTopSpeed = 0.88,
		BaseAccel = 0.88,
		BaseSteer = 0.85,
		BaseWreckPower = 1.75,
		BaseArmorFactor = 0.58,
	},
}

-- Flexible alias lookup so UI can pass "sports", "APEX GT", "ApexGT", etc.
local VEHICLE_ALIASES: { [string]: string } = {
	["sports"] = "sports",
	["apex gt"] = "sports",
	["apexgt"] = "sports",
	["sedan"] = "sedan",
	["cruiser v8"] = "sedan",
	["cruiserv8"] = "sedan",
	["compact"] = "hatchback",
	["hatchback"] = "hatchback",
	["turbo pocket"] = "hatchback",
	["turbopocket"] = "hatchback",
	["muscle"] = "sedan",
	["hellfire gt"] = "sedan",
	["suv"] = "suv",
	["titan 4x4"] = "suv",
	["titan 4×4"] = "suv",
	["titan4x4"] = "suv",
	["pickup"] = "pickup",
	["ranch rammer"] = "pickup",
	["ranchrammer"] = "pickup",
	["van"] = "van",
	["iron van"] = "van",
	["ironvan"] = "van",
	["monstertruck"] = "boxTruck",
	["monster truck"] = "boxTruck",
	["bulldozer"] = "boxTruck",
	["tank"] = "boxTruck",
	["boxtruck"] = "boxTruck",
	["box truck"] = "boxTruck",
	["goliath rig"] = "boxTruck",
	["goliathrig"] = "boxTruck",
	["motorcycle"] = "motorcycle",
	["street bolt"] = "motorcycle",
	["streetbolt"] = "motorcycle",
}

local PAINT_PALETTE = {
	[0] = { Name = "Stealth Obsidian", Color = Color3.fromRGB(26, 31, 41) },
	[1] = { Name = "Midnight Navy", Color = Color3.fromRGB(26, 46, 82) },
	[2] = { Name = "Shadow Gunmetal", Color = Color3.fromRGB(51, 56, 66) },
	[3] = { Name = "Dark Crimson", Color = Color3.fromRGB(122, 26, 31) },
	[4] = { Name = "Antique Bronze", Color = Color3.fromRGB(117, 87, 41) },
	[5] = { Name = "Forest Slate", Color = Color3.fromRGB(31, 61, 46) },
	[6] = { Name = "Deep Violet", Color = Color3.fromRGB(61, 31, 87) },
	[7] = { Name = "Moonlit Silver", Color = Color3.fromRGB(143, 153, 168) },
}

--------------------------------------------------------------------------------
-- 5 Upgrade Tracks (Levels 1 to 5)
--------------------------------------------------------------------------------
export type TrackName = "Engine" | "Armor" | "Nitro" | "Plow" | "Magnet"

local MAX_UPGRADE_LEVEL = 5

-- Cost to upgrade from current Level L -> L+1 (index 1 = L1->L2, ..., index 4 = L4->L5)
local UPGRADE_COSTS: { [number]: number } = {
	[1] = 400,  -- Level 1 -> 2
	[2] = 900,  -- Level 2 -> 3
	[3] = 1800, -- Level 3 -> 4
	[4] = 3200, -- Level 4 -> 5
}

local TRACK_METADATA: { [string]: { Name: TrackName, DisplayName: string, Description: string } } = {
	Engine = {
		Name = "Engine",
		DisplayName = "V8 TWIN-TURBO ENGINE",
		Description = "Boosts Top Speed & Acceleration (+8% speed, +10% acceleration per level)",
	},
	Armor = {
		Name = "Armor",
		DisplayName = "REINFORCED CHASSIS ARMOR",
		Description = "Increases Vehicle Max Health & Impact Resistance (+25% HP, -10% damage taken per level)",
	},
	Nitro = {
		Name = "Nitro",
		DisplayName = "HYPER NITRO INJECTOR",
		Description = "Increases Boost Power & Nitro Recharge Rate (+12% power, +18% recharge per level)",
	},
	Plow = {
		Name = "Plow",
		DisplayName = "HEAVY DEMOLITION PLOW",
		Description = "Amplifies Ramming Force & lowers Destruction Speed Threshold (+20% ramming force per level)",
	},
	Magnet = {
		Name = "Magnet",
		DisplayName = "CASH & CHAOS MAGNET",
		Description = "Multiplies all Cash & Chaos Points earned up to 2.0x at Level 5",
	},
}

local TRACK_ALIASES: { [string]: TrackName } = {
	["engine"] = "Engine",
	["turbo"] = "Engine",
	["speed"] = "Engine",
	["armor"] = "Armor",
	["health"] = "Armor",
	["hull"] = "Armor",
	["nitro"] = "Nitro",
	["boost"] = "Nitro",
	["plow"] = "Plow",
	["wreckingball"] = "Plow",
	["wrecking"] = "Plow",
	["ram"] = "Plow",
	["magnet"] = "Magnet",
	["cashmagnet"] = "Magnet",
	["multiplier"] = "Magnet",
}

--------------------------------------------------------------------------------
-- Shared Infrastructure Helpers (Bindables & Remotes)
--------------------------------------------------------------------------------
local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function ensureBindableEvent(parent: Instance, name: string): BindableEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BindableEvent") then
		return existing
	end
	local ev = Instance.new("BindableEvent")
	ev.Name = name
	ev.Parent = parent
	return ev
end

local function ensureBindableFunction(parent: Instance, name: string): BindableFunction
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("BindableFunction") then
		return existing
	end
	local fn = Instance.new("BindableFunction")
	fn.Name = name
	fn.Parent = parent
	return fn
end

local function ensureRemoteEvent(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = parent
	return re
end

local function ensureRemoteFunction(parent: Instance, name: string): RemoteFunction
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local rf = Instance.new("RemoteFunction")
	rf.Name = name
	rf.Parent = parent
	return rf
end

local serverEventsFolder = ensureFolder(ServerStorage, "Events")
local remotesFolder = ensureFolder(ReplicatedStorage, "Remotes")

-- ServerStorage Bindables
local SpendCashFunction = ensureBindableFunction(ServerStorage, "SpendCashFunction")
local UpdatePlayerDataEvent = ensureBindableEvent(ServerStorage, "UpdatePlayerDataEvent")
local PlayerDataLoadedEvent = ensureBindableEvent(ServerStorage, "PlayerDataLoadedEvent")
local VehicleRepairedEvent = ensureBindableEvent(ServerStorage, "VehicleRepairedEvent")
local VehicleUpgradedEvent = ensureBindableEvent(ServerStorage, "VehicleUpgradedEvent")
local VehicleSpawnRequestEvent = ensureBindableEvent(ServerStorage, "VehicleSpawnRequestEvent")
local StyleCalloutRemote = ensureRemoteEvent(remotesFolder, "StyleCallout")

-- Mirror in ServerStorage.Events
ensureBindableEvent(serverEventsFolder, "VehicleRepairedEvent")
ensureBindableEvent(serverEventsFolder, "VehicleUpgradedEvent")
ensureBindableEvent(serverEventsFolder, "VehicleSpawnRequestEvent")

-- ReplicatedStorage Remotes for Garage, Speed Shop, and Mechanic Spot
local GarageActionRemote = ensureRemoteEvent(remotesFolder, "GarageAction")
local SpeedShopActionRemote = ensureRemoteEvent(remotesFolder, "SpeedShopAction")
local BuyUpgradeRemote = ensureRemoteEvent(remotesFolder, "BuyUpgrade")
local PurchaseUpgradeFunction = ensureRemoteFunction(remotesFolder, "PurchaseUpgrade")
local UnlockVehicleRemote = ensureRemoteEvent(remotesFolder, "UnlockVehicle")
local SelectVehicleRemote = ensureRemoteEvent(remotesFolder, "SelectVehicle")
local RepairVehicleRemote = ensureRemoteEvent(remotesFolder, "RepairVehicle")
local GarageNotificationRemote = ensureRemoteEvent(remotesFolder, "GarageNotification")
local SpeedShopToggleRemote = ensureRemoteEvent(remotesFolder, "SpeedShopToggle")
local GetGarageDataFunction = ensureRemoteFunction(remotesFolder, "GetGarageData")

-- Root aliases for broad script compatibility
local RootGarageRemote = ensureRemoteEvent(ReplicatedStorage, "GarageEvent")
local RootSpeedShopRemote = ensureRemoteEvent(ReplicatedStorage, "SpeedShopEvent")
local RootMechanicRemote = ensureRemoteEvent(ReplicatedStorage, "MechanicRepairEvent")

--------------------------------------------------------------------------------
-- Upgrade & Vehicle Multiplier Calculations
--------------------------------------------------------------------------------
local MAGNET_MULTIPLIERS = { 1.0, 1.15, 1.35, 1.60, 2.00 }

local function resolveVehicleId(rawId: any): string?
	if type(rawId) ~= "string" then
		return nil
	end
	local key = string.lower(string.gsub(rawId, "^%s*(.-)%s*$", "%1"))
	return VEHICLE_ALIASES[key] or (if VEHICLE_CATALOG[rawId] then rawId else nil)
end

local function resolveTrackName(rawTrack: any): TrackName?
	if type(rawTrack) ~= "string" then
		return nil
	end
	local key = string.lower(string.gsub(rawTrack, "%s+", ""))
	return TRACK_ALIASES[key]
end

local function getUnlockedVehiclesMap(player: Player): { [string]: boolean }
	local unlocked: { [string]: boolean } = {
		sports = true,
		sedan = true,
	}
	local rawJson = player:GetAttribute("UnlockedVehicles")
	if type(rawJson) == "string" and rawJson ~= "" then
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(rawJson)
		end)
		if ok and type(decoded) == "table" then
			for k, v in pairs(decoded) do
				if type(k) == "number" and type(v) == "string" then
					unlocked[v] = true
				elseif type(k) == "string" and v == true then
					unlocked[k] = true
				end
			end
		end
	end
	return unlocked
end

local function setUnlockedVehiclesMap(player: Player, unlocked: { [string]: boolean })
	local list = {}
	for id, isUnlocked in pairs(unlocked) do
		if isUnlocked then
			table.insert(list, id)
			player:SetAttribute("Unlocked_" .. id, true)
		end
	end
	table.sort(list)
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(list)
	end)
	if ok then
		player:SetAttribute("UnlockedVehicles", encoded)
	end
end

local function getTrackLevel(player: Player, track: TrackName): number
	local lvl = tonumber(player:GetAttribute("Upgrade_" .. track) or player:GetAttribute(track .. "Level")) or 1
	return math.clamp(math.floor(lvl), 1, MAX_UPGRADE_LEVEL)
end

local function findPlayerVehicleModel(player: Player): Model?
	-- Check Workspace.PlayerVehicles or character seat
	local vehiclesFolder = Workspace:FindFirstChild("PlayerVehicles") or Workspace:FindFirstChild("Vehicles")
	if vehiclesFolder then
		local byName = vehiclesFolder:FindFirstChild(player.Name .. "_Vehicle")
			or vehiclesFolder:FindFirstChild(player.Name)
			or vehiclesFolder:FindFirstChild("PlayerCar_" .. tostring(player.UserId))
		if byName and byName:IsA("Model") then
			return byName
		end
		for _, child in ipairs(vehiclesFolder:GetChildren()) do
			if child:IsA("Model") and (child:GetAttribute("OwnerUserId") == player.UserId or child:GetAttribute("Owner") == player.Name) then
				return child
			end
		end
	end

	local character = player.Character
	if character then
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum and hum.SeatPart then
			local model = hum.SeatPart:FindFirstAncestorOfClass("Model")
			if model and model ~= character then
				return model
			end
		end
	end
	return nil
end

local function recomputeAndApplyStats(player: Player, fullHeal: boolean?)
	local equippedId = resolveVehicleId(player:GetAttribute("EquippedVehicle")) or "sports"
	local spec = VEHICLE_CATALOG[equippedId] or VEHICLE_CATALOG.sports
	local paintIndex = math.clamp(math.floor(tonumber(player:GetAttribute("SelectedPaint")) or 0), 0, 7)
	local paintInfo = PAINT_PALETTE[paintIndex] or PAINT_PALETTE[0]

	local engineLvl = getTrackLevel(player, "Engine")
	local armorLvl = getTrackLevel(player, "Armor")
	local nitroLvl = getTrackLevel(player, "Nitro")
	local plowLvl = getTrackLevel(player, "Plow")
	local magnetLvl = getTrackLevel(player, "Magnet")

	-- 1. Engine: Top Speed (+8% per lvl above 1) & Acceleration (+10% per lvl above 1)
	local topSpeedMult = spec.BaseTopSpeed * (1.0 + 0.08 * (engineLvl - 1))
	local accelMult = spec.BaseAccel * (1.0 + 0.10 * (engineLvl - 1))

	-- 2. Armor: Vehicle Max Health (+25% per lvl above 1) & Impact Resistance (-10% incoming damage per lvl above 1)
	local maxHealthMult = 1.0 + 0.25 * (armorLvl - 1)
	local maxHealth = math.floor(spec.BaseHealth * maxHealthMult)
	local incomingDamageScale = spec.BaseArmorFactor * (1.0 - 0.10 * (armorLvl - 1))
	local impactResistanceMult = 1.0 / math.max(0.25, incomingDamageScale)

	-- 3. Nitro: Boost Power (+12% per lvl above 1) & Recharge Rate (+18% per lvl above 1)
	local nitroPowerMult = 1.0 + 0.12 * (nitroLvl - 1)
	local nitroRechargeMult = 1.0 + 0.18 * (nitroLvl - 1)

	-- 4. Plow: Ramming Force (+22% per lvl above 1) & Destruction Speed Threshold Reduction (-12% per lvl above 1)
	local rammingForceMult = spec.BaseWreckPower * (1.0 + 0.22 * (plowLvl - 1))
	local destructionThresholdReduction = 0.12 * (plowLvl - 1) -- Up to 48% easier to smash heavy structures

	-- 5. Magnet: Cash & Chaos Point Multiplier (1.0x -> 1.15x -> 1.35x -> 1.60x -> 2.00x)
	local magnetMult = MAGNET_MULTIPLIERS[magnetLvl] or 1.0

	-- Mirror both Upgrade_<Track> and <Track>Level attributes
	player:SetAttribute("Upgrade_Engine", engineLvl)
	player:SetAttribute("Upgrade_Armor", armorLvl)
	player:SetAttribute("Upgrade_Nitro", nitroLvl)
	player:SetAttribute("Upgrade_Plow", plowLvl)
	player:SetAttribute("Upgrade_Magnet", magnetLvl)

	player:SetAttribute("EngineLevel", engineLvl)
	player:SetAttribute("ArmorLevel", armorLvl)
	player:SetAttribute("NitroLevel", nitroLvl)
	player:SetAttribute("PlowLevel", plowLvl)
	player:SetAttribute("MagnetLevel", magnetLvl)

	-- Derived Multipliers on Player
	player:SetAttribute("EquippedVehicle", spec.Id)
	player:SetAttribute("SelectedVehicle", spec.Id)
	player:SetAttribute("VehicleDisplayName", spec.DisplayName)
	player:SetAttribute("SelectedPaint", paintIndex)
	player:SetAttribute("SelectedPaintColor", paintInfo.Color)

	player:SetAttribute("TopSpeedMultiplier", tonumber(string.format("%.3f", topSpeedMult)))
	player:SetAttribute("AccelerationMultiplier", tonumber(string.format("%.3f", accelMult)))
	player:SetAttribute("SteerMultiplier", spec.BaseSteer)
	player:SetAttribute("MaxHealthMultiplier", tonumber(string.format("%.3f", maxHealthMult)))
	player:SetAttribute("DamageResistanceMultiplier", tonumber(string.format("%.3f", impactResistanceMult)))
	player:SetAttribute("IncomingDamageScale", tonumber(string.format("%.3f", incomingDamageScale)))
	player:SetAttribute("NitroPowerMultiplier", tonumber(string.format("%.3f", nitroPowerMult)))
	player:SetAttribute("NitroRechargeMultiplier", tonumber(string.format("%.3f", nitroRechargeMult)))
	player:SetAttribute("RammingForceMultiplier", tonumber(string.format("%.3f", rammingForceMult)))
	player:SetAttribute("DestructionThresholdReduction", tonumber(string.format("%.3f", destructionThresholdReduction)))
	player:SetAttribute("CashMagnetMultiplier", tonumber(string.format("%.3f", magnetMult)))
	player:SetAttribute("ChaosPointMultiplier", tonumber(string.format("%.3f", magnetMult)))

	player:SetAttribute("VehicleMaxHealth", maxHealth)
	local currentHealth = tonumber(player:GetAttribute("VehicleHealth"))
	if fullHeal or currentHealth == nil or currentHealth <= 0 then
		currentHealth = maxHealth
	else
		currentHealth = math.min(maxHealth, currentHealth)
	end
	player:SetAttribute("VehicleHealth", currentHealth)

	-- Push stats onto active Vehicle Model in Workspace if present
	local vehicleModel = findPlayerVehicleModel(player)
	if vehicleModel then
		vehicleModel:SetAttribute("VehicleType", spec.Id)
		vehicleModel:SetAttribute("TopSpeedMultiplier", topSpeedMult)
		vehicleModel:SetAttribute("AccelerationMultiplier", accelMult)
		vehicleModel:SetAttribute("RammingForceMultiplier", rammingForceMult)
		vehicleModel:SetAttribute("DestructionThresholdReduction", destructionThresholdReduction)
		vehicleModel:SetAttribute("NitroPowerMultiplier", nitroPowerMult)
		vehicleModel:SetAttribute("NitroRechargeMultiplier", nitroRechargeMult)
		vehicleModel:SetAttribute("DamageResistanceMultiplier", impactResistanceMult)
		vehicleModel:SetAttribute("MaxHealth", maxHealth)
		vehicleModel:SetAttribute("Health", currentHealth)
		vehicleModel:SetAttribute("PlowLevel", plowLvl)
		vehicleModel:SetAttribute("ArmorLevel", armorLvl)

		local seat = vehicleModel:FindFirstChildOfClass("VehicleSeat")
		if seat then
			local baseStudsSpeed = tonumber(seat:GetAttribute("BaseMaxSpeed")) or 85
			local baseTorque = tonumber(seat:GetAttribute("BaseTorque")) or 25000
			seat:SetAttribute("BaseMaxSpeed", baseStudsSpeed)
			seat:SetAttribute("BaseTorque", baseTorque)
			seat.MaxSpeed = baseStudsSpeed * topSpeedMult
			seat.Torque = baseTorque * accelMult
		end
	end
end

--------------------------------------------------------------------------------
-- Cash Debit Helper (Supports SpendCashFunction + Direct Attribute Fallback)
--------------------------------------------------------------------------------
local function trySpendCash(player: Player, amount: number, reason: string): boolean
	local cost = math.floor(amount)
	if cost <= 0 then
		return true
	end

	local currentCash = math.max(0, math.floor(tonumber(player:GetAttribute("Cash")) or 0))
	if currentCash < cost then
		return false
	end

	local ok, spent = pcall(function()
		return SpendCashFunction:Invoke(player, cost, reason)
	end)
	if ok and spent == true then
		return true
	end

	-- Fallback direct attribute & leaderstats deduction
	local freshCash = math.max(0, math.floor(tonumber(player:GetAttribute("Cash")) or 0))
	if freshCash < cost then
		return false
	end
	local remaining = freshCash - cost
	player:SetAttribute("Cash", remaining)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local cashVal = ls:FindFirstChild("Cash") :: IntValue?
		if cashVal then
			cashVal.Value = remaining
		end
	end
	return true
end

--------------------------------------------------------------------------------
-- Core Garage & Shop Operations
--------------------------------------------------------------------------------
local function buildGarageSnapshot(player: Player)
	local unlocked = getUnlockedVehiclesMap(player)
	local upgrades = {
		Engine = getTrackLevel(player, "Engine"),
		Armor = getTrackLevel(player, "Armor"),
		Nitro = getTrackLevel(player, "Nitro"),
		Plow = getTrackLevel(player, "Plow"),
		Magnet = getTrackLevel(player, "Magnet"),
	}
	local nextCosts = {
		Engine = UPGRADE_COSTS[upgrades.Engine],
		Armor = UPGRADE_COSTS[upgrades.Armor],
		Nitro = UPGRADE_COSTS[upgrades.Nitro],
		Plow = UPGRADE_COSTS[upgrades.Plow],
		Magnet = UPGRADE_COSTS[upgrades.Magnet],
	}
	return {
		Cash = tonumber(player:GetAttribute("Cash")) or 0,
		EquippedVehicle = player:GetAttribute("EquippedVehicle") or "sports",
		SelectedPaint = tonumber(player:GetAttribute("SelectedPaint")) or 0,
		UnlockedVehicles = unlocked,
		Upgrades = upgrades,
		NextCosts = nextCosts,
		MaxLevel = MAX_UPGRADE_LEVEL,
		Catalog = VEHICLE_CATALOG,
		Tracks = TRACK_METADATA,
		VehicleHealth = tonumber(player:GetAttribute("VehicleHealth")) or 100,
		VehicleMaxHealth = tonumber(player:GetAttribute("VehicleMaxHealth")) or 100,
	}
end

local function purchaseUpgrade(player: Player, rawTrack: any): (boolean, string)
	local track = resolveTrackName(rawTrack)
	if not track then
		return false, "Invalid upgrade track."
	end

	local currentLevel = getTrackLevel(player, track)
	if currentLevel >= MAX_UPGRADE_LEVEL then
		return false, string.format("%s is already MAX LEVEL (%d)!", track, MAX_UPGRADE_LEVEL)
	end

	local cost = UPGRADE_COSTS[currentLevel] or 3200
	if not trySpendCash(player, cost, "Upgrade_" .. track) then
		return false, string.format("Need $%d for %s Level %d!", cost, track, currentLevel + 1)
	end

	local newLevel = currentLevel + 1
	player:SetAttribute("Upgrade_" .. track, newLevel)
	player:SetAttribute(track .. "Level", newLevel)

	recomputeAndApplyStats(player, track == "Armor")

	UpdatePlayerDataEvent:Fire(player, "UpgradeTrack", {
		Track = track,
		Level = newLevel,
	})
	VehicleUpgradedEvent:Fire(player, track, newLevel)
	local folderEv = serverEventsFolder:FindFirstChild("VehicleUpgradedEvent") :: BindableEvent?
	if folderEv then
		folderEv:Fire(player, track, newLevel)
	end

	local msg = string.format("%s UPGRADED TO LVL %d!", string.upper(track), newLevel)
	StyleCalloutRemote:FireClient(player, {
		Callout = msg,
		Multiplier = tonumber(player:GetAttribute("ComboMultiplier")) or 1,
		ComboCount = tonumber(player:GetAttribute("ComboCount")) or 0,
		CashAwarded = 0,
	})

	GarageNotificationRemote:FireClient(player, "BuyUpgrade", true, msg, buildGarageSnapshot(player))
	return true, msg
end

local function unlockOrSelectVehicle(player: Player, rawVehicleId: any, optionalPaintIndex: any): (boolean, string)
	local vehicleId = resolveVehicleId(rawVehicleId)
	if not vehicleId then
		return false, "Unknown vehicle class."
	end

	local spec = VEHICLE_CATALOG[vehicleId]
	local unlocked = getUnlockedVehiclesMap(player)

	if not unlocked[vehicleId] then
		if not trySpendCash(player, spec.Price, "UnlockVehicle_" .. vehicleId) then
			return false, string.format("Need $%d to unlock %s!", spec.Price, spec.DisplayName)
		end
		unlocked[vehicleId] = true
		setUnlockedVehiclesMap(player, unlocked)
		UpdatePlayerDataEvent:Fire(player, "UnlockVehicle", vehicleId)
	end

	player:SetAttribute("EquippedVehicle", vehicleId)
	player:SetAttribute("SelectedVehicle", vehicleId)

	if type(optionalPaintIndex) == "number" then
		local paintIdx = math.clamp(math.floor(optionalPaintIndex), 0, 7)
		player:SetAttribute("SelectedPaint", paintIdx)
		UpdatePlayerDataEvent:Fire(player, "SelectedPaint", paintIdx)
	end

	recomputeAndApplyStats(player, true)
	UpdatePlayerDataEvent:Fire(player, "EquipVehicle", vehicleId)

	-- Notify any vehicle spawner script to hot-swap the player's car
	VehicleSpawnRequestEvent:Fire(player, vehicleId, player:GetAttribute("SelectedPaint"))
	local folderSpawnEv = serverEventsFolder:FindFirstChild("VehicleSpawnRequestEvent") :: BindableEvent?
	if folderSpawnEv then
		folderSpawnEv:Fire(player, vehicleId, player:GetAttribute("SelectedPaint"))
	end

	local msg = string.format("EQUIPPED %s!", spec.DisplayName)
	StyleCalloutRemote:FireClient(player, {
		Callout = msg,
		Multiplier = tonumber(player:GetAttribute("ComboMultiplier")) or 1,
		ComboCount = tonumber(player:GetAttribute("ComboCount")) or 0,
		CashAwarded = 0,
	})
	GarageNotificationRemote:FireClient(player, "SelectVehicle", true, msg, buildGarageSnapshot(player))
	return true, msg
end

local function selectPaint(player: Player, rawPaintIndex: any): (boolean, string)
	local paintIndex = math.clamp(math.floor(tonumber(rawPaintIndex) or 0), 0, 7)
	local paintInfo = PAINT_PALETTE[paintIndex] or PAINT_PALETTE[0]

	player:SetAttribute("SelectedPaint", paintIndex)
	player:SetAttribute("SelectedPaintColor", paintInfo.Color)
	recomputeAndApplyStats(player, false)
	UpdatePlayerDataEvent:Fire(player, "SelectedPaint", paintIndex)

	VehicleSpawnRequestEvent:Fire(player, player:GetAttribute("EquippedVehicle"), paintIndex)
	local msg = string.format("PAINT: %s!", string.upper(paintInfo.Name))
	GarageNotificationRemote:FireClient(player, "SelectPaint", true, msg, buildGarageSnapshot(player))
	return true, msg
end

local repairCooldowns: { [number]: number } = {}

local function repairPlayerVehicle(player: Player, stationName: string?, respawnCFrame: CFrame?): (boolean, string)
	local now = os.clock()
	if repairCooldowns[player.UserId] and now - repairCooldowns[player.UserId] < 1.5 then
		return false, "Repair cooling down."
	end
	repairCooldowns[player.UserId] = now

	recomputeAndApplyStats(player, true)
	local maxHealth = tonumber(player:GetAttribute("VehicleMaxHealth")) or 100
	player:SetAttribute("VehicleHealth", maxHealth)
	player:SetAttribute("VehicleDamageRatio", 0)
	player:SetAttribute("LastRepairTime", os.time())

	if respawnCFrame then
		player:SetAttribute("LastMechanicRespawnCFrame", respawnCFrame)
	end

	local vehicleModel = findPlayerVehicleModel(player)
	if vehicleModel then
		vehicleModel:SetAttribute("Health", maxHealth)
		vehicleModel:SetAttribute("Damage", 0)
		vehicleModel:SetAttribute("IsWrecked", false)
	end

	local label = if stationName and stationName ~= "" then stationName else "MECHANIC SPOT"
	local msg = string.format("WRENCH REPAIRED 100%% AT %s!", string.upper(label))

	VehicleRepairedEvent:Fire(player, label, 0)
	local folderRepairEv = serverEventsFolder:FindFirstChild("VehicleRepairedEvent") :: BindableEvent?
	if folderRepairEv then
		folderRepairEv:Fire(player, label, 0)
	end

	StyleCalloutRemote:FireClient(player, {
		Callout = "REPAIRED 100%!",
		Multiplier = tonumber(player:GetAttribute("ComboMultiplier")) or 1,
		ComboCount = tonumber(player:GetAttribute("ComboCount")) or 0,
		CashAwarded = 0,
	})
	GarageNotificationRemote:FireClient(player, "RepairVehicle", true, msg, buildGarageSnapshot(player))
	return true, msg
end

--------------------------------------------------------------------------------
-- RemoteEvent & RemoteFunction Wiring
--------------------------------------------------------------------------------
GetGarageDataFunction.OnServerInvoke = function(player: Player)
	return buildGarageSnapshot(player)
end

BuyUpgradeRemote.OnServerEvent:Connect(function(player: Player, trackName: any)
	purchaseUpgrade(player, trackName)
end)

PurchaseUpgradeFunction.OnServerInvoke = function(player: Player, trackName: any)
	local ok, _msg = purchaseUpgrade(player, trackName)
	return ok
end

UnlockVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any)
	unlockOrSelectVehicle(player, vehicleId, nil)
end)

SelectVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleId: any, paintIndex: any)
	unlockOrSelectVehicle(player, vehicleId, paintIndex)
end)

RepairVehicleRemote.OnServerEvent:Connect(function(player: Player, stationName: any)
	repairPlayerVehicle(player, if type(stationName) == "string" then stationName else "Mechanic Spot", nil)
end)
RootMechanicRemote.OnServerEvent:Connect(function(player: Player, stationName: any)
	repairPlayerVehicle(player, if type(stationName) == "string" then stationName else "Mechanic Spot", nil)
end)

local function handleCompositeGarageAction(player: Player, action: any, arg1: any, arg2: any)
	local act = string.lower(tostring(action or ""))
	if act == "buyupgrade" or act == "upgrade" then
		purchaseUpgrade(player, arg1)
	elseif act == "unlockvehicle" or act == "buyvehicle" or act == "selectvehicle" or act == "equipvehicle" then
		unlockOrSelectVehicle(player, arg1, arg2)
	elseif act == "selectpaint" or act == "paint" then
		selectPaint(player, arg1)
	elseif act == "repair" or act == "repairvehicle" or act == "mechanicspot" then
		repairPlayerVehicle(player, if type(arg1) == "string" then arg1 else "Mechanic Spot", nil)
	elseif act == "openspeedshop" then
		player:SetAttribute("SpeedShopOpen", true)
		SpeedShopToggleRemote:FireClient(player, true, buildGarageSnapshot(player))
	elseif act == "closespeedshop" then
		player:SetAttribute("SpeedShopOpen", false)
		SpeedShopToggleRemote:FireClient(player, false, buildGarageSnapshot(player))
	end
end

GarageActionRemote.OnServerEvent:Connect(handleCompositeGarageAction)
SpeedShopActionRemote.OnServerEvent:Connect(handleCompositeGarageAction)
RootGarageRemote.OnServerEvent:Connect(handleCompositeGarageAction)
RootSpeedShopRemote.OnServerEvent:Connect(handleCompositeGarageAction)

--------------------------------------------------------------------------------
-- Drive-Through Mechanic Spots & Speed Shop Showroom Pads in Workspace
--------------------------------------------------------------------------------
local function resolvePlayerFromHit(hit: BasePart): Player?
	local char = hit:FindFirstAncestorOfClass("Model")
	if char then
		local directPlayer = Players:GetPlayerFromCharacter(char)
		if directPlayer then
			return directPlayer
		end
		local ownerId = char:GetAttribute("OwnerUserId")
		if type(ownerId) == "number" then
			return Players:GetPlayerByUserId(ownerId)
		end
		local seat = char:FindFirstChildOfClass("VehicleSeat")
		if seat and seat.Occupant and seat.Occupant.Parent then
			return Players:GetPlayerFromCharacter(seat.Occupant.Parent)
		end
	end
	return nil
end

local boundPads: { [Instance]: boolean } = {}
local speedShopPadDebounces: { [number]: number } = {}

local function bindMechanicSpotPad(pad: BasePart, spotName: string)
	if boundPads[pad] then
		return
	end
	boundPads[pad] = true
	pad:SetAttribute("IsMechanicSpot", true)

	pad.Touched:Connect(function(hit: BasePart)
		local player = resolvePlayerFromHit(hit)
		if not player then
			return
		end
		local respawnCF = pad.CFrame + Vector3.new(0, 4, 0)
		repairPlayerVehicle(player, spotName, respawnCF)
	end)
end

local function bindSpeedShopPad(pad: BasePart, shopName: string)
	if boundPads[pad] then
		return
	end
	boundPads[pad] = true
	pad:SetAttribute("IsSpeedShop", true)

	pad.Touched:Connect(function(hit: BasePart)
		local player = resolvePlayerFromHit(hit)
		if not player then
			return
		end
		local now = os.clock()
		if speedShopPadDebounces[player.UserId] and now - speedShopPadDebounces[player.UserId] < 3.0 then
			return
		end
		speedShopPadDebounces[player.UserId] = now

		player:SetAttribute("NearSpeedShop", true)
		player:SetAttribute("SpeedShopOpen", true)
		SpeedShopToggleRemote:FireClient(player, true, buildGarageSnapshot(player), shopName)
	end)
end

local function createBillboardLabel(parent: BasePart, titleText: string, subtitleText: string, accentColor: Color3)
	local bb = Instance.new("BillboardGui")
	bb.Name = "StationSign"
	bb.Size = UDim2.fromOffset(220, 64)
	bb.StudsOffset = Vector3.new(0, 9, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 180
	bb.Parent = parent

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.58)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = titleText
	title.TextColor3 = accentColor
	title.TextStrokeTransparency = 0.2
	title.TextScaled = true
	title.Parent = bb

	local sub = Instance.new("TextLabel")
	sub.Name = "Subtitle"
	sub.Position = UDim2.fromScale(0, 0.58)
	sub.Size = UDim2.fromScale(1, 0.42)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.GothamBold
	sub.Text = subtitleText
	sub.TextColor3 = Color3.fromRGB(240, 245, 255)
	sub.TextStrokeTransparency = 0.3
	sub.TextScaled = true
	sub.Parent = bb
end

local function ensureDefaultGaragePadsInWorkspace()
	-- First bind any existing MechanicSpot / SpeedShop instances created by world builder scripts
	for _, inst in ipairs(CollectionService:GetTagged("MechanicSpot")) do
		if inst:IsA("BasePart") then
			bindMechanicSpotPad(inst, inst.Name)
		elseif inst:IsA("Model") and inst.PrimaryPart then
			bindMechanicSpotPad(inst.PrimaryPart, inst.Name)
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged("SpeedShop")) do
		if inst:IsA("BasePart") then
			bindSpeedShopPad(inst, inst.Name)
		elseif inst:IsA("Model") and inst.PrimaryPart then
			bindSpeedShopPad(inst.PrimaryPart, inst.Name)
		end
	end

	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BasePart") then
			local lower = string.lower(desc.Name)
			if desc:GetAttribute("IsMechanicSpot") or string.find(lower, "mechanicspot") or string.find(lower, "repairpad") then
				bindMechanicSpotPad(desc, desc.Name)
			elseif desc:GetAttribute("IsSpeedShop") or string.find(lower, "speedshop") or string.find(lower, "upgradepad") then
				bindSpeedShopPad(desc, desc.Name)
			end
		end
	end

	-- If no pads exist yet, spawn drive-through Mechanic Spots & Speed Shop pads in Workspace.GarageSpots
	if next(boundPads) ~= nil then
		return
	end

	local spotsFolder = ensureFolder(Workspace, "GarageSpots")

	local mechanicLocations = {
		{ Name = "Downtown Mechanic Bay", Position = Vector3.new(45, 0.4, -45) },
		{ Name = "Harbor Repair Garage", Position = Vector3.new(-140, 0.4, 90) },
		{ Name = "Uptown Pit Stop", Position = Vector3.new(160, 0.4, 130) },
	}

	for _, loc in ipairs(mechanicLocations) do
		local pad = Instance.new("Part")
		pad.Name = loc.Name
		pad.Size = Vector3.new(18, 0.6, 18)
		pad.Position = loc.Position
		pad.Anchored = true
		pad.CanCollide = false
		pad.Material = Enum.Material.Neon
		pad.Color = Color3.fromRGB(40, 235, 115)
		pad.Transparency = 0.25
		pad.Parent = spotsFolder
		CollectionService:AddTag(pad, "MechanicSpot")
		createBillboardLabel(pad, "MECHANIC SPOT", "DRIVE THROUGH FOR INSTANT REPAIR", Color3.fromRGB(60, 255, 130))
		bindMechanicSpotPad(pad, loc.Name)
	end

	local speedShopLocations = {
		{ Name = "Leo City Speed Shop", Position = Vector3.new(-45, 0.4, -45) },
		{ Name = "Industrial Tuning Showroom", Position = Vector3.new(120, 0.4, -150) },
	}

	for _, loc in ipairs(speedShopLocations) do
		local pad = Instance.new("Part")
		pad.Name = loc.Name
		pad.Size = Vector3.new(20, 0.6, 20)
		pad.Position = loc.Position
		pad.Anchored = true
		pad.CanCollide = false
		pad.Material = Enum.Material.Neon
		pad.Color = Color3.fromRGB(255, 175, 35)
		pad.Transparency = 0.25
		pad.Parent = spotsFolder
		CollectionService:AddTag(pad, "SpeedShop")
		createBillboardLabel(pad, "SPEED SHOP & GARAGE", "UPGRADE ENGINE · ARMOR · NITRO · PLOW · MAGNET", Color3.fromRGB(255, 200, 50))
		bindSpeedShopPad(pad, loc.Name)
	end
end

task.defer(ensureDefaultGaragePadsInWorkspace)

-- Also listen for dynamically streamed MechanicSpot / SpeedShop parts
Workspace.DescendantAdded:Connect(function(desc: Instance)
	if desc:IsA("BasePart") then
		local lower = string.lower(desc.Name)
		if desc:GetAttribute("IsMechanicSpot") or string.find(lower, "mechanicspot") or string.find(lower, "repairpad") then
			bindMechanicSpotPad(desc, desc.Name)
		elseif desc:GetAttribute("IsSpeedShop") or string.find(lower, "speedshop") or string.find(lower, "upgradepad") then
			bindSpeedShopPad(desc, desc.Name)
		end
	end
end)

--------------------------------------------------------------------------------
-- Player Lifecycle Integration
--------------------------------------------------------------------------------
local function initPlayerGarage(player: Player)
	-- Ensure default upgrade attributes exist if PlayerDataService hasn't populated yet
	for _, track in ipairs({ "Engine", "Armor", "Nitro", "Plow", "Magnet" }) do
		if player:GetAttribute("Upgrade_" .. track) == nil then
			player:SetAttribute("Upgrade_" .. track, 1)
		end
	end
	if player:GetAttribute("EquippedVehicle") == nil then
		player:SetAttribute("EquippedVehicle", "sports")
	end
	if player:GetAttribute("SelectedPaint") == nil then
		player:SetAttribute("SelectedPaint", 0)
	end

	recomputeAndApplyStats(player, true)

	player.CharacterAdded:Connect(function()
		task.wait(0.25)
		if player.Parent then
			recomputeAndApplyStats(player, true)
		end
	end)
end

PlayerDataLoadedEvent.Event:Connect(function(player: Player)
	if typeof(player) == "Instance" and player:IsA("Player") then
		recomputeAndApplyStats(player, true)
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(initPlayerGarage, player)
end
Players.PlayerAdded:Connect(initPlayerGarage)

Players.PlayerRemoving:Connect(function(player: Player)
	repairCooldowns[player.UserId] = nil
	speedShopPadDebounces[player.UserId] = nil
end)

-- Periodically refresh vehicle model multipliers in case a new vehicle was spawned
local syncAccum = 0
RunService.Heartbeat:Connect(function(dt: number)
	syncAccum += dt
	if syncAccum < 1.0 then
		return
	end
	syncAccum = 0
	for _, player in ipairs(Players:GetPlayers()) do
		recomputeAndApplyStats(player, false)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000E">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">GraphicsAndAtmosphereService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GraphicsAndAtmosphereService.script.luau
	World of Destruction (Roblox) — Version 1.0
	
	Configures crisp, modern Roblox graphics in Lighting and Workspace:
	- Lighting properties: Future lighting technology, realistic ShadowSoftness,
	  EnvironmentDiffuseScale, EnvironmentSpecularScale, warm golden-hour defaults.
	- Post-Processing & Atmospheric instances (idempotent with WeatherTimeService):
	  * Atmosphere (crisp horizon haze & sky scatter)
	  * Sky (celestial bodies & clean skybox)
	  * BloomEffect (vibrant neon signage, headlights, and plasma nitro glow)
	  * ColorCorrectionEffect (punchy arcade saturation & contrast)
	  * SunRaysEffect (cinematic volumetric sunbeams through Downtown towers)
	  * DepthOfFieldEffect (subtle distant horizon softness)
	- High-Visibility Landmark Beacons & Neon Signage in Workspace:
	  Places vertical light-beam beacons and floating 3D BillboardGui markers on key
	  Leo City destinations (Speed Shop Showrooms, Mechanic Repair Bays, Park Mega-Ramp,
	  Speedway Mega-Ramp, and Leo Plaza Spawn) so players can navigate effortlessly.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- 1. Lighting & Post-Processing Configuration
--------------------------------------------------------------------------------
local function ensurePostEffect<T>(className: string, name: string): any
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.ClassName == className then
			return child
		end
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

local function configureCrispLighting()
	-- Core Lighting properties tuned for vibrant Forza-style arcade clarity
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.18
	Lighting.EnvironmentDiffuseScale = 0.85
	Lighting.EnvironmentSpecularScale = 0.90
	Lighting.Brightness = math.max(Lighting.Brightness, 2.5)

	-- Atmosphere
	local atmosphere: Atmosphere = ensurePostEffect("Atmosphere", "WoDAtmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(198, 218, 245)
	atmosphere.Decay = Color3.fromRGB(145, 165, 200)
	atmosphere.Glare = 0.18
	atmosphere.Haze = 1.15

	-- Sky
	local sky: Sky = ensurePostEffect("Sky", "WoDSky")
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 11
	sky.StarCount = 3000

	-- BloomEffect (makes neon signs, police sirens, and plasma nitro pop)
	local bloom: BloomEffect = ensurePostEffect("BloomEffect", "WoDBloom")
	bloom.Enabled = true
	bloom.Intensity = 0.65
	bloom.Size = 26
	bloom.Threshold = 1.35

	-- ColorCorrectionEffect (saturated, warm sunlit arcade palette)
	local cc: ColorCorrectionEffect = ensurePostEffect("ColorCorrectionEffect", "WoDColorCorrection")
	cc.Enabled = true
	cc.Brightness = 0.02
	cc.Contrast = 0.12
	cc.Saturation = 0.18
	cc.TintColor = Color3.fromRGB(255, 252, 246)

	-- SunRaysEffect (volumetric rays between skyscrapers)
	local sunRays: SunRaysEffect = ensurePostEffect("SunRaysEffect", "WoDSunRays")
	sunRays.Enabled = true
	sunRays.Intensity = 0.08
	sunRays.Spread = 0.65

	-- Subtle DepthOfFieldEffect (keeps foreground razor-sharp, softens far horizon)
	local dof: DepthOfFieldEffect = ensurePostEffect("DepthOfFieldEffect", "WoDDepthOfField")
	dof.Enabled = true
	dof.FarIntensity = 0.10
	dof.FocusDistance = 160
	dof.InFocusRadius = 220
	dof.NearIntensity = 0

	Lighting:SetAttribute("GraphicsConfiguredV1", true)
end

configureCrispLighting()

--------------------------------------------------------------------------------
-- 2. High-Visibility City Landmark Beacons & Floating Signage
--------------------------------------------------------------------------------
type LandmarkBeaconSpec = {
	Id: string,
	Title: string,
	Subtitle: string,
	Position: Vector3,
	Color: Color3,
	PillarHeight: number,
	RingRadius: number,
}

local LANDMARK_BEACONS: { LandmarkBeaconSpec } = {
	{
		Id = "SpeedShopNorthEast",
		Title = "SPEED SHOP [B]",
		Subtitle = "CAR UPGRADES • PAINTS • GARAGE",
		Position = Vector3.new(120, 0, 120),
		Color = Color3.fromRGB(0, 235, 255),
		PillarHeight = 95,
		RingRadius = 18,
	},
	{
		Id = "SpeedShopSouthWest",
		Title = "SPEED SHOP [B]",
		Subtitle = "CAR UPGRADES • PAINTS • GARAGE",
		Position = Vector3.new(-120, 0, -120),
		Color = Color3.fromRGB(0, 235, 255),
		PillarHeight = 95,
		RingRadius = 18,
	},
	{
		Id = "MechanicBayDowntown",
		Title = "MECHANIC REPAIR BAY",
		Subtitle = "DRIVE THROUGH FOR INSTANT 100% REPAIR",
		Position = Vector3.new(90, 0, 0),
		Color = Color3.fromRGB(60, 255, 130),
		PillarHeight = 70,
		RingRadius = 14,
	},
	{
		Id = "MechanicBayPark",
		Title = "MECHANIC REPAIR BAY",
		Subtitle = "INSTANT REPAIR & NITRO REFILL",
		Position = Vector3.new(-150, 0, 0),
		Color = Color3.fromRGB(60, 255, 130),
		PillarHeight = 70,
		RingRadius = 14,
	},
	{
		Id = "ParkMegaRamp",
		Title = "PARK MEGA-RAMP",
		Subtitle = "STUNT ZONE • MEGA AIR MULTIPLIER",
		Position = Vector3.new(-210, 0, -30),
		Color = Color3.fromRGB(255, 145, 35),
		PillarHeight = 85,
		RingRadius = 16,
	},
	{
		Id = "SpeedwayMegaRamp",
		Title = "SPEEDWAY MEGA-RAMP",
		Subtitle = "HIGH-SPEED LAUNCH • 2X STUNT XP",
		Position = Vector3.new(210, 0, 180),
		Color = Color3.fromRGB(255, 145, 35),
		PillarHeight = 85,
		RingRadius = 16,
	},
	{
		Id = "LeoTowerIcon",
		Title = "LEO TOWER",
		Subtitle = "DOWNTOWN BOSS LANDMARK • JACKPOT PAYOUT",
		Position = Vector3.new(60, 0, 60),
		Color = Color3.fromRGB(255, 215, 55),
		PillarHeight = 115,
		RingRadius = 16,
	},
	{
		Id = "GrandStadiumArena",
		Title = "GRAND STADIUM ARENA",
		Subtitle = "DEMOLITION BOWL & COMBO PLAYGROUND",
		Position = Vector3.new(180, 0, -210),
		Color = Color3.fromRGB(215, 85, 255),
		PillarHeight = 95,
		RingRadius = 20,
	},
}

local animatedRings: { { Part: BasePart, BasePos: Vector3, BaseRadius: number, Phase: number } } = {}

local function buildLandmarkBeacons()
	local parentFolder = Workspace:FindFirstChild("LeoCity") or Workspace
	local existing = parentFolder:FindFirstChild("CityNavigationBeacons")
	if existing then
		existing:Destroy()
	end

	local beaconsFolder = Instance.new("Folder")
	beaconsFolder.Name = "CityNavigationBeacons"
	beaconsFolder.Parent = parentFolder

	for idx, spec in ipairs(LANDMARK_BEACONS) do
		local model = Instance.new("Model")
		model.Name = "Beacon_" .. spec.Id
		model:SetAttribute("LandmarkId", spec.Id)
		model:SetAttribute("LandmarkTitle", spec.Title)
		model.Parent = beaconsFolder

		-- 1. Translucent Neon Sky Beam Pillar (visible across the whole city)
		local beamPart = Instance.new("Part")
		beamPart.Name = "SkyBeaconBeam"
		beamPart.Shape = Enum.PartType.Cylinder
		beamPart.Material = Enum.Material.Neon
		beamPart.Color = spec.Color
		beamPart.Anchored = true
		beamPart.CanCollide = false
		beamPart.CanQuery = false
		beamPart.CanTouch = false
		beamPart.CastShadow = false
		beamPart.Transparency = 0.78
		beamPart.Size = Vector3.new(spec.PillarHeight, 3.2, 3.2)
		beamPart.CFrame = CFrame.new(spec.Position + Vector3.new(0, spec.PillarHeight * 0.5, 0))
			* CFrame.Angles(0, 0, math.rad(90))
		beamPart.Parent = model

		-- 2. Ground Pad Halo Ring
		local groundRing = Instance.new("Part")
		groundRing.Name = "GroundHaloRing"
		groundRing.Shape = Enum.PartType.Cylinder
		groundRing.Material = Enum.Material.Neon
		groundRing.Color = spec.Color
		groundRing.Anchored = true
		groundRing.CanCollide = false
		groundRing.CanQuery = false
		groundRing.CanTouch = false
		groundRing.CastShadow = false
		groundRing.Transparency = 0.35
		groundRing.Size = Vector3.new(0.35, spec.RingRadius * 2, spec.RingRadius * 2)
		groundRing.CFrame = CFrame.new(spec.Position + Vector3.new(0, 0.25, 0))
			* CFrame.Angles(0, 0, math.rad(90))
		groundRing.Parent = model

		local pointLight = Instance.new("PointLight")
		pointLight.Color = spec.Color
		pointLight.Brightness = 2.2
		pointLight.Range = 36
		pointLight.Shadows = false
		pointLight.Parent = groundRing

		table.insert(animatedRings, {
			Part = groundRing,
			BasePos = spec.Position + Vector3.new(0, 0.25, 0),
			BaseRadius = spec.RingRadius,
			Phase = idx * 0.85,
		})

		-- 3. High-Visibility Floating Billboard Sign
		local signAnchor = Instance.new("Part")
		signAnchor.Name = "SignAnchor"
		signAnchor.Size = Vector3.new(1, 1, 1)
		signAnchor.Transparency = 1
		signAnchor.Anchored = true
		signAnchor.CanCollide = false
		signAnchor.CanQuery = false
		signAnchor.CanTouch = false
		signAnchor.Position = spec.Position + Vector3.new(0, 22, 0)
		signAnchor.Parent = model

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "LandmarkSignGui"
		billboard.Size = UDim2.fromOffset(230, 56)
		billboard.StudsOffset = Vector3.new(0, 2, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = 650
		billboard.LightInfluence = 0
		billboard.Parent = signAnchor

		local card = Instance.new("Frame")
		card.Name = "Card"
		card.Size = UDim2.fromScale(1, 1)
		card.BackgroundColor3 = Color3.fromRGB(12, 16, 26)
		card.BackgroundTransparency = 0.18
		card.BorderSizePixel = 0
		card.Parent = billboard

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = card

		local stroke = Instance.new("UIStroke")
		stroke.Color = spec.Color
		stroke.Thickness = 2
		stroke.Parent = card

		local titleLabel = Instance.new("TextLabel")
		titleLabel.Name = "Title"
		titleLabel.Size = UDim2.new(1, -12, 0, 28)
		titleLabel.Position = UDim2.fromOffset(6, 4)
		titleLabel.BackgroundTransparency = 1
		titleLabel.Font = Enum.Font.GothamBlack
		titleLabel.Text = spec.Title
		titleLabel.TextColor3 = spec.Color
		titleLabel.TextSize = 15
		titleLabel.TextScaled = true
		titleLabel.Parent = card

		local subLabel = Instance.new("TextLabel")
		subLabel.Name = "Subtitle"
		subLabel.Size = UDim2.new(1, -12, 0, 18)
		subLabel.Position = UDim2.fromOffset(6, 32)
		subLabel.BackgroundTransparency = 1
		subLabel.Font = Enum.Font.GothamBold
		subLabel.Text = spec.Subtitle
		subLabel.TextColor3 = Color3.fromRGB(225, 232, 245)
		subLabel.TextSize = 11
		subLabel.TextScaled = true
		subLabel.Parent = card
	end
end

-- Build beacons immediately and re-parent to Workspace.LeoCity once WorldBuilderService finishes
buildLandmarkBeacons()
task.delay(3.0, function()
	local leoCity = Workspace:FindFirstChild("LeoCity")
	local currentBeacons = Workspace:FindFirstChild("CityNavigationBeacons")
	if leoCity and currentBeacons then
		currentBeacons.Parent = leoCity
	end
end)

-- Subtle pulse animation on landmark ground halo rings
local pulseElapsed = 0
RunService.Heartbeat:Connect(function(dt: number)
	pulseElapsed += dt
	if pulseElapsed < 0.05 then
		return
	end
	local t = os.clock()
	pulseElapsed = 0
	for _, item in ipairs(animatedRings) do
		if item.Part and item.Part.Parent then
			local wave = math.sin(t * 2.4 + item.Phase)
			local r = (item.BaseRadius * 2) + wave * 1.4
			item.Part.Size = Vector3.new(0.35, r, r)
			item.Part.Transparency = 0.35 + (wave * 0.12)
		end
	end
end)
]]></ProtectedString>
