	VehicleCatalog.PlayerPalette.GoldRush,
	VehicleCatalog.PlayerPalette.StealthBlack,
	VehicleCatalog.PlayerPalette.PearlWhite,
}

local function getPlayerUpgradeLevel(player: Player, track: string): number
	local val = player:GetAttribute("Upgrade_" .. track) or player:GetAttribute(track .. "Level")
	local n = tonumber(val) or 1
	return math.clamp(math.floor(n), 0, 5)
end

local function getPlayerEquippedArchetype(player: Player): string
	local raw = player:GetAttribute("EquippedVehicle") or player:GetAttribute("SelectedVehicle")
	if type(raw) == "string" and raw ~= "" then
		return VehicleCatalog.ResolveArchetypeId(raw)
	end
	return "Compact"
end

local function getPlayerPaintColor(player: Player, defaultColor: Color3): Color3
	local paintIdx = tonumber(player:GetAttribute("SelectedPaint"))
	if paintIdx and paintIdx >= 1 and paintIdx <= #PAINT_LIST then
		return PAINT_LIST[math.floor(paintIdx)]
	end
	return defaultColor
end

local function unanchorModel(model: Model)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = false
		end
	end
end

local function setModelNetworkOwner(model: Model, owner: Player?)
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
	if not chassis or chassis.Anchored then
		return
	end
	pcall(function()
		if owner then
			chassis:SetNetworkOwner(owner)
		else
			chassis:SetNetworkOwnershipAuto()
		end
	end)
end

--------------------------------------------------------------------------------
-- Damage, Smoke/Fire VFX & Repair Logic
--------------------------------------------------------------------------------
local function updateDamageVFX(model: Model)
	local health = tonumber(model:GetAttribute("Health")) or 100
	local maxHealth = math.max(1, tonumber(model:GetAttribute("MaxHealth")) or 100)
	local ratio = math.clamp(health / maxHealth, 0, 1)

	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end

	local engineAtt = chassis:FindFirstChild("EngineVFXAttachment")
	if not engineAtt then
		return
	end

	local smoke = engineAtt:FindFirstChild("DamageSmoke") :: ParticleEmitter?
	local fire = engineAtt:FindFirstChild("DamageFire") :: ParticleEmitter?

	if smoke then
		smoke.Enabled = ratio <= 0.55
		if ratio <= 0.25 then
			smoke.Rate = 45
			smoke.Color = ColorSequence.new(Color3.fromRGB(25, 25, 30))
		else
			smoke.Rate = 22
			smoke.Color = ColorSequence.new(Color3.fromRGB(95, 95, 105))
		end
	end

	if fire then
		fire.Enabled = ratio <= 0.25
	end
end

local function getDriverFromVehicle(model: Model): Player?
	local seat = model:FindFirstChild("DriveSeat") :: VehicleSeat?
	if not seat or not seat.Occupant then
		return nil
	end
	local char = seat.Occupant.Parent
	if not char then
		return nil
	end
	return Players:GetPlayerFromCharacter(char)
end

local function repairVehicle(model: Model, notifyDriver: boolean?)
	if not model or not model.Parent then
		return
	end
	local maxHealth = math.max(1, tonumber(model:GetAttribute("MaxHealth")) or 100)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("IsWrecked", false)
	updateDamageVFX(model)

	local driver = getDriverFromVehicle(model)
	if driver then
		driver:SetAttribute("VehicleHealth", maxHealth)
		driver:SetAttribute("VehicleMaxHealth", maxHealth)
		if notifyDriver then
			NotificationRemote:FireClient(driver, {
				Title = "MECHANIC GARAGE",
				Message = "Vehicle Fully Repaired & Tuned!",
				Category = "Success",
				Color = Color3.fromRGB(65, 240, 120),
				Duration = 2.5,
			})
		end
	end

	-- Brief green repair highlight flash
	local highlight = Instance.new("Highlight")
	highlight.Name = "RepairFlash"
	highlight.FillColor = Color3.fromRGB(60, 255, 130)
	highlight.OutlineColor = Color3.fromRGB(180, 255, 210)
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0.1
	highlight.Parent = model
	task.delay(0.8, function()
		if highlight.Parent then
			highlight:Destroy()
		end
	end)
end

-- Applies live Garage Upgrades to an existing vehicle Model
function ApplyUpgradesToVehicle(player: Player, model: Model)
	if not model or not model.Parent then
		return
	end
	local vehicleType = tostring(model:GetAttribute("VehicleType") or "Compact")
	local cfg = VehicleCatalog.GetConfig(vehicleType)

	local engineLvl = getPlayerUpgradeLevel(player, "Engine")
	local armorLvl = getPlayerUpgradeLevel(player, "Armor")
	local nitroLvl = getPlayerUpgradeLevel(player, "Nitro")
	local plowLvl = getPlayerUpgradeLevel(player, "Plow")

	-- Level 1 is baseline (0 bonus steps), levels 2..5 add strong bonuses
	local engineSteps = math.max(0, engineLvl - 1)
	local armorSteps = math.max(0, armorLvl - 1)
	local nitroSteps = math.max(0, nitroLvl - 1)
	local plowSteps = math.max(0, plowLvl - 1)

	local effectiveMaxSpeed = math.round(cfg.MaxSpeed * (1 + engineSteps * 0.08))
	local effectiveAccel = math.round(cfg.Acceleration * (1 + engineSteps * 0.10))
	local effectiveMaxHealth = math.round(cfg.MaxHealth * (1 + armorSteps * 0.15))
	local effectiveNitroCap = cfg.NitroCapacity * (1 + nitroSteps * 0.15)
	local effectiveRamMult = cfg.RamMultiplier + plowSteps * 0.30

	local prevMax = tonumber(model:GetAttribute("MaxHealth")) or cfg.MaxHealth
	local prevHealth = tonumber(model:GetAttribute("Health")) or prevMax
	local healthRatio = math.clamp(prevHealth / math.max(1, prevMax), 0.1, 1)
	local newHealth = math.round(effectiveMaxHealth * healthRatio)

	model:SetAttribute("EngineLevel", engineLvl)
	model:SetAttribute("ArmorLevel", armorLvl)
	model:SetAttribute("NitroLevel", nitroLvl)
	model:SetAttribute("PlowLevel", plowSteps)
	model:SetAttribute("MaxSpeed", effectiveMaxSpeed)
	model:SetAttribute("Acceleration", effectiveAccel)
	model:SetAttribute("MaxHealth", effectiveMaxHealth)
	model:SetAttribute("Health", newHealth)
	model:SetAttribute("NitroCapacity", effectiveNitroCap)
	model:SetAttribute("RamMultiplier", effectiveRamMult)

	local seat = model:FindFirstChild("DriveSeat") :: VehicleSeat?
	if seat then
		seat.MaxSpeed = 0
		seat.Torque = 0
		seat.TurnSpeed = cfg.TurnSpeed
	end

	-- Attach or upgrade all 5 visual 3D upgrade tracks (Engine, Armor, Nitro, Plow, Magnet)
	local magnetLvl = getPlayerUpgradeLevel(player, "Magnet")
	local magnetSteps = math.max(0, magnetLvl - 1)
	local visualPlowLevel = if cfg.HasBulldozerBlade then math.max(2, plowSteps) else plowSteps
	if VehicleCatalog.AttachVisualUpgrades then
		VehicleCatalog.AttachVisualUpgrades(model, {
			Engine = engineSteps,
			Armor = armorSteps,
			Nitro = nitroSteps,
			Plow = visualPlowLevel,
			Magnet = magnetSteps,
			AccentColor = cfg.AccentColor,
		})
	else
		VehicleCatalog.AttachRamPlow(model, visualPlowLevel, cfg.AccentColor)
	end

	local driver = getDriverFromVehicle(model)
	if driver == player then
		player:SetAttribute("VehicleMaxHealth", effectiveMaxHealth)
		player:SetAttribute("VehicleHealth", newHealth)
	end
end

local function applyDamageToVehicle(model: Model, amount: number, attacker: Player?)
	if not model or not model.Parent then
		return
	end
	if model:GetAttribute("IsWrecked") == true then
		return
	end

	local now = os.clock()
	if lastDamageAt[model] and now - lastDamageAt[model] < 0.08 then
		return
	end
	lastDamageAt[model] = now

	local armorLvl = tonumber(model:GetAttribute("ArmorLevel")) or 1
	local damageReduction = math.clamp(1.0 - (armorLvl - 1) * 0.08, 0.55, 1.0)
	local finalDamage = math.max(1, math.round(amount * damageReduction))

	local currentHealth = tonumber(model:GetAttribute("Health")) or 100
	local maxHealth = tonumber(model:GetAttribute("MaxHealth")) or 100
	local newHealth = math.max(0, currentHealth - finalDamage)
	model:SetAttribute("Health", newHealth)

	updateDamageVFX(model)

	local driver = getDriverFromVehicle(model)
	if driver then
		driver:SetAttribute("VehicleHealth", newHealth)
		driver:SetAttribute("VehicleMaxHealth", maxHealth)
	end

	if newHealth <= 0 then
		model:SetAttribute("IsWrecked", true)
		local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
		local pos = if chassis then chassis.Position else Vector3.new(0, 5, 0)

		ExplosionEffectRemote:FireAllClients(pos, 18)

		if attacker then
			local coinReward = tonumber(model:GetAttribute("CoinReward")) or 25
			DestructionBindable:Fire(attacker, {
				Type = tostring(model:GetAttribute("DisplayName") or model.Name),
				CashReward = coinReward * 2,
				Position = pos,
				IsExplosion = true,
				Heat = 15,
			})
		end

		-- Eject occupant safely
		local seat = model:FindFirstChild("DriveSeat") :: VehicleSeat?
		if seat and seat.Occupant then
			local hum = seat.Occupant
			hum.Sit = false
			local hrp = hum.Parent and hum.Parent:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.new(0, 42, 0)
			end
		end

		if chassis then
			chassis.AssemblyLinearVelocity = Vector3.new(math.random(-18, 18), 32, math.random(-18, 18))
		end

		-- Auto-restore personal vehicle after 4 seconds
		local ownerId = tonumber(model:GetAttribute("OwnerUserId")) or 0
		if ownerId > 0 then
			task.delay(4.0, function()
				if model.Parent then
					repairVehicle(model, true)
				end
			end)
		else
			task.delay(8.0, function()
				if model.Parent then
					repairVehicle(model, false)
				end
			end)
		end
	end
end

--------------------------------------------------------------------------------
-- Seated Driver Head-Clipping Fix & Cabin Silhouette Helper
--------------------------------------------------------------------------------
local function ensureCabinDriverSilhouette(model: Model)
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end
	if model:FindFirstChild("DriverSilhouetteHelmet") then
		return
	end
	local h = chassis.Size.Y
	local cabH = math.max(3.4, h * 1.38)
	local seat = model:FindFirstChild("DriveSeat") :: BasePart?
	local seatZ = if seat then chassis.CFrame:PointToObjectSpace(seat.Position).Z else 0

	local helmet = Instance.new("Part")
	helmet.Name = "DriverSilhouetteHelmet"
	helmet.Shape = Enum.PartType.Ball
	helmet.Size = Vector3.new(1.22, 1.24, 1.28)
	helmet.Color = Color3.fromRGB(18, 22, 28)
	helmet.Material = Enum.Material.SmoothPlastic
	helmet.TopSurface = Enum.SurfaceType.Smooth
	helmet.BottomSurface = Enum.SurfaceType.Smooth
	helmet.CanCollide = false
	helmet.Massless = true
	helmet.CFrame = chassis.CFrame * CFrame.new(0, h * 0.5 + cabH * 0.56, seatZ + 0.04)
	helmet.Parent = model

	local weld = Instance.new("Weld")
	weld.Name = "DriverSilhouetteHelmet_Weld"
	weld.Part0 = chassis
	weld.Part1 = helmet
	weld.C0 = CFrame.new(0, h * 0.5 + cabH * 0.56, seatZ + 0.04)
	weld.Parent = helmet
end

local function shouldHideSeatedCharacterPart(inst: Instance, character: Model): boolean
	if inst:IsA("BasePart") then
		if inst.Name == "HumanoidRootPart" then
			return false
		end
		if inst.Name == "Head"
			or inst.Name == "UpperTorso"
			or inst.Name == "Torso"
			or inst.Name:find("Arm") ~= nil
			or inst.Name:find("Hand") ~= nil
		then
			return true
		end
		if inst:FindFirstAncestorOfClass("Accessory") or inst:FindFirstAncestorOfClass("Hat") then
			return true
		end
		local wodFolder = character:FindFirstChild("WODAvatarAttachments")
		if wodFolder and inst:IsDescendantOf(wodFolder) then
			return true
		end
		if inst.Name:find("AvatarCustomAccessory") ~= nil or inst:GetAttribute("AvatarCustomAccessory") == true then
			return true
		end
		if CollectionService:HasTag(inst, "AvatarCustomAccessory") then
			return true
		end
	elseif inst:IsA("Decal") or inst:IsA("Texture") then
		local parent = inst.Parent
		if parent and (parent.Name == "Head" or parent:FindFirstAncestorOfClass("Accessory") ~= nil) then
			return true
		end
	end
	return false
end

local function setSeatedCharacterHidden(character: Model?, vehicleModel: Model?, hide: boolean)
	if vehicleModel and hide then
		ensureCabinDriverSilhouette(vehicleModel)
	end
	if not character then
		return
	end
	for _, desc in ipairs(character:GetDescendants()) do
		if shouldHideSeatedCharacterPart(desc, character) then
			if desc:IsA("BasePart") then
				if hide then
					if desc:GetAttribute("PreSeatTransparency") == nil and desc.Transparency < 0.99 then
						desc:SetAttribute("PreSeatTransparency", desc.Transparency)
					end
					desc.Transparency = 1
				else
					local saved = tonumber(desc:GetAttribute("PreSeatTransparency"))
					if saved == nil or saved >= 0.99 then
						saved = 0
					end
					desc.Transparency = saved
					desc:SetAttribute("PreSeatTransparency", nil)
				end
			elseif desc:IsA("Decal") or desc:IsA("Texture") then
				if hide then
					if desc:GetAttribute("PreSeatTransparency") == nil and desc.Transparency < 0.99 then
						desc:SetAttribute("PreSeatTransparency", desc.Transparency)
					end
					desc.Transparency = 1
				else
					local saved = tonumber(desc:GetAttribute("PreSeatTransparency"))
					if saved == nil or saved >= 0.99 then
						saved = 0
					end
					desc.Transparency = saved
					desc:SetAttribute("PreSeatTransparency", nil)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Hook Vehicle Seat Occupancy & Prompts
--------------------------------------------------------------------------------
local function hookVehicleModel(model: Model)
	if hookedVehicles[model] then
		return
	end
	local conns: { RBXScriptConnection } = {}
	hookedVehicles[model] = conns

	local seat = model:FindFirstChild("DriveSeat") :: VehicleSeat?
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
	if not seat or not chassis then
		return
	end

	unanchorModel(model)
	ensureCabinDriverSilhouette(model)

	local prompt = seat:FindFirstChild("EnterVehiclePrompt") :: ProximityPrompt?
	if prompt then
		table.insert(
			conns,
			prompt.Triggered:Connect(function(player: Player)
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hum or hum.Health <= 0 then
					return
				end
				if seat.Occupant and seat.Occupant ~= hum then
					-- Hijack if occupied by NPC traffic
					local occPlayer = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
					if not occPlayer then
						seat.Occupant.Sit = false
					else
						return
					end
				end
				seat:Sit(hum)
			end)
		)
	end

	local currentDriver: Player? = nil
	local currentDriverChar: Model? = nil
	local charDescendantConn: RBXScriptConnection? = nil

	table.insert(
		conns,
		seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local occupant = seat.Occupant
			if occupant then
				local char = occupant.Parent :: Model?
				local player = if char then Players:GetPlayerFromCharacter(char) else nil
				if char then
					currentDriverChar = char
					setSeatedCharacterHidden(char, model, true)
					if charDescendantConn then
						charDescendantConn:Disconnect()
					end
					charDescendantConn = char.DescendantAdded:Connect(function()
						if seat.Occupant == occupant then
							task.defer(setSeatedCharacterHidden, char, model, true)
						end
					end)
				end
				if player then
					currentDriver = player
					if prompt then
						prompt.Enabled = false
					end

					unanchorModel(model)
					setModelNetworkOwner(model, player)

					-- If this is the player's vehicle or unclaimed, apply their Garage Upgrades
					local ownerId = tonumber(model:GetAttribute("OwnerUserId")) or 0
					if ownerId == 0 or ownerId == player.UserId then
						model:SetAttribute("OwnerUserId", player.UserId)
						playerVehicles[player.UserId] = model
						ApplyUpgradesToVehicle(player, model)
					end

					local vType = tostring(model:GetAttribute("VehicleType") or model.Name)
					local vName = tostring(model:GetAttribute("DisplayName") or vType)
					local hp = tonumber(model:GetAttribute("Health")) or 100
					local maxHp = tonumber(model:GetAttribute("MaxHealth")) or 100
					local topSpeed = tonumber(model:GetAttribute("MaxSpeed")) or 64
					local nitroCap = tonumber(model:GetAttribute("NitroCapacity")) or 4.0

					player:SetAttribute("InVehicle", true)
					player:SetAttribute("CurrentVehicleType", vType)
					player:SetAttribute("CurrentVehicleName", vName)
					player:SetAttribute("VehicleHealth", hp)
					player:SetAttribute("VehicleMaxHealth", maxHp)

					VehicleEnteredRemote:FireClient(player, {
						VehicleClass = vType,
						VehicleName = vName,
						Health = hp,
						MaxHealth = maxHp,
						TopSpeed = topSpeed,
						NitroDuration = nitroCap,
						NitroCooldown = 4.0,
						Model = model,
					})
				end
			else
				if charDescendantConn then
					charDescendantConn:Disconnect()
					charDescendantConn = nil
				end
				if currentDriverChar and currentDriverChar.Parent then
					setSeatedCharacterHidden(currentDriverChar, model, false)
				end
				currentDriverChar = nil

				if prompt then
					prompt.Enabled = true
				end
				setModelNetworkOwner(model, nil)

				if currentDriver and currentDriver.Parent then
					currentDriver:SetAttribute("InVehicle", false)
					VehicleExitedRemote:FireClient(currentDriver, model)
				end
				currentDriver = nil
			end
		end)
	)

	table.insert(
		conns,
		model:GetAttributeChangedSignal("Health"):Connect(function()
			updateDamageVFX(model)
		end)
	)

	table.insert(
		conns,
		model.AncestryChanged:Connect(function(_, parent)
			if not parent then
				if charDescendantConn then
					charDescendantConn:Disconnect()
					charDescendantConn = nil
				end
				if currentDriverChar and currentDriverChar.Parent then
					setSeatedCharacterHidden(currentDriverChar, model, false)
					currentDriverChar = nil
				end
				local list = hookedVehicles[model]
				if list then
					for _, c in ipairs(list) do
						c:Disconnect()
					end
					hookedVehicles[model] = nil
				end
				lastDamageAt[model] = nil
			end
		end)
	)
end

--------------------------------------------------------------------------------
-- Spawning Player Vehicles & Parked City Fleet
--------------------------------------------------------------------------------
function SpawnPlayerVehicle(
	player: Player,
	requestedType: string?,
	spawnCFrame: CFrame?,
	autoSit: boolean?
): Model?
	if not player or not player.Parent then
		return nil
	end

	local archetypeId = if requestedType and requestedType ~= ""
		then VehicleCatalog.ResolveArchetypeId(requestedType)
		else getPlayerEquippedArchetype(player)

	local cfg = VehicleCatalog.GetConfig(archetypeId)
	local paintColor = getPlayerPaintColor(player, cfg.PrimaryColor)

	-- Compute spawn CFrame near player character or open Grand Central Avenue default
	local targetCF = spawnCFrame
	if not targetCF then
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local look = hrp.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flatLook.Magnitude < 0.05 then
				flatLook = Vector3.new(0, 0, -1)
			else
				flatLook = flatLook.Unit
			end
			-- If player is standing in Leo Plaza near SpawnLocation / fountain, snap onto open Grand Central Avenue
			local candidatePos = if autoSit
				then hrp.Position
				else hrp.Position + flatLook * 14
			if math.abs(candidatePos.X) < 16 and candidatePos.Z > -28 and candidatePos.Z < 32 and not autoSit then
				targetCF = CFrame.new(0, cfg.HoverHeight + 1.2, -10)
			else
				local spawnPos = Vector3.new(candidatePos.X, math.max(hrp.Position.Y, 1.5) + cfg.HoverHeight + 1.0, candidatePos.Z)
				targetCF = CFrame.lookAt(spawnPos, spawnPos + flatLook)
			end
		else
			targetCF = CFrame.new(0, cfg.HoverHeight + 1.2, -10)
		end
	end

	-- Remove old personal vehicle for this player
	local existing = playerVehicles[player.UserId]
	if existing and existing.Parent then
		local seat = existing:FindFirstChild("DriveSeat") :: VehicleSeat?
		if seat and seat.Occupant then
			seat.Occupant.Sit = false
		end
		existing:Destroy()
	end

	local engineLvl = getPlayerUpgradeLevel(player, "Engine")
	local armorLvl = getPlayerUpgradeLevel(player, "Armor")
	local nitroLvl = getPlayerUpgradeLevel(player, "Nitro")
	local plowLvl = getPlayerUpgradeLevel(player, "Plow")

	local vehicle = VehicleCatalog.BuildVehicle(archetypeId, {
		PrimaryColor = paintColor,
		OwnerUserId = player.UserId,
		EngineLevel = math.max(0, engineLvl - 1),
		ArmorLevel = math.max(0, armorLvl - 1),
		NitroLevel = math.max(0, nitroLvl - 1),
		PlowLevel = math.max(0, plowLvl - 1),
		CFrame = targetCF,
	})
	vehicle.Name = player.Name .. "_" .. archetypeId
	vehicle.Parent = vehiclesFolder

	playerVehicles[player.UserId] = vehicle
	hookVehicleModel(vehicle)
	ApplyUpgradesToVehicle(player, vehicle)
	setModelNetworkOwner(vehicle, player)

	if autoSit then
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local seat = vehicle:FindFirstChild("DriveSeat") :: VehicleSeat?
		if hum and hum.Health > 0 and seat then
			task.defer(function()
				if seat.Parent and hum.Parent then
					seat:Sit(hum)
				end
			end)
		end
	end

	return vehicle
end

local function spawnParkedCityVehicles()
	for idx, spec in ipairs(PARKED_SPAWN_SPOTS) do
		local color = spec.Color or VehicleCatalog.GetRandomTrafficColor()
		local model = VehicleCatalog.BuildVehicle(spec.Archetype, {
			PrimaryColor = color,
			IsTraffic = false,
			CFrame = spec.CFrame,
		})
		model.Name = string.format("Parked_%s_%d", spec.Archetype, idx)
		model.Parent = parkedVehiclesFolder
		hookVehicleModel(model)
	end
end

--------------------------------------------------------------------------------
-- Remote & Bindable Listeners
--------------------------------------------------------------------------------
SpawnVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleType: any, autoSit: any)
	local now = os.clock()
	if lastSummonAt[player.UserId] and now - lastSummonAt[player.UserId] < 1.0 then
		return
	end
	lastSummonAt[player.UserId] = now

	local reqType = if type(vehicleType) == "string" then vehicleType else nil
	local shouldSit = if type(autoSit) == "boolean" then autoSit else true
	SpawnPlayerVehicle(player, reqType, nil, shouldSit)
end)

SummonVehicleRemote.OnServerEvent:Connect(function(player: Player, vehicleType: any, autoSit: any)
	local now = os.clock()
	if lastSummonAt[player.UserId] and now - lastSummonAt[player.UserId] < 1.0 then
		return
	end
	lastSummonAt[player.UserId] = now

	local reqType = if type(vehicleType) == "string" then vehicleType else nil
	local shouldSit = if type(autoSit) == "boolean" then autoSit else true
	local model = SpawnPlayerVehicle(player, reqType, nil, shouldSit)
	if model then
		NotificationRemote:FireClient(player, {
			Title = "VEHICLE DELIVERED",
			Message = string.format("%s summoned!", tostring(model:GetAttribute("DisplayName") or model.Name)),
			Category = "Info",
			Color = Color3.fromRGB(80, 195, 255),
			Duration = 2.0,
		})
	end
end)

RepairVehicleRemote.OnServerEvent:Connect(function(player: Player)
	local vehicle = playerVehicles[player.UserId]
	if vehicle and vehicle.Parent then
		repairVehicle(vehicle, true)
	end
end)

EnterNearestVehicleRemote.OnServerEvent:Connect(function(player: Player, targetModel: any)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp or hum.Health <= 0 or hum.Sit then
		return
	end

	local bestSeat: VehicleSeat? = nil
	local bestDist = 24

	if typeof(targetModel) == "Instance" and targetModel:IsA("Model") then
		local s = targetModel:FindFirstChild("DriveSeat") :: VehicleSeat?
		if s and (s.Position - hrp.Position).Magnitude <= 26 then
			bestSeat = s
		end
	end

	if not bestSeat then
		for _, veh in ipairs(CollectionService:GetTagged("Vehicle")) do
			if veh:IsA("Model") then
				local s = veh:FindFirstChild("DriveSeat") :: VehicleSeat?
				if s then
					local d = (s.Position - hrp.Position).Magnitude
					if d < bestDist then
						bestDist = d
						bestSeat = s
					end
				end
			end
		end
	end

	if bestSeat then
		if bestSeat.Occupant and bestSeat.Occupant ~= hum then
			local occPlayer = Players:GetPlayerFromCharacter(bestSeat.Occupant.Parent)
			if not occPlayer then
				bestSeat.Occupant.Sit = false
			else
				return
			end
		end
		bestSeat:Sit(hum)
	end
end)

ToggleHeadlightsRemote.OnServerEvent:Connect(function(player: Player, stateOverride: any)
	local vehicle = playerVehicles[player.UserId]
	if not vehicle or not vehicle.Parent then
		return
	end
	local current = vehicle:GetAttribute("HeadlightsOn") == true
	local nextState = if type(stateOverride) == "boolean" then stateOverride else not current
	vehicle:SetAttribute("HeadlightsOn", nextState)

	for _, partName in ipairs({ "HeadlightL", "HeadlightR" }) do
		local hl = vehicle:FindFirstChild(partName) :: BasePart?
		if hl then
			hl.Material = if nextState then Enum.Material.Neon else Enum.Material.SmoothPlastic
			local spot = hl:FindFirstChildOfClass("SpotLight")
			if spot then
				spot.Enabled = nextState
			end
		end
	end
end)

VehicleDamageRemote.OnServerEvent:Connect(function(player: Player, amount: any)
	local vehicle = playerVehicles[player.UserId]
	if not vehicle or not vehicle.Parent then
		return
	end
	local dmg = math.clamp(tonumber(amount) or 5, 1, 80)
	applyDamageToVehicle(vehicle, dmg, nil)
end)

VehicleVFXRemote.OnServerEvent:Connect(function(player: Player, vfxKind: any, enabled: any)
	local vehicle = playerVehicles[player.UserId]
	if not vehicle or not vehicle.Parent then
		return
	end
	local chassis = vehicle.PrimaryPart or vehicle:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end
	local isOn = enabled == true
	local kind = tostring(vfxKind or "")

	if kind == "Nitro" then
		for _, attName in ipairs({ "ExhaustAttachmentL", "ExhaustAttachmentR" }) do
			local att = chassis:FindFirstChild(attName)
			local emitter = att and att:FindFirstChild("NitroFlame") :: ParticleEmitter?
			if emitter then
				emitter.Enabled = isOn
			end
		end
	elseif kind == "Drift" then
		for _, attName in ipairs({ "DriftAttachmentL", "DriftAttachmentR" }) do
			local att = chassis:FindFirstChild(attName)
			local emitter = att and att:FindFirstChild("DriftSmoke") :: ParticleEmitter?
			if emitter then
				emitter.Enabled = isOn
			end
		end
		for _, trailName in ipairs({ "SkidTrailL", "SkidTrailR" }) do
			local trail = chassis:FindFirstChild(trailName) :: Trail?
			if trail then
				trail.Enabled = isOn
			end
		end
	end
end)

DamageVehicleBindable.Event:Connect(function(vehicle: Model, amount: number, attacker: Player?)
	if typeof(vehicle) == "Instance" and vehicle:IsA("Model") then
		applyDamageToVehicle(vehicle, tonumber(amount) or 10, attacker)
	end
end)

SpawnPlayerVehicleBindable.Event:Connect(function(player: Player, vehicleType: string?, spawnCF: CFrame?, autoSit: boolean?)
	if typeof(player) == "Instance" and player:IsA("Player") then
		SpawnPlayerVehicle(player, vehicleType, spawnCF, autoSit)
	end
end)

RepairPlayerVehicleBindable.Event:Connect(function(player: Player)
	if typeof(player) == "Instance" and player:IsA("Player") then
		local veh = playerVehicles[player.UserId]
		if veh then
			repairVehicle(veh, true)
		end
	end
end)

--------------------------------------------------------------------------------
-- Player Lifecycle & Garage Attribute Sync
--------------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		task.wait(0.25)
		if not player.Parent or player.Character ~= character then
			return
		end
		local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local spawnCF: CFrame
			if math.abs(hrp.Position.X) < 32 and math.abs(hrp.Position.Z - 22) < 36 then
				spawnCF = CFrame.new(0, 3.2, 22)
			else
				local look = hrp.CFrame.LookVector
				local flatLook = Vector3.new(look.X, 0, look.Z)
				if flatLook.Magnitude < 0.05 then
					flatLook = Vector3.new(0, 0, -1)
				else
					flatLook = flatLook.Unit
				end
				local spawnPos = Vector3.new(hrp.Position.X, 3.2, hrp.Position.Z)
				spawnCF = CFrame.lookAt(spawnPos, spawnPos + flatLook)
			end
			-- Auto-seat the player in their vehicle on spawn so pressing [W] immediately drives!
			local veh = SpawnPlayerVehicle(player, nil, spawnCF, true)
			if veh then
				setModelNetworkOwner(veh, player)
			end
		end
	end)

	-- Live-update vehicle stats/plow whenever player upgrades change
	for _, attr in ipairs({ "Upgrade_Engine", "Upgrade_Armor", "Upgrade_Nitro", "Upgrade_Plow", "EngineLevel", "ArmorLevel", "NitroLevel", "PlowLevel" }) do
		player:GetAttributeChangedSignal(attr):Connect(function()
			local veh = playerVehicles[player.UserId]
			if veh and veh.Parent then
				ApplyUpgradesToVehicle(player, veh)
			end
		end)
	end

	-- Respawn/swap vehicle when EquippedVehicle changes in Speed Shop and auto-sit the player!
	player:GetAttributeChangedSignal("EquippedVehicle"):Connect(function()
		local newType = getPlayerEquippedArchetype(player)
		local currentVeh = playerVehicles[player.UserId]
		if currentVeh and currentVeh.Parent then
			local currentType = tostring(currentVeh:GetAttribute("VehicleType") or "")
			if currentType ~= newType then
				local chassis = currentVeh.PrimaryPart
				local cf = if chassis then chassis.CFrame else nil
				SpawnPlayerVehicle(player, newType, cf, true)
			end
		else
			SpawnPlayerVehicle(player, newType, nil, true)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	local veh = playerVehicles[player.UserId]
	if veh and veh.Parent then
		veh:Destroy()
	end
	playerVehicles[player.UserId] = nil
	lastMechanicHealAt[player.UserId] = nil
	lastSummonAt[player.UserId] = nil
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Hook any vehicles added dynamically by other services
CollectionService:GetInstanceAddedSignal("Vehicle"):Connect(function(inst: Instance)
	if inst:IsA("Model") then
		task.defer(hookVehicleModel, inst)
	end
end)

spawnParkedCityVehicles()

--------------------------------------------------------------------------------
-- Heartbeat: Mechanic Spot Auto-Repair Proximity Check
--------------------------------------------------------------------------------
local mechanicCheckAccumulator = 0

RunService.Heartbeat:Connect(function(dt: number)
	mechanicCheckAccumulator += dt
	if mechanicCheckAccumulator < 0.35 then
		return
	end
	mechanicCheckAccumulator = 0

	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		local veh = playerVehicles[player.UserId]
		if not veh or not veh.Parent then
			continue
		end
		local chassis = veh.PrimaryPart
		if not chassis then
			continue
		end

		local hp = tonumber(veh:GetAttribute("Health")) or 100
		local maxHp = tonumber(veh:GetAttribute("MaxHealth")) or 100
		if hp >= maxHp and veh:GetAttribute("IsWrecked") ~= true then
			continue
		end

		if lastMechanicHealAt[player.UserId] and now - lastMechanicHealAt[player.UserId] < MECHANIC_COOLDOWN then
			continue
		end

		local pos = chassis.Position
		local nearMechanic = false

		for _, spot in ipairs(DEFAULT_MECHANIC_SPOTS) do
			if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(spot.Position.X, 0, spot.Position.Z)).Magnitude <= MECHANIC_HEAL_RADIUS then
				nearMechanic = true
				break
			end
		end

		if not nearMechanic then
			for _, tagged in ipairs(CollectionService:GetTagged("MechanicSpot")) do
				local spotPos: Vector3? = nil
				if tagged:IsA("BasePart") then
					spotPos = tagged.Position
				elseif tagged:IsA("Model") and tagged.PrimaryPart then
					spotPos = tagged.PrimaryPart.Position
				end
				if spotPos and (pos - spotPos).Magnitude <= MECHANIC_HEAL_RADIUS then
					nearMechanic = true
					break
				end
			end
		end

		if nearMechanic then
			lastMechanicHealAt[player.UserId] = now
			repairVehicle(veh, true)
		end
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000015">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">ViralRetentionAndZonesService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- ViralRetentionAndZonesService.script.luau
-- Implements Driving Empire paycheck-for-driving loop, Playtime Gift Chests, and Rebirth multiplier.
-- (Out-of-place neon viral archways, laser gates, spinning diamond cube, and shredder pit disabled
-- to preserve an authentic Snowy Christmas Manhattan aesthetic.)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

-- Clean up any legacy LeoCityViralZones folder if present
local existingZones = Workspace:FindFirstChild("LeoCityViralZones")
if existingZones then
	existingZones:Destroy()
end

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

local function ensureRemoteFunction(name: string): RemoteFunction
	local existing = remotesFolder:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end
	local rf = Instance.new("RemoteFunction")
	rf.Name = name
	rf.Parent = remotesFolder
	return rf
end

local claimPlaytimeGiftRF = ensureRemoteFunction("ClaimPlaytimeGift")
local requestRebirthRF = ensureRemoteFunction("RequestRebirth")

local PLAYTIME_GIFTS = {
	{ Index = 1, Seconds = 45, Reward = 500, Label = "45s Holiday Gift" },
	{ Index = 2, Seconds = 120, Reward = 1200, Label = "2m Holiday Gift" },
	{ Index = 3, Seconds = 240, Reward = 2500, Label = "4m Holiday Gift" },
	{ Index = 4, Seconds = 420, Reward = 5000, Label = "7m Holiday Gift" },
	{ Index = 5, Seconds = 600, Reward = 10000, Label = "10m Holiday Gift" },
	{ Index = 6, Seconds = 900, Reward = 25000, Label = "15m Holiday Jackpot" },
}

local playerClaimedGifts: { [Player]: { [number]: boolean } } = {}
local playerLastDrivePos: { [Player]: Vector3 } = {}
local playerDriveStuds: { [Player]: number } = {}

local function getRebirthMultiplier(player: Player): number
	local mult = tonumber(player:GetAttribute("RebirthMultiplier")) or 1
	return math.max(1, mult)
end

local function getPlayerCash(player: Player): number
	local attrCash = tonumber(player:GetAttribute("Cash"))
	if attrCash ~= nil then
		return attrCash
	end
	local ls = player:FindFirstChild("leaderstats")
	local cashVal = ls and ls:FindFirstChild("Cash")
	if cashVal and cashVal:IsA("IntValue") then
		return cashVal.Value
	end
	return 0
end

local function addPlayerCash(player: Player, baseAmount: number, reason: string?): number
	local finalAmount = math.floor(baseAmount * getRebirthMultiplier(player) + 0.5)
	local addCashBindable = ServerStorage:FindFirstChild("AddCashEvent")
	if addCashBindable and addCashBindable:IsA("BindableEvent") then
		addCashBindable:Fire(player, finalAmount, reason or "ViralReward")
	else
		local newCash = math.max(0, getPlayerCash(player) + finalAmount)
		player:SetAttribute("Cash", newCash)
		local ls = player:FindFirstChild("leaderstats")
		local cashVal = ls and ls:FindFirstChild("Cash")
		if cashVal and cashVal:IsA("IntValue") then
			cashVal.Value = newCash
		end
	end
	if reason then
		player:SetAttribute("LastViralBonusText", string.format("+$%d %s", finalAmount, reason))
	end
	return finalAmount
end

local function setPlayerCashExact(player: Player, newCash: number)
	local current = getPlayerCash(player)
	local delta = newCash - current
	local addCashBindable = ServerStorage:FindFirstChild("AddCashEvent")
	if addCashBindable and addCashBindable:IsA("BindableEvent") then
		addCashBindable:Fire(player, delta, "RebirthReset")
	end
	player:SetAttribute("Cash", newCash)
	local ls = player:FindFirstChild("leaderstats")
	local cashVal = ls and ls:FindFirstChild("Cash")
	if cashVal and cashVal:IsA("IntValue") then
		cashVal.Value = newCash
	end
end

local function updateCrownTitle(player: Player)
	local rebirths = tonumber(player:GetAttribute("RebirthCount")) or 0
	if rebirths <= 0 then
		return
	end
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return
	end
	local existing = head:FindFirstChild("RebirthCrownTag")
	if existing then
		existing:Destroy()
	end
end

local function syncGiftAttributes(player: Player)
	local claimed = playerClaimedGifts[player] or {}
	local playSec = tonumber(player:GetAttribute("PlaytimeSeconds")) or 0
	local list = {}
	local nextRemaining = 0
	local readyCount = 0
	for _, g in ipairs(PLAYTIME_GIFTS) do
		if claimed[g.Index] then
			table.insert(list, tostring(g.Index))
		elseif playSec >= g.Seconds then
			readyCount += 1
		elseif nextRemaining == 0 then
			nextRemaining = math.max(1, g.Seconds - playSec)
		end
	end
	player:SetAttribute("ClaimedGiftsCSV", table.concat(list, ","))
	player:SetAttribute("ReadyGiftCount", readyCount)
	player:SetAttribute("NextGiftSecondsLeft", nextRemaining)
end

claimPlaytimeGiftRF.OnServerInvoke = function(player: Player, giftIndex: any)
	local idx = tonumber(giftIndex)
	local gift = idx and PLAYTIME_GIFTS[idx]
	if not gift then
		return { Success = false, Message = "Invalid gift" }
	end
	playerClaimedGifts[player] = playerClaimedGifts[player] or {}
	if playerClaimedGifts[player][idx] then
		return { Success = false, Message = "Already claimed" }
	end
	local playSec = tonumber(player:GetAttribute("PlaytimeSeconds")) or 0
	if playSec < gift.Seconds then
		return { Success = false, Message = "Keep playing to unlock!" }
	end
	playerClaimedGifts[player][idx] = true
	local earned = addPlayerCash(player, gift.Reward, "HOLIDAY GIFT")
	syncGiftAttributes(player)
	return { Success = true, Reward = earned, GiftIndex = idx }
end

requestRebirthRF.OnServerInvoke = function(player: Player)
	local rebirths = tonumber(player:GetAttribute("RebirthCount")) or 0
	local cost = 25000 * (rebirths + 1)
	local cash = getPlayerCash(player)
	if cash < cost then
		return { Success = false, Message = string.format("Need $%d Cash to Rebirth!", cost), Cost = cost }
	end
	rebirths += 1
	local newMult = 1 + rebirths * 1.0
	player:SetAttribute("RebirthCount", rebirths)
	player:SetAttribute("RebirthMultiplier", newMult)
	setPlayerCashExact(player, 1500)
	updateCrownTitle(player)
	return { Success = true, RebirthCount = rebirths, RebirthMultiplier = newMult, NextCost = 25000 * (rebirths + 1) }
end

local function setupPlayer(player: Player)
	playerClaimedGifts[player] = {}
	playerDriveStuds[player] = 0
	player:SetAttribute("PlaytimeSeconds", 0)
	player:SetAttribute("RebirthCount", tonumber(player:GetAttribute("RebirthCount")) or 0)
	player:SetAttribute("RebirthMultiplier", 1 + (tonumber(player:GetAttribute("RebirthCount")) or 0) * 1.0)
	player:SetAttribute("DrivePaycheckEarned", 0)
	syncGiftAttributes(player)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		updateCrownTitle(player)
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	playerClaimedGifts[player] = nil
	playerLastDrivePos[player] = nil
	playerDriveStuds[player] = nil
end)
for _, p in ipairs(Players:GetPlayers()) do
	setupPlayer(p)
end

task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local playSec = (tonumber(player:GetAttribute("PlaytimeSeconds")) or 0) + 1
			player:SetAttribute("PlaytimeSeconds", playSec)
			syncGiftAttributes(player)

			local char = player.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			if rootPart and rootPart:IsA("BasePart") then
				local pos = Vector3.new(rootPart.Position.X, 0, rootPart.Position.Z)
				local last = playerLastDrivePos[player]
				playerLastDrivePos[player] = pos
				if last then
					local step = (pos - last).Magnitude
					if step >= 3 and step <= 220 then
						local accum = (playerDriveStuds[player] or 0) + step
						while accum >= 80 do
							accum -= 80
							local paid = addPlayerCash(player, 25, "DRIVE PAYCHECK")
							player:SetAttribute("DrivePaycheckEarned", (tonumber(player:GetAttribute("DrivePaycheckEarned")) or 0) + paid)
						end
						playerDriveStuds[player] = accum
					end
				end
			end
		end
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000016">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">WeatherTimeService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- WeatherTimeService.script.luau
-- Crisp Snowy Christmas NYC late-afternoon / twilight weather system for Leo City:
-- Keeps ClockTime around 15.6 (crisp winter twilight where snowy Central Park and tall Manhattan
-- limestone skyscrapers are clearly visible while warm golden Christmas lights & streetlamps glow),
-- BloomEffect.Intensity = 0.14, BloomEffect.Threshold = 2.2 (zero blurry neon blobs),
-- and gentle falling snowflakes (SnowEmitter) across the city.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- LIGHTING POST-PROCESSING & ATMOSPHERE SETUP
--------------------------------------------------------------------------------
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
if not atmosphere then
	atmosphere = Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
end
atmosphere.Density = 0.15
atmosphere.Offset = 0.10
atmosphere.Color = Color3.fromRGB(185, 200, 222)
atmosphere.Decay = Color3.fromRGB(125, 140, 165)
atmosphere.Glare = 0.04
atmosphere.Haze = 0.45

local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
if not bloom then
	bloom = Instance.new("BloomEffect")
	bloom.Parent = Lighting
end
bloom.Enabled = true
bloom.Intensity = 0.14
bloom.Size = 14
bloom.Threshold = 2.2

local colorCorrection = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
if not colorCorrection then
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Parent = Lighting
end
colorCorrection.Enabled = true
colorCorrection.Brightness = 0.02
colorCorrection.Contrast = 0.12
colorCorrection.Saturation = 0.06
colorCorrection.TintColor = Color3.fromRGB(246, 249, 255)

--------------------------------------------------------------------------------
-- WEATHER & TIME PRESETS (SNOWY CHRISTMAS MANHATTAN)
--------------------------------------------------------------------------------
type WeatherPreset = {
	name: string,
	displayName: string,
	clockTime: number,
	brightness: number,
	ambient: Color3,
	outdoorAmbient: Color3,
	fogColor: Color3,
	colorShiftTop: Color3,
	atmosphereDensity: number,
	atmosphereOffset: number,
	atmosphereGlare: number,
	atmosphereHaze: number,
	atmosphereColor: Color3,
	atmosphereDecay: Color3,
	roadReflectance: number,
	roadMaterial: Enum.Material,
	gripMultiplier: number,
	isSnowing: boolean,
	isRaining: boolean,
	snowRate: number,
	rainRate: number,
	bloomIntensity: number,
}

local PRESETS: { WeatherPreset } = {
	{
		name = "Snowstorm",
		displayName = "Central Park Christmas Snowfall",
		clockTime = 15.6,
		brightness = 2.55,
		ambient = Color3.fromRGB(128, 138, 156),
		outdoorAmbient = Color3.fromRGB(158, 170, 190),
		fogColor = Color3.fromRGB(168, 182, 204),
		colorShiftTop = Color3.fromRGB(215, 226, 245),
		atmosphereDensity = 0.15,
		atmosphereOffset = 0.10,
		atmosphereGlare = 0.04,
		atmosphereHaze = 0.45,
		atmosphereColor = Color3.fromRGB(185, 200, 222),
		atmosphereDecay = Color3.fromRGB(125, 140, 165),
		roadReflectance = 0.10,
		roadMaterial = Enum.Material.Asphalt,
		gripMultiplier = 0.96,
		isSnowing = true,
		isRaining = false,
		snowRate = 280,
		rainRate = 0,
		bloomIntensity = 0.14,
	},
	{
		name = "CloudyNYC",
		displayName = "5th Avenue Holiday Flurries",
		clockTime = 15.6,
		brightness = 2.60,
		ambient = Color3.fromRGB(132, 142, 160),
		outdoorAmbient = Color3.fromRGB(162, 174, 194),
		fogColor = Color3.fromRGB(172, 186, 208),
		colorShiftTop = Color3.fromRGB(220, 230, 248),
		atmosphereDensity = 0.14,
		atmosphereOffset = 0.09,
		atmosphereGlare = 0.04,
		atmosphereHaze = 0.40,
		atmosphereColor = Color3.fromRGB(190, 204, 226),
		atmosphereDecay = Color3.fromRGB(130, 144, 168),
		roadReflectance = 0.10,
		roadMaterial = Enum.Material.Asphalt,
		gripMultiplier = 0.97,
		isSnowing = true,
		isRaining = false,
		snowRate = 220,
		rainRate = 0,
		bloomIntensity = 0.14,
	},
}

--------------------------------------------------------------------------------
-- OVERHEAD NYC PRECIPITATION CANOPY (GENTLE CHRISTMAS SNOWFLAKES)
--------------------------------------------------------------------------------
local existingCanopy = Workspace:FindFirstChild("NYCPrecipitationCanopy")
if existingCanopy then
	existingCanopy:Destroy()
end

local canopyPart = Instance.new("Part")
canopyPart.Name = "NYCPrecipitationCanopy"
canopyPart.Size = Vector3.new(360, 2, 360)
canopyPart.Position = Vector3.new(0, 92, 0)
canopyPart.Anchored = true
canopyPart.CanCollide = false
canopyPart.CanQuery = false
canopyPart.CanTouch = false
canopyPart.CastShadow = false
canopyPart.Transparency = 1
canopyPart.Parent = Workspace

local snowEmitter = Instance.new("ParticleEmitter")
snowEmitter.Name = "SnowEmitter"
snowEmitter.Color = ColorSequence.new(Color3.fromRGB(246, 250, 255))
snowEmitter.LightEmission = 0.30
snowEmitter.LightInfluence = 0.45
snowEmitter.Size = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.38),
	NumberSequenceKeypoint.new(0.5, 0.48),
	NumberSequenceKeypoint.new(1, 0.28),
})
snowEmitter.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.18),
	NumberSequenceKeypoint.new(0.8, 0.28),
	NumberSequenceKeypoint.new(1, 0.90),
})
snowEmitter.Lifetime = NumberRange.new(3.5, 5.2)
snowEmitter.Rate = 280
snowEmitter.Speed = NumberRange.new(18, 28)
snowEmitter.SpreadAngle = Vector2.new(16, 16)
snowEmitter.Acceleration = Vector3.new(-4, -3, 2)
snowEmitter.RotSpeed = NumberRange.new(-40, 40)
snowEmitter.EmissionDirection = Enum.NormalId.Bottom
snowEmitter.Enabled = true
snowEmitter.Parent = canopyPart

local rainEmitter = Instance.new("ParticleEmitter")
rainEmitter.Name = "RainEmitter"
rainEmitter.Rate = 0
rainEmitter.Enabled = false
rainEmitter.Parent = canopyPart

-- Follow active players on Heartbeat so gentle Christmas snow surrounds the player & nearby skyscrapers
RunService.Heartbeat:Connect(function()
	local sumPos = Vector3.zero
	local count = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			sumPos += hrp.Position
			count += 1
		end
	end
	if count > 0 then
		local avg = sumPos / count
		canopyPart.Position = Vector3.new(avg.X, 92, avg.Z)
	else
		local cam = Workspace.CurrentCamera
		if cam then
			local cPos = cam.CFrame.Position
			canopyPart.Position = Vector3.new(cPos.X, 92, cPos.Z)
		end
	end
end)

local function updateRoadWetness(reflectance: number, material: Enum.Material)
	local city = Workspace:FindFirstChild("LeoCity")
	local roads = city and city:FindFirstChild("Roads")
	if not roads then
		return
	end
	for _, part in ipairs(roads:GetChildren()) do
		if part:IsA("BasePart") and (part.Name == "RoadNS" or part.Name == "RoadEW" or part.Name == "GrandCentralAveNS") then
			part.Reflectance = reflectance
			part.Material = material
		end
	end
end

--------------------------------------------------------------------------------
-- APPLY WEATHER & CYCLE LOOP
--------------------------------------------------------------------------------
local DWELL_DURATION = 60.0
local TRANSITION_DURATION = 6.0
local currentPresetIndex = 1

local function applyPreset(preset: WeatherPreset, instant: boolean?)
	Workspace:SetAttribute("CurrentWeather", preset.name)
	Workspace:SetAttribute("WeatherState", preset.name)
	Workspace:SetAttribute("WeatherDisplayName", preset.displayName)
	Workspace:SetAttribute("TimeOfDayState", preset.name)
	Workspace:SetAttribute("RoadGripMultiplier", preset.gripMultiplier)
	Workspace:SetAttribute("IsSnowing", preset.isSnowing)
	Workspace:SetAttribute("IsRaining", preset.isRaining)
	Workspace:SetAttribute("ClockTime", preset.clockTime)

	if instant then
		Lighting.ClockTime = preset.clockTime
		Lighting.Brightness = preset.brightness
		Lighting.Ambient = preset.ambient
		Lighting.OutdoorAmbient = preset.outdoorAmbient
		Lighting.FogColor = preset.fogColor
		Lighting.ColorShift_Top = preset.colorShiftTop
		if atmosphere then
			atmosphere.Density = preset.atmosphereDensity
			atmosphere.Offset = preset.atmosphereOffset
			atmosphere.Glare = preset.atmosphereGlare
			atmosphere.Haze = preset.atmosphereHaze
			atmosphere.Color = preset.atmosphereColor
			atmosphere.Decay = preset.atmosphereDecay
		end
		if bloom then
			bloom.Intensity = preset.bloomIntensity
			bloom.Size = 14
			bloom.Threshold = 2.2
		end
	else
		local tweenInfo = TweenInfo.new(TRANSITION_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		TweenService:Create(Lighting, tweenInfo, {
			ClockTime = preset.clockTime,
			Brightness = preset.brightness,
			Ambient = preset.ambient,
			OutdoorAmbient = preset.outdoorAmbient,
			FogColor = preset.fogColor,
			ColorShift_Top = preset.colorShiftTop,
		}):Play()

		if atmosphere then
			TweenService:Create(atmosphere, tweenInfo, {
				Density = preset.atmosphereDensity,
				Offset = preset.atmosphereOffset,
				Glare = preset.atmosphereGlare,
				Haze = preset.atmosphereHaze,
				Color = preset.atmosphereColor,
				Decay = preset.atmosphereDecay,
			}):Play()
		end

		if bloom then
			bloom.Threshold = 2.2
			TweenService:Create(bloom, tweenInfo, {
				Intensity = preset.bloomIntensity,
			}):Play()
		end
	end

	snowEmitter.Rate = preset.snowRate
	snowEmitter.Enabled = preset.isSnowing
	rainEmitter.Rate = 0
	rainEmitter.Enabled = false
	updateRoadWetness(preset.roadReflectance, preset.roadMaterial)
end

-- Initialize immediately with Snowy Christmas Manhattan at ClockTime = 15.6
applyPreset(PRESETS[1], true)

task.spawn(function()
	while true do
		task.wait(DWELL_DURATION)
		currentPresetIndex = (currentPresetIndex % #PRESETS) + 1
		applyPreset(PRESETS[currentPresetIndex], false)
	end
end)

print("[WeatherTimeService] Snowy Christmas Manhattan weather cycle active at ClockTime 15.6.")
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX00000017">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">WorldBuilderService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- WorldBuilderService.script.luau
-- Procedurally generates Leo City in Workspace.LeoCity with multi-block grid,
-- districts (Downtown, Industrial Construction Yard, Beachfront Boardwalk, Suburban Park),
-- interactive zones (Speed Shop, Mechanic Repair Bays, Stunt Ramps), and hundreds of
-- CollectionService-tagged "Destructible" props.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

--------------------------------------------------------------------------------
-- SHARED EVENTS & FOLDERS
--------------------------------------------------------------------------------
local function ensureEvents()
	local serverEvents = ServerStorage:FindFirstChild("ServerEvents")
	if not serverEvents then
		serverEvents = Instance.new("Folder")
		serverEvents.Name = "ServerEvents"
		serverEvents.Parent = ServerStorage
	end
	if not serverEvents:FindFirstChild("DestructionOccurred") then
		local be = Instance.new("BindableEvent")
		be.Name = "DestructionOccurred"
		be.Parent = serverEvents
	end
	if not serverEvents:FindFirstChild("MechanicTriggered") then
		local be = Instance.new("BindableEvent")
		be.Name = "MechanicTriggered"
		be.Parent = serverEvents
	end
	if not serverEvents:FindFirstChild("SpeedShopTriggered") then
		local be = Instance.new("BindableEvent")
		be.Name = "SpeedShopTriggered"
		be.Parent = serverEvents
	end

	local repEvents = ReplicatedStorage:FindFirstChild("Remotes")
	if not repEvents then
		repEvents = Instance.new("Folder")
		repEvents.Name = "Remotes"
		repEvents.Parent = ReplicatedStorage
	end
	for _, name in ipairs({ "DestructionOccurred", "OpenSpeedShop", "VehicleRepaired", "StuntJumpTriggered" }) do
		if not repEvents:FindFirstChild(name) then
			local re = Instance.new("RemoteEvent")
			re.Name = name
			re.Parent = repEvents
		end
	end
	return serverEvents, repEvents
end

local ServerEvents, RemoteEvents = ensureEvents()

--------------------------------------------------------------------------------
-- CONSTANTS & GRID CONFIG
--------------------------------------------------------------------------------
local BLOCK_SIZE = 180 -- spacious 180-stud NYC blocks so buildings, plazas, and 4-lane avenues never overlap!
local ROAD_WIDTH = 38 -- 4-lane NYC avenues
local SIDEWALK_WIDTH = 10 -- bluestone sidewalk
local GRID_RADIUS = 3 -- -3..3 = 7x7 full city blocks (-630..630 road lines)

Workspace:SetAttribute("LeoCityBlockSize", BLOCK_SIZE)
Workspace:SetAttribute("LeoCityRoadWidth", ROAD_WIDTH)
Workspace:SetAttribute("LeoCityGridRadius", GRID_RADIUS)

local existingPreview = Workspace:FindFirstChild("LeoCity_EditPreview")
if existingPreview then
	existingPreview:Destroy()
end

local existingCity = Workspace:FindFirstChild("LeoCity")
if existingCity then
	existingCity:Destroy()
end

local defaultSpawn = Workspace:FindFirstChild("SpawnLocation")
if defaultSpawn and defaultSpawn:IsA("SpawnLocation") then
	defaultSpawn:Destroy()
end

local CityRoot = Instance.new("Folder")
CityRoot.Name = "LeoCity"
CityRoot.Parent = Workspace

local RoadsFolder = Instance.new("Folder")
RoadsFolder.Name = "Roads"
RoadsFolder.Parent = CityRoot

local BuildingsFolder = Instance.new("Folder")
BuildingsFolder.Name = "Buildings"
BuildingsFolder.Parent = CityRoot

local LandmarksFolder = Instance.new("Folder")
LandmarksFolder.Name = "Landmarks"
LandmarksFolder.Parent = CityRoot

local localZonesFolder = Instance.new("Folder")
localZonesFolder.Name = "InteractiveZones"
localZonesFolder.Parent = CityRoot

local PropsFolder = Instance.new("Folder")
PropsFolder.Name = "DestructibleProps"
PropsFolder.Parent = CityRoot

local TrafficLightsFolder = Instance.new("Folder")
TrafficLightsFolder.Name = "TrafficLights"
TrafficLightsFolder.Parent = CityRoot

--------------------------------------------------------------------------------
-- PART & SIGN HELPERS
--------------------------------------------------------------------------------
local function makePart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, anchored: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	p.Anchored = if anchored == nil then true else anchored
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function makeWedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material): WedgePart
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Size = size
	w.CFrame = cf
	w.Color = color
	w.Material = mat
	w.Anchored = true
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	w.Parent = parent
	return w
end

local function addSurfaceSign(part: BasePart, text: string, textColor: Color3, face: Enum.NormalId?)
	local sg = Instance.new("SurfaceGui")
	sg.Name = "SignGui"
	sg.Face = face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 24
	sg.LightInfluence = 0
	sg.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextStrokeTransparency = 0.2
	label.Parent = sg
end

local function weldChildrenToPrimary(model: Model, primary: BasePart)
	model.PrimaryPart = primary
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BasePart") and desc ~= primary then
			local w = Instance.new("Weld")
			w.Name = desc.Name .. "_Weld"
			w.Part0 = primary
			w.Part1 = desc
			w.C0 = primary.CFrame:Inverse() * desc.CFrame
			w.Parent = desc
			desc.Anchored = false
		end
	end
end

local PROP_DEFAULT_REQUIRED_TIER: { [string]: number } = {
	-- Tier 1: All Everyday Street Props, Hydrants, Streetlights, Bus Stops, Billboards & Taxis (Starter Car Smashes All!)
	Crate = 1,
	WoodenCrate = 1,
	JackpotCrate = 1,
	TrafficCone = 1,
	Fence = 1,
	Bench = 1,
	TrashCan = 1,
	RecyclingBin = 1,
	Mailbox = 1,
	NewspaperBox = 1,
	FoodVendorCart = 1,
	CafePatio = 1,
	ConstructionBarrier = 1,
	FireHydrant = 1,
	StreetLight = 1,
	TrafficLight = 1,
	BusStop = 1,
	PalmTree = 1,
	SnowyChristmasTree = 1,
	Snowman = 1,
	Billboard = 1,
	TrafficVehicle = 1,
	-- Tier 2: Gold ATMs & Explosive Fuel Targets (Unlocked by Sedan / Muscle or Plow Lv.2)
	GoldATM = 2,
	GasPump = 2,
	ExplosiveBarrel = 2,
	-- Tier 3: Heavy Armored Cash Trucks & Surveillance Towers (Unlocked by SUV / Pickup / Sports or Plow Lv.3)
	ArmoredCashTruck = 3,
	MegaCorpTower = 3,
	-- Tier 4: Massive Civic Landmarks & Transit Buses (Unlocked by Monster Truck or Plow Lv.4)
	CityBus = 4,
	ConstructionCrane = 4,
	PlazaFountain = 4,
	-- Tier 5: Ultra-Armored End-Game Bank Vaults & Boss (Unlocked by Goliath Bulldozer or Plow Lv.5)
	MegaCorpBankVault = 5,
	BossGoliath = 5,
}

local function tagDestructible(
	instance: Instance,
	propType: string,
	cashValue: number,
	chaosPoints: number,
	breakThreshold: number,
	explosive: boolean?,
	requiredTier: number?
)
	local reqTier = requiredTier or PROP_DEFAULT_REQUIRED_TIER[propType] or 1
	instance:SetAttribute("PropType", propType)
	instance:SetAttribute("DestructibleType", propType)
	instance:SetAttribute("IsDestructible", true)
	instance:SetAttribute("CashValue", cashValue)
	instance:SetAttribute("CashReward", cashValue)
	instance:SetAttribute("ChaosPoints", chaosPoints)
	instance:SetAttribute("BreakThreshold", breakThreshold)
	instance:SetAttribute("Explosive", explosive == true)
	instance:SetAttribute("RequiredTier", reqTier)
	instance:SetAttribute("Destroyed", false)

	if instance:IsA("Model") and instance.PrimaryPart then
		instance:SetAttribute("OriginCFrame", instance.PrimaryPart.CFrame)
	elseif instance:IsA("BasePart") then
		instance:SetAttribute("OriginCFrame", instance.CFrame)
	end

	CollectionService:AddTag(instance, "Destructible")
end

--------------------------------------------------------------------------------
-- DESTRUCTIBLE PROP BUILDERS
--------------------------------------------------------------------------------

local function spawnFireHydrant(pos: Vector3)
	local m = Instance.new("Model")
	m.Name = "FireHydrant"

	local body = makePart(m, "Body", Vector3.new(1.6, 3.2, 1.6), CFrame.new(pos + Vector3.new(0, 1.6, 0)), Color3.fromRGB(215, 38, 35), Enum.Material.Metal, true)
	makePart(m, "Cap", Vector3.new(1.9, 0.6, 1.9), CFrame.new(pos + Vector3.new(0, 3.3, 0)), Color3.fromRGB(225, 228, 236), Enum.Material.Metal, false)
	makePart(m, "NozzleX", Vector3.new(2.2, 0.6, 0.6), CFrame.new(pos + Vector3.new(0, 2.2, 0)), Color3.fromRGB(195, 200, 208), Enum.Material.Metal, false)

	weldChildrenToPrimary(m, body)
	m.Parent = PropsFolder
	tagDestructible(m, "FireHydrant", 35, 20, 4, false)
end

local function spawnStreetLight(pos: Vector3, yawDeg: number)
	local m = Instance.new("Model")
	m.Name = "StreetLight"
	local rot = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)

	local pole = makePart(m, "Pole", Vector3.new(0.8, 16, 0.8), rot * CFrame.new(0, 8, 0), Color3.fromRGB(38, 42, 50), Enum.Material.Metal, true)
	makePart(m, "Base", Vector3.new(1.6, 2.2, 1.6), rot * CFrame.new(0, 1.1, 0), Color3.fromRGB(30, 34, 42), Enum.Material.Metal, false)
	makePart(m, "Arm", Vector3.new(0.5, 0.5, 5.5), rot * CFrame.new(0, 15.6, -2.5), Color3.fromRGB(38, 42, 50), Enum.Material.Metal, false)
	local bulb = makePart(m, "Bulb", Vector3.new(1.4, 0.4, 2.0), rot * CFrame.new(0, 15.2, -4.6), Color3.fromRGB(255, 212, 135), Enum.Material.Neon, false)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 212, 145)
	light.Range = 38
	light.Brightness = 1.75
	light.Parent = bulb

	weldChildrenToPrimary(m, pole)
	m.Parent = PropsFolder
	tagDestructible(m, "StreetLight", 45, 25, 4, false)
end

local function spawnTrafficLight(intersectionPos: Vector3, cornerOffset: Vector3, yawDeg: number, axis: string)
	local m = Instance.new("Model")
	m.Name = "TrafficLight"
	local basePos = intersectionPos + cornerOffset
	local rot = CFrame.new(basePos) * CFrame.Angles(0, math.rad(yawDeg), 0)

	local pole = makePart(m, "Pole", Vector3.new(0.9, 17, 0.9), rot * CFrame.new(0, 8.5, 0), Color3.fromRGB(50, 54, 62), Enum.Material.Metal, true)
	makePart(m, "Arm", Vector3.new(9, 0.6, 0.6), rot * CFrame.new(4.2, 16, 0), Color3.fromRGB(50, 54, 62), Enum.Material.Metal, false)
	makePart(m, "Housing", Vector3.new(1.6, 4.2, 1.2), rot * CFrame.new(7.5, 15.2, 0), Color3.fromRGB(28, 30, 35), Enum.Material.Metal, false)

	local redLens = makePart(m, "RedLens", Vector3.new(0.9, 0.9, 0.3), rot * CFrame.new(7.5, 16.4, -0.55), Color3.fromRGB(255, 45, 45), Enum.Material.SmoothPlastic, false)
	local yellowLens = makePart(m, "YellowLens", Vector3.new(0.9, 0.9, 0.3), rot * CFrame.new(7.5, 15.2, -0.55), Color3.fromRGB(255, 200, 40), Enum.Material.SmoothPlastic, false)
	local greenLens = makePart(m, "GreenLens", Vector3.new(0.9, 0.9, 0.3), rot * CFrame.new(7.5, 14.0, -0.55), Color3.fromRGB(45, 255, 90), Enum.Material.Neon, false)
	redLens.CanCollide = false
	yellowLens.CanCollide = false
	greenLens.CanCollide = false

	weldChildrenToPrimary(m, pole)
	m:SetAttribute("IntersectionX", intersectionPos.X)
	m:SetAttribute("IntersectionZ", intersectionPos.Z)
	m:SetAttribute("TrafficAxis", axis) -- "NS" or "EW"
	m:SetAttribute("LightState", "Green")
	CollectionService:AddTag(m, "TrafficLight")

	m.Parent = TrafficLightsFolder
	tagDestructible(m, "TrafficLight", 45, 25, 25, false)
end

local function spawnCrateCluster(pos: Vector3, rows: number)
	local boxSize = 3.2
	for r = 0, rows - 1 do
		local count = math.max(1, rows - r)
		for c = 0, count - 1 do
			local offset = Vector3.new((c - (count - 1) * 0.5) * (boxSize + 0.2), r * boxSize + boxSize * 0.5, 0)
			local crate = makePart(
				PropsFolder,
				"WoodenCrate",
				Vector3.new(boxSize, boxSize, boxSize),
				CFrame.new(pos + offset) * CFrame.Angles(0, math.rad((r * 17 + c * 31) % 25 - 12), 0),
				Color3.fromRGB(145, 98, 56),
				Enum.Material.WoodPlanks,
				true
			)
			tagDestructible(crate, "WoodenCrate", 15, 10, 12, false)
		end
	end
end

local function spawnBench(pos: Vector3, yawDeg: number)
	local m = Instance.new("Model")
	m.Name = "ParkBench"
	local rot = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local seat = makePart(m, "Seat", Vector3.new(6, 0.5, 2.2), rot * CFrame.new(0, 1.6, 0), Color3.fromRGB(138, 88, 48), Enum.Material.Wood, true)
	makePart(m, "Backrest", Vector3.new(6, 1.8, 0.4), rot * CFrame.new(0, 2.6, -0.9), Color3.fromRGB(138, 88, 48), Enum.Material.Wood, false)
	makePart(m, "LegL", Vector3.new(0.5, 1.6, 2.0), rot * CFrame.new(-2.4, 0.8, 0), Color3.fromRGB(40, 42, 48), Enum.Material.Metal, false)
	makePart(m, "LegR", Vector3.new(0.5, 1.6, 2.0), rot * CFrame.new(2.4, 0.8, 0), Color3.fromRGB(40, 42, 48), Enum.Material.Metal, false)

	weldChildrenToPrimary(m, seat)
	m.Parent = PropsFolder
	tagDestructible(m, "Bench", 20, 12, 14, false)
end

local function spawnFenceRun(pos: Vector3, yawDeg: number, segments: number, color: Color3)
	local baseRot = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)
	for i = 1, segments do
		local segCF = baseRot * CFrame.new((i - (segments + 1) * 0.5) * 8, 1.8, 0)
		local fence = makePart(PropsFolder, "FencePanel", Vector3.new(7.6, 3.6, 0.5), segCF, color, Enum.Material.WoodPlanks, true)
		tagDestructible(fence, "Fence", 15, 8, 12, false)
	end
end

local function spawnBusStop(pos: Vector3, yawDeg: number)
	local m = Instance.new("Model")
	m.Name = "BusStop"
	local rot = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)

	local backGlass = makePart(m, "GlassBack", Vector3.new(9, 7.5, 0.4), rot * CFrame.new(0, 3.75, -2.2), Color3.fromRGB(130, 200, 245), Enum.Material.Glass, true)
	backGlass.Transparency = 0.35
	makePart(m, "Roof", Vector3.new(9.8, 0.6, 5.2), rot * CFrame.new(0, 7.8, -0.2), Color3.fromRGB(48, 54, 66), Enum.Material.Metal, false)
	makePart(m, "PostL", Vector3.new(0.5, 7.6, 0.5), rot * CFrame.new(-4.3, 3.8, -2.2), Color3.fromRGB(70, 78, 90), Enum.Material.Metal, false)
	makePart(m, "PostR", Vector3.new(0.5, 7.6, 0.5), rot * CFrame.new(4.3, 3.8, -2.2), Color3.fromRGB(70, 78, 90), Enum.Material.Metal, false)
	local sign = makePart(m, "BusSign", Vector3.new(1.4, 2.2, 0.3), rot * CFrame.new(4.6, 6.2, 1.8), Color3.fromRGB(30, 140, 255), Enum.Material.Neon, false)
	addSurfaceSign(sign, "BUS", Color3.new(1, 1, 1), Enum.NormalId.Front)

	weldChildrenToPrimary(m, backGlass)
	m.Parent = PropsFolder
	tagDestructible(m, "BusStop", 60, 35, 24, false)
end

local function spawnBillboard(pos: Vector3, yawDeg: number, slogan: string, accentColor: Color3)
	local m = Instance.new("Model")
	m.Name = "Billboard"
	local rot = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)

	-- Support post stops cleanly at Y = 14 (below the board at Y = 14..22) so no pole ever slices through sign text!
	local post = makePart(m, "SupportPost", Vector3.new(1.8, 14, 1.8), rot * CFrame.new(0, 7, 0), Color3.fromRGB(48, 52, 62), Enum.Material.Metal, true)
	makePart(m, "Crossbeam", Vector3.new(12, 0.8, 2.0), rot * CFrame.new(0, 13.8, 0), Color3.fromRGB(42, 46, 56), Enum.Material.Metal, false)
	local board = makePart(m, "Board", Vector3.new(18, 8, 1.2), rot * CFrame.new(0, 18, 0), Color3.fromRGB(18, 22, 32), Enum.Material.Metal, false)
	local trim = makePart(m, "NeonTrim", Vector3.new(18.6, 0.6, 1.4), rot * CFrame.new(0, 22.3, 0), accentColor, Enum.Material.Neon, false)
	trim.CanCollide = false
	addSurfaceSign(board, slogan, accentColor, Enum.NormalId.Front)
	addSurfaceSign(board, slogan, accentColor, Enum.NormalId.Back)

	weldChildrenToPrimary(m, post)
	m.Parent = PropsFolder
	tagDestructible(m, "Billboard", 85, 50, 12, false)
end

local function spawnJackpotCrate(pos: Vector3)
	local m = Instance.new("Model")
	m.Name = "JackpotCrate"

	-- Festive Holiday Gift Stack (crimson, emerald, and royal-gold wrapped present boxes with metallic ribbon bands — never blinding neon yellow!)
	local core = makePart(m, "CrimsonGiftBox", Vector3.new(3.6, 2.8, 3.6), CFrame.new(pos + Vector3.new(0, 1.4, 0)), Color3.fromRGB(186, 32, 38), Enum.Material.SmoothPlastic, true)
	local bandX = makePart(m, "GoldRibbonX", Vector3.new(3.75, 2.86, 0.55), CFrame.new(pos + Vector3.new(0, 1.4, 0)), Color3.fromRGB(214, 172, 68), Enum.Material.Metal, false)
	bandX.CanCollide = false
	local bandZ = makePart(m, "GoldRibbonZ", Vector3.new(0.55, 2.86, 3.75), CFrame.new(pos + Vector3.new(0, 1.4, 0)), Color3.fromRGB(214, 172, 68), Enum.Material.Metal, false)
	bandZ.CanCollide = false

	local topBoxCF = CFrame.new(pos + Vector3.new(-0.2, 3.8, 0.15)) * CFrame.Angles(0, math.rad(18), 0)
	local topBox = makePart(m, "EmeraldGiftBox", Vector3.new(2.5, 2.0, 2.5), topBoxCF, Color3.fromRGB(28, 118, 64), Enum.Material.SmoothPlastic, false)
	topBox.CanCollide = false
	local topRibbon = makePart(m, "TopGoldRibbon", Vector3.new(2.62, 2.06, 0.45), topBoxCF, Color3.fromRGB(224, 182, 76), Enum.Material.Metal, false)
	topRibbon.CanCollide = false
	local bowLoop = makePart(m, "HolidayGoldBow", Vector3.new(1.1, 0.45, 1.1), topBoxCF * CFrame.new(0, 1.15, 0), Color3.fromRGB(224, 182, 76), Enum.Material.Metal, false)
	bowLoop.CanCollide = false

	local sideBoxCF = CFrame.new(pos + Vector3.new(1.85, 0.95, -1.1)) * CFrame.Angles(0, math.rad(-14), 0)
	local sideBox = makePart(m, "GoldWrappedGiftBox", Vector3.new(2.0, 1.9, 2.0), sideBoxCF, Color3.fromRGB(198, 154, 56), Enum.Material.Metal, false)
	sideBox.CanCollide = false
	local sideRibbon = makePart(m, "CrimsonRibbon", Vector3.new(2.1, 1.96, 0.4), sideBoxCF, Color3.fromRGB(186, 32, 38), Enum.Material.SmoothPlastic, false)
	sideRibbon.CanCollide = false

	addSurfaceSign(core, "HOLIDAY GIFT", Color3.fromRGB(248, 232, 185), Enum.NormalId.Front)
	addSurfaceSign(core, "HOLIDAY GIFT", Color3.fromRGB(248, 232, 185), Enum.NormalId.Back)

	weldChildrenToPrimary(m, core)
	m:SetAttribute("IsJackpotCrate", true)
	m.Parent = PropsFolder
	tagDestructible(m, "JackpotCrate", 250, 180, 5, false)
end

local function spawnSteamingManhole(pos: Vector3)
	local cover = makePart(
		RoadsFolder,
		"SteamingManhole",
		Vector3.new(0.18, 3.6, 3.6),
		CFrame.new(pos.X, 0.22, pos.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(44, 48, 56),
		Enum.Material.DiamondPlate,
		true
	)
	cover.Shape = Enum.PartType.Cylinder
	cover.CanCollide = false

	local steam = Instance.new("ParticleEmitter")
	steam.Name = "NYCSteamVent"
	steam.Color = ColorSequence.new(Color3.fromRGB(215, 225, 240))
	steam.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.5, 2.4),
		NumberSequenceKeypoint.new(1, 4.2),
	})
	steam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(0.6, 0.72),
		NumberSequenceKeypoint.new(1, 1.0),
	})
	steam.Lifetime = NumberRange.new(1.8, 2.8)
	steam.Rate = 14
	steam.Speed = NumberRange.new(3.5, 6.5)
	steam.SpreadAngle = Vector2.new(14, 14)
	steam.EmissionDirection = Enum.NormalId.Right
	steam.Parent = cover
end

