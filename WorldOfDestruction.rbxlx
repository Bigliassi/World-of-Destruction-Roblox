--------------------------------------------------------------------------------
-- Active Pursuit Data Structures
--------------------------------------------------------------------------------
type CopPartOffset = {
	Part: BasePart,
	Offset: CFrame,
}

type CopWheelEntry = {
	Tire: BasePart,
	Rim: BasePart,
	Spoke: BasePart,
	BaseOffset: CFrame,
}

type ActiveCopUnit = {
	Id: string,
	Kind: PoliceUnitKind,
	Archetype: UnitArchetype,
	Model: Model,
	Chassis: Part,
	RedSiren: Part,
	BlueSiren: Part,
	RedLight: PointLight,
	BlueLight: PointLight,
	PartOffsets: { CopPartOffset },
	Wheels: { CopWheelEntry },
	WheelRadius: number,
