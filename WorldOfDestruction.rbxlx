local function spawnGoldCashCrateDrop(pos: Vector3)
	local crate = Instance.new("Part")
	crate.Name = "BossGoldCrate"
	crate.Size = Vector3.new(2.6, 2.6, 2.6)
	crate.Position = pos + Vector3.new((math.random() - 0.5) * 8, 4.5, (math.random() - 0.5) * 8)
	crate.Color = Color3.fromRGB(255, 210, 45)
	crate.Material = Enum.Material.Neon
	crate.Anchored = false
	crate.CanCollide = false
	crate.Parent = Workspace
	crate.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 28, 22, (math.random() - 0.5) * 28)
	Debris:AddItem(crate, 2.5)
end

local function syncCampaignAttributesToPlayer(player: Player, state: PlayerChaosState)
	local actDef = getCampaignActDef(state.CampaignAct)
	local bossPos = if activeBossHull and activeBossHull.Parent then activeBossHull.Position else Vector3.new(0, 3.8, -80)
	local isBossAct = (state.CampaignAct == 5 and not state.CampaignCompleted)

	player:SetAttribute("CampaignAct", state.CampaignAct)
	player:SetAttribute("CampaignTotalActs", #CAMPAIGN_ACTS)
	player:SetAttribute("CampaignActTitle", actDef.Title)
	player:SetAttribute("CampaignStoryText", actDef.StoryText)
	player:SetAttribute("CampaignObjectiveText", actDef.ObjectiveText)
	player:SetAttribute("CampaignProgress", math.min(actDef.Goal, math.floor(state.CampaignProgress)))
	player:SetAttribute("CampaignGoal", actDef.Goal)
	player:SetAttribute("CampaignRewardCash", actDef.RewardCash)
	player:SetAttribute("CampaignCompleted", state.CampaignCompleted)

	player:SetAttribute("BossActive", isBossAct)
	player:SetAttribute("BossHealth", if isBossAct then math.max(0, math.floor(activeBossHealth)) else 0)
	player:SetAttribute("BossMaxHealth", BOSS_MAX_HEALTH)
	player:SetAttribute("BossPosition", bossPos)

	-- Keep Mission* attributes synced to Campaign Act while Campaign is in progress so HUD works seamlessly
	if not state.CampaignCompleted then
		player:SetAttribute("MissionId", actDef.Id)
		player:SetAttribute("MissionTitle", actDef.Title .. " — " .. actDef.ObjectiveText)
		player:SetAttribute("MissionDescription", actDef.StoryText)
		player:SetAttribute("MissionProgress", math.min(actDef.Goal, math.floor(state.CampaignProgress)))
		player:SetAttribute("MissionGoal", actDef.Goal)
		player:SetAttribute("MissionReward", actDef.RewardCash)
	end

	CampaignUpdateRemote:FireClient(player, {
		Act = state.CampaignAct,
		TotalActs = #CAMPAIGN_ACTS,
		ActTitle = actDef.Title,
		StoryText = actDef.StoryText,
		ObjectiveText = actDef.ObjectiveText,
		Progress = math.min(actDef.Goal, math.floor(state.CampaignProgress)),
		Goal = actDef.Goal,
		RewardCash = actDef.RewardCash,
		Completed = state.CampaignCompleted,
		BossActive = isBossAct,
		BossHealth = activeBossHealth,
		BossMaxHealth = BOSS_MAX_HEALTH,
		BossPosition = bossPos,
	})
end

local function advanceCampaignProgress(player: Player, eventKind: string, amount: number)
	local state = playerStates[player.UserId]
	if not state or state.CampaignCompleted then
		return
	end

	local actDef = getCampaignActDef(state.CampaignAct)
	local matched = false

	if actDef.Kind == "PropsCount" and (eventKind == "PropsCount" or eventKind == "Hydrants") then
		state.CampaignProgress += amount
		matched = true
	elseif actDef.Kind == "HydrantsOrProps" and (eventKind == "Hydrants" or eventKind == "PropsCount" or eventKind == "Combo3x") then
		state.CampaignProgress += amount
		matched = true
	elseif actDef.Kind == "DamageValue" and (eventKind == "DamageValue" or eventKind == "GasExplosion") then
		state.CampaignProgress += amount
		matched = true
	elseif actDef.Kind == "StuntsAndCops" and (eventKind == "Stunt" or eventKind == "CopTakedowns" or eventKind == "PropsCount") then
		state.CampaignProgress += amount
		matched = true
	elseif actDef.Kind == "BossFinale" and (eventKind == "BossDamage" or eventKind == "DamageValue") then
		state.CampaignProgress += amount
		matched = true
	end

	if not matched then
		return
	end

	if state.CampaignProgress >= actDef.Goal then
		-- Act Completed!
		local magnetMult = getMagnetMultiplier(player)
		local rewardCash = math.floor(actDef.RewardCash * magnetMult)
		local rewardChaos = math.floor(actDef.RewardChaos * magnetMult)
		addCash(player, rewardCash, "CampaignAct" .. tostring(state.CampaignAct))
		addChaosScore(player, rewardChaos)

		if state.CampaignAct < #CAMPAIGN_ACTS then
			local completedActNum = state.CampaignAct
			state.CampaignAct += 1
			state.CampaignProgress = 0
			if state.CampaignAct == 5 then
				spawnBossGoliathConvoy()
			end
			syncCampaignAttributesToPlayer(player, state)

			local nextActDef = getCampaignActDef(state.CampaignAct)
			local bannerMsg = string.format("ACT %d COMPLETE! +$%d • NEXT: %s", completedActNum, rewardCash, nextActDef.Title)
			StyleCalloutRemote:FireClient(player, {
				Callout = bannerMsg,
				Multiplier = state.ComboMultiplier,
				ComboCount = state.ComboCount,
				CashAwarded = rewardCash,
				ChaosAwarded = rewardChaos,
				IsMissionBanner = true,
			})
			NotificationRemote:FireClient(player, bannerMsg, "Campaign")
		else
			-- ACT 5 GRAND FINALE VICTORY!
			state.CampaignProgress = actDef.Goal
			state.CampaignCompleted = true
			activeBossHealth = 0
			if activeBossModel and activeBossModel.Parent then
				activeBossModel:Destroy()
				activeBossModel = nil
				activeBossHull = nil
			end
			syncCampaignAttributesToPlayer(player, state)

			-- Award 5,000 XP via DestructionBindable / XPGained if available
			local xpEvent = ServerStorage:FindFirstChild("AwardXPEvent")
			if xpEvent and xpEvent:IsA("BindableEvent") then
				xpEvent:Fire(player, 5000, "CampaignVictory")
			end

			local victoryMsg = "VICTORY! LEO CITY LIBERATED! +$50,000"
			StyleCalloutRemote:FireClient(player, {
				Callout = victoryMsg,
				Multiplier = 10,
				IsOverdrive = true,
				ComboCount = state.ComboCount,
				CashAwarded = rewardCash,
				ChaosAwarded = rewardChaos,
				IsMissionBanner = true,
			})
			NotificationRemote:FireClient(player, victoryMsg, "Victory")
		end
	else
		syncCampaignAttributesToPlayer(player, state)
	end
end

local function damageBossConvoy(player: Player, rawDamage: number)
	local state = playerStates[player.UserId]
	if not state or state.CampaignCompleted or state.CampaignAct ~= 5 then
		return
	end
	local now = os.clock()
	if now - state.LastBossHitAt < 0.45 then
		return
	end
	state.LastBossHitAt = now

	local dmg = math.clamp(math.floor(rawDamage), 200, 350)
	activeBossHealth = math.max(0, activeBossHealth - dmg)
	if activeBossModel then
		activeBossModel:SetAttribute("BossHealth", activeBossHealth)
	end
	if activeBossHpFill then
		activeBossHpFill.Size = UDim2.fromScale(math.clamp(activeBossHealth / BOSS_MAX_HEALTH, 0, 1), 1)
	end
	if activeBossHpLabel then
		activeBossHpLabel.Text = string.format("HP: %d / %d", activeBossHealth, BOSS_MAX_HEALTH)
	end
	if activeBossHull then
		spawnGoldCashCrateDrop(activeBossHull.Position)
	end

	addCash(player, 450, "BossGoliathHit")
	StyleCalloutRemote:FireClient(player, {
		Callout = string.format("GOLIATH HIT! -%d HP (+$450)", dmg),
		Multiplier = state.ComboMultiplier,
		ComboCount = state.ComboCount,
		CashAwarded = 450,
	})
	BossUpdateRemote:FireClient(player, {
		BossHealth = activeBossHealth,
		BossMaxHealth = BOSS_MAX_HEALTH,
		DamageDealt = dmg,
	})

	advanceCampaignProgress(player, "BossDamage", dmg)
end

ReportBossImpactRemote.OnServerEvent:Connect(function(player: Player, impactSpeed: any)
	local spd = math.clamp(tonumber(impactSpeed) or 65, 20, 160)
	damageBossConvoy(player, math.clamp(spd * 3.8, 220, 350))
end)

--------------------------------------------------------------------------------
-- Live Chaos Missions Management
--------------------------------------------------------------------------------
local function getActiveMissionDef(state: PlayerChaosState): MissionDefinition
	local idx = ((state.MissionIndex - 1) % #LIVE_CHAOS_MISSIONS) + 1
	return LIVE_CHAOS_MISSIONS[idx]
end

local function syncMissionToPlayer(player: Player, state: PlayerChaosState, status: string?)
	local def = getActiveMissionDef(state)
	-- While the 5-Act Story Campaign is active, keep MissionTitle/Progress/Goal synced to the Campaign Act!
	if not state.CampaignCompleted then
		syncCampaignAttributesToPlayer(player, state)
		return
	end
	player:SetAttribute("MissionId", def.Id)
	player:SetAttribute("MissionTitle", def.Title)
	player:SetAttribute("MissionDescription", def.Description)
	player:SetAttribute("MissionProgress", math.min(def.Goal, math.floor(state.MissionProgress)))
	player:SetAttribute("MissionGoal", def.Goal)
	player:SetAttribute("MissionTimeRemaining", math.max(0, math.ceil(state.MissionTimeRemaining)))
	player:SetAttribute("MissionReward", def.RewardCash)

	local payload = {
		Id = def.Id,
		Title = def.Title,
		Description = def.Description,
		Progress = math.min(def.Goal, math.floor(state.MissionProgress)),
		Goal = def.Goal,
		TimeRemaining = math.max(0, math.ceil(state.MissionTimeRemaining)),
		RewardCash = def.RewardCash,
		RewardChaos = def.RewardChaos,
		Status = status or "Active",
	}
	MissionUpdateRemote:FireClient(player, payload)
	RootMissionUpdateRemote:FireClient(player, payload)
end

local function startMission(player: Player, state: PlayerChaosState, missionIndex: number)
	state.MissionIndex = missionIndex
	state.MissionProgress = 0
	state.MissionIntermission = 0
	state.HeatSurvivalAccumulator = 0
	local def = getActiveMissionDef(state)
	state.MissionTimeRemaining = def.Duration
	syncMissionToPlayer(player, state, "Started")
end

local function advanceMissionProgress(player: Player, kind: string, amount: number)
	local state = playerStates[player.UserId]
	if not state or state.MissionIntermission > 0 or state.MissionTimeRemaining <= 0 then
		return
	end

	local def = getActiveMissionDef(state)
	if def.Kind ~= kind then
		return
	end

	if kind == "ComboMultiplier" then
		state.MissionProgress = math.max(state.MissionProgress, amount)
	else
		state.MissionProgress = math.min(def.Goal, state.MissionProgress + amount)
	end

	if state.MissionProgress >= def.Goal then
		-- Mission Complete!
		local magnetMult = getMagnetMultiplier(player)
		local finalCash = math.floor(def.RewardCash * magnetMult)
		local finalChaos = math.floor(def.RewardChaos * magnetMult)

		addCash(player, finalCash, "MissionComplete:" .. def.Id)
		addChaosScore(player, finalChaos)

		local completedCount = (tonumber(player:GetAttribute("MissionsCompleted")) or 0) + 1
		player:SetAttribute("MissionsCompleted", completedCount)

		state.MissionProgress = def.Goal
		state.MissionIntermission = MISSION_INTERMISSION
		syncMissionToPlayer(player, state, "Completed")

		StyleCalloutRemote:FireClient(player, {
			Callout = string.format("CHALLENGE COMPLETE! +$%d", finalCash),
			Multiplier = state.ComboMultiplier,
			ComboCount = state.ComboCount,
			CashAwarded = finalCash,
			ChaosAwarded = finalChaos,
			IsMissionBanner = true,
		})
	else
		syncMissionToPlayer(player, state, "Active")
	end
end

--------------------------------------------------------------------------------
-- Chaos Combo Tracker & Style Callouts
--------------------------------------------------------------------------------
local function resolveDestructionCallout(objectType: string, isChainExplosion: boolean?, multiplier: number): string
	local upper = string.upper(objectType)
	if isChainExplosion or string.find(upper, "EXPLOS") or string.find(upper, "TANK") or string.find(upper, "BARREL") or string.find(upper, "GAS") then
		return "CHAIN EXPLOSION!"
	elseif string.find(upper, "HYDRANT") or string.find(upper, "WATER") or string.find(upper, "FOUNTAIN") or string.find(upper, "HYDRO") then
		return "HYDRO BLAST!"
	elseif string.find(upper, "POLICE") or string.find(upper, "COP") or string.find(upper, "CRUISER") or string.find(upper, "SWAT") or string.find(upper, "INTERCEPTOR") then
		return "COP TAKEDOWN!"
	elseif multiplier >= 10 then
		return "10x OVERDRIVE!"
	else
		return "SMASH!"
	end
end

local function syncComboAttributes(player: Player, state: PlayerChaosState)
	player:SetAttribute("ComboCount", state.ComboCount)
	player:SetAttribute("ComboMultiplier", state.ComboMultiplier)
	player:SetAttribute("ComboTimer", tonumber(string.format("%.2f", state.ComboTimer)))
	player:SetAttribute("ComboTimerRatio", math.clamp(state.ComboTimer / COMBO_BASE_WINDOW, 0, 1))
	player:SetAttribute("CurrentStreakName", state.CurrentStreakName)
	player:SetAttribute("UnbankedComboCash", state.UnbankedComboCash)

	local maxCombo = math.max(0, math.floor(tonumber(player:GetAttribute("MaxCombo")) or 0))
	if state.ComboCount > maxCombo then
		player:SetAttribute("MaxCombo", state.ComboCount)
		local ls = player:FindFirstChild("leaderstats")
		if ls then
			local mcVal = ls:FindFirstChild("MaxCombo") :: IntValue?
			if mcVal then
				mcVal.Value = state.ComboCount
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Casino Jackpot Fever & Lucky Spin Progression System
--------------------------------------------------------------------------------
local JACKPOT_PRIZES = {
	{ Id = "MegaCash", Weight = 32, BaseTitle = "MEGA CASH JACKPOT! +$3,500" },
	{ Id = "GoldenFrenzy", Weight = 25, BaseTitle = "30s GOLDEN 3X FRENZY!" },
	{ Id = "SuperNitroRepair", Weight = 20, BaseTitle = "SUPER NITRO & FULL REPAIR JACKPOT!" },
	{ Id = "InstantLevelUp", Weight = 13, BaseTitle = "INSTANT LEVEL-UP JACKPOT!" },
	{ Id = "GrandRoyal", Weight = 10, BaseTitle = "GRAND ROYAL JACKPOT! +$10,000" },
}

local function triggerCasinoJackpotSpin(player: Player, state: PlayerChaosState, worldPosition: Vector3?)
	state.JackpotCharge = 0
	state.JackpotSpinsCount += 1
	player:SetAttribute("JackpotCharge", 0)
	player:SetAttribute("JackpotSpinsCount", state.JackpotSpinsCount)

	-- Weighted roll among the 5 exciting Casino Jackpot Prizes
	local totalWeight = 0
	for _, prize in ipairs(JACKPOT_PRIZES) do
		totalWeight += prize.Weight
	end
	local roll = math.random(1, totalWeight)
	local picked = JACKPOT_PRIZES[1]
	for _, prize in ipairs(JACKPOT_PRIZES) do
		if roll <= prize.Weight then
			picked = prize
			break
		end
		roll -= prize.Weight
	end

	local level = math.max(1, tonumber(player:GetAttribute("Level")) or 1)
	local levelScale = 1 + math.min((level - 1) * 0.08, 1.5)
	local prizeTitle = picked.BaseTitle
	local cashAwarded = 0
	local bonusMult = math.max(state.ComboMultiplier, 3)

	if picked.Id == "MegaCash" then
		cashAwarded = math.floor(3500 * levelScale)
		prizeTitle = "MEGA CASH JACKPOT! +$3,500"
		addCash(player, cashAwarded, "Jackpot_MegaCash")
		addChaosScore(player, cashAwarded * 2)
	elseif picked.Id == "GoldenFrenzy" then
		prizeTitle = "30s GOLDEN 3X FRENZY!"
		cashAwarded = 1500
		bonusMult = 3
		state.GoldenFrenzyRemaining = 30.0
		player:SetAttribute("Golden3xFrenzyActive", true)
		player:SetAttribute("Golden3xFrenzyRemaining", 30)
		addCash(player, cashAwarded, "Jackpot_GoldenFrenzy")
		addChaosScore(player, 4500)
	elseif picked.Id == "SuperNitroRepair" then
		prizeTitle = "SUPER NITRO & FULL REPAIR JACKPOT!"
		cashAwarded = 2000
		addCash(player, cashAwarded, "Jackpot_SuperNitroRepair")
		addChaosScore(player, 4000)
		player:SetAttribute("UnlimitedNitroRemaining", 15)
		player:SetAttribute("TouchNitro", true)
		RepairPlayerVehicleBindable:Fire(player)
		task.delay(6.0, function()
			if player and player.Parent then
				player:SetAttribute("TouchNitro", false)
			end
		end)
	elseif picked.Id == "InstantLevelUp" then
		prizeTitle = "INSTANT LEVEL-UP JACKPOT!"
		local xpReq = math.max(250, tonumber(player:GetAttribute("XPRequired")) or 500)
		cashAwarded = math.max(2500, level * 350)
		addCash(player, cashAwarded, "Jackpot_InstantLevelUp")
		addChaosScore(player, 5000)
		AwardXPBindable:Fire(player, xpReq, "CasinoJackpotInstantLevelUp")
	elseif picked.Id == "GrandRoyal" then
		cashAwarded = 10000
		prizeTitle = "GRAND ROYAL JACKPOT! +$10,000"
		bonusMult = 10
		addCash(player, cashAwarded, "Jackpot_GrandRoyal")
		addChaosScore(player, 20000)
	end

	updateNextVehicleUnlockAttributes(player)

	local spinPayload = {
		IsJackpotSpin = true,
		PrizeId = picked.Id,
		PrizeTitle = prizeTitle,
		Callout = "🎰 " .. prizeTitle,
		CashAwarded = cashAwarded,
		ChaosAwarded = cashAwarded * 2,
		Multiplier = bonusMult,
		ComboCount = state.ComboCount,
		JackpotSpinsCount = state.JackpotSpinsCount,
		Position = worldPosition,
	}
	StyleCalloutRemote:FireClient(player, spinPayload)
	RootStyleCalloutRemote:FireClient(player, spinPayload)
	NotificationRemote:FireClient(player, "🎰 CASINO JACKPOT: " .. prizeTitle, "Jackpot")
end

local function addJackpotCharge(player: Player, amount: number, worldPosition: Vector3?)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	state.JackpotCharge = math.clamp(state.JackpotCharge + math.floor(amount), 0, 100)
	player:SetAttribute("JackpotCharge", state.JackpotCharge)

	if state.JackpotCharge >= 100 then
		triggerCasinoJackpotSpin(player, state, worldPosition)
	end
end

local function registerComboAction(
	player: Player,
	baseCash: number,
	baseChaos: number,
	styleCallout: string,
	heatDelta: number,
	worldPosition: Vector3?
): (number, number)
	local state = playerStates[player.UserId]
	if not state then
		return 0, 0
	end

	-- Advance chain and refresh 4.5s dynamic combo timer
	state.ComboCount += 1
	state.ComboTimer = COMBO_BASE_WINDOW

	local mult, isOverdrive, _tierLabel = computeMultiplierTier(state.ComboCount)
	state.ComboMultiplier = mult

	-- Upgrade callout to 10x OVERDRIVE! on exact threshold crossing
	local finalCallout = styleCallout
	if isOverdrive and state.ComboCount == 20 then
		finalCallout = "10x OVERDRIVE!"
	end
	state.CurrentStreakName = finalCallout

	-- Scale reward by ComboMultiplier * CashMagnetMultiplier * WantedHeatMultiplier * Golden3xFrenzy
	local magnetMult = getMagnetMultiplier(player)
	local wantedMult = getWantedMultiplier(player)
	local frenzyMult = if state.GoldenFrenzyRemaining > 0 or player:GetAttribute("Golden3xFrenzyActive") == true then 3.0 else 1.0
	local totalScalar = mult * magnetMult * wantedMult * frenzyMult

	local awardedCash = math.max(1, math.floor(baseCash * totalScalar))
	local awardedChaos = math.max(5, math.floor(baseChaos * totalScalar))

	-- Continuously credit cash & chaos score AND accumulate unbanked combo bonus pool
	addCash(player, awardedCash, finalCallout)
	addChaosScore(player, awardedChaos)
	state.UnbankedComboCash += awardedCash

	syncComboAttributes(player, state)

	-- Advance active missions & 5-Act Story Campaign
	advanceMissionProgress(player, "DamageValue", awardedCash * 15)
	advanceMissionProgress(player, "ComboMultiplier", state.ComboMultiplier)
	advanceCampaignProgress(player, "DamageValue", awardedCash * 18)
	if state.ComboMultiplier >= 3 then
		advanceCampaignProgress(player, "Combo3x", 1)
	end

	-- Broadcast Heat increase to PoliceHeatService
	if heatDelta > 0 then
		AddHeatBindable:Fire(player, heatDelta, finalCallout, worldPosition)
	end

	-- Fire Style Callout to Client HUD
	local payload = {
		Callout = finalCallout,
		Multiplier = state.ComboMultiplier,
		IsOverdrive = isOverdrive,
		ComboCount = state.ComboCount,
		ComboTimer = state.ComboTimer,
		CashAwarded = awardedCash,
		ChaosAwarded = awardedChaos,
		Position = worldPosition,
	}
	StyleCalloutRemote:FireClient(player, payload)
	RootStyleCalloutRemote:FireClient(player, payload)

	return awardedCash, awardedChaos
end

local function finishAndBankCombo(player: Player, state: PlayerChaosState)
	local completedChain = state.ComboCount
	local comboEarned = state.UnbankedComboCash

	local bankedBonus = 0
	if completedChain >= 3 and comboEarned > 0 then
		local magnetMult = getMagnetMultiplier(player)
		bankedBonus = math.max(10, math.floor(comboEarned * COMBO_BONUS_RATE * magnetMult))
		addCash(player, bankedBonus, "ComboBankBonus")
		addChaosScore(player, bankedBonus * 2)
	end

	state.ComboCount = 0
	state.ComboMultiplier = 1
	state.ComboTimer = 0
	state.UnbankedComboCash = 0
	state.CurrentStreakName = ""
	syncComboAttributes(player, state)

	if completedChain >= 2 then
		ComboCompletedRemote:FireClient(player, {
			CompletedChain = completedChain,
			BankedBonusCash = bankedBonus,
			TotalComboCash = comboEarned + bankedBonus,
		})
	end
end

--------------------------------------------------------------------------------
-- Event Handlers: Destruction, Stunts (Air/Drift/Near-Miss), Cop Takedowns
--------------------------------------------------------------------------------
local function handleDestructionEvent(
	playerOrPayload: any,
	objectTypeOrInfo: any,
	baseCashReward: number?,
	worldPos: Vector3?,
	extraMeta: { [string]: any }?
)
	local player: Player = playerOrPayload
	if type(playerOrPayload) == "table" and objectTypeOrInfo == nil then
		player = playerOrPayload.player or playerOrPayload.Player
		objectTypeOrInfo = playerOrPayload
		baseCashReward = tonumber(playerOrPayload.cashEarned or playerOrPayload.CashReward)
		worldPos = playerOrPayload.position or playerOrPayload.Position
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end

	local objectType = "Prop"
	local baseCash = tonumber(baseCashReward) or 25
	local pos = if typeof(worldPos) == "Vector3" then worldPos else nil
	local isChainExplosion = false
	-- Paced Police Heat per prop:
	-- Small/medium street props (Crate, Fence, Bench, TrashCan, Mailbox, Cone): 3.5 heat (~28 small props to trigger 1 Star!)
	-- Streetlights / Hydrants / Bus Stops / Billboards: 5.0 heat
	-- Gas Pumps / Explosive Barrels: 14.0 heat
	local heatGenerated = 3.5

	if type(objectTypeOrInfo) == "table" then
		objectType = tostring(objectTypeOrInfo.Type or objectTypeOrInfo.propType or objectTypeOrInfo.Category or objectTypeOrInfo.Name or "Prop")
		baseCash = tonumber(objectTypeOrInfo.CashReward or objectTypeOrInfo.cashEarned or objectTypeOrInfo.CoinReward or objectTypeOrInfo.Value) or baseCash
		if typeof(objectTypeOrInfo.Position) == "Vector3" then
			pos = objectTypeOrInfo.Position
		elseif typeof(objectTypeOrInfo.position) == "Vector3" then
			pos = objectTypeOrInfo.position
		end
		isChainExplosion = objectTypeOrInfo.IsExplosion == true or objectTypeOrInfo.isExplosion == true or objectTypeOrInfo.ChainExplosion == true
	elseif type(objectTypeOrInfo) == "string" then
		objectType = objectTypeOrInfo
	elseif typeof(objectTypeOrInfo) == "Instance" then
		objectType = objectTypeOrInfo:GetAttribute("DestructibleType")
			or objectTypeOrInfo:GetAttribute("Category")
			or objectTypeOrInfo.Name
		baseCash = tonumber(objectTypeOrInfo:GetAttribute("CashReward") or objectTypeOrInfo:GetAttribute("CoinReward")) or baseCash
		if objectTypeOrInfo:IsA("BasePart") then
			pos = objectTypeOrInfo.Position
		elseif objectTypeOrInfo:IsA("Model") and objectTypeOrInfo.PrimaryPart then
			pos = objectTypeOrInfo.PrimaryPart.Position
		end
	end

	if extraMeta and type(extraMeta) == "table" then
		if extraMeta.IsChainExplosion or extraMeta.IsExplosion then
			isChainExplosion = true
		end
	end

	local upperType = string.upper(objectType)
	local isJackpotCrate = (upperType == "JACKPOTCRATE") or (string.find(upperType, "JACKPOT") ~= nil)
	if type(objectTypeOrInfo) == "table" and (objectTypeOrInfo.isJackpotCrate == true or objectTypeOrInfo.IsJackpotCrate == true) then
		isJackpotCrate = true
	end

	local isGoldATM = (upperType == "GOLDATM") or (string.find(upperType, "ATM") ~= nil)
	local isArmoredCashTruck = (upperType == "ARMOREDCASH_TRUCK")
		or (upperType == "ARMOREDCASHTRUCK")
		or (string.find(upperType, "ARMORED") ~= nil and string.find(upperType, "TRUCK") ~= nil)
		or (string.find(upperType, "CASHTRUCK") ~= nil)
	local isMegaCorpBankVault = (upperType == "MEGACORPBANKVAULT")
		or (string.find(upperType, "VAULT") ~= nil)
		or (string.find(upperType, "BANK") ~= nil)

	if string.find(upperType, "LIGHT") or string.find(upperType, "HYDRANT") or string.find(upperType, "BUS") or string.find(upperType, "BILLBOARD") or string.find(upperType, "TOWER") then
		heatGenerated = 5.0
	end

	baseCash = math.clamp(math.floor(baseCash), 5, 2500)
	local baseChaos = baseCash * 3

	local state = playerStates[player.UserId]
	local nextMult = if state then select(1, computeMultiplierTier(state.ComboCount + 1)) else 1
	local callout = resolveDestructionCallout(objectType, isChainExplosion, nextMult)
	local highTierChargeBonus: number? = nil

	if isMegaCorpBankVault then
		baseCash = math.max(baseCash * 3, 550)
		baseChaos = math.max(baseChaos * 3, 1650)
		heatGenerated = 20.0
		callout = "BANK VAULT HEIST!"
		highTierChargeBonus = 50
	elseif isArmoredCashTruck then
		baseCash = math.max(baseCash * 2, 380)
		baseChaos = math.max(baseChaos * 2, 1140)
		heatGenerated = 15.0
		callout = "ARMORED TRUCK SMASH!"
		highTierChargeBonus = 40
	elseif isJackpotCrate then
		baseCash = math.max(baseCash * 2, 250)
		baseChaos = math.max(baseChaos * 2, 750)
		callout = "JACKPOT CRATE 3X!"
		highTierChargeBonus = 35
	elseif isGoldATM then
		baseCash = math.max(baseCash * 2, 200)
		baseChaos = math.max(baseChaos * 2, 600)
		heatGenerated = 8.0
		callout = "GOLD ATM BUST!"
		highTierChargeBonus = 25
	elseif callout == "CHAIN EXPLOSION!" then
		baseCash = math.floor(baseCash * 1.6)
		baseChaos = math.floor(baseChaos * 1.8)
		heatGenerated = 14.0
		advanceCampaignProgress(player, "GasExplosion", 5000)
	elseif callout == "HYDRO BLAST!" then
		baseCash = math.floor(baseCash * 1.35)
		baseChaos = math.floor(baseChaos * 1.4)
		heatGenerated = 5.0
		advanceMissionProgress(player, "Hydrants", 1)
		advanceCampaignProgress(player, "Hydrants", 1)
	elseif callout == "COP TAKEDOWN!" then
		baseCash = math.max(baseCash, 150)
		baseChaos = math.max(baseChaos, 500)
		heatGenerated = 18.0
		advanceMissionProgress(player, "CopTakedowns", 1)
		advanceCampaignProgress(player, "CopTakedowns", 1)
	end

	local totalDest = (tonumber(player:GetAttribute("TotalDestructions")) or 0) + 1
	player:SetAttribute("TotalDestructions", totalDest)
	advanceMissionProgress(player, "PropsCount", 1)
	advanceCampaignProgress(player, "PropsCount", 1)

	-- If player is in Act 5 and smashes props near the Boss Convoy, deal bonus collateral damage to Goliath!
	if state and state.CampaignAct == 5 and not state.CampaignCompleted then
		if pos and activeBossHull and (pos - activeBossHull.Position).Magnitude <= 85 then
			damageBossConvoy(player, 200)
		end
	end

	registerComboAction(player, baseCash, baseChaos, callout, heatGenerated, pos)

	-- Advance Casino Jackpot Fever Charge (+25 to +50 for high-tier targets: GoldATM, JackpotCrate, ArmoredCashTruck, MegaCorpBankVault; +9 to +18 for regular props!)
	local chargeGain = highTierChargeBonus or math.random(9, 18)
	if type(objectTypeOrInfo) == "table" and tonumber(objectTypeOrInfo.jackpotChargeGain) then
		chargeGain = math.max(chargeGain, tonumber(objectTypeOrInfo.jackpotChargeGain) :: number)
	end
	addJackpotCharge(player, chargeGain, pos)
end

local function handleStuntEvent(player: Player, stuntType: string, rawValue: number?, worldPos: Vector3?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local kind = string.upper(tostring(stuntType or "STUNT"))
	local val = math.max(0.1, tonumber(rawValue) or 1.0)
	local pos = if typeof(worldPos) == "Vector3" then worldPos else nil

	if string.find(kind, "AIR") or string.find(kind, "JUMP") then
		-- Airtime jump (val = seconds in air or height)
		local clampedAir = math.clamp(val, 0.4, 12.0)
		local baseCash = math.floor(35 * clampedAir)
		local baseChaos = math.floor(120 * clampedAir)
		registerComboAction(player, baseCash, baseChaos, "MEGA AIR!", 2.5, pos)
		advanceMissionProgress(player, "DriftScore", baseChaos)
		advanceMissionProgress(player, "Airtime", math.ceil(clampedAir))
		advanceCampaignProgress(player, "Stunt", 1)
	elseif string.find(kind, "DRIFT") then
		-- Drift score (val = drift duration seconds or drift score points)
		local normalized = if val > 25 then math.clamp(val / 100, 0.5, 10) else math.clamp(val, 0.5, 10)
		local baseCash = math.floor(30 * normalized)
		local baseChaos = math.floor(110 * normalized)
		registerComboAction(player, baseCash, baseChaos, "DRIFT KING!", 2.0, pos)
		advanceMissionProgress(player, "DriftScore", baseChaos)
		advanceCampaignProgress(player, "Stunt", 1)
	elseif string.find(kind, "NEAR") or string.find(kind, "MISS") then
		-- High-speed traffic/police near-miss
		local baseCash = 40
		local baseChaos = 125
		registerComboAction(player, baseCash, baseChaos, "NEAR MISS!", 1.5, pos)
		advanceMissionProgress(player, "DriftScore", baseChaos)
		advanceCampaignProgress(player, "Stunt", 1)
	end
end

local function handlePoliceTakedown(player: Player, unitType: string?, worldPos: Vector3?, customBonusCash: number?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local unit = tostring(unitType or "Patrol Cruiser")
	local baseCash = math.clamp(tonumber(customBonusCash) or 175, 100, 1000)
	local baseChaos = baseCash * 4
	local pos = if typeof(worldPos) == "Vector3" then worldPos else nil

	local takedowns = (tonumber(player:GetAttribute("CopTakedowns")) or 0) + 1
	player:SetAttribute("CopTakedowns", takedowns)

	advanceMissionProgress(player, "CopTakedowns", 1)
	advanceCampaignProgress(player, "CopTakedowns", 1)
	registerComboAction(player, baseCash, baseChaos, "COP TAKEDOWN!", 18, pos)

	-- Persist milestone update
	UpdatePlayerDataBindable:Fire(player, {
		CopTakedowns = takedowns,
	})
	local _ = unit
end

--------------------------------------------------------------------------------
-- Wire BindableEvents & RemoteEvents
--------------------------------------------------------------------------------
DestructionBindable.Event:Connect(handleDestructionEvent)
OnObjectDestroyedBindable.Event:Connect(handleDestructionEvent)
FolderDestructionBindable.Event:Connect(handleDestructionEvent)

local serverEventsAlt = ensureFolder(ServerStorage, "ServerEvents")
local altDestructionBindable = ensureBindableEvent(serverEventsAlt, "DestructionOccurred")
altDestructionBindable.Event:Connect(handleDestructionEvent)

StuntBindable.Event:Connect(handleStuntEvent)
FolderStuntBindable.Event:Connect(handleStuntEvent)

PoliceTakedownBindable.Event:Connect(handlePoliceTakedown)
FolderPoliceTakedownBindable.Event:Connect(handlePoliceTakedown)

AddCashBindable.Event:Connect(function(player: Player, amount: number, reason: string?)
	if typeof(player) == "Instance" and player:IsA("Player") then
		addCash(player, tonumber(amount) or 0, reason)
	end
end)
FolderAddCashBindable.Event:Connect(function(player: Player, amount: number, reason: string?)
	if typeof(player) == "Instance" and player:IsA("Player") then
		addCash(player, tonumber(amount) or 0, reason)
	end
end)

SpendCashFunction.OnInvoke = function(player: Player, amount: number, reason: string?): boolean
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end
	return debitCash(player, tonumber(amount) or 0, reason)
end

-- Handle "BUSTED!" penalty from PoliceHeatService:
-- Confiscates a small % of unbanked combo cash (plus a small capped fine if no combo is active)
local function onPlayerBusted(player: Player, penaltyOverride: number?)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	local state = playerStates[player.UserId]
	local confiscated = 0

	if state then
		if state.UnbankedComboCash > 0 then
			-- Confiscate 30% of unbanked combo cash
			confiscated = math.max(10, math.floor(state.UnbankedComboCash * 0.30))
		else
			-- Small 8% wallet fine capped at $150
			local currentCash = tonumber(player:GetAttribute("Cash")) or 0
			confiscated = math.min(150, math.floor(currentCash * 0.08))
		end

		if type(penaltyOverride) == "number" and penaltyOverride > 0 then
			confiscated = math.floor(penaltyOverride)
		end

		if confiscated > 0 then
			debitCash(player, confiscated, "BustedPenalty")
		end

		-- Reset active combo without banking bonus
		state.ComboCount = 0
		state.ComboMultiplier = 1
		state.ComboTimer = 0
		state.UnbankedComboCash = 0
		state.CurrentStreakName = "BUSTED!"
		syncComboAttributes(player, state)
	end
end

PlayerBustedBindable.Event:Connect(onPlayerBusted)
FolderPlayerBustedBindable.Event:Connect(onPlayerBusted)

-- Client Remote listeners (with basic rate limiting & validation)
local function onClientDestructionReport(player: Player, objectTypeOrInfo: any, baseCash: any, worldPos: any, extraMeta: any)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.LastClientReportAt < REMOTE_RATE_LIMIT then
		return
	end
	state.LastClientReportAt = now
	local clampedCash = math.clamp(tonumber(baseCash) or 25, 5, 400)
	handleDestructionEvent(player, objectTypeOrInfo, clampedCash, worldPos, extraMeta)
end

ReportDestructionRemote.OnServerEvent:Connect(onClientDestructionReport)
RootDestructionRemote.OnServerEvent:Connect(onClientDestructionReport)

local function onClientStuntReport(player: Player, stuntType: any, value: any, worldPos: any)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	local now = os.clock()
	if now - state.LastClientReportAt < REMOTE_RATE_LIMIT then
		return
	end
	state.LastClientReportAt = now
	handleStuntEvent(player, tostring(stuntType or "Jump"), tonumber(value) or 1, worldPos)
end

ReportStuntRemote.OnServerEvent:Connect(onClientStuntReport)
RootStuntRemote.OnServerEvent:Connect(onClientStuntReport)

SkipMissionRemote.OnServerEvent:Connect(function(player: Player)
	local state = playerStates[player.UserId]
	if not state then
		return
	end
	startMission(player, state, state.MissionIndex + 1)
end)

--------------------------------------------------------------------------------
-- Player Lifecycle & HeatLevel Leaderstat Mirroring
--------------------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local ls = ensurePlayerSetup(player)
	local state: PlayerChaosState = {
		ComboCount = 0,
		ComboMultiplier = 1,
		ComboTimer = 0,
		UnbankedComboCash = 0,
		CurrentStreakName = "",
		JackpotCharge = tonumber(player:GetAttribute("JackpotCharge")) or 0,
		JackpotSpinsCount = tonumber(player:GetAttribute("JackpotSpinsCount")) or 0,
		GoldenFrenzyRemaining = 0,
		CampaignAct = 1,
		CampaignProgress = 0,
		CampaignCompleted = false,
		MissionIndex = 1,
		MissionProgress = 0,
		MissionTimeRemaining = LIVE_CHAOS_MISSIONS[1].Duration,
		MissionIntermission = 0,
		HeatSurvivalAccumulator = 0,
		LastClientReportAt = 0,
		LastBossHitAt = 0,
	}
	playerStates[player.UserId] = state
	syncCampaignAttributesToPlayer(player, state)
	updateNextVehicleUnlockAttributes(player)

	for _, attrName in ipairs({ "Cash", "Level", "EquippedVehicle", "SelectedVehicle", "OwnedVehicles", "UnlockedVehicles" }) do
		player:GetAttributeChangedSignal(attrName):Connect(function()
			updateNextVehicleUnlockAttributes(player)
		end)
	end
	for _, milestone in ipairs(VEHICLE_UNLOCK_LADDER) do
		player:GetAttributeChangedSignal("Unlocked_" .. milestone.Id):Connect(function()
			updateNextVehicleUnlockAttributes(player)
		end)
		player:GetAttributeChangedSignal("Owned_" .. milestone.Id):Connect(function()
			updateNextVehicleUnlockAttributes(player)
		end)
	end

	-- Mirror HeatStars attribute to leaderstats.HeatLevel automatically
	player:GetAttributeChangedSignal("HeatStars"):Connect(function()
		local stars = math.clamp(math.floor(tonumber(player:GetAttribute("HeatStars")) or 0), 0, 5)
		local heatVal = ls:FindFirstChild("HeatLevel") :: IntValue?
		if heatVal then
			heatVal.Value = stars
		end
	end)

	-- Start first Live Chaos Mission / Campaign Act shortly after join
	task.delay(1.5, function()
		if player.Parent and playerStates[player.UserId] == state then
			syncCampaignAttributesToPlayer(player, state)
			startMission(player, state, 1)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	playerStates[player.UserId] = nil
end

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

--------------------------------------------------------------------------------
-- Main Heartbeat Loop: Dynamic Combo Timer & Live Chaos Mission Cycling
--------------------------------------------------------------------------------
local missionSyncAccumulator = 0

RunService.Heartbeat:Connect(function(dt: number)
	missionSyncAccumulator += dt
	local shouldBroadcastMission = missionSyncAccumulator >= 1.0
	if shouldBroadcastMission then
		missionSyncAccumulator = 0
	end

	-- Update Act 5 Boss Goliath Convoy patrol along Grand Central Avenue ((-140 <-> 140)) & check player ramming
	if activeBossHull and activeBossHull.Parent and activeBossHealth > 0 then
		bossPatrolPhase += dt * 0.45
		local zPos = math.sin(bossPatrolPhase) * 140
		local dirZ = math.cos(bossPatrolPhase)
		local yaw = if dirZ >= 0 then math.pi else 0
		activeBossHull.CFrame = CFrame.new(0, 3.8, zPos) * CFrame.Angles(0, yaw, 0)

		for _, plr in ipairs(Players:GetPlayers()) do
			local st = playerStates[plr.UserId]
			if st and st.CampaignAct == 5 and not st.CampaignCompleted then
				plr:SetAttribute("BossPosition", activeBossHull.Position)
				local char = plr.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local refPart: BasePart? = if hum and hum.SeatPart then hum.SeatPart else (char and char:FindFirstChild("HumanoidRootPart") :: BasePart?)
				if refPart then
					local dist = (refPart.Position - activeBossHull.Position).Magnitude
					local spd = refPart.AssemblyLinearVelocity.Magnitude
					if dist <= 22.0 and spd >= 24.0 then
						damageBossConvoy(plr, math.clamp(spd * 4.0, 220, 350))
					end
				end
			end
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local state = playerStates[player.UserId]
		if not state then
			continue
		end

		-- 1. Tick dynamic 4.5s Chaos Combo timer
		if state.ComboCount > 0 and state.ComboTimer > 0 then
			state.ComboTimer = math.max(0, state.ComboTimer - dt)
			player:SetAttribute("ComboTimer", tonumber(string.format("%.2f", state.ComboTimer)))
			player:SetAttribute("ComboTimerRatio", math.clamp(state.ComboTimer / COMBO_BASE_WINDOW, 0, 1))

			if state.ComboTimer <= 0 then
				finishAndBankCombo(player, state)
			end
		end

		-- 1B. Tick 30s Golden 3X Frenzy Jackpot buff
		if state.GoldenFrenzyRemaining > 0 then
			state.GoldenFrenzyRemaining = math.max(0, state.GoldenFrenzyRemaining - dt)
			if state.GoldenFrenzyRemaining <= 0 then
				player:SetAttribute("Golden3xFrenzyActive", false)
				player:SetAttribute("Golden3xFrenzyRemaining", 0)
			elseif shouldBroadcastMission then
				player:SetAttribute("Golden3xFrenzyRemaining", math.ceil(state.GoldenFrenzyRemaining))
			end
		end

		-- 2. Tick Live Chaos Mission / Timed Challenge
		if state.MissionIntermission > 0 then
			state.MissionIntermission = math.max(0, state.MissionIntermission - dt)
			if state.MissionIntermission <= 0 then
				startMission(player, state, state.MissionIndex + 1)
			end
		elseif state.MissionTimeRemaining > 0 then
			state.MissionTimeRemaining = math.max(0, state.MissionTimeRemaining - dt)

			-- Check "Survive 3-Star Heat for 45s!" mission type
			local def = getActiveMissionDef(state)
			if def.Kind == "SurviveHeat" then
				local reqStars = def.RequiredHeatStars or 3
				local currentStars = tonumber(player:GetAttribute("HeatStars")) or 0
				local isBusted = player:GetAttribute("IsBusted") == true
				if currentStars >= reqStars and not isBusted then
					state.HeatSurvivalAccumulator += dt
					if state.HeatSurvivalAccumulator >= 1.0 then
						local wholeSeconds = math.floor(state.HeatSurvivalAccumulator)
						state.HeatSurvivalAccumulator -= wholeSeconds
						advanceMissionProgress(player, "SurviveHeat", wholeSeconds)
					end
				end
			end

			if state.MissionTimeRemaining <= 0 and state.MissionIntermission <= 0 then
				-- Mission timer expired; rotate to next mission after short intermission
				state.MissionIntermission = MISSION_INTERMISSION * 0.65
				syncMissionToPlayer(player, state, "Expired")
			elseif shouldBroadcastMission then
				player:SetAttribute("MissionTimeRemaining", math.max(0, math.ceil(state.MissionTimeRemaining)))
			end
		end
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000C">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">DestructionService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- DestructionService.script.luau
-- High-impact Roblox physics destruction system for Leo City with 5-Tier Destruction Power System:
-- - Computes player SmashPowerTier (1..5) from vehicle archetype + Plow upgrade level and publishes
--   `player:SetAttribute("SmashPowerTier", tier)`.
-- - Enforces RequiredTier (1..5) per prop:
--   - When playerSmashTier >= requiredTier: smashes immediately and awards full Cash & Coins.
--   - When playerSmashTier < requiredTier: resists destruction, spawns metallic spark burst + clink sound,
--     and shows a 1.2s floating 3D badge ("NEED TIER X CAR OR PLOW! [PRESS B]" in gold/red, 1.5s cooldown).
-- - Preserves vehicle integrity on rammed vehicles (AITrafficVehicle, Vehicle, TrafficVehicle, ArmoredCashTruck):
--   NEVER breaks internal WeldConstraints and NEVER sets CanCollide = false on body parts; keeps all parts
--   welded to PrimaryPart (Chassis), unanchors Chassis, and applies a dramatic upward/forward flip impulse
--   (launchDir * 55 + Vector3.new(0, 32, 0)) + angular spin so the entire intact car flips and tumbles!
-- - Spawns water geysers, electric sparks, and chain-reaction explosions.
-- - Automatically respawns destroyed props after 45 seconds when players are far away.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- EVENTS & REMOTES SETUP
--------------------------------------------------------------------------------
local ServerEvents = ServerStorage:FindFirstChild("ServerEvents")
if not ServerEvents then
	ServerEvents = Instance.new("Folder")
	ServerEvents.Name = "ServerEvents"
	ServerEvents.Parent = ServerStorage
end

local DestructionBindable = ServerEvents:FindFirstChild("DestructionOccurred") :: BindableEvent?
if not DestructionBindable then
	DestructionBindable = Instance.new("BindableEvent")
	DestructionBindable.Name = "DestructionOccurred"
	DestructionBindable.Parent = ServerEvents
end

local RepEvents = ReplicatedStorage:FindFirstChild("Remotes")
if not RepEvents then
	RepEvents = Instance.new("Folder")
	RepEvents.Name = "Remotes"
	RepEvents.Parent = ReplicatedStorage
end

local function ensureRemote(name: string): RemoteEvent
	local existing = RepEvents:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = RepEvents
	return re
end

local DestructionRemote = ensureRemote("DestructionOccurred")
local ExplosionRemote = ensureRemote("ExplosionEffect")
local ReportDestructionRemote = ensureRemote("ReportDestruction")
local SmashPropRemote = ensureRemote("SmashProp")

--------------------------------------------------------------------------------
-- CONSTANTS & STATE
--------------------------------------------------------------------------------
local RESPAWN_DELAY = 45.0
local SAFE_PLAYER_RESPAWN_DIST = 65.0
local EXPLOSION_BLAST_RADIUS = 38.0
local PROXIMITY_SWEEP_INTERVAL = 0.06
local CLIENT_REPORT_MAX_DIST = 45.0
local TIER_BLOCK_COOLDOWN = 1.5

type RespawnEntry = {
	template: Instance,
	parent: Instance,
	originCF: CFrame,
	destroyedAt: number,
	liveInstance: Instance,
}

local respawnQueue: { RespawnEntry } = {}
local boundInstances: { [Instance]: boolean } = {}
local boundParts: { [BasePart]: boolean } = {}
local tierBlockedCooldowns: { [Instance]: number } = {}

--------------------------------------------------------------------------------
-- 5-TIER DESTRUCTION POWER SYSTEM HELPERS
--------------------------------------------------------------------------------
local VEHICLE_CLASS_BASE_TIER: { [string]: number } = {
	Compact = 1,
	Hatchback = 1,
	Sedan = 2,
	Muscle = 2,
	SUV = 3,
	Van = 3,
	Pickup = 3,
	Sports = 3,
	MonsterTruck = 4,
	Monster = 4,
	Bulldozer = 5,
	Tank = 5,
	ArmoredTank = 5,
	BoxTruck = 5,
}

local PROP_REQUIRED_TIER: { [string]: number } = {
	-- Tier 1: All Everyday Street Props, Hydrants, Streetlights, Bus Stops, Billboards & Taxis (Starter Car Smashes All!)
	Crate = 1,
	WoodenCrate = 1,
	JackpotCrate = 1,
	TrafficCone = 1,
	Fence = 1,
	Bench = 1,
	StreetBench = 1,
	TrashCan = 1,
	RecyclingBin = 1,
	Mailbox = 1,
	NewspaperBox = 1,
	FoodVendorCart = 1,
	CafePatio = 1,
	ConstructionBarrier = 1,
	FireHydrant = 1,
	StreetLight = 1,
	TrafficLight = 1,
	BusStop = 1,
	PalmTree = 1,
	Billboard = 1,
	TrafficVehicle = 1,

	-- Tier 2: Gold ATMs & Explosive Fuel Targets (Unlocked by Sedan / Muscle or Plow Lv.2)
	GoldATM = 2,
	GasPump = 2,
	ExplosiveBarrel = 2,

	-- Tier 3: Heavy Armored Cash Trucks & Surveillance Towers (Unlocked by SUV / Pickup / Sports or Plow Lv.3)
	ArmoredCashTruck = 3,
	MegaCorpTower = 3,

	-- Tier 4: Massive Civic Landmarks & Transit Buses (Unlocked by Monster Truck or Plow Lv.4)
	CityBus = 4,
	ConstructionCrane = 4,
	PlazaFountain = 4,

	-- Tier 5: Ultra-Armored End-Game Targets (Unlocked by Goliath Bulldozer or Plow Lv.5)
	MegaCorpBankVault = 5,
	BossGoliath = 5,
}

local function getPlayerSmashTier(player: Player?, vehicleModel: Model?): number
	local vClass = ""
	if vehicleModel then
		vClass = tostring(vehicleModel:GetAttribute("VehicleType") or vehicleModel.Name)
	end
	if (vClass == "" or not VEHICLE_CLASS_BASE_TIER[vClass]) and player then
		vClass = tostring(player:GetAttribute("CurrentVehicleType") or player:GetAttribute("EquippedVehicle") or "Compact")
	end

	local baseTier = VEHICLE_CLASS_BASE_TIER[vClass]
	if not baseTier and vehicleModel then
		baseTier = tonumber(vehicleModel:GetAttribute("BaseSmashTier"))
	end
	baseTier = baseTier or 1

	local plowUpgrade = 1
	if player then
		plowUpgrade = tonumber(player:GetAttribute("Upgrade_Plow")) or 1
	end
	local plowBonus = math.floor((plowUpgrade - 1) * 0.75)
	local tier = math.clamp(baseTier + plowBonus, 1, 5)

	if player and player:GetAttribute("SmashPowerTier") ~= tier then
		player:SetAttribute("SmashPowerTier", tier)
	end
	return tier
end

local function isVehicleDestructible(inst: Instance): boolean
	if
		CollectionService:HasTag(inst, "AITrafficVehicle")
		or CollectionService:HasTag(inst, "TrafficVehicle")
		or CollectionService:HasTag(inst, "Vehicle")
	then
		return true
	end
	local propType = tostring(inst:GetAttribute("PropType") or inst.Name)
	if propType == "TrafficVehicle" or propType == "ArmoredCashTruck" then
		return true
	end
	return false
end

local function getPropRequiredTier(inst: Instance): number
	local explicit = tonumber(inst:GetAttribute("RequiredTier"))
	if explicit and explicit >= 1 then
		return math.clamp(math.floor(explicit), 1, 5)
	end

	local propType = tostring(inst:GetAttribute("PropType") or inst.Name)
	if PROP_REQUIRED_TIER[propType] then
		return PROP_REQUIRED_TIER[propType]
	end

	if CollectionService:HasTag(inst, "AITrafficVehicle") or CollectionService:HasTag(inst, "TrafficVehicle") then
		return 1
	end

	local lower = string.lower(propType)
	if string.find(lower, "bankvault") or string.find(lower, "bossgoliath") then
		return 5
	elseif string.find(lower, "citybus") or string.find(lower, "crane") or string.find(lower, "fountain") then
		return 4
	elseif string.find(lower, "cashtruck") or string.find(lower, "megacorptower") then
		return 3
	elseif string.find(lower, "atm") or string.find(lower, "gaspump") or string.find(lower, "barrel") then
		return 2
	end

	return 1
end

local function showTierResistanceFeedback(propInst: Instance, requiredTier: number)
	local now = os.clock()
	local lastShown = tierBlockedCooldowns[propInst]
	if lastShown and (now - lastShown) < TIER_BLOCK_COOLDOWN then
		return
	end
	tierBlockedCooldowns[propInst] = now

	local adorneePart: BasePart? = if propInst:IsA("BasePart")
		then propInst
		elseif propInst:IsA("Model") then (propInst.PrimaryPart or propInst:FindFirstChildWhichIsA("BasePart", true))
		else nil
	if not adorneePart then
		return
	end

	-- Metallic spark burst + metallic clink sound
	local sparkHost = Instance.new("Part")
	sparkHost.Name = "TierResistSparkVFX"
	sparkHost.Size = Vector3.new(0.5, 0.5, 0.5)
	sparkHost.Position = adorneePart.Position
	sparkHost.Anchored = true
	sparkHost.CanCollide = false
	sparkHost.Transparency = 1
	sparkHost.Parent = Workspace

	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 235, 110), Color3.fromRGB(255, 110, 20))
	pe.LightEmission = 1.0
	pe.Size = NumberSequence.new(0.45, 0.0)
	pe.Lifetime = NumberRange.new(0.18, 0.42)
	pe.Speed = NumberRange.new(20, 38)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -45, 0)
	pe.Rate = 0
	pe.Parent = sparkHost
	pe:Emit(24)

	local clink = Instance.new("Sound")
	clink.Name = "MetallicResistClink"
	clink.SoundId = "rbxasset://sounds/metal.ogg"
	clink.Volume = 0.25
	clink.PlaybackSpeed = 1.25
	clink.Parent = sparkHost
	clink:Play()

	Debris:AddItem(sparkHost, 0.8)

	if propInst:FindFirstChild("TierBlockedBadge") then
		return
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = "TierBlockedBadge"
	bb.Adornee = adorneePart
	bb.Size = UDim2.fromOffset(310, 54)
	bb.StudsOffset = Vector3.new(0, 4.2, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 95
	bb.Parent = propInst

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(135, 18, 24)
	frame.BackgroundTransparency = 0.08
	frame.BorderSizePixel = 0
	frame.Parent = bb

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 205, 45)
	stroke.Thickness = 2.5
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -16, 1, -8)
	label.Position = UDim2.fromOffset(8, 4)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = "NEED TIER " .. tostring(requiredTier) .. " CAR OR PLOW! [PRESS B]"
	label.TextColor3 = Color3.fromRGB(255, 220, 65)
	label.TextStrokeColor3 = Color3.fromRGB(40, 8, 10)
	label.TextStrokeTransparency = 0.15
	label.TextScaled = true
	label.Parent = frame

	TweenService:Create(
		bb,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ StudsOffset = Vector3.new(0, 6.8, 0) }
	):Play()

	Debris:AddItem(bb, 1.2)
end

--------------------------------------------------------------------------------
-- DESTRUCTIBLE RESOLUTION HELPERS
--------------------------------------------------------------------------------
local function isDestructibleRoot(inst: Instance): boolean
	if inst == Workspace or inst:IsA("Folder") then
		return false
	end
	if CollectionService:HasTag(inst, "Destructible") then
		return true
	end
	if inst:GetAttribute("IsDestructible") == true or inst:GetAttribute("PropType") ~= nil then
		return true
	end
	return false
end

local function resolveDestructibleInstance(candidate: Instance?): Instance?
	if not candidate or not candidate:IsDescendantOf(Workspace) then
		return nil
	end

	local bestMatch: Instance? = nil
	local curr: Instance? = candidate
	while curr and curr ~= Workspace do
		if isDestructibleRoot(curr) then
			bestMatch = curr
		end
		curr = curr.Parent
	end

	if bestMatch then
		if (tonumber(bestMatch:GetAttribute("OwnerUserId")) or 0) > 0 then
			return nil
		end
		return bestMatch
	end

	-- Check if inside Workspace.LeoCity.DestructibleProps or TrafficLights
	local leoCity = Workspace:FindFirstChild("LeoCity")
	if leoCity then
		local propsFolder = leoCity:FindFirstChild("DestructibleProps")
		local lightsFolder = leoCity:FindFirstChild("TrafficLights")
		local node: Instance? = candidate
		while node and node.Parent and node.Parent ~= Workspace do
			if (propsFolder and node.Parent == propsFolder) or (lightsFolder and node.Parent == lightsFolder) then
				if node:IsA("Model") or node:IsA("BasePart") then
					return node
				end
			end
			node = node.Parent
		end
	end

	return nil
end

local function getDestructiblePosition(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		local primary = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		if primary then
			return primary.Position
		end
	end
	return nil
end

local function getEffectiveBreakThreshold(inst: Instance): number
	local rawThreshold = (inst:GetAttribute("BreakThreshold") :: number?) or 5
	local propType = (inst:GetAttribute("PropType") :: string?) or inst.Name
	if propType == "ConstructionCrane" or propType == "PlazaFountain" then
		return math.min(rawThreshold, 12)
	end
	return math.min(rawThreshold, 5)
end

--------------------------------------------------------------------------------
-- DRIVER & VEHICLE RESOLUTION
--------------------------------------------------------------------------------
local function resolveAttacker(hitPart: BasePart): (Player?, number, Vector3, Model?)
	local vel = hitPart.AssemblyLinearVelocity
	local speed = vel.Magnitude
	local ramMultiplier = 1.0
	local attacker: Player? = nil
	local resolvedVehicleModel: Model? = nil

	local model = hitPart:FindFirstAncestorOfClass("Model")
	if model then
		-- Check if it's a player character
		local plr = Players:GetPlayerFromCharacter(model)
		if plr then
			attacker = plr
		end

		-- Check if it's a vehicle with a Driver/VehicleSeat or Owner attribute
		local vehicleModel = model
		while vehicleModel.Parent and vehicleModel.Parent:IsA("Model") and vehicleModel.Parent ~= Workspace do
			vehicleModel = vehicleModel.Parent :: Model
		end
		if CollectionService:HasTag(vehicleModel, "Vehicle") or vehicleModel:FindFirstChild("DriveSeat") then
			resolvedVehicleModel = vehicleModel
		end

		local ramAttr = (vehicleModel:GetAttribute("RamMultiplier") :: number?)
			or (vehicleModel:GetAttribute("RamPower") :: number?)
			or (model:GetAttribute("RamMultiplier") :: number?)
		if ramAttr then
			ramMultiplier = ramAttr
		end

		local ownerUserId = (vehicleModel:GetAttribute("OwnerUserId") :: number?)
			or (vehicleModel:GetAttribute("DriverUserId") :: number?)
		if ownerUserId and not attacker then
			attacker = Players:GetPlayerByUserId(ownerUserId)
		end

		local ownerName = (vehicleModel:GetAttribute("Owner") :: string?)
			or (vehicleModel:GetAttribute("DriverName") :: string?)
		if ownerName and not attacker then
			attacker = Players:FindFirstChild(ownerName) :: Player?
		end

		if not attacker then
			local seat = vehicleModel:FindFirstChildWhichIsA("VehicleSeat", true)
				or vehicleModel:FindFirstChildWhichIsA("Seat", true)
			if seat and seat.Occupant then
				local char = seat.Occupant.Parent
				if char then
					attacker = Players:GetPlayerFromCharacter(char)
				end
			end
		end

		-- Fallback velocity from vehicle primary part or driver attributes if collision stopped the bumper part
		local vPrimary = vehicleModel.PrimaryPart or vehicleModel:FindFirstChild("Chassis") :: BasePart?
		if vPrimary and vPrimary.AssemblyLinearVelocity.Magnitude > speed then
			vel = vPrimary.AssemblyLinearVelocity
			speed = vel.Magnitude
		end
		if attacker and speed < 8 then
			local attrSpeed = tonumber(attacker:GetAttribute("VehicleSpeed")) or 0
			if attrSpeed > speed and vPrimary then
				vel = vPrimary.CFrame.LookVector * attrSpeed
				speed = attrSpeed
			end
		end
	end

	-- Fallback: nearest player within 35 studs
	if not attacker then
		local bestDist = 35
		for _, plr in ipairs(Players:GetPlayers()) do
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local d = (root.Position - hitPart.Position).Magnitude
				if d < bestDist then
					bestDist = d
					attacker = plr
					if speed < root.AssemblyLinearVelocity.Magnitude then
						vel = root.AssemblyLinearVelocity
						speed = vel.Magnitude
					end
				end
			end
		end
	end

	return attacker, ramMultiplier, vel, resolvedVehicleModel
end

--------------------------------------------------------------------------------
-- SPECIAL PROP VFX (GEYSERS, SPARKS, SHATTER DEBRIS, EXPLOSIONS)
--------------------------------------------------------------------------------
local function spawnWaterGeyser(pos: Vector3)
	local emitterPart = Instance.new("Part")
	emitterPart.Name = "HydrantWaterGeyser"
	emitterPart.Size = Vector3.new(1, 1, 1)
	emitterPart.Position = pos + Vector3.new(0, 0.5, 0)
	emitterPart.Anchored = true
	emitterPart.Transparency = 1
	emitterPart.CanCollide = false
	emitterPart.Parent = Workspace

	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(165, 225, 255), Color3.fromRGB(240, 250, 255))
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.8),
		NumberSequenceKeypoint.new(0.6, 2.2),
		NumberSequenceKeypoint.new(1, 3.2),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.8, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(1.1, 1.6)
	pe.Rate = 85
	pe.Speed = NumberRange.new(34, 46)
	pe.SpreadAngle = Vector2.new(8, 8)
	pe.Acceleration = Vector3.new(0, -45, 0)
	pe.Parent = emitterPart

	Debris:AddItem(emitterPart, 8.0)
end

local function spawnElectricSparks(part: BasePart)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "ElectricSparks"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 230, 95), Color3.fromRGB(255, 120, 20))
	pe.LightEmission = 1
	pe.Size = NumberSequence.new(0.45, 0)
	pe.Lifetime = NumberRange.new(0.25, 0.55)
	pe.Rate = 60
	pe.Speed = NumberRange.new(16, 28)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -35, 0)
	pe.Parent = part

	task.delay(2.2, function()
		if pe and pe.Parent then
			pe.Enabled = false
		end
	end)
end

local WOOD_PROPS: { [string]: boolean } = {
	WoodenCrate = true,
	Crate = true,
	JackpotCrate = true,
	Fence = true,
	Bench = true,
	PalmTree = true,
}

local function spawnShatterDebrisBurst(
	originPos: Vector3,
	propType: string,
	baseColor: Color3,
	baseMaterial: Enum.Material,
	launchDir: Vector3,
	launchSpeed: number
)
	local isWood = WOOD_PROPS[propType]
		or baseMaterial == Enum.Material.Wood
		or baseMaterial == Enum.Material.WoodPlanks
	local fragmentCount = if isWood then 5 else 4
	local fragMaterial = if isWood then Enum.Material.WoodPlanks else Enum.Material.Metal
	local fragColor = if isWood
		then Color3.fromRGB(148, 102, 58)
		else baseColor

	for i = 1, fragmentCount do
		local frag = Instance.new("Part")
		frag.Name = if isWood then "WoodSplinter" else "MetalFragment"
		if isWood then
			frag.Size = Vector3.new(
				0.35 + math.random() * 0.35,
				0.22 + math.random() * 0.25,
				1.4 + math.random() * 1.4
			)
		else
			frag.Size = Vector3.new(
				0.45 + math.random() * 0.55,
				0.20 + math.random() * 0.35,
				0.75 + math.random() * 0.95
			)
		end
		frag.Color = fragColor
		frag.Material = fragMaterial
		frag.TopSurface = Enum.SurfaceType.Smooth
		frag.BottomSurface = Enum.SurfaceType.Smooth
		frag.Anchored = false
		frag.CanCollide = false
		frag.Massless = true

		local offset = Vector3.new(
			(math.random() - 0.5) * 2.6,
			0.8 + math.random() * 2.2,
			(math.random() - 0.5) * 2.6
		)
		frag.CFrame = CFrame.new(originPos + offset)
			* CFrame.Angles(
				math.random() * math.pi * 2,
				math.random() * math.pi * 2,
				math.random() * math.pi * 2
			)
		frag.Parent = Workspace

		local scatter = Vector3.new(
			(math.random() - 0.5) * 28,
			14 + math.random() * 18,
			(math.random() - 0.5) * 28
		)
		frag.AssemblyLinearVelocity = launchDir * math.clamp(launchSpeed * 1.05, 26, 72) + scatter
		frag.AssemblyAngularVelocity = Vector3.new(
			(math.random() - 0.5) * 26,
			(math.random() - 0.5) * 26,
			(math.random() - 0.5) * 26
		)

		Debris:AddItem(frag, 3.5)
	end
end

local destroyProp: (inst: Instance, attacker: Player?, hitVel: Vector3, isFromExplosion: boolean) -> ()

local function breakAllInternalWelds(model: Model)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("WeldConstraint") then
			desc.Enabled = false
			desc:Destroy()
		elseif desc:IsA("Weld") or desc:IsA("Snap") or desc:IsA("ManualWeld") then
			desc:Destroy()
		end
	end
end

local function triggerChainExplosion(pos: Vector3, attacker: Player?, sourcePropType: string?)
	local isRealExplosiveProp = (sourcePropType == "ExplosiveBarrel" or sourcePropType == "GasPump")

	local exp = Instance.new("Explosion")
	exp.BlastRadius = EXPLOSION_BLAST_RADIUS
	exp.BlastPressure = 0 -- Custom impulse handling for predictable arcade feel
	exp.DestroyJointRadiusPercent = 0
	exp.Visible = isRealExplosiveProp
	exp.Position = pos
	exp.Parent = Workspace

	if isRealExplosiveProp and ExplosionRemote then
		ExplosionRemote:FireAllClients(pos, EXPLOSION_BLAST_RADIUS)
	end

	-- Flash light burst
	local flashPart = Instance.new("Part")
	flashPart.Size = Vector3.new(1, 1, 1)
	flashPart.Position = pos
	flashPart.Anchored = true
	flashPart.CanCollide = false
	flashPart.Transparency = 1
	flashPart.Parent = Workspace

	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 150, 40)
	pl.Brightness = 6
	pl.Range = 55
	pl.Parent = flashPart
	Debris:AddItem(flashPart, 0.35)

	-- Blast nearby destructibles in radius with proportional shockwave velocity
	task.delay(0.08, function()
		local attackerTier = if attacker then (tonumber(attacker:GetAttribute("SmashPowerTier")) or getPlayerSmashTier(attacker, nil)) else 3
		for _, prop in ipairs(CollectionService:GetTagged("Destructible")) do
			if prop:GetAttribute("Destroyed") ~= true then
				local pPos = getDestructiblePosition(prop)
				if pPos then
					local delta = pPos - pos
					local dist = delta.Magnitude
					if dist <= EXPLOSION_BLAST_RADIUS then
						local reqTier = getPropRequiredTier(prop)
						if math.max(attackerTier, 3) >= reqTier then
							local dir = if dist > 0.1 then delta.Unit else Vector3.new(0, 1, 0)
							local falloff = math.clamp(1 - (dist / EXPLOSION_BLAST_RADIUS) * 0.5, 0.45, 1.0)
							destroyProp(prop, attacker, dir * (58 * falloff) + Vector3.new(0, 14, 0), true)
						end
					end
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- CORE DESTRUCTION HANDLER
--------------------------------------------------------------------------------
destroyProp = function(inst: Instance, attacker: Player?, hitVel: Vector3, isFromExplosion: boolean)
	if not inst or not inst.Parent then
		return
	end
	if inst:GetAttribute("Destroyed") == true then
		return
	end
	inst:SetAttribute("Destroyed", true)

	local primary: BasePart? = if inst:IsA("Model")
		then (inst.PrimaryPart or (inst:FindFirstChild("Chassis") :: BasePart?) or inst:FindFirstChildWhichIsA("BasePart", true))
		elseif inst:IsA("BasePart") then inst
		else nil
	if not primary then
		return
	end

	local propPos = primary.Position
	local originCF = (inst:GetAttribute("OriginCFrame") :: CFrame?) or primary.CFrame
	local propType = (inst:GetAttribute("PropType") :: string?) or inst.Name
	local isVehicle = isVehicleDestructible(inst)
	local isJackpotCrate = (propType == "JackpotCrate")
		or (inst:GetAttribute("IsJackpotCrate") == true)
		or (string.find(string.lower(propType), "jackpot") ~= nil)
	local cashValue = (inst:GetAttribute("CashValue") :: number?) or 20
	local chaosPoints = (inst:GetAttribute("ChaosPoints") :: number?) or 15
	if isJackpotCrate then
		propType = "JackpotCrate"
		cashValue = math.floor(cashValue * 3)
		chaosPoints = math.floor(chaosPoints * 3)
	end
	local isExplosive = ((inst:GetAttribute("Explosive") :: boolean?) == true)
		or (propType == "ExplosiveBarrel")
		or (propType == "GasPump")

	-- Clone clean template for respawning before unanchoring/modifying (skip AI traffic cars which self-respawn)
	if inst.Parent and not CollectionService:HasTag(inst, "AITrafficVehicle") then
		local ok, cleanClone = pcall(function()
			return inst:Clone()
		end)
		if ok and cleanClone then
			cleanClone:SetAttribute("Destroyed", false)
			table.insert(respawnQueue, {
				template = cleanClone,
				parent = inst.Parent,
				originCF = originCF,
				destroyedAt = os.clock(),
				liveInstance = inst,
			})
		end
	end

	local flatVel = Vector3.new(hitVel.X, 0, hitVel.Z)
	local launchDir = if flatVel.Magnitude > 0.5
		then flatVel.Unit
		elseif hitVel.Magnitude > 0.5 then hitVel.Unit
		else Vector3.new(0, 1, 0)
	local launchSpeed = math.clamp(math.max(hitVel.Magnitude * 1.25, 36), 32, 78)

	local parts: { BasePart } = {}
	if inst:IsA("Model") then
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
	elseif inst:IsA("BasePart") then
		table.insert(parts, inst)
	end

	if isVehicle then
		-- NEVER break internal WeldConstraints and NEVER set CanCollide = false on vehicle body parts!
		-- Keep all parts of the vehicle welded together to its PrimaryPart (Chassis), unanchor Chassis,
		-- and apply a dramatic upward/forward flip impulse + angular spin so the entire intact car flips!
		for _, p in ipairs(parts) do
			p.Anchored = false
		end
		primary.Anchored = false
		primary.CanCollide = true
		primary.AssemblyLinearVelocity = launchDir * 55 + Vector3.new(0, 32, 0)
		primary.AssemblyAngularVelocity = Vector3.new(
			(math.random() - 0.5) * 18,
			(math.random() - 0.5) * 14,
			(math.random() - 0.5) * 18
		)
	else
		-- Regular destructible prop: break all internal welds so boards/crates/poles/signs shatter apart
		if inst:IsA("Model") then
			breakAllInternalWelds(inst)
		end

		local upwardLift = math.clamp(launchSpeed * 0.45, 18, 28)
		local spreadScale = math.clamp(launchSpeed * 0.25, 8, 18)

		for idx, p in ipairs(parts) do
			p.Anchored = false
			p.CanCollide = false
			local partSpeedScale = math.clamp(1.08 - (idx - 1) * 0.05, 0.78, 1.15)
			local spread = Vector3.new(
				(math.random() - 0.5) * 2.2,
				math.random() * 0.55 + 0.15,
				(math.random() - 0.5) * 2.2
			) * spreadScale
			p.AssemblyLinearVelocity = launchDir * (launchSpeed * partSpeedScale)
				+ Vector3.new(0, upwardLift, 0)
				+ spread
			p.AssemblyAngularVelocity = Vector3.new(
				(math.random() - 0.5) * 22,
				(math.random() - 0.5) * 22,
				(math.random() - 0.5) * 22
			)
		end

		-- Re-enable collision on flying debris after 0.35s once the vehicle has plowed past
		task.delay(0.35, function()
			if inst and inst.Parent then
				for _, p in ipairs(parts) do
					if p and p.Parent and p.Transparency < 0.95 then
						p.CanCollide = true
					end
				end
			end
		end)
	end

	-- Spawn extra flying wood splinters / metal fragments cleaned up after 3.5s
	spawnShatterDebrisBurst(propPos, propType, primary.Color, primary.Material, launchDir, launchSpeed)

	-- Special Prop Effects
	if propType == "FireHydrant" or propType == "PlazaFountain" then
		spawnWaterGeyser(originCF.Position)
	elseif propType == "StreetLight" or propType == "TrafficLight" or propType == "Billboard" then
		spawnElectricSparks(primary)
	end

	if isExplosive then
		local realType = if (propType == "ExplosiveBarrel" or propType == "GasPump") then propType else "ExplosiveBarrel"
		triggerChainExplosion(propPos, attacker, realType)
	end

	-- Broadcast DestructionOccurred to Economy/Combo systems and clients
	local payload = {
		player = attacker,
		Player = attacker,
		propType = propType,
		Type = propType,
		cashEarned = cashValue,
		CashReward = cashValue,
		chaosPoints = chaosPoints,
		position = propPos,
		Position = propPos,
		isExplosion = isExplosive,
		IsExplosion = isExplosive,
		isFromExplosion = isFromExplosion,
		isJackpotCrate = isJackpotCrate,
		IsJackpotCrate = isJackpotCrate,
		jackpotChargeGain = if isJackpotCrate then 35 else nil,
	}
	if DestructionBindable then
		DestructionBindable:Fire(payload)
	else
		local rootDestBindable = ServerStorage:FindFirstChild("DestructionEvent")
		if rootDestBindable and rootDestBindable:IsA("BindableEvent") and attacker then
			rootDestBindable:Fire(attacker, payload, cashValue, propPos)
		end
	end
	if DestructionRemote then
		if attacker then
			DestructionRemote:FireClient(attacker, payload)
		else
			DestructionRemote:FireAllClients(payload)
		end
	end

	-- Fade out broken non-vehicle physics parts after 6 seconds to keep framerate fast
	if not isVehicle then
		task.delay(6.0, function()
			if inst and inst.Parent then
				for _, p in ipairs(parts) do
					if p and p.Parent then
						p.Transparency = 1
						p.CanCollide = false
						p.Anchored = true
					end
				end
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- COLLISION BINDING (ALL DESCENDANT BASEPARTS)
--------------------------------------------------------------------------------
local function bindDestructible(inst: Instance)
	if boundInstances[inst] then
		return
	end
	boundInstances[inst] = true

	local function onTouched(otherPart: BasePart)
		if inst:GetAttribute("Destroyed") == true then
			return
		end
		if otherPart.Anchored then
			return
		end
		if otherPart:IsDescendantOf(inst) then
			return
		end
		if CollectionService:HasTag(otherPart, "Destructible") or otherPart:GetAttribute("Destroyed") == true then
			return
		end
		local otherModel = otherPart:FindFirstAncestorOfClass("Model")
		if otherModel then
			if CollectionService:HasTag(otherModel, "Destructible") and not CollectionService:HasTag(otherModel, "Vehicle") then
				return
			end
			if otherModel:GetAttribute("Destroyed") == true then
				return
			end
		end

		local attacker, ramMultiplier, hitVel, attackerVehModel = resolveAttacker(otherPart)
		local effectiveSpeed = hitVel.Magnitude * ramMultiplier
		local threshold = getEffectiveBreakThreshold(inst)

		if effectiveSpeed >= threshold or (attacker ~= nil and effectiveSpeed >= 2.0) then
			local smashTier = getPlayerSmashTier(attacker, attackerVehModel)
			local requiredTier = getPropRequiredTier(inst)
			if smashTier < requiredTier then
				showTierResistanceFeedback(inst, requiredTier)
				return
			end

			local launchVel = if hitVel.Magnitude >= 15
				then hitVel
				else (otherPart.CFrame.LookVector * 38 + Vector3.new(0, 12, 0))
			destroyProp(inst, attacker, launchVel, false)
		end
	end

	local function bindPart(p: BasePart)
		if boundParts[p] then
			return
		end
		boundParts[p] = true
		p.Touched:Connect(onTouched)
	end

	if inst:IsA("BasePart") then
		bindPart(inst)
	elseif inst:IsA("Model") then
		for _, desc in ipairs(inst:GetDescendants()) do
			if desc:IsA("BasePart") then
				bindPart(desc)
			end
		end
		inst.DescendantAdded:Connect(function(desc: Instance)
			if desc:IsA("BasePart") then
				bindPart(desc)
			end
		end)
	end
end

for _, inst in ipairs(CollectionService:GetTagged("Destructible")) do
	bindDestructible(inst)
end
CollectionService:GetInstanceAddedSignal("Destructible"):Connect(bindDestructible)

-- Also ensure any untagged props inside Workspace.LeoCity.DestructibleProps are tagged & bound
task.defer(function()
	local leoCity = Workspace:WaitForChild("LeoCity", 15)
	if not leoCity then
		return
	end
	local propsFolder = leoCity:WaitForChild("DestructibleProps", 10)
	if propsFolder then
		for _, child in ipairs(propsFolder:GetChildren()) do
			if not CollectionService:HasTag(child, "Destructible") then
				CollectionService:AddTag(child, "Destructible")
			end
			bindDestructible(child)
		end
		propsFolder.ChildAdded:Connect(function(child: Instance)
			if not CollectionService:HasTag(child, "Destructible") then
				CollectionService:AddTag(child, "Destructible")
			end
			bindDestructible(child)
		end)
	end
end)

--------------------------------------------------------------------------------
-- CLIENT REPORT DESTRUCTION / SMASH PROP REMOTE LISTENERS
--------------------------------------------------------------------------------
local function getPlayerReferencePositionAndVelocity(player: Player): (Vector3?, Vector3, Model?)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if hum and hum.SeatPart then
		local seatPart = hum.SeatPart
		local vehModel = seatPart:FindFirstAncestorOfClass("Model")
		local chassis = vehModel and (vehModel.PrimaryPart or vehModel:FindFirstChild("Chassis") :: BasePart?)
		if chassis then
			return chassis.Position, chassis.AssemblyLinearVelocity, vehModel
		end
		return seatPart.Position, seatPart.AssemblyLinearVelocity, vehModel
	end

	if hrp then
		return hrp.Position, hrp.AssemblyLinearVelocity, nil
	end
	return nil, Vector3.zero, nil
end

local function handleClientSmashRequest(player: Player, targetArg: any, velocityArg: any)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	if typeof(targetArg) ~= "Instance" then
		return
	end

	local propInst = resolveDestructibleInstance(targetArg)
	if not propInst or propInst:GetAttribute("Destroyed") == true then
		return
	end

	local playerPos, fallbackVel, vehModel = getPlayerReferencePositionAndVelocity(player)
	if not playerPos then
		return
	end

	-- Verify proximity within 45 studs of any part of the destructible prop (or its primary position)
	local withinRange = false
	local propPos = getDestructiblePosition(propInst)
	if propPos then
		local flatDelta = Vector3.new(propPos.X - playerPos.X, 0, propPos.Z - playerPos.Z)
		if (propPos - playerPos).Magnitude <= CLIENT_REPORT_MAX_DIST or flatDelta.Magnitude <= CLIENT_REPORT_MAX_DIST then
			withinRange = true
		end
	end
	if not withinRange and targetArg:IsA("BasePart") then
		if (targetArg.Position - playerPos).Magnitude <= CLIENT_REPORT_MAX_DIST then
			withinRange = true
		end
	end
	if not withinRange then
		return
	end

	local smashTier = getPlayerSmashTier(player, vehModel)
	local requiredTier = getPropRequiredTier(propInst)
	if smashTier < requiredTier then
		showTierResistanceFeedback(propInst, requiredTier)
		return
	end

	local hitVel = if typeof(velocityArg) == "Vector3" then velocityArg else fallbackVel
	if hitVel.Magnitude < 25 then
		local look = if vehModel and vehModel.PrimaryPart
			then vehModel.PrimaryPart.CFrame.LookVector
			elseif propPos then (propPos - playerPos).Unit
			else Vector3.new(0, 0, -1)
		hitVel = look * 42 + Vector3.new(0, 18, 0)
	end

	destroyProp(propInst, player, hitVel, false)
end

ReportDestructionRemote.OnServerEvent:Connect(handleClientSmashRequest)
SmashPropRemote.OnServerEvent:Connect(handleClientSmashRequest)

--------------------------------------------------------------------------------
-- PLAYER SMASH POWER TIER ATTRIBUTE SYNC
--------------------------------------------------------------------------------
local function bindPlayerSmashTierSync(player: Player)
	getPlayerSmashTier(player, nil)
	for _, attr in ipairs({ "EquippedVehicle", "CurrentVehicleType", "Upgrade_Plow", "PlowLevel" }) do
		player:GetAttributeChangedSignal(attr):Connect(function()
			local _, _, vehModel = getPlayerReferencePositionAndVelocity(player)
			getPlayerSmashTier(player, vehModel)
		end)
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(bindPlayerSmashTierSync, plr)
end
Players.PlayerAdded:Connect(bindPlayerSmashTierSync)

--------------------------------------------------------------------------------
-- SERVER-SIDE VEHICLE PROXIMITY SMASH SWEEP (EVERY 0.06s)
--------------------------------------------------------------------------------
local sweepOverlapParams = OverlapParams.new()
sweepOverlapParams.FilterType = Enum.RaycastFilterType.Exclude

local sweepAccumulator = 0

local function sweepAroundVehicle(vehicleModel: Model, driver: Player?)
	local chassis = vehicleModel.PrimaryPart or vehicleModel:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end

	local smashTier = getPlayerSmashTier(driver, vehicleModel)

	local vel = chassis.AssemblyLinearVelocity
	local speed = vel.Magnitude
	local attrSpeed = if driver then (tonumber(driver:GetAttribute("VehicleSpeed")) or 0) else 0
	local seat = vehicleModel:FindFirstChildWhichIsA("VehicleSeat", true)
	local throttleActive = seat ~= nil and math.abs(seat.ThrottleFloat) > 0.05

	if speed < 2.5 and attrSpeed < 2.5 and not throttleActive then
		return
	end

	local filter: { Instance } = { vehicleModel }
	if driver and driver.Character then
		table.insert(filter, driver.Character)
	end
	sweepOverlapParams.FilterDescendantsInstances = filter

	local boxCF = chassis.CFrame * CFrame.new(0, 0, -1.75)
	local boxSize = chassis.Size + Vector3.new(4.5, 3.0, 6.5)
	local hitParts = Workspace:GetPartBoundsInBox(boxCF, boxSize, sweepOverlapParams)

	local forwardDir = chassis.CFrame.LookVector
	local effectiveSpeed = math.max(speed, attrSpeed, 38)
	local launchVel = forwardDir * effectiveSpeed + Vector3.new(0, 18, 0)

	for _, part in ipairs(hitParts) do
		local propInst = resolveDestructibleInstance(part)
		if propInst and propInst ~= vehicleModel and propInst:GetAttribute("Destroyed") ~= true then
			local requiredTier = getPropRequiredTier(propInst)
			if smashTier >= requiredTier then
				destroyProp(propInst, driver, launchVel, false)
			else
				showTierResistanceFeedback(propInst, requiredTier)
			end
		end
	end
end

RunService.Heartbeat:Connect(function(dt: number)
	sweepAccumulator += dt
	if sweepAccumulator < PROXIMITY_SWEEP_INTERVAL then
		return
	end
	sweepAccumulator = 0

	local sweptVehicles: { [Model]: boolean } = {}

	-- 1. Check all players seated in vehicles (or sprinting on foot into Tier 1 street props)
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?

		if hum and hum.SeatPart then
			local vehModel = hum.SeatPart:FindFirstAncestorOfClass("Model")
			if vehModel and not sweptVehicles[vehModel] then
				sweptVehicles[vehModel] = true
				sweepAroundVehicle(vehModel, plr)
			end
		elseif hrp and hrp.AssemblyLinearVelocity.Magnitude >= 22 then
			-- High-speed on-foot dash/sprint prop smash (Tier 1 props only)
			sweepOverlapParams.FilterDescendantsInstances = if char then { char } else {}
			local hitParts = Workspace:GetPartBoundsInBox(hrp.CFrame, Vector3.new(5.5, 6.0, 5.5), sweepOverlapParams)
			for _, part in ipairs(hitParts) do
				local propInst = resolveDestructibleInstance(part)
				if propInst and propInst:GetAttribute("Destroyed") ~= true then
					local requiredTier = getPropRequiredTier(propInst)
					if requiredTier <= 1 then
						destroyProp(propInst, plr, hrp.AssemblyLinearVelocity + Vector3.new(0, 14, 0), false)
					end
				end
			end
		end
	end

	-- 2. Also check any tagged Vehicle with an OwnerUserId or active occupant
	for _, inst in ipairs(CollectionService:GetTagged("Vehicle")) do
		if inst:IsA("Model") and not sweptVehicles[inst] then
			local seat = inst:FindFirstChildWhichIsA("VehicleSeat", true)
			local driver: Player? = nil
			if seat and seat.Occupant and seat.Occupant.Parent then
				driver = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
			end
			if not driver then
				local ownerId = tonumber(inst:GetAttribute("OwnerUserId"))
				if ownerId and ownerId > 0 then
					driver = Players:GetPlayerByUserId(ownerId)
				end
			end
			if driver or (inst.PrimaryPart and inst.PrimaryPart.AssemblyLinearVelocity.Magnitude >= 8) then
				sweptVehicles[inst] = true
				sweepAroundVehicle(inst, driver)
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- AUTOMATIC PROP RESPAWNING LOOP (AFTER 45s WHEN PLAYERS ARE FAR AWAY)
--------------------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(3.0)
		local now = os.clock()
		for i = #respawnQueue, 1, -1 do
			local entry = respawnQueue[i]
			if now - entry.destroyedAt >= RESPAWN_DELAY then
				local farEnough = true
				for _, plr in ipairs(Players:GetPlayers()) do
					local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and (root.Position - entry.originCF.Position).Magnitude < SAFE_PLAYER_RESPAWN_DIST then
						farEnough = false
						break
					end
				end

				if farEnough then
					table.remove(respawnQueue, i)
					if entry.liveInstance and entry.liveInstance.Parent then
						boundInstances[entry.liveInstance] = nil
						tierBlockedCooldowns[entry.liveInstance] = nil
						entry.liveInstance:Destroy()
					end
					if entry.parent and entry.parent.Parent then
						local restored = entry.template
						if restored:IsA("Model") and restored.PrimaryPart then
							restored:PivotTo(entry.originCF)
						elseif restored:IsA("BasePart") then
							restored.CFrame = entry.originCF
						end
						restored.Parent = entry.parent
						CollectionService:AddTag(restored, "Destructible")
						bindDestructible(restored)
					end
				end
			end
		end
	end
end)

print("[DestructionService] Ready and monitoring destructible city props with 5-Tier Destruction Power System.")
