				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	GraphicsAndAtmosphereService.script.luau
	World of Destruction (Roblox)
	Configures crisp, high-contrast Snowy Christmas Manhattan late-afternoon / twilight lighting & post-processing.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local function ensurePostEffect(className: string, name: string): any
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.ClassName == className then
			return child
		end
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

local function configureCrispLighting()
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.20
	Lighting.EnvironmentDiffuseScale = 0.92
	Lighting.EnvironmentSpecularScale = 0.95
	Lighting.ClockTime = 15.6
	Lighting.Brightness = 2.55
	Lighting.Ambient = Color3.fromRGB(128, 138, 156)
	Lighting.OutdoorAmbient = Color3.fromRGB(158, 170, 190)
	Lighting.FogColor = Color3.fromRGB(168, 182, 204)
	Lighting.ColorShift_Top = Color3.fromRGB(215, 226, 245)

	local atmosphere: Atmosphere = ensurePostEffect("Atmosphere", "WoDAtmosphere")
	atmosphere.Density = 0.15
	atmosphere.Offset = 0.10
	atmosphere.Color = Color3.fromRGB(185, 200, 222)
	atmosphere.Decay = Color3.fromRGB(125, 140, 165)
	atmosphere.Glare = 0.04
	atmosphere.Haze = 0.45

	local sky: Sky = ensurePostEffect("Sky", "WoDSky")
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 12
	sky.MoonAngularSize = 11
	sky.StarCount = 1500

	local bloom: BloomEffect = ensurePostEffect("BloomEffect", "WoDBloom")
	bloom.Enabled = true
	bloom.Intensity = 0.14
	bloom.Size = 14
	bloom.Threshold = 2.2

	local cc: ColorCorrectionEffect = ensurePostEffect("ColorCorrectionEffect", "WoDColorCorrection")
	cc.Enabled = true
	cc.Brightness = 0.02
	cc.Contrast = 0.12
	cc.Saturation = 0.06
	cc.TintColor = Color3.fromRGB(246, 249, 255)

	local sunRays: SunRaysEffect = ensurePostEffect("SunRaysEffect", "WoDSunRays")
	sunRays.Enabled = true
	sunRays.Intensity = 0.04
	sunRays.Spread = 0.50

	local dof: DepthOfFieldEffect = ensurePostEffect("DepthOfFieldEffect", "WoDDepthOfField")
	dof.Enabled = false

	-- Clean up any legacy CityNavigationBeacons or LeoCityViralZones so there is zero visual clutter
	local leoCity = Workspace:FindFirstChild("LeoCity")
	if leoCity and leoCity:FindFirstChild("CityNavigationBeacons") then
		leoCity.CityNavigationBeacons:Destroy()
	end
	if Workspace:FindFirstChild("CityNavigationBeacons") then
		Workspace.CityNavigationBeacons:Destroy()
	end
	if Workspace:FindFirstChild("LeoCityViralZones") then
		Workspace.LeoCityViralZones:Destroy()
	end

	Lighting:SetAttribute("GraphicsConfiguredV1", true)
end

configureCrispLighting()
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000F">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">MonetizationService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	MonetizationService.script.luau
	World of Destruction (Roblox) — Version 1.0
	
	Complete Roblox MarketplaceService Integration for GamePasses & Developer Products,
	plus Studio Sandbox Purchase Mode:
	- GamePasses (Permanent Perks):
	  1. VIP2xCash            — 2x Cash & XP permanently
	  2. UnlimitedNitro       — Infinite Nitro boost + blue plasma flames
	  3. GoldenBulldozerPass  — Unlocks Special Golden Apex Bulldozer
	  4. HeatShieldScanner    — 50% slower Police Heat buildup + faster evade
	  5. MegaMagnetPass       — 2x Combo Timer window & +50% Cash Magnet
	- Developer Products (Repeatable Consumables):
	  1. CashPackStarter           — +$10,000 Cash
	  2. CashPackPro               — +$50,000 Cash
	  3. CashPackTycoon            — +$250,000 Cash
	  4. BribePoliceChief          — Instantly clear 5-Star Heat
	  5. InstantMaxRepairAndBoost  — Instant full repair + 60s Overdrive 2x Multiplier
	- Studio Sandbox Purchase Mode:
	  When running inside Roblox Studio (`RunService:IsStudio()`) or when placeholder
	  Asset IDs (`0`) are configured, players can test-grant any GamePass or DevProduct
	  for free via the "Store / VIP [M]" UI or remote so monetization can be tested
	  immediately before publishing Robux Asset IDs.
]]

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

--------------------------------------------------------------------------------
-- GamePass & Developer Product Catalog
--------------------------------------------------------------------------------
export type GamePassEntry = {
	Key: string,
	PassId: number,
	Title: string,
	PriceRobux: number,
	Description: string,
	IconText: string,
	AccentColor: { number },
}

export type DevProductEntry = {
	Key: string,
	ProductId: number,
	Title: string,
	PriceRobux: number,
	Description: string,
	IconText: string,
	AccentColor: { number },
}

local GAMEPASS_CATALOG: { GamePassEntry } = {
