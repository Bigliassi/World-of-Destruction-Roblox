		MaxHealth = 140,
		Mass = 1350,
		MaxSpeed = 98,
		ReverseSpeed = 42,
		Acceleration = 78,
		BrakeDecel = 112,
		TurnSpeed = 2.95,
		DriftFactor = 1.55,
		RamMultiplier = 1.25,
		NitroCapacity = 4.8,
		HoverHeight = 2.1,

		Size = Vector3.new(7.0, 2.2, 15.4),
		WheelRadius = 1.5,
		WheelWidth = 1.15,
		WheelbaseOffsetZ = 5.0,
		TrackOffsetX = 3.55,

		PrimaryColor = Color3.fromRGB(245, 110, 20),
		SecondaryColor = Color3.fromRGB(20, 22, 26),
