-- Populate Page 3: VIP Store & Studio Sandbox Tester
--------------------------------------------------------------------------------
local storeList = Instance.new("UIListLayout")
storeList.Padding = UDim.new(0, 8)
storeList.Parent = storePage

local storeStatusBanner = Instance.new("TextLabel")
storeStatusBanner.Name = "StoreStatusBanner"
storeStatusBanner.Size = UDim2.new(1, -12, 0, 36)
storeStatusBanner.BackgroundColor3 = Color3.fromRGB(32, 26, 52)
storeStatusBanner.Font = Enum.Font.GothamBlack
storeStatusBanner.Text = "STUDIO SANDBOX MODE ACTIVE: Click any GamePass or DevProduct below to test-unlock for FREE!"
storeStatusBanner.TextColor3 = Color3.fromRGB(255, 215, 65)
storeStatusBanner.TextSize = 12
storeStatusBanner.Parent = storePage
addCorner(storeStatusBanner, 8)

local DEFAULT_GAMEPASSES = {
	{ Key = "VIP2xCash", Title = "VIP 2x Cash & XP", PriceRobux = 399, Description = "Permanently doubles all Cash & XP earned from smashing, stunts, combos, and missions!" },
	{ Key = "UnlimitedNitro", Title = "Unlimited Plasma Nitro", PriceRobux = 299, Description = "Infinite Nitro boost meter that never depletes + twin Blue Plasma exhaust flames!" },
	{ Key = "GoldenBulldozerPass", Title = "Golden Apex Bulldozer", PriceRobux = 499, Description = "Unlocks the heavily armored Golden Apex Bulldozer & Goliath Rig with 24K Gold trim!" },
	{ Key = "HeatShieldScanner", Title = "Police Heat Shield Scanner", PriceRobux = 249, Description = "50% slower Police Heat buildup and 50% faster cooldown when evading pursuit!" },
	{ Key = "MegaMagnetPass", Title = "Mega Combo & Cash Magnet", PriceRobux = 199, Description = "Doubles your Combo Timer window (9.0s) and grants a permanent +50% Cash Magnet boost!" },
}

local DEFAULT_DEVPRODUCTS = {
	{ Key = "CashPackStarter", Title = "Starter Cash Pack (+$10,000)", PriceRobux = 49, Description = "Instantly adds $10,000 Destruction Cash to your wallet for Speed Shop upgrades!" },
	{ Key = "CashPackPro", Title = "Pro Cash Vault (+$50,000)", PriceRobux = 199, Description = "Instantly adds $50,000 Destruction Cash to unlock heavy vehicles & high-tier upgrades!" },
	{ Key = "CashPackTycoon", Title = "Tycoon Mega Crate (+$250,000)", PriceRobux = 699, Description = "Instantly adds $250,000 Destruction Cash — max out every Speed Shop track & vehicle!" },
	{ Key = "BribePoliceChief", Title = "Bribe Police Chief (Clear Heat)", PriceRobux = 35, Description = "Instantly calls off all pursuing Police units and resets 5-Star Heat to 0!" },
	{ Key = "InstantMaxRepairAndBoost", Title = "Max Repair + 60s Overdrive", PriceRobux = 29, Description = "Instantly repairs your vehicle to 100% HP, refills Nitro, and triggers 60s 2x Overdrive!" },
}

local function renderStoreCatalog()
	for _, child in ipairs(storePage:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local function createStoreRow(kind: "GamePass" | "DevProduct", item: { Key: string, Title: string, PriceRobux: number, Description: string })
		local isOwned = kind == "GamePass" and (localPlayer:GetAttribute("Pass_" .. item.Key) == true or localPlayer:GetAttribute(item.Key) == true)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -12, 0, 58)
		row.BackgroundColor3 = if isOwned then Color3.fromRGB(20, 40, 34) else Color3.fromRGB(20, 27, 44)
		row.BorderSizePixel = 0
		row.Parent = storePage
		addCorner(row, 9)
		addStroke(
			row,
			if isOwned then Color3.fromRGB(65, 240, 145) elseif kind == "GamePass" then Color3.fromRGB(255, 200, 55) else Color3.fromRGB(0, 215, 255),
			1.4
		)

		local badge = Instance.new("TextLabel")
		badge.Size = UDim2.fromOffset(86, 22)
		badge.Position = UDim2.fromOffset(10, 7)
		badge.BackgroundColor3 = if kind == "GamePass" then Color3.fromRGB(165, 115, 20) else Color3.fromRGB(20, 115, 155)
		badge.Font = Enum.Font.GothamBlack
		badge.Text = if kind == "GamePass" then "GAMEPASS" else "CONSUMABLE"
		badge.TextColor3 = Color3.fromRGB(255, 255, 255)
		badge.TextSize = 10
		badge.Parent = row
		addCorner(badge, 5)

		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, -250, 0, 22)
		title.Position = UDim2.fromOffset(104, 6)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBlack
		title.Text = item.Title
		title.TextColor3 = Color3.fromRGB(255, 255, 255)
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = row

		local desc = Instance.new("TextLabel")
		desc.Size = UDim2.new(1, -165, 0, 22)
		desc.Position = UDim2.fromOffset(10, 31)
		desc.BackgroundTransparency = 1
		desc.Font = Enum.Font.GothamMedium
		desc.Text = item.Description
		desc.TextColor3 = Color3.fromRGB(205, 215, 235)
		desc.TextSize = 11
		desc.TextXAlignment = Enum.TextXAlignment.Left
		desc.TextTruncate = Enum.TextTruncate.AtEnd
		desc.Parent = row

		local buyBtn = Instance.new("TextButton")
		buyBtn.AnchorPoint = Vector2.new(1, 0.5)
		buyBtn.Position = UDim2.new(1, -10, 0.5, 0)
		buyBtn.Size = UDim2.fromOffset(135, 36)
		buyBtn.BackgroundColor3 = if isOwned then Color3.fromRGB(40, 150, 90) else Color3.fromRGB(245, 185, 35)
		buyBtn.Font = Enum.Font.GothamBlack
		buyBtn.Text = if isOwned then "ACTIVE ✓" else string.format("R$ %d (TEST)", item.PriceRobux)
		buyBtn.TextColor3 = if isOwned then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(15, 20, 30)
		buyBtn.TextSize = 12
		buyBtn.Parent = row
		addCorner(buyBtn, 8)

		buyBtn.Activated:Connect(function()
			local reqRemote = findRemoteEvent("RequestMonetizationPurchase")
			if reqRemote then
				reqRemote:FireServer(kind, item.Key)
			end
			task.delay(0.25, renderStoreCatalog)
		end)
	end

	for _, gp in ipairs(DEFAULT_GAMEPASSES) do
		createStoreRow("GamePass", gp)
	end
	for _, dp in ipairs(DEFAULT_DEVPRODUCTS) do
		createStoreRow("DevProduct", dp)
	end
end

local function switchModalTab(tabName: "Controls" | "Levels" | "Store")
	controlsPage.Visible = (tabName == "Controls")
	levelsPage.Visible = (tabName == "Levels")
	storePage.Visible = (tabName == "Store")

	tabControlsBtn.BackgroundColor3 = if tabName == "Controls" then Color3.fromRGB(0, 145, 205) else Color3.fromRGB(24, 32, 52)
	tabLevelsBtn.BackgroundColor3 = if tabName == "Levels" then Color3.fromRGB(0, 145, 205) else Color3.fromRGB(24, 32, 52)
	tabStoreBtn.BackgroundColor3 = if tabName == "Store" then Color3.fromRGB(185, 130, 25) else Color3.fromRGB(24, 32, 52)

	if tabName == "Levels" then
		renderRanksTable()
	elseif tabName == "Store" then
		renderStoreCatalog()
	end
end

local function openModalWithTab(tabName: "Controls" | "Levels" | "Store")
	if modalBackdrop.Visible and ((tabName == "Controls" and controlsPage.Visible) or (tabName == "Store" and storePage.Visible)) then
		modalBackdrop.Visible = false
		return
	end
	modalBackdrop.Visible = true
	switchModalTab(tabName)
end

tabControlsBtn.Activated:Connect(function()
	switchModalTab("Controls")
end)
tabLevelsBtn.Activated:Connect(function()
	switchModalTab("Levels")
end)
tabStoreBtn.Activated:Connect(function()
	switchModalTab("Store")
end)
closeBtn.Activated:Connect(function()
	modalBackdrop.Visible = false
end)
guideToggleBtn.Activated:Connect(function()
	openModalWithTab("Controls")
end)
storeToggleBtn.Activated:Connect(function()
	openModalWithTab("Store")
end)

--------------------------------------------------------------------------------
-- Onboarding Step Progression & Live Attribute Watchers
--------------------------------------------------------------------------------
local currentStepIndex = 1
local tutorialCompleted = false
local usedNitroOrDrift = false
local visitedSpeedShop = false

local function updateTutorialUI()
	if tutorialCompleted then
		tutorialCard.Visible = false
		setWaypointVisible(false)
		return
	end

	local spec = TUTORIAL_STEPS[currentStepIndex]
	if not spec then
		tutorialCompleted = true
		tutorialCard.Visible = false
		setWaypointVisible(false)
		return
	end

	tutHeader.Text = spec.Title
	tutHeader.TextColor3 = spec.AccentColor
	tutBody.Text = spec.Instruction
	tutHintLabel.Text = spec.KeyHint
	tutorialCardStroke.Color = spec.AccentColor
	tutProgressFill.BackgroundColor3 = spec.AccentColor

	TweenService:Create(
		tutProgressFill,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(currentStepIndex / #TUTORIAL_STEPS, 1) }
	):Play()

	if currentStepIndex == #TUTORIAL_STEPS then
		tutNextBtn.Text = "Finish ✓"
	else
		tutNextBtn.Text = "Next ▸"
	end
end

local function advanceTutorialStep()
	if tutorialCompleted then
		return
	end
	if currentStepIndex < #TUTORIAL_STEPS then
		currentStepIndex += 1
		updateTutorialUI()
	else
		tutorialCompleted = true
		updateTutorialUI()
	end
end

tutNextBtn.Activated:Connect(advanceTutorialStep)
tutSkipBtn.Activated:Connect(function()
	tutorialCompleted = true
	updateTutorialUI()
end)

-- Keyboard shortcuts: [H] Guide & Ranks, [M] VIP Store, plus detecting [V], [LeftShift], [Space], [B]
UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.Space then
		usedNitroOrDrift = true
	elseif input.KeyCode == Enum.KeyCode.B then
		visitedSpeedShop = true
	end

	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.H then
		openModalWithTab("Controls")
	elseif input.KeyCode == Enum.KeyCode.M then
		openModalWithTab("Store")
	end
end)

-- Update Top-Right Level & XP Badge
local function refreshLevelBadge()
	local lvl = tonumber(localPlayer:GetAttribute("Level")) or 1
	local rank = tostring(localPlayer:GetAttribute("RankTitle") or "Street Rookie")
	local ratio = tonumber(localPlayer:GetAttribute("XPProgressRatio")) or 0.1
	levelTitleText.Text = string.format("LV.%d • %s", lvl, string.upper(rank))
	xpBarFill.Size = UDim2.fromScale(math.clamp(ratio, 0.06, 1), 1)
end

localPlayer:GetAttributeChangedSignal("Level"):Connect(refreshLevelBadge)
localPlayer:GetAttributeChangedSignal("XPProgressRatio"):Connect(refreshLevelBadge)
localPlayer:GetAttributeChangedSignal("RankTitle"):Connect(refreshLevelBadge)
localPlayer:GetAttributeChangedSignal("ToggleHelpUI"):Connect(function()
	openModalWithTab("Controls")
end)
localPlayer:GetAttributeChangedSignal("ToggleVIPUI"):Connect(function()
	openModalWithTab("Store")
end)
refreshLevelBadge()

-- Listen for server MonetizationNotifications
task.spawn(function()
	local folder = ReplicatedStorage:WaitForChild("Remotes", 10)
	if folder then
		local monNotif = folder:FindFirstChild("MonetizationNotification")
		if monNotif and monNotif:IsA("RemoteEvent") then
			monNotif.OnClientEvent:Connect(function(payload: { [string]: any })
				if type(payload) == "table" and payload.Message then
					storeStatusBanner.Text = tostring(payload.Message)
					renderStoreCatalog()
				end
			end)
		end
	end
end)

-- Main Onboarding & 3D Waypoint Update Loop
ensure3DWaypoint()
updateTutorialUI()

RunService.RenderStepped:Connect(function()
	if tutorialCompleted then
		return
	end

	local character = localPlayer.Character
	local rootPart = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if not rootPart then
		setWaypointVisible(false)
		return
	end

	local playerPos = rootPart.Position
	local isSeated = (humanoid ~= nil and humanoid.SeatPart ~= nil) or localPlayer:GetAttribute("IsDriving") == true

	-- Auto-check completion conditions for current step
	if currentStepIndex == 1 then
		if isSeated then
			advanceTutorialStep()
			return
		end
	elseif currentStepIndex == 2 then
		local destCount = tonumber(localPlayer:GetAttribute("TotalDestructions")) or 0
		local comboCount = tonumber(localPlayer:GetAttribute("ComboCount")) or 0
		if destCount >= 5 or comboCount >= 3 then
			advanceTutorialStep()
			return
		end
	elseif currentStepIndex == 3 then
		if usedNitroOrDrift then
			advanceTutorialStep()
			return
		end
	elseif currentStepIndex == 4 then
		local nearestShop = findNearestSpeedShopPosition(playerPos)
		local engLvl = tonumber(localPlayer:GetAttribute("Upgrade_Engine")) or 1
		if visitedSpeedShop or (nearestShop - playerPos).Magnitude < 24 or engLvl > 1 then
			advanceTutorialStep()
			return
		end
	elseif currentStepIndex == 5 then
		local heatStars = tonumber(localPlayer:GetAttribute("HeatStars")) or 0
		local missionsDone = tonumber(localPlayer:GetAttribute("MissionsCompleted")) or 0
		if heatStars >= 1 or missionsDone >= 1 then
			advanceTutorialStep()
			return
		end
	end

	-- Update 3D Waypoint Beam position toward step objective
	local spec = TUTORIAL_STEPS[currentStepIndex]
	if not spec or not waypointStartPart or not waypointEndPart then
		return
	end

	local targetPos = playerPos + Vector3.new(0, 0, -30)
	local targetLabel = "▼ OBJECTIVE"

	if spec.TargetKind == "Vehicle" then
		targetPos = findNearestVehiclePosition(playerPos)
		targetLabel = "▼ YOUR VEHICLE [V]"
	elseif spec.TargetKind == "Destructibles" then
		targetPos = Vector3.new(60, 1.5, 30)
		targetLabel = "▼ SMASH ZONE"
	elseif spec.TargetKind == "Stunt" then
		targetPos = Vector3.new(-210, 1.5, -30)
		targetLabel = "▼ MEGA-RAMP STUNT"
	elseif spec.TargetKind == "SpeedShop" then
		targetPos = findNearestSpeedShopPosition(playerPos)
		targetLabel = "▼ SPEED SHOP [B]"
	elseif spec.TargetKind == "Heat" then
		targetPos = Vector3.new(60, 1.5, 60)
		targetLabel = "▼ LEO TOWER CHAOS"
	end

	setWaypointVisible(true)
	waypointStartPart.Position = playerPos + Vector3.new(0, 1.5, 0)
	waypointEndPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	waypointEndPart.Color = spec.AccentColor

	if waypointBillboardTitle then
		waypointBillboardTitle.Text = targetLabel
		waypointBillboardTitle.TextColor3 = spec.AccentColor
	end
	if waypointBillboardDist then
		local distMeters = math.floor((targetPos - playerPos).Magnitude)
		waypointBillboardDist.Text = string.format("%d m away", distMeters)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000020">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000021">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX0000001D">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">CameraAndFXController</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- CameraAndFXController.client.luau
-- Dynamic speed-scaled chase camera, trauma 3D shake, police pursuit vignette, 3D floating BillboardGui popups, and procedural SFX.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ==========================================
-- 1. SCREEN VIGNETTE FOR POLICE PURSUIT & IMPACTS
-- ==========================================
local existingFxGui = playerGui:FindFirstChild("WorldOfDestructionFXGui")
if existingFxGui then
	existingFxGui:Destroy()
end

local fxGui = Instance.new("ScreenGui")
fxGui.Name = "WorldOfDestructionFXGui"
fxGui.IgnoreGuiInset = true
fxGui.ResetOnSpawn = false
fxGui.DisplayOrder = -5
fxGui.Parent = playerGui

local vignetteFrame = Instance.new("Frame")
vignetteFrame.Name = "PursuitVignette"
vignetteFrame.Size = UDim2.fromScale(1, 1)
vignetteFrame.BackgroundTransparency = 1
vignetteFrame.BorderSizePixel = 0
vignetteFrame.Parent = fxGui

local vignetteStroke = Instance.new("UIStroke")
vignetteStroke.Thickness = 26
vignetteStroke.Color = Color3.fromRGB(255, 45, 45)
vignetteStroke.Transparency = 1
vignetteStroke.Parent = vignetteFrame

local impactFlash = Instance.new("Frame")
impactFlash.Name = "ImpactFlash"
impactFlash.Size = UDim2.fromScale(1, 1)
impactFlash.BackgroundColor3 = Color3.fromRGB(255, 200, 120)
impactFlash.BackgroundTransparency = 1
impactFlash.BorderSizePixel = 0
impactFlash.Parent = fxGui

-- ==========================================
-- 2. PROCEDURAL SOUND SYNTHESIS
-- ==========================================
local sfxFolder = SoundService:FindFirstChild("WODClientSFX")
if not sfxFolder then
	sfxFolder = Instance.new("Folder")
	sfxFolder.Name = "WODClientSFX"
	sfxFolder.Parent = SoundService
end

type SfxPreset = { id: string, speed: number, volume: number }
local SFX_PRESETS: { [string]: SfxPreset } = {
	Impact = { id = "rbxasset://sounds/collide.wav", speed = 0.92, volume = 0.65 },
	HeavySmash = { id = "rbxasset://sounds/Launching rocket.wav", speed = 1.25, volume = 0.75 },
	Explosion = { id = "rbxasset://sounds/Rocket shot.wav", speed = 0.78, volume = 0.90 },
	CashChime = { id = "rbxasset://sounds/electronicpingshort.wav", speed = 1.35, volume = 0.45 },
	LevelUp = { id = "rbxasset://sounds/uuhhh.mp3", speed = 1.45, volume = 0.70 },
}

local function playProceduralSound(kind: string, pitchVariance: number?)
	local preset = SFX_PRESETS[kind] or SFX_PRESETS.Impact
	local sound = Instance.new("Sound")
	sound.Name = kind .. "SFX"
	sound.SoundId = preset.id
	local variance = (pitchVariance or 0.1) * (math.random() * 2 - 1)
	sound.PlaybackSpeed = math.max(0.4, preset.speed + variance)
	sound.Volume = preset.volume
	sound.Parent = sfxFolder
	sound:Play()
	task.delay(2.5, function()
		sound:Destroy()
	end)
end

-- ==========================================
-- 3. 3D FLOATING BILLBOARD POPUPS
-- ==========================================
local popupContainer = Workspace:FindFirstChild("WODFloatingPopups")
if not popupContainer then
	popupContainer = Instance.new("Folder")
	popupContainer.Name = "WODFloatingPopups"
	popupContainer.Parent = Workspace
end

local function spawn3DPopup(worldPos: Vector3, headline: string, subtext: string?, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Name = "FXPopupAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = worldPos + Vector3.new((math.random() - 0.5) * 3, 2.5, (math.random() - 0.5) * 3)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Parent = popupContainer

	local bb = Instance.new("BillboardGui")
	bb.Name = "ImpactBillboard"
	bb.Size = UDim2.fromOffset(180, 64)
	bb.StudsOffset = Vector3.new(0, 1, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 260
	bb.Parent = anchor

	local mainLabel = Instance.new("TextLabel")
	mainLabel.Size = UDim2.new(1, 0, 0.6, 0)
	mainLabel.BackgroundTransparency = 1
	mainLabel.Font = Enum.Font.GothamBlack
	mainLabel.Text = headline
	mainLabel.TextColor3 = color
	mainLabel.TextScaled = true
	mainLabel.TextStrokeTransparency = 0.2
	mainLabel.Parent = bb

	if subtext and #subtext > 0 then
		local subLabel = Instance.new("TextLabel")
		subLabel.Size = UDim2.new(1, 0, 0.4, 0)
		subLabel.Position = UDim2.fromScale(0, 0.58)
		subLabel.BackgroundTransparency = 1
		subLabel.Font = Enum.Font.GothamBold
		subLabel.Text = subtext
		subLabel.TextColor3 = Color3.fromRGB(255, 245, 190)
		subLabel.TextScaled = true
		subLabel.TextStrokeTransparency = 0.35
		subLabel.Parent = bb
	end

	TweenService:Create(bb, TweenInfo.new(0.95, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		StudsOffset = Vector3.new(0, 6.5, 0),
	}):Play()
	TweenService:Create(mainLabel, TweenInfo.new(0.95, Enum.EasingStyle.Linear), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()

	task.delay(1.0, function()
		anchor:Destroy()
	end)
end

-- ==========================================
-- 4. TRAUMA CAMERA SHAKE & IMPACT FLASH
-- ==========================================
local trauma = 0.0
local currentFov = 70.0
local lastSpeed = 0.0
local noiseClock = 0.0

local function addCameraTrauma(amount: number, flashAlpha: number?)
	trauma = math.clamp(trauma + amount, 0, 1.0)
	if flashAlpha and flashAlpha > 0 then
		impactFlash.BackgroundTransparency = math.clamp(1 - flashAlpha, 0.45, 0.95)
		TweenService:Create(impactFlash, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 1,
		}):Play()
	end
end

-- ==========================================
-- 5. REMOTE & ATTRIBUTE LISTENERS
-- ==========================================
local lastCashAttr = tonumber(player:GetAttribute("Cash")) or 0
local lastLevelAttr = tonumber(player:GetAttribute("Level")) or 1

player.AttributeChanged:Connect(function(attr: string)
	if attr == "Cash" then
		local nowCash = tonumber(player:GetAttribute("Cash")) or 0
		if nowCash > lastCashAttr then
			playProceduralSound("CashChime", 0.08)
		end
		lastCashAttr = nowCash
	elseif attr == "Level" then
		local nowLvl = tonumber(player:GetAttribute("Level")) or 1
		if nowLvl > lastLevelAttr then
			playProceduralSound("LevelUp", 0.04)
			addCameraTrauma(0.35, 0.25)
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				spawn3DPopup(root.Position, "LEVEL UP! LV." .. tostring(nowLvl), "RANK PROMOTION", Color3.fromRGB(95, 225, 255))
			end
		end
		lastLevelAttr = nowLvl
	end
end)

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then return end

	local function bindEvent(name: string, callback: (...any) -> ())
		local r = remotes:FindFirstChild(name)
		if r and r:IsA("RemoteEvent") then
			r.OnClientEvent:Connect(callback)
		end
	end

	bindEvent("DamageDealt", function(worldPos: any, damageOrCash: any, labelText: any)
		local pos = typeof(worldPos) == "Vector3" and worldPos or (
			player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			and (player.Character.HumanoidRootPart :: BasePart).Position or Vector3.zero
		)
		local amount = tonumber(damageOrCash) or 100
		local title = amount >= 0 and ("+$" .. tostring(math.floor(amount))) or tostring(labelText or "SMASH!")
		local subtitle = typeof(labelText) == "string" and labelText or "DESTRUCTION"
		spawn3DPopup(pos, title, subtitle, Color3.fromRGB(110, 255, 140))
		addCameraTrauma(math.clamp(amount / 600, 0.18, 0.65), 0.15)
		playProceduralSound(amount > 300 and "HeavySmash" or "Impact", 0.12)
	end)

	bindEvent("DestructionOccurred", function(worldPosOrPayload: any, propName: any, cashAwarded: any)
		local pos = Vector3.zero
		local cash = 75
		local sub = "PROP WRECKED"
		if typeof(worldPosOrPayload) == "Vector3" then
			pos = worldPosOrPayload
			cash = tonumber(cashAwarded) or 75
			sub = typeof(propName) == "string" and ("WRECKED " .. string.upper(propName)) or "PROP WRECKED"
		elseif type(worldPosOrPayload) == "table" then
			if typeof(worldPosOrPayload.position) == "Vector3" then
				pos = worldPosOrPayload.position
			elseif typeof(worldPosOrPayload.Position) == "Vector3" then
				pos = worldPosOrPayload.Position
			end
			cash = tonumber(worldPosOrPayload.cashEarned or worldPosOrPayload.CashReward) or 75
			local pType = worldPosOrPayload.propType or worldPosOrPayload.Type
			if typeof(pType) == "string" then
				sub = "WRECKED " .. string.upper(pType)
			end
		end
		spawn3DPopup(pos, "+$" .. tostring(math.floor(cash)), sub, Color3.fromRGB(255, 210, 65))
		addCameraTrauma(0.28, 0.1)
		playProceduralSound("Impact", 0.15)
	end)

	bindEvent("ExplosionEffect", function(worldPos: any, radius: any)
		local pos = typeof(worldPos) == "Vector3" and worldPos or Vector3.zero
		local r = tonumber(radius) or 35
		spawn3DPopup(pos, "BOOM!", "EXPLOSIVE CHAIN REACTION", Color3.fromRGB(255, 95, 45))
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local dist = root and (root.Position - pos).Magnitude or 40
		local intensity = math.clamp(1 - (dist / math.max(80, r * 3)), 0.25, 0.95)
		addCameraTrauma(intensity, intensity * 0.45)
		playProceduralSound("Explosion", 0.08)
	end)

	bindEvent("CameraShake", function(intensity: any)
		addCameraTrauma(tonumber(intensity) or 0.35, 0.15)
	end)
end)

-- ==========================================
-- 6. RENDERSTEPPED CHASE CAMERA, FOV & SIREN VIGNETTE
-- ==========================================
local sirenPhase = 0.0

RunService.RenderStepped:Connect(function(dt: number)
	local cam = Workspace.CurrentCamera
	if not cam then return end

	noiseClock += dt * 28
	sirenPhase += dt * 8.5

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	-- Compute vehicle/character speed & local collision deceleration trauma
	local speedMph = tonumber(player:GetAttribute("SpeedMPH")) or 0
	if root and speedMph == 0 then
		speedMph = root.AssemblyLinearVelocity.Magnitude * 0.68
	end
	local speedDrop = lastSpeed - speedMph
	if speedDrop > 32 then
		addCameraTrauma(math.clamp(speedDrop / 95, 0.2, 0.7), 0.2)
		playProceduralSound("Impact", 0.14)
	end
	lastSpeed = speedMph

	-- Dynamic Speed-Based FOV Scaling (70 base -> up to 92 at high speed / nitro)
	local isDriving = (humanoid and humanoid.Sit) or (speedMph > 8)
	local nitroBoost = (player:GetAttribute("TouchNitro") == true) and 5 or 0
	local targetFov = isDriving and math.clamp(70 + (speedMph / 140) * 18 + nitroBoost, 70, 92) or 70
	currentFov = currentFov + (targetFov - currentFov) * math.min(1, dt * 8)
	cam.FieldOfView = currentFov

	-- Trauma-Based 3D Rotational & Positional Camera Shake
	if trauma > 0.001 then
		local shake = trauma * trauma
		local dx = math.noise(noiseClock, 1.3) * 1.6 * shake
		local dy = math.noise(1.3, noiseClock) * 1.6 * shake
		local roll = math.noise(noiseClock, noiseClock) * math.rad(5.5) * shake
		cam.CFrame = cam.CFrame * CFrame.new(dx, dy, 0) * CFrame.Angles(dy * 0.02, dx * 0.02, roll)
		trauma = math.max(0, trauma - dt * 1.45)
	end

	-- Police Siren Screen Vignette at High Heat
	local stars = tonumber(player:GetAttribute("HeatStars") or player:GetAttribute("WantedLevel")) or 0
	if stars >= 1 then
		local wave = math.sin(sirenPhase)
		vignetteStroke.Color = (wave >= 0) and Color3.fromRGB(255, 45, 55) or Color3.fromRGB(45, 130, 255)
		local pulseAlpha = 0.78 - (math.abs(wave) * (0.14 + stars * 0.04))
		vignetteStroke.Transparency = math.clamp(pulseAlpha, 0.42, 0.92)
	else
		vignetteStroke.Transparency = 1
	end
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX0000001E">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">OnFootController</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	OnFootController.client.luau
	Enhanced on-foot character movement & vehicle interaction controller
	for World of Destruction (Leo City).

	Features (inspired by OnFootController.swift & HeroCharacter.swift):
	  - Smooth Sprint (LeftShift / L3 / Touch) with speed ramp & subtle FOV boost
	  - Tactical Dodge / Roll (Q / ButtonB / Touch) with burst dash impulse & trail
	  - Super Jump (enhanced jump power + double-jump boost in mid-air)
	  - Quick Enter / Hijack nearby vehicle (E / ButtonX)
	  - Quick-Summon personal vehicle (V / DPadUp / Touch)
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- Tuning Constants
--------------------------------------------------------------------------------
local WALK_SPEED = 18
local SPRINT_SPEED = 30
local ACCEL_RATE = 48
local DECEL_RATE = 64

local BASE_JUMP_POWER = 56
local SUPER_JUMP_BOOST = 42
local SUPER_JUMP_COOLDOWN = 0.85

local DODGE_SPEED = 68
local DODGE_DURATION = 0.24
local DODGE_COOLDOWN = 1.05

local SUMMON_COOLDOWN = 1.5
local ENTER_VEHICLE_RANGE = 22

local BASE_FOV = 70
local SPRINT_FOV = 77

--------------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------------
local isSprinting = false
local currentTargetSpeed = WALK_SPEED
local smoothedSpeed = WALK_SPEED

local lastDodgeAt = 0
local isDodging = false
local dodgeEndTime = 0
local dodgeDirection = Vector3.zero

local lastSummonAt = 0
local lastSuperJumpAt = 0
local canDoubleJump = false

local function getRemoteEvent(name: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		local r = remotes:FindFirstChild(name)
		if r and r:IsA("RemoteEvent") then
			return r
		end
	end
	local root = ReplicatedStorage:FindFirstChild(name)
	if root and root:IsA("RemoteEvent") then
		return root
	end
	return nil
end

local function isPlayerSeated(): boolean
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return (hum ~= nil and hum.SeatPart ~= nil)
end

--------------------------------------------------------------------------------
-- Actions: Dodge/Roll, Quick-Enter Vehicle, Quick-Summon Vehicle
--------------------------------------------------------------------------------
local function performDodgeRoll()
	if isPlayerSeated() then
		return
	end
	local now = os.clock()
	if now - lastDodgeAt < DODGE_COOLDOWN then
		return
	end

	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp or hum.Health <= 0 then
		return
	end

	lastDodgeAt = now
	isDodging = true
	dodgeEndTime = now + DODGE_DURATION

	local moveDir = hum.MoveDirection
	if moveDir.Magnitude > 0.05 then
		dodgeDirection = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
	else
		local look = hrp.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		dodgeDirection = if flatLook.Magnitude > 0.05 then flatLook.Unit else Vector3.new(0, 0, -1)
	end

	-- Apply initial burst velocity with a slight hop
	hrp.AssemblyLinearVelocity = dodgeDirection * DODGE_SPEED + Vector3.new(0, 14, 0)
	localPlayer:SetAttribute("IsDodging", true)

	-- Brief visual highlight streak during tactical dodge
	local highlight = Instance.new("Highlight")
	highlight.Name = "DodgeTrailHighlight"
	highlight.FillColor = Color3.fromRGB(120, 210, 255)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0.2
	highlight.Parent = char

	task.delay(DODGE_DURATION, function()
		isDodging = false
		localPlayer:SetAttribute("IsDodging", false)
		if highlight.Parent then
			highlight:Destroy()
		end
	end)
end

local function findNearestVehicle(origin: Vector3): Model?
	local bestModel: Model? = nil
	local bestDist = ENTER_VEHICLE_RANGE

	for _, veh in ipairs(CollectionService:GetTagged("Vehicle")) do
		if veh:IsA("Model") then
			local seat = veh:FindFirstChild("DriveSeat") :: VehicleSeat?
			local primary = seat or veh.PrimaryPart
			if primary then
				local dist = (primary.Position - origin).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestModel = veh
				end
			end
		end
	end

	return bestModel
end

local function tryEnterOrHijackNearestVehicle()
	if isPlayerSeated() then
		return
	end
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end

	local nearest = findNearestVehicle(hrp.Position)
	if nearest then
		local enterRemote = getRemoteEvent("EnterNearestVehicle")
		if enterRemote then
			enterRemote:FireServer(nearest)
		end
	end
end

local function trySummonPersonalVehicle()
	local now = os.clock()
	if now - lastSummonAt < SUMMON_COOLDOWN then
		return
	end
	lastSummonAt = now

	local summonRemote = getRemoteEvent("SummonVehicle") or getRemoteEvent("SpawnVehicle")
	if summonRemote then
		summonRemote:FireServer(nil, true)
	end
end

--------------------------------------------------------------------------------
-- Input Bindings
--------------------------------------------------------------------------------
local function bindOnFootActions()
	-- Sprint (LeftShift / ButtonL3)
	ContextActionService:BindAction("OnFootSprint", function(_, state: Enum.UserInputState)
		if isPlayerSeated() then
			isSprinting = false
			return Enum.ContextActionResult.Pass
		end
		isSprinting = (state == Enum.UserInputState.Begin)
		localPlayer:SetAttribute("IsSprinting", isSprinting)
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)

	-- Tactical Dodge / Roll (Q / ButtonB)
	ContextActionService:BindAction("OnFootDodge", function(_, state: Enum.UserInputState)
		if isPlayerSeated() then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			performDodgeRoll()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("OnFootDodge", "DODGE")
	ContextActionService:SetPosition("OnFootDodge", UDim2.new(1, -165, 1, -65))

	-- Quick Enter / Hijack Vehicle (E / ButtonX)
	ContextActionService:BindAction("OnFootEnterVehicle", function(_, state: Enum.UserInputState)
		if isPlayerSeated() then
			return Enum.ContextActionResult.Pass
		end
		if state == Enum.UserInputState.Begin then
			tryEnterOrHijackNearestVehicle()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonX)

	-- Quick-Summon Personal Vehicle (V / DPadUp)
	ContextActionService:BindAction("OnFootSummonVehicle", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			trySummonPersonalVehicle()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.V, Enum.KeyCode.DPadUp)
	ContextActionService:SetTitle("OnFootSummonVehicle", "CAR [V]")
	ContextActionService:SetPosition("OnFootSummonVehicle", UDim2.new(1, -95, 1, -65))
end

-- Super Jump (Double-Jump in mid-air when pressing Jump again)
UserInputService.JumpRequest:Connect(function()
	if isPlayerSeated() then
		return
	end
	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp or hum.Health <= 0 then
		return
	end

	local state = hum:GetState()
	local isAir = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping)
	local now = os.clock()

	if isAir and canDoubleJump and (now - lastSuperJumpAt) >= SUPER_JUMP_COOLDOWN then
		canDoubleJump = false
		lastSuperJumpAt = now
		local vel = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(vel.X * 1.12, math.max(vel.Y, 0) + SUPER_JUMP_BOOST, vel.Z * 1.12)
	end
end)

--------------------------------------------------------------------------------
-- Character Setup & Per-Frame Movement Smoothing
--------------------------------------------------------------------------------
local function setupCharacter(character: Model)
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end

	hum.UseJumpPower = true
	hum.JumpPower = BASE_JUMP_POWER
	hum.WalkSpeed = WALK_SPEED
	smoothedSpeed = WALK_SPEED
	canDoubleJump = false

	hum.StateChanged:Connect(function(_, newState: Enum.HumanoidStateType)
		if newState == Enum.HumanoidStateType.Jumping then
			task.delay(0.12, function()
				canDoubleJump = true
			end)
		elseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then
			canDoubleJump = false
		end
	end)
end

if localPlayer.Character then
	task.spawn(setupCharacter, localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(setupCharacter)
bindOnFootActions()

RunService.RenderStepped:Connect(function(dt: number)
	if dt <= 0 or dt > 0.15 then
		return
	end
	if isPlayerSeated() then
		return
	end

	local char = localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp or hum.Health <= 0 then
		return
	end

	local now = os.clock()
	if isDodging and now < dodgeEndTime then
		local currentVel = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(
			dodgeDirection.X * DODGE_SPEED,
			currentVel.Y,
			dodgeDirection.Z * DODGE_SPEED
		)
		return
	end

	-- Smooth acceleration/deceleration between Walk and Sprint (matching OnFootController.swift)
	local moving = hum.MoveDirection.Magnitude > 0.05
	currentTargetSpeed = if (isSprinting and moving) then SPRINT_SPEED else WALK_SPEED

	if smoothedSpeed < currentTargetSpeed then
		smoothedSpeed = math.min(currentTargetSpeed, smoothedSpeed + ACCEL_RATE * dt)
	else
		smoothedSpeed = math.max(currentTargetSpeed, smoothedSpeed - DECEL_RATE * dt)
	end

	hum.WalkSpeed = smoothedSpeed

	-- Subtle FOV widening while sprinting on foot
	local cam = Workspace.CurrentCamera
	if cam then
		local targetFov = if (isSprinting and moving) then SPRINT_FOV else BASE_FOV
		cam.FieldOfView = cam.FieldOfView + (targetFov - cam.FieldOfView) * math.min(1, dt * 8)
	end
end)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX0000001F">
				<Properties>
					<bool name="Disabled">false</bool>
					<string name="Name">VehicleClientController</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	VehicleClientController.client.luau
	High-playability arcade driving controller for World of Destruction (Leo City).

	Features:
	  - Snappy arcade acceleration, crisp braking, reverse, and speed-sensitive steering
	  - Handbrake drifting (Space / R1 / Touch) with lateral slip & drift angle scoring
	  - Regenerating Nitro boost (LeftShift / L1 / Touch) with flame particles & camera FOV surge
	  - Mid-air pitch/roll stunt control (W/A/S/D) + airtime tracker reporting "MEGA AIR!" to server
	  - High-speed near-miss detector against traffic & police vehicles ("NEAR MISS!")
	  - Real-time 4-wheel spin & front-axle steering visual animation + tire skid trails/smoke
	  - Headlight toggle (L key + automatic night activation based on Lighting.ClockTime)
]]

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer

local sharedFolder = ReplicatedStorage:WaitForChild("Shared", 10)
local VehicleCatalog: any = nil
if sharedFolder then
	pcall(function()
		VehicleCatalog = require(sharedFolder:WaitForChild("VehicleCatalog", 5))
	end)
end

local function ensureRemoteEvent(name: string): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		local found = remotes:FindFirstChild(name)
		if found and found:IsA("RemoteEvent") then
			return found
		end
	end
	local rootFound = ReplicatedStorage:FindFirstChild(name)
	if rootFound and rootFound:IsA("RemoteEvent") then
		return rootFound
	end
	return nil
end

--------------------------------------------------------------------------------
-- Arcade Driving Constants (tuned from Swift VehicleConfig & VehicleController)
--------------------------------------------------------------------------------
local BASE_FOV = 70
local BOOST_FOV_ADD = 14
local SPEED_FOV_ADD = 6

local BOOST_SPEED_MULTIPLIER = 1.62
local BOOST_ACCEL_MULTIPLIER = 2.15
local NITRO_REGEN_RATE = 0.42         -- seconds of fuel recovered per second
local NITRO_REGEN_DELAY = 1.1         -- delay after releasing boost before regen

local DRIFT_MIN_SPEED = 28            -- studs/s minimum forward speed to hold drift
local DRIFT_STEER_MULTIPLIER = 1.45   -- sharper yaw rate while drifting
local DRIFT_SLIP_ANGLE_MAX = math.rad(22)
local DRIFT_LATERAL_GRIP = 0.14       -- lower = longer sideways slide
local NORMAL_LATERAL_GRIP = 0.86      -- crisp lateral grip when not drifting

local AIR_PITCH_TORQUE = 2.6          -- rad/s^2 air pitch control
local AIR_ROLL_TORQUE = 3.0           -- rad/s^2 air roll control
local MIN_STUNT_AIRTIME = 0.65        -- seconds in air to trigger MEGA AIR bonus
local MIN_DRIFT_SCORE_TIME = 0.65     -- seconds of drift to trigger DRIFT KING bonus

local NEAR_MISS_MIN_SPEED = 54        -- studs/s required for near-miss detection
local NEAR_MISS_MAX_DIST = 14.5       -- studs center-to-center threshold
local NEAR_MISS_MIN_DIST = 5.2        -- closer than this counts as a scrape/hit
local NEAR_MISS_COOLDOWN = 2.5        -- per-vehicle cooldown (seconds)

--------------------------------------------------------------------------------
-- Active Driving State
--------------------------------------------------------------------------------
local activeSeat: VehicleSeat? = nil
local activeModel: Model? = nil
local activeChassis: BasePart? = nil

local currentSpeed = 0                -- signed forward speed (studs/s)
local smoothedSteer = 0               -- filtered steer input [-1, 1]
local smoothedSlipAngle = 0           -- visual tail-out angle (rad)
local wheelSpinAngle = 0              -- accumulated wheel rotation (rad)

local isDrifting = false
local driftDuration = 0
local driftReportTimer = 0

local isBoosting = false
local nitroFuel = 4.0
local nitroMax = 4.0
local lastBoostUsedAt = 0

local isAirborne = false
local airTime = 0

local handbrakeHeld = false
local boostHeld = false
local headlightsOn = true
local manualHeadlightOverride = false

local lastVfxNitro = false
local lastVfxDrift = false
local nearMissTimestamps: { [Model]: number } = {}
local lastCollisionCheckSpeed = 0

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

--------------------------------------------------------------------------------
-- Helper Functions
--------------------------------------------------------------------------------
local function moveToward(current: number, target: number, maxDelta: number): number
	local diff = target - current
	if math.abs(diff) <= maxDelta then
		return target
	end
	return current + (if diff > 0 then maxDelta else -maxDelta)
end

local function fireStuntToServer(stuntType: string, value: number, pos: Vector3)
	local reportStunt = ensureRemoteEvent("ReportStunt") or ensureRemoteEvent("StuntEvent")
	if reportStunt then
		reportStunt:FireServer(stuntType, value, pos)
	end
end

local function setLocalVFX(model: Model?, nitroActive: boolean, driftActive: boolean)
	if not model then
		return
	end
	local chassis = model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?
	if not chassis then
		return
	end

	if nitroActive ~= lastVfxNitro then
		lastVfxNitro = nitroActive
		for _, attName in ipairs({ "ExhaustAttachmentL", "ExhaustAttachmentR" }) do
			local att = chassis:FindFirstChild(attName)
			local flame = att and att:FindFirstChild("NitroFlame") :: ParticleEmitter?
			if flame then
				flame.Enabled = nitroActive
			end
		end
		local vfxRemote = ensureRemoteEvent("VehicleVFX")
		if vfxRemote then
			vfxRemote:FireServer("Nitro", nitroActive)
		end
	end

	if driftActive ~= lastVfxDrift then
		lastVfxDrift = driftActive
		for _, attName in ipairs({ "DriftAttachmentL", "DriftAttachmentR" }) do
			local att = chassis:FindFirstChild(attName)
			local smoke = att and att:FindFirstChild("DriftSmoke") :: ParticleEmitter?
			if smoke then
				smoke.Enabled = driftActive
			end
		end
		for _, trailName in ipairs({ "SkidTrailL", "SkidTrailR" }) do
			local trail = chassis:FindFirstChild(trailName) :: Trail?
			if trail then
				trail.Enabled = driftActive
			end
		end
		local vfxRemote = ensureRemoteEvent("VehicleVFX")
		if vfxRemote then
			vfxRemote:FireServer("Drift", driftActive)
		end
	end
end

local function applyHeadlightState(model: Model?, isOn: boolean)
	if not model then
		return
	end
	headlightsOn = isOn
	for _, partName in ipairs({ "HeadlightL", "HeadlightR" }) do
		local hl = model:FindFirstChild(partName) :: BasePart?
		if hl then
			hl.Material = if isOn then Enum.Material.Neon else Enum.Material.SmoothPlastic
			local spot = hl:FindFirstChildOfClass("SpotLight")
			if spot then
				spot.Enabled = isOn
			end
		end
	end
	local hlRemote = ensureRemoteEvent("ToggleHeadlights")
	if hlRemote then
		hlRemote:FireServer(isOn)
	end
end

--------------------------------------------------------------------------------
-- Input Actions (Handbrake Drift, Nitro Boost, Headlights)
--------------------------------------------------------------------------------
local function bindDrivingActions()
	ContextActionService:BindAction("VehicleDriftAction", function(_, state: Enum.UserInputState)
		handbrakeHeld = (state == Enum.UserInputState.Begin)
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonR1)
	ContextActionService:SetTitle("VehicleDriftAction", "DRIFT")
	ContextActionService:SetPosition("VehicleDriftAction", UDim2.new(1, -165, 1, -125))

	ContextActionService:BindAction("VehicleNitroAction", function(_, state: Enum.UserInputState)
		boostHeld = (state == Enum.UserInputState.Begin)
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("VehicleNitroAction", "NITRO")
	ContextActionService:SetPosition("VehicleNitroAction", UDim2.new(1, -95, 1, -185))

	ContextActionService:BindAction("VehicleHeadlightsAction", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin and activeModel then
			manualHeadlightOverride = true
			applyHeadlightState(activeModel, not headlightsOn)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.L)
end

local function unbindDrivingActions()
	ContextActionService:UnbindAction("VehicleDriftAction")
	ContextActionService:UnbindAction("VehicleNitroAction")
	ContextActionService:UnbindAction("VehicleHeadlightsAction")
	handbrakeHeld = false
	boostHeld = false
end

--------------------------------------------------------------------------------
-- Wheel Spin & Steering Animation
--------------------------------------------------------------------------------
local function animateWheels(model: Model, dt: number, forwardSpeed: number, steerAmount: number)
	local wheelRadius = 1.5
	local fl = model:FindFirstChild("WheelFL") :: BasePart?
	if fl then
		wheelRadius = math.max(0.8, fl.Size.Y * 0.5)
	end

	wheelSpinAngle = (wheelSpinAngle - (forwardSpeed / wheelRadius) * dt) % (math.pi * 2)
	local maxSteerAngle = math.rad(28)
	local steerYaw = -steerAmount * maxSteerAngle

	for _, wheelName in ipairs({ "WheelFL", "WheelFR", "WheelRL", "WheelRR" }) do
		local wheel = model:FindFirstChild(wheelName) :: BasePart?
		if wheel then
			local weld = wheel:FindFirstChild("WheelWeld") :: Weld?
			if weld then
				local bx = tonumber(wheel:GetAttribute("BaseX")) or weld.C0.Position.X
				local by = tonumber(wheel:GetAttribute("BaseY")) or weld.C0.Position.Y
				local bz = tonumber(wheel:GetAttribute("BaseZ")) or weld.C0.Position.Z
				local isFront = wheel:GetAttribute("IsFrontWheel") == true
				if isFront then
					weld.C0 = CFrame.new(bx, by, bz)
						* CFrame.Angles(0, steerYaw, 0)
						* CFrame.Angles(wheelSpinAngle, 0, 0)
				else
					weld.C0 = CFrame.new(bx, by, bz) * CFrame.Angles(wheelSpinAngle, 0, 0)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Near-Miss Detection
--------------------------------------------------------------------------------
local function checkNearMisses(myModel: Model, myPos: Vector3, absSpeed: number)
	if absSpeed < NEAR_MISS_MIN_SPEED then
		return
	end

	local now = os.clock()
	for _, other in ipairs(CollectionService:GetTagged("Vehicle")) do
		if other ~= myModel and other:IsA("Model") and other.PrimaryPart then
			local lastAt = nearMissTimestamps[other]
			if not lastAt or (now - lastAt) >= NEAR_MISS_COOLDOWN then
				local dist = (other.PrimaryPart.Position - myPos).Magnitude
				if dist >= NEAR_MISS_MIN_DIST and dist <= NEAR_MISS_MAX_DIST then
					nearMissTimestamps[other] = now
					fireStuntToServer("NearMiss", 1, myPos)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Seat Session Management
--------------------------------------------------------------------------------
local function startDrivingSession(seat: VehicleSeat, model: Model, chassis: BasePart)
	activeSeat = seat
	activeModel = model
	activeChassis = chassis

	local forwardDir = chassis.CFrame.LookVector
	currentSpeed = chassis.AssemblyLinearVelocity:Dot(forwardDir)
	smoothedSteer = 0
	smoothedSlipAngle = 0
	isDrifting = false
	driftDuration = 0
	driftReportTimer = 0
	isAirborne = false
	airTime = 0

	nitroMax = tonumber(model:GetAttribute("NitroCapacity")) or 4.0
	nitroFuel = nitroMax
	lastVfxNitro = false
	lastVfxDrift = false
	lastCollisionCheckSpeed = 0

	local filterList: { Instance } = { model }
	if localPlayer.Character then
		table.insert(filterList, localPlayer.Character)
	end
	raycastParams.FilterDescendantsInstances = filterList

	bindDrivingActions()

	-- Automatic night-time headlights check
	if not manualHeadlightOverride then
		local clock = Lighting.ClockTime
		local shouldBeOn = (clock >= 17.5 or clock <= 6.5) or (model:GetAttribute("HeadlightsOn") == true)
		applyHeadlightState(model, shouldBeOn)
	end
end

local function stopDrivingSession()
	if activeModel then
		setLocalVFX(activeModel, false, false)
	end
	unbindDrivingActions()

	activeSeat = nil
	activeModel = nil
	activeChassis = nil
	currentSpeed = 0
	isDrifting = false
	isBoosting = false
	isAirborne = false

	localPlayer:SetAttribute("VehicleSpeed", 0)
	localPlayer:SetAttribute("VehicleSpeedMPH", 0)
	localPlayer:SetAttribute("IsDrifting", false)
	localPlayer:SetAttribute("IsBoosting", false)
	localPlayer:SetAttribute("AirTime", 0)

	local cam = Workspace.CurrentCamera
	if cam then
		cam.FieldOfView = BASE_FOV
	end
end

local function inspectCharacterSeat(character: Model)
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end

	local function checkSeat()
		local seatPart = hum.SeatPart
		if seatPart and seatPart:IsA("VehicleSeat") then
			local model = seatPart:FindFirstAncestorOfClass("Model")
			local chassis = model and (model.PrimaryPart or model:FindFirstChild("Chassis") :: BasePart?)
			if model and chassis then
				if activeSeat ~= seatPart then
					startDrivingSession(seatPart, model, chassis)
				end
				return
			end
		end
		if activeSeat ~= nil then
			stopDrivingSession()
		end
	end

	hum:GetPropertyChangedSignal("SeatPart"):Connect(checkSeat)
	checkSeat()
end

if localPlayer.Character then
	task.spawn(inspectCharacterSeat, localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(inspectCharacterSeat)

--------------------------------------------------------------------------------
-- Main Per-Frame Arcade Driving Physics Loop
--------------------------------------------------------------------------------
RunService.RenderStepped:Connect(function(dt: number)
	if not activeSeat or not activeModel or not activeChassis then
		return
	end
	if not activeModel.Parent or not activeSeat.Parent then
		stopDrivingSession()
		return
	end
	if dt <= 0 or dt > 0.15 then
		return
	end

	local seat = activeSeat
	local model = activeModel
	local chassis = activeChassis

	if model:GetAttribute("IsWrecked") == true then
		setLocalVFX(model, false, false)
		return
	end

	-- 1. Read Vehicle Tuning Attributes
	local maxSpeed = tonumber(model:GetAttribute("MaxSpeed")) or 85
	local reverseMax = tonumber(model:GetAttribute("ReverseSpeed")) or 40
	local accelRate = tonumber(model:GetAttribute("Acceleration")) or 65
	local brakeDecel = tonumber(model:GetAttribute("BrakeDecel")) or 115
	local turnSpeed = tonumber(model:GetAttribute("TurnSpeed")) or 2.85
	local driftFactor = tonumber(model:GetAttribute("DriftFactor")) or 1.25
	local hoverHeight = tonumber(model:GetAttribute("HoverHeight")) or 2.2
	nitroMax = tonumber(model:GetAttribute("NitroCapacity")) or 4.0

	-- Damage penalty only when severely hurt (<30% health)
	local hp = tonumber(model:GetAttribute("Health")) or 100
	local maxHp = math.max(1, tonumber(model:GetAttribute("MaxHealth")) or 100)
	local healthFactor = if (hp / maxHp) < 0.25 then 0.80 else 1.0

	-- 2. Read Throttle & Steer Inputs from VehicleSeat
	local rawThrottle = seat.ThrottleFloat
	local rawSteer = seat.SteerFloat

	-- Smooth steering input
	smoothedSteer += (rawSteer - smoothedSteer) * math.min(1, dt * 14)

	-- 3. Ground Detection Raycast
	local rayOrigin = chassis.Position + Vector3.new(0, 2.5, 0)
	local rayLength = hoverHeight + chassis.Size.Y * 0.5 + 4.2
	local groundHit = Workspace:Raycast(rayOrigin, Vector3.new(0, -rayLength, 0), raycastParams)
	local groundedNow = groundHit ~= nil

	if not groundedNow then
		if not isAirborne then
			isAirborne = true
			airTime = 0
		end
		airTime += dt
	else
		if isAirborne then
			local completedAir = airTime
			isAirborne = false
			airTime = 0
			if completedAir >= MIN_STUNT_AIRTIME then
				fireStuntToServer("Air", completedAir, chassis.Position)
			end
		end
	end

	-- 4. Drift State & Scoring
	local forwardVec = chassis.CFrame.LookVector
	local flatForward = Vector3.new(forwardVec.X, 0, forwardVec.Z)
	if flatForward.Magnitude < 0.01 then
		flatForward = Vector3.new(0, 0, -1)
	else
		flatForward = flatForward.Unit
	end
	local flatRight = Vector3.new(-flatForward.Z, 0, flatForward.X)

	local vel = chassis.AssemblyLinearVelocity
	local measuredForwardSpeed = vel:Dot(flatForward)

	-- Blend our kinematic target speed with physical velocity so wall impacts respond naturally
	if math.abs(measuredForwardSpeed - currentSpeed) > 22 then
		currentSpeed = measuredForwardSpeed * 0.65 + currentSpeed * 0.35
	end

	-- Detect hard wall collision to apply minor vehicle damage
	local speedDrop = lastCollisionCheckSpeed - math.abs(measuredForwardSpeed)
	if speedDrop > 42 and lastCollisionCheckSpeed > 50 then
		local dmgRemote = ensureRemoteEvent("VehicleDamage")
		if dmgRemote then
			dmgRemote:FireServer(math.clamp(math.round(speedDrop * 0.18), 3, 18))
		end
	end
	lastCollisionCheckSpeed = math.abs(measuredForwardSpeed)

	local wantsDrift = groundedNow
		and currentSpeed > DRIFT_MIN_SPEED
		and math.abs(smoothedSteer) > 0.22
		and (handbrakeHeld or (math.abs(smoothedSteer) > 0.85 and currentSpeed > maxSpeed * 0.72 and rawThrottle > 0.4))

	if wantsDrift then
		isDrifting = true
		driftDuration += dt
		driftReportTimer += dt
		if driftReportTimer >= 1.4 then
			driftReportTimer = 0
			fireStuntToServer("Drift", 1.4, chassis.Position)
		end
	else
		if isDrifting then
			local finishedDrift = driftDuration
			isDrifting = false
			driftDuration = 0
			driftReportTimer = 0
			if finishedDrift >= MIN_DRIFT_SCORE_TIME then
				fireStuntToServer("Drift", finishedDrift, chassis.Position)
			end
		end
	end

	-- 5. Nitro Boost State & Fuel Meter
	local now = os.clock()
	local canBoost = boostHeld and nitroFuel > 0.05 and (rawThrottle > 0 or isDrifting)
	if canBoost then
		isBoosting = true
		nitroFuel = math.max(0, nitroFuel - dt)
		lastBoostUsedAt = now
	else
		isBoosting = false
		if now - lastBoostUsedAt >= NITRO_REGEN_DELAY then
			nitroFuel = math.min(nitroMax, nitroFuel + nitroMax * NITRO_REGEN_RATE * dt)
		end
	end

	-- 6. Update Longitudinal Speed (Forward / Reverse / Brake / Coast)
	local effectiveTopSpeed = maxSpeed * (if isBoosting then BOOST_SPEED_MULTIPLIER else 1.0) * healthFactor
	local effectiveAccel = accelRate * (if isBoosting then BOOST_ACCEL_MULTIPLIER else 1.0) * healthFactor

	if handbrakeHeld and not isDrifting then
		currentSpeed = moveToward(currentSpeed, 0, brakeDecel * dt)
	elseif math.abs(rawThrottle) < 0.05 then
		currentSpeed = moveToward(currentSpeed, 0, (brakeDecel * 0.24) * dt)
	elseif rawThrottle > 0 then
		if currentSpeed < -1 then
			currentSpeed = moveToward(currentSpeed, 0, brakeDecel * dt)
		else
			local driftScrub = if isDrifting and not isBoosting then 8.0 else 0.0
			currentSpeed = math.clamp(
				currentSpeed + (effectiveAccel * rawThrottle - driftScrub) * dt,
				-reverseMax,
				effectiveTopSpeed
			)
		end
	elseif rawThrottle < 0 then
		if currentSpeed > 2 then
			currentSpeed = moveToward(currentSpeed, 0, brakeDecel * dt)
		else
			currentSpeed = math.clamp(
				currentSpeed + (accelRate * 0.85 * rawThrottle) * dt,
				-reverseMax * healthFactor,
				effectiveTopSpeed
			)
		end
	end

	-- 7. Update Steering & Angular Velocity (Ground vs. Mid-Air Control)
	local absSpeed = math.abs(currentSpeed)
	local motionGate = math.clamp(absSpeed / 4.0, 0, 1)
	if rawThrottle ~= 0 then
		motionGate = math.max(motionGate, 0.35)
	end

	local driftBoost = if isDrifting then (DRIFT_STEER_MULTIPLIER * math.clamp(driftFactor, 0.9, 1.6)) else 1.0
	local speedScale = 0.0085
	local effectiveTurnRate = (turnSpeed * driftBoost) / (1 + absSpeed * speedScale)
	local steerDir = if currentSpeed < -1.0 then 1 else -1
	local targetYawRate = smoothedSteer * effectiveTurnRate * steerDir * motionGate

	local targetSlip = if isDrifting
		then (-smoothedSteer * DRIFT_SLIP_ANGLE_MAX * math.clamp(absSpeed / 45, 0.3, 1.0))
		else 0
	smoothedSlipAngle += (targetSlip - smoothedSlipAngle) * math.min(1, dt * 9.0)

	if groundedNow then
		-- Apply responsive yaw rotation while keeping roll/pitch stabilized against flipping
		local currentAngVel = chassis.AssemblyAngularVelocity
		local upVec = chassis.CFrame.UpVector
		local rightVec = chassis.CFrame.RightVector

		-- Upright stabilization torque if the car tilts too far on uneven debris
		local rollErr = rightVec.Y
		local pitchErr = forwardVec.Y
		local stabilizePitch = math.clamp(-pitchErr * 4.5, -3.5, 3.5)
		local stabilizeRoll = math.clamp(rollErr * 6.5, -4.5, 4.5)

		local desiredAngVel = Vector3.new(0, targetYawRate, 0)
			+ rightVec * stabilizePitch
			+ forwardVec * stabilizeRoll
		chassis.AssemblyAngularVelocity = currentAngVel:Lerp(desiredAngVel, math.min(1, dt * 18))

		-- Compute velocity with controlled lateral drift slip
		local currentLateralSpeed = vel:Dot(flatRight)
		local grip = if isDrifting then DRIFT_LATERAL_GRIP else NORMAL_LATERAL_GRIP
		local nextLateralSpeed = currentLateralSpeed * math.max(0, 1 - grip * dt * 12)
		if isDrifting then
			-- Add outward tail slide kick proportional to steer & driftFactor
			nextLateralSpeed += smoothedSteer * currentSpeed * 0.22 * driftFactor * dt * 6
		end

		local targetHorizontalVel = flatForward * currentSpeed + flatRight * nextLateralSpeed
		local nextY = vel.Y
		-- Gentle downforce so the car stays planted at high speed unless climbing a ramp
		if forwardVec.Y < 0.12 and nextY > -2 then
			nextY = math.min(nextY, -2.5)
		elseif forwardVec.Y >= 0.18 and currentSpeed > 45 then
			-- Ramp climb assist!
			nextY = math.max(nextY, currentSpeed * forwardVec.Y * 1.15)
		end

		chassis.AssemblyLinearVelocity = Vector3.new(targetHorizontalVel.X, nextY, targetHorizontalVel.Z)
	else
		-- Mid-air stunt control: W/S pitches nose, A/D rolls/yaws vehicle!
		local rightVec = chassis.CFrame.RightVector
		local lookVec = chassis.CFrame.LookVector
		local pitchInput = rawThrottle * AIR_PITCH_TORQUE
		local rollInput = -rawSteer * AIR_ROLL_TORQUE
		local yawInput = -rawSteer * 1.2

		local airAngVel = rightVec * pitchInput + lookVec * rollInput + Vector3.new(0, yawInput, 0)
		chassis.AssemblyAngularVelocity = chassis.AssemblyAngularVelocity:Lerp(airAngVel, math.min(1, dt * 6))
	end

	-- 8. Visual Wheel Spin, Tire Smoke/Skid Trails & Camera FOV Surge
	animateWheels(model, dt, currentSpeed, smoothedSteer)
	setLocalVFX(model, isBoosting, isDrifting or (handbrakeHeld and absSpeed > 25))
	checkNearMisses(model, chassis.Position, absSpeed)

	local cam = Workspace.CurrentCamera
	if cam then
		local speedRatio = math.clamp(absSpeed / math.max(1, maxSpeed), 0, 1.4)
		local targetFov = BASE_FOV + speedRatio * SPEED_FOV_ADD + (if isBoosting then BOOST_FOV_ADD else 0)
		cam.FieldOfView = cam.FieldOfView + (targetFov - cam.FieldOfView) * math.min(1, dt * 8)
	end

	-- 9. Publish Live Attributes for HUD Consumption
	local mph = math.round(absSpeed * 1.15)
	local ratio = math.clamp(nitroFuel / math.max(0.1, nitroMax), 0, 1)
	localPlayer:SetAttribute("VehicleSpeed", math.round(absSpeed))
	localPlayer:SetAttribute("VehicleSpeedMPH", mph)
	localPlayer:SetAttribute("SpeedMPH", mph)
	localPlayer:SetAttribute("NitroRatio", ratio)
	localPlayer:SetAttribute("NitroFuel", math.round(ratio * 100))
	localPlayer:SetAttribute("MaxNitroFuel", 100)
	localPlayer:SetAttribute("IsDrifting", isDrifting)
	localPlayer:SetAttribute("IsBoosting", isBoosting)
	localPlayer:SetAttribute("DriftAngle", math.round(math.deg(math.abs(smoothedSlipAngle))))
	localPlayer:SetAttribute("AirTime", tonumber(string.format("%.1f", airTime)))
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="StarterCharacterScripts" referent="RBX00000022">
			<Properties>
				<string name="Name">StarterCharacterScripts</string>
			</Properties>
		</Item>
