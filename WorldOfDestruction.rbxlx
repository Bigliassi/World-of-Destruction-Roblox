	"LaunchPromptText",
	"DRIVE [W/A/S/D] & SMASH EVERYTHING TO UNLOCK ALL 8 CARS!",
	UDim2.new(1, -24, 1, -12),
	UDim2.fromOffset(12, 6),
	Enum.Font.GothamBlack,
	22,
	Color3.fromRGB(255, 235, 85),
	Enum.TextXAlignment.Center,
	launchPromptBanner
)
